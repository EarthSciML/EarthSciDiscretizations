{
  "discretizations": {
    "midpoint_1d": {
      "applies_to": {
        "op": "integral",
        "args": ["$u"],
        "var": "x",
        "lower": { "op": "const", "value": 0.0 },
        "upper": { "op": "const", "value": 1.0 }
      },
      "grid_family": "cartesian",
      "accuracy": "O(h^2) midpoint/Euler quadrature of a full-domain 1-D integral on a uniform cartesian grid",
      "replacement": {
        "op": "*",
        "args": [
          "dx",
          {
            "op": "arrayop",
            "reduce": "+",
            "ranges": {
              "j": [1, { "op": "index", "args": ["size_x", 1] }]
            },
            "expr": { "op": "index", "args": ["$u", "j"] },
            "args": ["size_x"]
          }
        ]
      }
    }
  }
}
