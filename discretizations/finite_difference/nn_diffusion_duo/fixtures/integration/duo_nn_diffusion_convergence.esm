{
  "case": "duo_nn_diffusion_convergence",
  "pipeline_kind": "mms_convergence",
  "mms_kind": "sin_lon_cos_lat",
  "description": "DUO nn_diffusion convergence: du/dt = Laplacian(u, dim=cell) on a DUO icosahedral triangular mesh. MMS: u(lon,lat) = sin(lon)*cos(lat); exact Laplacian = -2*u/R^2. Unit-sphere grids (R=1) are used so that the diffusion timescale R^2=1 keeps the solution change O(1e-3) over t_final=0.001, well above double-precision noise. Observed L-inf orders over levels 2-4: [1.25, 2.0] (pre-asymptotic; approaches first order as the pole-adjacent cells dominate at finer levels).",
  "esm": "duo_nn_diffusion_pde.esm",
  "grid_refs": [
    "duo_level2_unit.gdd.json",
    "duo_level3_unit.gdd.json",
    "duo_level4_unit.gdd.json"
  ],
  "t_final": 0.001,
  "convergence": {
    "metric": "Linf",
    "expected_min_order": 1.9,
    "min_order": 1.2
  }
}