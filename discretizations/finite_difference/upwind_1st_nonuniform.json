{
  "discretizations": {
    "upwind_1st_nonuniform": {
      "applies_to": {
        "op": "grad",
        "args": ["$u"],
        "dim": "$x"
      },
      "grid_family": "cartesian",
      "combine": "+",
      "accuracy": "O(dx_i)",
      "stencil": [
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": -1 },
          "coeff": {
            "op": "/",
            "args": [-1, { "op": "index", "args": ["dx", "$x"] }]
          }
        },
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": 0 },
          "coeff": {
            "op": "/",
            "args": [1, { "op": "index", "args": ["dx", "$x"] }]
          }
        }
      ]
    }
  }
}
