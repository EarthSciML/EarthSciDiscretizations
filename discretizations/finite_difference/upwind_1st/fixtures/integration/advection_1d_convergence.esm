{
  "case": "advection_1d_convergence",
  "pipeline_kind": "advection_1d_convergence",
  "description": "1D advection du/dt = -v * grad(u) on [0,1] periodic, v=1. IC = cos(2*pi*x). Exact solution = cos(2*pi*(x - v*t)). Sweeps N=16 and N=32 with upwind_1st-only GDDs (no centered_2nd_uniform to avoid rule conflict on 'grad'). Verifies first-order spatial convergence: log2(err_N16 / err_N32) >= 0.8. t_final=0.1 keeps numerical dissipation modest so convergence is in the asymptotic O(h) regime.",
  "esm": "advection_1d_pde.esm",
  "grid_refs": [
    "adv_n16.gdd.json",
    "adv_n32.gdd.json"
  ],
  "velocity": 1.0,
  "t_final": 0.1,
  "convergence": {
    "expected_order": 1.0,
    "min_order": 0.8,
    "comment": "First-order upwind: analytic dissipation model predicts order ~0.94 at t=0.1 for N=16->32."
  }
}
