{
  "esm": "0.2.0",
  "metadata": {
    "name": "centered_4th_deriv_uniform_canonical"
  },
  "grids": {
    "gx": {
      "family": "cartesian",
      "dimensions": [
        { "name": "i", "size": 8, "periodic": true, "spacing": "uniform" }
      ]
    }
  },
  "rules": [
    {
      "name": "centered_4th_deriv_uniform",
      "pattern": { "op": "d2", "args": ["$u"], "dim": "$x" },
      "replacement": {
        "op": "/",
        "args": [
          {
            "op": "-",
            "args": [
              {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      16,
                      {
                        "op": "+",
                        "args": [
                          { "op": "index", "args": ["$u", { "op": "-", "args": ["$x", 1] }] },
                          { "op": "index", "args": ["$u", { "op": "+", "args": ["$x", 1] }] }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "+",
                    "args": [
                      { "op": "index", "args": ["$u", { "op": "-", "args": ["$x", 2] }] },
                      { "op": "index", "args": ["$u", { "op": "+", "args": ["$x", 2] }] }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  30,
                  { "op": "index", "args": ["$u", "$x"] }
                ]
              }
            ]
          },
          { "op": "*", "args": [12, { "op": "*", "args": ["dx", "dx"] }] }
        ]
      }
    }
  ],
  "models": {
    "M": {
      "grid": "gx",
      "variables": {
        "u": {
          "type": "state",
          "default": 0.0,
          "units": "1",
          "shape": ["i"],
          "location": "cell_center"
        },
        "dx": {
          "type": "parameter",
          "default": 1.0,
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": { "op": "d2", "args": ["u"], "dim": "i" }
        }
      ]
    }
  }
}
