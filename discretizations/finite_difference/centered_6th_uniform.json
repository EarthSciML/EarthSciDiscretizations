{
  "discretizations": {
    "centered_6th_uniform": {
      "applies_to": {
        "op": "grad",
        "args": ["$u"],
        "dim": "$x"
      },
      "grid_family": "cartesian",
      "combine": "+",
      "accuracy": "O(dx^6)",
      "order": 6,
      "stencil": [
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": -3 },
          "coeff": { "op": "/", "args": [-1, { "op": "*", "args": [60, "dx"] }] }
        },
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": -2 },
          "coeff": { "op": "/", "args": [9, { "op": "*", "args": [60, "dx"] }] }
        },
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": -1 },
          "coeff": { "op": "/", "args": [-45, { "op": "*", "args": [60, "dx"] }] }
        },
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": 1 },
          "coeff": { "op": "/", "args": [45, { "op": "*", "args": [60, "dx"] }] }
        },
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": 2 },
          "coeff": { "op": "/", "args": [-9, { "op": "*", "args": [60, "dx"] }] }
        },
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": 3 },
          "coeff": { "op": "/", "args": [1, { "op": "*", "args": [60, "dx"] }] }
        }
      ]
    }
  }
}
