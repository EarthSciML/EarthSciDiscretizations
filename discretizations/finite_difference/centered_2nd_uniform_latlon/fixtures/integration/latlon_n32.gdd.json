{
  "esm": "0.5.0",
  "kind": "grid_discretization_descriptor",
  "metadata": {
    "title": "Lat-lon N=32x32 (colatitude, unit sphere)",
    "description": "Regular lat-lon grid on unit sphere. Colatitude lat in [0,pi] with N=32; longitude lon in [0,2pi] with N=32. Both periodic so Y_{2,0} gets exact ghost cells."
  },
  "grids": {
    "domain": {
      "family": "cartesian",
      "spatial": {
        "lat": {
          "min": 0.0,
          "max": 3.141592653589793,
          "units": "rad",
          "grid_spacing": 0.09817477042468103
        },
        "lon": {
          "min": 0.0,
          "max": 6.283185307179586,
          "units": "rad",
          "grid_spacing": 0.19634954084936207
        }
      },
      "boundary_conditions": [
        {"type": "periodic", "dimensions": ["lat", "lon"]}
      ]
    }
  },
  "discretizations": {
    "centered_2nd_uniform_latlon": {
      "ref": "../../../centered_2nd_uniform_latlon.json"
    }
  }
}
