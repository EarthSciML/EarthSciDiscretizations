{
  "esm": "0.4.0",
  "metadata": {"name": "latlon_grad_pde"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u": {
          "type": "state",
          "shape": ["lat", "lon"],
          "location": "cell_center",
          "default": 0.0
        },
        "R":       {"type": "parameter", "default": 1.0,                "units": "1"},
        "dlat":    {"type": "parameter", "default": 0.19634954084936207, "units": "1"},
        "dlon":    {"type": "parameter", "default": 0.39269908169872414, "units": "1"},
        "cos_lat": {"type": "parameter", "default": 1.0,                "units": "1"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "grad", "args": ["u"], "dim": "lat"}
        }
      ],
      "initial_conditions": {
        "type": "expression",
        "values": {
          "u": {
            "op": "*",
            "args": [
              0.25,
              {"op": "^", "args": [{"op": "/", "args": [5.0, 3.141592653589793]}, 0.5]},
              {"op": "-", "args": [
                {"op": "*", "args": [3.0, {"op": "^", "args": [{"op": "cos", "args": ["lat"]}, 2.0]}]},
                1.0
              ]}
            ]
          }
        }
      }
    }
  }
}
