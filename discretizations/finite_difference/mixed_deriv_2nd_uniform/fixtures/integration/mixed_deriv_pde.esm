{
  "esm": "0.4.0",
  "metadata": {"name": "mixed_deriv_pde"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "acc": {"type": "state", "shape": ["x", "y"], "location": "cell_center", "default": 0.0},
        "u":   {"type": "state", "shape": ["x", "y"], "location": "cell_center", "default": 0.0},
        "dx":  {"type": "parameter"},
        "dy":  {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["acc"], "wrt": "t"},
          "rhs": {"op": "grad", "args": [
            {"op": "grad", "args": ["u"], "dim": "y"}
          ], "dim": "x"}
        },
        {"lhs": {"op": "D", "args": ["u"], "wrt": "t"}, "rhs": 0.0}
      ],
      "initial_conditions": {
        "type": "expression",
        "values": {
          "acc": 0.0,
          "u": {"op": "cos", "args": [
            {"op": "*", "args": [6.283185307179586, {"op": "+", "args": ["x", "y"]}]}
          ]}
        }
      }
    }
  }
}
