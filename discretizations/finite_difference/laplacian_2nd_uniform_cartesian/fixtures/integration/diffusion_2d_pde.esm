{
  "esm": "0.4.0",
  "metadata": {"name": "diffusion_2d_pde"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u": {"type": "state", "shape": ["x", "y"], "location": "cell_center", "default": 0.0},
        "dx": {"type": "parameter"},
        "dy": {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "laplacian", "args": ["u"]}
        }
      ],
      "initial_conditions": {
        "type": "expression",
        "values": {
          "u": {
            "op": "*",
            "args": [
              {"op": "sin", "args": [{"op": "*", "args": [6.283185307179586, "x"]}]},
              {"op": "sin", "args": [{"op": "*", "args": [6.283185307179586, "y"]}]}
            ]
          }
        }
      }
    }
  }
}
