{
  "discretizations": {
    "d2_dxi2_cubed_sphere": {
      "applies_to": { "op": "d2", "args": ["$phi"], "dim": "xi" },
      "grid_family": "cubed_sphere",
      "combine": "+",
      "accuracy": "O(h^2)",
      "stencil": [
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": -1 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 0 }
          ],
          "coeff": { "op": "/", "args": [1, { "op": "^", "args": ["h", 2] }] }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 0 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 0 }
          ],
          "coeff": { "op": "/", "args": [-2, { "op": "^", "args": ["h", 2] }] }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 1 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 0 }
          ],
          "coeff": { "op": "/", "args": [1, { "op": "^", "args": ["h", 2] }] }
        }
      ],
      "metric_bindings": {
        "h": "uniform isotropic spacing dξ = dη"
      },
      "description": "Centered O(h²) second derivative along ξ on the cubed-sphere panel (η offset fixed at 0)."
    },
    "d2_deta2_cubed_sphere": {
      "applies_to": { "op": "d2", "args": ["$phi"], "dim": "eta" },
      "grid_family": "cubed_sphere",
      "combine": "+",
      "accuracy": "O(h^2)",
      "stencil": [
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 0 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": -1 }
          ],
          "coeff": { "op": "/", "args": [1, { "op": "^", "args": ["h", 2] }] }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 0 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 0 }
          ],
          "coeff": { "op": "/", "args": [-2, { "op": "^", "args": ["h", 2] }] }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 0 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 1 }
          ],
          "coeff": { "op": "/", "args": [1, { "op": "^", "args": ["h", 2] }] }
        }
      ],
      "metric_bindings": {
        "h": "uniform isotropic spacing dξ = dη"
      },
      "description": "Centered O(h²) second derivative along η on the cubed-sphere panel (ξ offset fixed at 0)."
    },
    "d2_dxieta_cubed_sphere": {
      "applies_to": { "op": "d2", "args": ["$phi"], "dim": "xi_eta" },
      "grid_family": "cubed_sphere",
      "combine": "+",
      "accuracy": "O(h^2)",
      "stencil": [
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 1 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 1 }
          ],
          "coeff": {
            "op": "/",
            "args": [1, { "op": "*", "args": [4, { "op": "^", "args": ["h", 2] }] }]
          }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": -1 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": -1 }
          ],
          "coeff": {
            "op": "/",
            "args": [1, { "op": "*", "args": [4, { "op": "^", "args": ["h", 2] }] }]
          }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 1 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": -1 }
          ],
          "coeff": {
            "op": "/",
            "args": [-1, { "op": "*", "args": [4, { "op": "^", "args": ["h", 2] }] }]
          }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": -1 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 1 }
          ],
          "coeff": {
            "op": "/",
            "args": [-1, { "op": "*", "args": [4, { "op": "^", "args": ["h", 2] }] }]
          }
        }
      ],
      "metric_bindings": {
        "h": "uniform isotropic spacing dξ = dη"
      },
      "description": "Centered O(h²) mixed second derivative ∂²/∂ξ∂η on the cubed-sphere panel via the standard 4-point cross stencil."
    },
    "d1_dxi_over_J_cubed_sphere": {
      "applies_to": { "op": "d1_over_J", "args": ["$phi"], "dim": "xi" },
      "grid_family": "cubed_sphere",
      "combine": "+",
      "accuracy": "O(h^2)",
      "stencil": [
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 1 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 0 }
          ],
          "coeff": {
            "op": "/",
            "args": [1, { "op": "*", "args": [2, "h", "J"] }]
          }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": -1 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 0 }
          ],
          "coeff": {
            "op": "/",
            "args": [-1, { "op": "*", "args": [2, "h", "J"] }]
          }
        }
      ],
      "metric_bindings": {
        "h": "uniform isotropic spacing dξ = dη",
        "J": "Jacobian (sqrt(det g_{ab})·R²)"
      },
      "description": "First derivative ∂φ/∂ξ divided by J: (φ(ξ+1,η) − φ(ξ−1,η)) / (2·h·J). Used for metric-derivative first-order correction terms."
    },
    "d1_deta_over_J_cubed_sphere": {
      "applies_to": { "op": "d1_over_J", "args": ["$phi"], "dim": "eta" },
      "grid_family": "cubed_sphere",
      "combine": "+",
      "accuracy": "O(h^2)",
      "stencil": [
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 0 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": 1 }
          ],
          "coeff": {
            "op": "/",
            "args": [1, { "op": "*", "args": [2, "h", "J"] }]
          }
        },
        {
          "selectors": [
            { "kind": "cubed_sphere", "axis": "xi", "offset": 0 },
            { "kind": "cubed_sphere", "axis": "eta", "offset": -1 }
          ],
          "coeff": {
            "op": "/",
            "args": [-1, { "op": "*", "args": [2, "h", "J"] }]
          }
        }
      ],
      "metric_bindings": {
        "h": "uniform isotropic spacing dξ = dη",
        "J": "Jacobian (sqrt(det g_{ab})·R²)"
      },
      "description": "First derivative ∂φ/∂η divided by J: (φ(ξ,η+1) − φ(ξ,η−1)) / (2·h·J). Used for metric-derivative first-order correction terms."
    },
    "covariant_laplacian_cubed_sphere": {
      "kind": "cross_metric",
      "applies_to": {
        "op": "laplacian",
        "args": ["$phi"]
      },
      "grid_family": "cubed_sphere",
      "combine": "+",
      "accuracy": "O(h^2)",
      "axes": ["xi", "eta"],
      "terms": [
        {
          "axis_stencil": "d2_dxi2_cubed_sphere",
          "metric_component": "ginv_xi_xi",
          "sign": 1,
          "description": "g^{ξξ} · ∂²φ/∂ξ²"
        },
        {
          "axis_stencil": "d2_deta2_cubed_sphere",
          "metric_component": "ginv_eta_eta",
          "sign": 1,
          "description": "g^{ηη} · ∂²φ/∂η²"
        },
        {
          "axis_stencil": "d2_dxieta_cubed_sphere",
          "metric_component": "ginv_xi_eta",
          "sign": 1,
          "description": "g^{ξη} · ∂²φ/∂ξ∂η  (ξη term)"
        },
        {
          "axis_stencil": "d2_dxieta_cubed_sphere",
          "metric_component": "ginv_xi_eta",
          "sign": 1,
          "description": "g^{ηξ} · ∂²φ/∂ξ∂η  (ηξ term; equals ξη term for symmetric metric)"
        },
        {
          "axis_stencil": "d1_dxi_over_J_cubed_sphere",
          "metric_component": "dJgxx_dxi",
          "sign": 1,
          "description": "(1/J)·∂ξ(J·g^{ξξ}) · ∂φ/∂ξ  first-order metric-derivative correction"
        },
        {
          "axis_stencil": "d1_dxi_over_J_cubed_sphere",
          "metric_component": "dJgxe_deta",
          "sign": 1,
          "description": "(1/J)·∂η(J·g^{ξη}) · ∂φ/∂ξ  first-order metric-derivative correction"
        },
        {
          "axis_stencil": "d1_deta_over_J_cubed_sphere",
          "metric_component": "dJgyy_deta",
          "sign": 1,
          "description": "(1/J)·∂η(J·g^{ηη}) · ∂φ/∂η  first-order metric-derivative correction"
        },
        {
          "axis_stencil": "d1_deta_over_J_cubed_sphere",
          "metric_component": "dJgxe_dxi",
          "sign": 1,
          "description": "(1/J)·∂ξ(J·g^{ξη}) · ∂φ/∂η  first-order metric-derivative correction"
        }
      ],
      "reference": "src/operators/laplacian.jl (imperative reference); Putman & Lin (2007), JCP 227(1):55-78 — gnomonic cubed-sphere covariant FV operators.",
      "notes": "Full covariant Laplacian on the gnomonic cubed sphere: ∇²φ = (1/J)[∂_ξ(J·g^{ξξ}·∂_ξφ + J·g^{ξη}·∂_ηφ) + ∂_η(J·g^{ξη}·∂_ξφ + J·g^{ηη}·∂_ηφ)]. Expressed as a cross_metric composite (§7.6) with 8 terms: 2 diagonal second-derivative terms (ginv_xi_xi·∂²/∂ξ² and ginv_eta_eta·∂²/∂η²), 2 cross-derivative terms (ginv_xi_eta·∂²/∂ξ∂η for ξη and ηξ, symmetric), and 4 first-order metric-derivative correction terms capturing (1/J)·∂(Jg^{ab}) contributions. Together these 8 terms reproduce the 9-point stencil of the ad-hoc selectors form. Uniform isotropic spacing h = π/(2·Nc) = dξ = dη at all cell centers.",
      "panel_handling": "lives in the cubed_sphere grid accessor (src/grids/panel_connectivity.jl); the rule references in-panel (ξ,η) offsets only. The top-level rule and its per-axis stencils carry no `panel` field — cross-panel ghost extension and basis rotation happen below the rule layer."
    }
  }
}
