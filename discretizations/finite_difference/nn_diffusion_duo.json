{
  "discretizations": {
    "nn_diffusion_duo": {
      "applies_to": { "op": "laplacian", "args": ["$u"], "dim": "cell" },
      "grid_family": "unstructured",
      "requires_locations": ["cell_center"],
      "emits_location": "cell_center",
      "combine": "+",
      "accuracy": "O(h^2) on a quasi-uniform triangular icosahedral mesh",
      "stencil": [
        {
          "selector": {
            "kind": "reduction",
            "table": "cell_neighbors",
            "count_expr": 3,
            "k_bound": "k",
            "combine": "+"
          },
          "coeff": {
            "op": "/",
            "args": [
              { "op": "index", "args": [
                  "dc_edge",
                  { "op": "index", "args": ["edges_on_face", "$target", "k"] }
              ]},
              { "op": "*", "args": [
                  { "op": "index", "args": [
                      "dv_edge",
                      { "op": "index", "args": ["edges_on_face", "$target", "k"] }
                  ]},
                  { "op": "index", "args": ["area", "$target"] }
              ]}
            ]
          }
        },
        {
          "selector": {
            "kind": "indirect",
            "table": "cell_neighbors",
            "index_expr": "$target"
          },
          "coeff": {
            "op": "*",
            "args": [
              -1,
              {
                "op": "arrayop",
                "output_idx": [],
                "expr": {
                  "op": "/",
                  "args": [
                    { "op": "index", "args": [
                        "dc_edge",
                        { "op": "index", "args": ["edges_on_face", "$target", "k"] }
                    ]},
                    { "op": "*", "args": [
                        { "op": "index", "args": [
                            "dv_edge",
                            { "op": "index", "args": ["edges_on_face", "$target", "k"] }
                        ]},
                        { "op": "index", "args": ["area", "$target"] }
                    ]}
                  ]
                },
                "ranges": {
                  "k": [0, 2]
                },
                "reduce": "+",
                "args": ["dc_edge", "dv_edge", "area", "edges_on_face"]
              }
            ]
          }
        }
      ]
    }
  }
}
