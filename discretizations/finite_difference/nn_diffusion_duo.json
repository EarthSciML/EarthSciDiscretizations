{
  "discretizations": {
    "nn_diffusion_duo": {
      "applies_to": { "op": "laplacian", "args": ["$u"], "dim": "cell" },
      "grid_family": "unstructured",
      "requires_locations": ["cell_center"],
      "emits_location": "cell_center",
      "combine": "+",
      "accuracy": "O(h^2) on a quasi-uniform triangular icosahedral mesh",
      "replacement": {
        "op": "arrayop",
        "reduce": "+",
        "ranges": {
          "k": [0, 2]
        },
        "expr": {
          "op": "*",
          "args": [
            {
              "op": "/",
              "args": [
                { "op": "index", "args": [
                    "dc_edge",
                    { "op": "index", "args": ["edges_on_face", "i", "k"] }
                ]},
                { "op": "*", "args": [
                    { "op": "index", "args": [
                        "dv_edge",
                        { "op": "index", "args": ["edges_on_face", "i", "k"] }
                    ]},
                    { "op": "index", "args": ["area", "i"] }
                ]}
              ]
            },
            { "op": "-", "args": [
                { "op": "index", "args": [
                    "$u",
                    { "op": "index", "args": ["cell_neighbors", "i", "k"] }
                ]},
                { "op": "index", "args": ["$u", "i"] }
            ]}
          ]
        },
        "args": ["dc_edge", "dv_edge", "area", "edges_on_face", "cell_neighbors"]
      }
    }
  }
}
