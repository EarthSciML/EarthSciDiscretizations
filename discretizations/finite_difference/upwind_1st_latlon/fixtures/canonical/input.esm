{
  "esm": "0.4.0",
  "metadata": {
    "name": "upwind_1st_latlon_canonical"
  },
  "grids": {
    "gll": {
      "family": "latlon",
      "dimensions": [
        {
          "name": "lon",
          "size": 8,
          "periodic": true
        },
        {
          "name": "lat",
          "size": 8
        }
      ]
    }
  },
  "rules": [
    {
      "name": "upwind_1st_latlon",
      "pattern": {
        "op": "grad",
        "args": [
          "$u"
        ],
        "dim": "$k"
      },
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  -1,
                  {
                    "op": "*",
                    "args": [
                      "R",
                      "cos_lat",
                      "dlon"
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "$u",
                  "lat",
                  {
                    "op": "+",
                    "args": [
                      "lon",
                      -1
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  1,
                  {
                    "op": "*",
                    "args": [
                      "R",
                      "cos_lat",
                      "dlon"
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "$u",
                  "lat",
                  "lon"
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  -1,
                  {
                    "op": "*",
                    "args": [
                      "R",
                      "dlat"
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "$u",
                  {
                    "op": "+",
                    "args": [
                      "lat",
                      -1
                    ]
                  },
                  "lon"
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  1,
                  {
                    "op": "*",
                    "args": [
                      "R",
                      "dlat"
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "$u",
                  "lat",
                  "lon"
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "models": {
    "M": {
      "grid": "gll",
      "variables": {
        "u": {
          "type": "state",
          "default": 0.0,
          "units": "1",
          "shape": [
            "lon",
            "lat"
          ],
          "location": "cell_center"
        },
        "cos_lat": {
          "type": "parameter",
          "default": 1.0,
          "units": "1"
        },
        "R": {
          "type": "parameter",
          "default": 1.0,
          "units": "1"
        },
        "dlon": {
          "type": "parameter",
          "default": 1.0,
          "units": "1"
        },
        "dlat": {
          "type": "parameter",
          "default": 1.0,
          "units": "1"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "grad",
            "args": [
              "u"
            ],
            "dim": "lon"
          }
        }
      ]
    }
  }
}
