{
  "discretizations": {
    "centered_2nd_nonuniform_cartesian": {
      "applies_to": {
        "op": "d2",
        "args": ["$u"],
        "dim": "$x"
      },
      "grid_family": "cartesian",
      "combine": "+",
      "accuracy": "O(dx^2)",
      "stencil": [
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": -1 },
          "coeff": {
            "op": "/",
            "args": [
              2,
              {
                "op": "*",
                "args": [
                  { "op": "index", "args": ["dx", "$x"] },
                  {
                    "op": "+",
                    "args": [
                      { "op": "index", "args": ["dx", "$x"] },
                      { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": 0 },
          "coeff": {
            "op": "/",
            "args": [
              -2,
              {
                "op": "*",
                "args": [
                  { "op": "index", "args": ["dx", "$x"] },
                  { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] }
                ]
              }
            ]
          }
        },
        {
          "selector": { "kind": "cartesian", "axis": "$x", "offset": 1 },
          "coeff": {
            "op": "/",
            "args": [
              2,
              {
                "op": "*",
                "args": [
                  { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] },
                  {
                    "op": "+",
                    "args": [
                      { "op": "index", "args": ["dx", "$x"] },
                      { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
