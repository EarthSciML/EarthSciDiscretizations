{
  "case": "mpas_nn_diffusion_convergence",
  "pipeline_kind": "mms_convergence",
  "mms_kind": "sin_lon_cos_lat",
  "description": "MPAS nn_diffusion convergence: du/dt = Laplacian(u, dim=cell) on MPAS Voronoi mesh. MMS: u(lon,lat) = sin(lon)*cos(lat); exact Laplacian = -2*u/R^2. Unit-sphere grids (R=1) are used so that the diffusion timescale R^2=1 keeps the solution change O(1e-3) over t_final=0.001, well above double-precision noise. Observed L-inf orders over levels 3-5: [1.35, 1.64] (pre-asymptotic; approaches first order as the pole-adjacent hexagonal cells dominate at finer levels).",
  "esm": "mpas_nn_diffusion_pde.esm",
  "grid_refs": [
    "mpas_x1_642_unit.gdd.json",
    "mpas_x1_2562_unit.gdd.json",
    "mpas_x1_10242_unit.gdd.json"
  ],
  "t_final": 0.001,
  "convergence": {
    "metric": "Linf",
    "expected_min_order": 1.9,
    "min_order": 1.3
  }
}