{
  "esm": "0.4.0",
  "metadata": {
    "name": "upwind_1st_vertical_canonical"
  },
  "grids": {
    "gz": {
      "family": "vertical",
      "dimensions": [
        {
          "name": "k",
          "size": 16,
          "periodic": true,
          "spacing": "uniform"
        }
      ]
    }
  },
  "rules": [
    {
      "name": "upwind_1st_vertical",
      "pattern": {
        "op": "grad",
        "args": [
          "$u"
        ],
        "dim": "$x"
      },
      "replacement": {
        "op": "arrayop",
        "output_idx": [
          "$x"
        ],
        "expr": {
          "op": "+",
          "args": [
            {
              "op": "*",
              "args": [
                {
                  "op": "/",
                  "args": [
                    -1,
                    "h"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "$u",
                    {
                      "op": "+",
                      "args": [
                        "$x",
                        -1
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "*",
              "args": [
                {
                  "op": "/",
                  "args": [
                    1,
                    "h"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "$u",
                    "$x"
                  ]
                }
              ]
            }
          ]
        },
        "args": [
          "$u"
        ]
      }
    }
  ],
  "models": {
    "M": {
      "grid": "gz",
      "variables": {
        "u": {
          "type": "state",
          "default": 0.0,
          "units": "1",
          "shape": [
            "k"
          ],
          "location": "cell_center"
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "grad",
            "args": [
              "u"
            ],
            "dim": "k"
          }
        }
      ]
    }
  }
}
