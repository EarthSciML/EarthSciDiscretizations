{
  "case": "diffusion_1d_vertical_analytic",
  "pipeline_kind": "mms_convergence",
  "description": "1D vertical heat equation du/dt = d2u/dz2 on [0,1] with zero Dirichlet BCs. IC = sin(pi*z). Exact continuous solution = sin(pi*z)*exp(-pi^2*t). MMS convergence sweep N=16->32 verifies O(h^2) spatial accuracy of centered_2nd_deriv_uniform_vertical via build_ode_problem. Interior-only comparison (boundary_skip=3) avoids the O(1/h) ghost-cell forcing error at boundary cells; t_final is small so ghost contamination at interior cells is negligible.",
  "esm": "diffusion_1d_vertical_pde.esm",
  "grid_refs": [
    "../../../../gdd/vertical_1d_dirichlet_n16.gdd.json",
    "../../../../gdd/vertical_1d_dirichlet_n32.gdd.json"
  ],
  "mms_kind": "sin_pi_z_dirichlet_interior",
  "boundary_skip": 3,
  "t_final": 1e-5,
  "convergence": {
    "min_order": 1.8,
    "comment": "O(h^2) interior truncation at t=1e-5 gives errors ~3e-7 (N=16) and ~8e-8 (N=32), order~2. Ghost-cell contamination at skip+1 cells from boundary is ~t^4/h^7 << spatial error for these parameters."
  }
}
