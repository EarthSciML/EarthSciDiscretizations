{
  "discretizations": {
    "laplacian_2nd_uniform_cartesian": {
      "applies_to": {
        "op": "laplacian",
        "args": ["$u"]
      },
      "grid_family": "cartesian",
      "combine": "+",
      "accuracy": "O(dx^2)",
      "stencil": [
        {
          "selector": { "kind": "arakawa", "axis": "$x", "offset": -1, "stagger": "cell_center" },
          "coeff": {
            "op": "/",
            "args": [1, { "op": "*", "args": ["dx", "dx"] }]
          }
        },
        {
          "selector": { "kind": "arakawa", "axis": "$x", "offset": 0, "stagger": "cell_center" },
          "coeff": {
            "op": "/",
            "args": [-2, { "op": "*", "args": ["dx", "dx"] }]
          }
        },
        {
          "selector": { "kind": "arakawa", "axis": "$x", "offset": 1, "stagger": "cell_center" },
          "coeff": {
            "op": "/",
            "args": [1, { "op": "*", "args": ["dx", "dx"] }]
          }
        },
        {
          "selector": { "kind": "arakawa", "axis": "$y", "offset": -1, "stagger": "cell_center" },
          "coeff": {
            "op": "/",
            "args": [1, { "op": "*", "args": ["dy", "dy"] }]
          }
        },
        {
          "selector": { "kind": "arakawa", "axis": "$y", "offset": 0, "stagger": "cell_center" },
          "coeff": {
            "op": "/",
            "args": [-2, { "op": "*", "args": ["dy", "dy"] }]
          }
        },
        {
          "selector": { "kind": "arakawa", "axis": "$y", "offset": 1, "stagger": "cell_center" },
          "coeff": {
            "op": "/",
            "args": [1, { "op": "*", "args": ["dy", "dy"] }]
          }
        }
      ],
      "replacement": {
        "op": "arrayop",
        "output_idx": ["$x", "$y"],
        "expr": {
          "op": "+",
          "args": [
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [1, { "op": "*", "args": ["dx", "dx"] }] },
                { "op": "index", "args": ["$u", { "op": "+", "args": ["$x", -1] }, "$y"] }
              ]
            },
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [-2, { "op": "*", "args": ["dx", "dx"] }] },
                { "op": "index", "args": ["$u", "$x", "$y"] }
              ]
            },
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [1, { "op": "*", "args": ["dx", "dx"] }] },
                { "op": "index", "args": ["$u", { "op": "+", "args": ["$x", 1] }, "$y"] }
              ]
            },
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [1, { "op": "*", "args": ["dy", "dy"] }] },
                { "op": "index", "args": ["$u", "$x", { "op": "+", "args": ["$y", -1] }] }
              ]
            },
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [-2, { "op": "*", "args": ["dy", "dy"] }] },
                { "op": "index", "args": ["$u", "$x", "$y"] }
              ]
            },
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [1, { "op": "*", "args": ["dy", "dy"] }] },
                { "op": "index", "args": ["$u", "$x", { "op": "+", "args": ["$y", 1] }] }
              ]
            }
          ]
        }
      }
    }
  }
}
