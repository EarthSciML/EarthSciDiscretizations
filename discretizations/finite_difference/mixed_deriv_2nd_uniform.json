{
  "discretizations": {
    "mixed_deriv_2nd_uniform": {
      "applies_to": {
        "op": "grad",
        "args": [{ "op": "grad", "args": ["$u"], "dim": "$y" }],
        "dim": "$x"
      },
      "grid_family": "cartesian",
      "accuracy": "O(dx^2)",
      "replacement": {
        "op": "arrayop",
        "output_idx": ["$x", "$y"],
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "-",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "$u",
                        { "op": "+", "args": ["$x", 1] },
                        { "op": "+", "args": ["$y", 1] }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "$u",
                        { "op": "+", "args": ["$x", 1] },
                        { "op": "-", "args": ["$y", 1] }
                      ]
                    }
                  ]
                },
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "$u",
                        { "op": "-", "args": ["$x", 1] },
                        { "op": "+", "args": ["$y", 1] }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "$u",
                        { "op": "-", "args": ["$x", 1] },
                        { "op": "-", "args": ["$y", 1] }
                      ]
                    }
                  ]
                }
              ]
            },
            { "op": "*", "args": [4, { "op": "*", "args": ["dx", "dy"] }] }
          ]
        },
        "args": ["$u"]
      }
    }
  }
}
