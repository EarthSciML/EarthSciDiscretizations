{
  "rule": "upwind_1st_nonuniform",
  "manufactured_solution": "sin(2*pi*x) on [0,1] periodic; derivative 2*pi*cos(2*pi*x)",
  "sampling": "cell_center",
  "grid_type": "stretched",
  "stretching": "sinusoidal amplitude 0.3 — dx[i] = (L/N) * (1 + 0.3*sin(2*pi*(i-1)/N))",
  "grids": [
    { "n": 16 },
    { "n": 32 },
    { "n": 64 },
    { "n": 128 }
  ]
}
