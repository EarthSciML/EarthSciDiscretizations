{
  "esm": "0.4.0",
  "metadata": {
    "name": "divergence_duo_canonical"
  },
  "grids": {
    "domain": {
      "family": "duo",
      "dimensions": [
        { "name": "n_cells", "size": 320, "periodic": false, "spacing": "unstructured" },
        { "name": "n_edges", "size": 480, "periodic": false, "spacing": "unstructured" }
      ]
    }
  },
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "div": { "type": "state", "shape": ["n_cells"], "location": "cell_center", "default": 0.0 },
        "F": { "type": "state", "shape": ["n_edges"], "location": "edge_normal", "default": 0.0 }
      },
      "equations": [
        { "lhs": { "op": "D", "args": ["div"], "wrt": "t" }, "rhs": { "op": "div", "args": ["F"], "dim": "cell" } },
        { "lhs": { "op": "D", "args": ["F"], "wrt": "t" }, "rhs": 0.0 }
      ]
    }
  },
  "rules": [
    {
      "name": "divergence_duo",
      "pattern": { "op": "div", "args": ["$F"], "dim": "cell" },
      "replacement": {
        "op": "arrayop",
        "reduce": "+",
        "ranges": {
          "k": [1, 3]
        },
        "expr": {
          "op": "*",
          "args": [
            {
              "op": "*",
              "args": [
                { "op": "index", "args": ["edge_sign_on_face", "i", "k"] },
                {
                  "op": "/",
                  "args": [
                    { "op": "index", "args": [
                        "dc_edge",
                        { "op": "index", "args": ["edges_on_face", "i", "k"] }
                    ]},
                    { "op": "index", "args": ["tri_area", "i"] }
                  ]
                }
              ]
            },
            { "op": "index", "args": [
                "$F",
                { "op": "index", "args": ["edges_on_face", "i", "k"] }
            ]}
          ]
        },
        "args": ["$F", "dc_edge", "tri_area", "edges_on_face", "edge_sign_on_face"]
      }
    }
  ]
}
