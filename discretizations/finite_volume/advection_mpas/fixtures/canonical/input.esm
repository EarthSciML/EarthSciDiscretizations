{
  "esm": "0.4.0",
  "metadata": {
    "name": "advection_mpas_canonical"
  },
  "grids": {
    "domain": {
      "family": "mpas",
      "dimensions": [
        {
          "name": "n_cells",
          "size": 162,
          "periodic": false,
          "spacing": "unstructured"
        },
        {
          "name": "n_edges",
          "size": 480,
          "periodic": false,
          "spacing": "unstructured"
        }
      ]
    }
  },
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "adv": {
          "type": "state",
          "shape": [
            "n_cells"
          ],
          "location": "cell_center",
          "default": 0.0
        },
        "u": {
          "type": "state",
          "shape": [
            "n_edges"
          ],
          "location": "edge_normal",
          "default": 0.0
        },
        "q": {
          "type": "state",
          "shape": [
            "n_cells"
          ],
          "location": "cell_center",
          "default": 0.0
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "D",
            "args": [
              "adv"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "div",
            "args": [
              {
                "op": "*",
                "args": [
                  "q",
                  "u"
                ]
              }
            ],
            "dim": "cell"
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "q"
            ],
            "wrt": "t"
          },
          "rhs": 0.0
        }
      ]
    }
  },
  "rules": [
    {
      "name": "advection_mpas",
      "pattern": {
        "op": "div",
        "args": [
          {
            "op": "*",
            "args": [
              "$q",
              "$u"
            ]
          }
        ],
        "dim": "cell"
      },
      "where": [
        {
          "guard": "var_location_is",
          "pvar": "$q",
          "location": "cell_center"
        },
        {
          "guard": "var_location_is",
          "pvar": "$u",
          "location": "edge_normal"
        }
      ],
      "replacement": {
        "op": "arrayop",
        "reduce": "+",
        "ranges": {
          "k": [
            1,
            {
              "op": "index",
              "args": [
                "n_edges_on_cell",
                "i"
              ]
            }
          ]
        },
        "expr": {
          "op": "*",
          "args": [
            {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "edge_sign_on_cell",
                    "i",
                    "k"
                  ]
                },
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "dv_edge",
                        {
                          "op": "index",
                          "args": [
                            "edges_on_cell",
                            "i",
                            "k"
                          ]
                        }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "area_cell",
                        "i"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "$u",
                    {
                      "op": "index",
                      "args": [
                        "edges_on_cell",
                        "i",
                        "k"
                      ]
                    }
                  ]
                },
                {
                  "op": "/",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "$q",
                            {
                              "op": "index",
                              "args": [
                                "cells_on_edge",
                                {
                                  "op": "index",
                                  "args": [
                                    "edges_on_cell",
                                    "i",
                                    "k"
                                  ]
                                },
                                1
                              ]
                            }
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "$q",
                            {
                              "op": "index",
                              "args": [
                                "cells_on_edge",
                                {
                                  "op": "index",
                                  "args": [
                                    "edges_on_cell",
                                    "i",
                                    "k"
                                  ]
                                },
                                2
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    2
                  ]
                }
              ]
            }
          ]
        },
        "args": [
          "$u",
          "$q",
          "dv_edge",
          "area_cell",
          "edges_on_cell",
          "edge_sign_on_cell",
          "cells_on_edge",
          "n_edges_on_cell"
        ]
      }
    }
  ]
}