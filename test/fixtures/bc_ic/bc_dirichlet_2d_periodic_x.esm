{
  "esm": "0.4.0",
  "metadata": {"name": "bc_dirichlet_2d_periodic_x"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u":  {"type": "state",     "shape": ["x", "y"], "location": "cell_center", "default": 0.0},
        "dx": {"type": "parameter"},
        "dy": {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "laplacian", "args": ["u"]}
        }
      ],
      "initial_conditions": {
        "type": "expression",
        "values": {
          "u": {
            "op": "*",
            "args": [
              {"op": "sin", "args": [{"op": "*", "args": [6.283185307179586, "x"]}]},
              {"op": "sin", "args": [{"op": "*", "args": [3.141592653589793, "y"]}]}
            ]
          }
        }
      },
      "boundary_conditions": {
        "u_ymin": {"variable": "u", "kind": "dirichlet", "side": "ymin", "value": 0},
        "u_ymax": {"variable": "u", "kind": "dirichlet", "side": "ymax", "value": 0}
      }
    }
  }
}
