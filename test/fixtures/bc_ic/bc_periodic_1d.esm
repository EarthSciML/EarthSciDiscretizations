{
  "esm": "0.4.0",
  "metadata": {"name": "bc_periodic_1d"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u":  {"type": "state",     "shape": ["x"], "location": "cell_center", "default": 0.0},
        "dx": {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "d2", "args": ["u"], "dim": "x"}
        }
      ],
      "boundary_conditions": {
        "u_xmin": {"variable": "u", "kind": "periodic", "side": "xmin"},
        "u_xmax": {"variable": "u", "kind": "periodic", "side": "xmax"}
      }
    }
  }
}
