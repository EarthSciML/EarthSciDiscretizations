{
  "esm": "0.4.0",
  "metadata": {"name": "bc_periodic_2d"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u":  {"type": "state",     "shape": ["x", "y"], "location": "cell_center", "default": 0.0},
        "dx": {"type": "parameter"},
        "dy": {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "laplacian", "args": ["u"]}
        }
      ],
      "boundary_conditions": {
        "u_xmin": {"variable": "u", "kind": "periodic", "side": "xmin"},
        "u_xmax": {"variable": "u", "kind": "periodic", "side": "xmax"},
        "u_ymin": {"variable": "u", "kind": "periodic", "side": "ymin"},
        "u_ymax": {"variable": "u", "kind": "periodic", "side": "ymax"}
      }
    }
  }
}
