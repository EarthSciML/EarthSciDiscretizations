{
  "esm": "0.4.0",
  "metadata": {"name": "cubed_sphere_transport"},
  "domains": {
    "sphere": {
      "spatial": {
        "lon": {"min": -3.141592653589793, "max": 3.141592653589793},
        "lat": {"min": -1.5707963267948966, "max": 1.5707963267948966},
        "t": {"min": 0.0, "max": 6.283185307179586}
      }
    }
  },
  "models": {
    "M": {
      "variables": {
        "h": {"type": "state"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["h"], "wrt": "t"},
          "rhs": {
            "op": "-",
            "args": [
              0,
              {"op": "D", "args": ["h"], "wrt": "lon"}
            ]
          }
        }
      ]
    }
  }
}
