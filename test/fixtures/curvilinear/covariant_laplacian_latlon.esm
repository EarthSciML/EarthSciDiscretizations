{
  "esm": "0.4.0",
  "metadata": {"name": "covariant_laplacian_latlon"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u":    {"type": "state",     "shape": ["lat", "lon"], "location": "cell_center", "default": 0.0},
        "dlon": {"type": "parameter"},
        "dlat": {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "laplacian", "args": ["u"]}
        }
      ]
    }
  }
}
