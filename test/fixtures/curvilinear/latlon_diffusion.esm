{
  "esm": "0.4.0",
  "metadata": {"name": "latlon_diffusion"},
  "models": {
    "M": {
      "variables": {
        "u": {"type": "state"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {
            "op": "+",
            "args": [
              {"op": "D", "args": [{"op": "D", "args": ["u"], "wrt": "lon"}], "wrt": "lon"},
              {"op": "D", "args": [{"op": "D", "args": ["u"], "wrt": "lat"}], "wrt": "lat"}
            ]
          }
        }
      ]
    }
  }
}
