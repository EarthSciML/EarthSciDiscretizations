{
  "esm": "0.4.0",
  "metadata": {"name": "upwind_nonuniform_bode_test"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u":  {"type": "state", "shape": ["x"], "location": "cell_center", "default": 0.0},
        "dx": {"type": "state", "shape": ["x"], "default": 0.25}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "grad", "args": ["u"], "dim": "x"}
        }
      ]
    }
  }
}
