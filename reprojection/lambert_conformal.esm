                    "args": [
                      "phi0",
                      2.0
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "_comment": "Conformal tangent at the input latitude: tan(π/4 + φ/2). Sets ρ for the point. Singular (→0, ρ→∞) at the far pole φ=−90°·sign(n); the projection is undefined there by construction, so points must avoid that pole.",
          "lhs": "tphi",
          "rhs": {
