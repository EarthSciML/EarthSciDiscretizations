{
  "id": "mixed_dae_observed",
  "bead": "esd-625",
  "description": "Mixed DAE: a scalar state x with dx/dt = -k*x, plus an observed y = x^2. After EarthSciSerialization.discretize(), the equation set contains 1 differential and 1 algebraic equation. RFC §12 binding contract: dae_support=true -> accept (metadata.system_class = \"dae\"); dae_support=false -> abort with code E_NO_DAE_SUPPORT.",
  "input": {
    "esm": "0.2.0",
    "metadata": { "name": "mixed_dae_observed" },
    "models": {
      "M": {
        "variables": {
          "x": { "type": "state",    "default": 1.0, "units": "1" },
          "y": { "type": "observed", "units": "1" },
          "k": { "type": "parameter","default": 0.5, "units": "1/s" }
        },
        "equations": [
          {
            "lhs": { "op": "D", "args": ["x"], "wrt": "t" },
            "rhs": { "op": "*", "args": [ { "op": "-", "args": ["k"] }, "x" ] }
          },
          {
            "lhs": "y",
            "rhs": { "op": "^", "args": ["x", 2] }
          }
        ]
      }
    }
  },
  "expect": [
    {
      "mode": "dae_support_enabled",
      "kind": "output",
      "system_class": "dae",
      "algebraic_equation_count": 1,
      "per_model": { "M": 1 }
    },
    {
      "mode": "dae_support_disabled",
      "kind": "error",
      "code": "E_NO_DAE_SUPPORT",
      "message_must_contain": ["models.M", "equations"]
    }
  ],
  "tags": ["authored_algebraic", "observed_equation"]
}
