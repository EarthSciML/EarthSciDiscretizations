{
  "esm": "0.4.0",
  "metadata": {
    "name": "expression_ic_structured_canonical"
  },
  "grids": {
    "gll": {
      "family": "latlon",
      "dimensions": [
        { "name": "lon", "size": 8, "periodic": true },
        { "name": "lat", "size": 8 }
      ]
    },
    "gak": {
      "family": "arakawa",
      "dimensions": [
        { "name": "x", "size": 4, "periodic": true },
        { "name": "y", "size": 4, "periodic": true }
      ]
    }
  },
  "models": {
    "Mlatlon": {
      "grid": "gll",
      "variables": {
        "u_ll": {
          "type": "state",
          "default": 0.0,
          "units": "1",
          "shape": ["lon", "lat"],
          "location": "cell_center"
        }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["u_ll"], "wrt": "t" },
          "rhs": { "op": "*", "args": [0.0, "u_ll"] }
        }
      ],
      "initialization_equations": [
        {
          "lhs": "u_ll",
          "rhs": {
            "op": "*",
            "args": [
              { "op": "sin", "args": ["lon"] },
              { "op": "cos", "args": ["lat"] }
            ]
          }
        }
      ]
    },
    "Marakawa": {
      "grid": "gak",
      "variables": {
        "u_ak": {
          "type": "state",
          "default": 0.0,
          "units": "1",
          "shape": ["x", "y"],
          "location": "cell_center"
        }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["u_ak"], "wrt": "t" },
          "rhs": { "op": "*", "args": [0.0, "u_ak"] }
        }
      ],
      "initialization_equations": [
        {
          "lhs": "u_ak",
          "rhs": {
            "op": "*",
            "args": [
              { "op": "sin", "args": [{ "op": "*", "args": [6.283185307179586, "x"] }] },
              { "op": "sin", "args": [{ "op": "*", "args": [6.283185307179586, "y"] }] }
            ]
          }
        }
      ]
    }
  }
}
