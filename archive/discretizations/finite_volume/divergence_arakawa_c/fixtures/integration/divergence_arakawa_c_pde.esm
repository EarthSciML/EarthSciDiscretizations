{
  "esm": "0.4.0",
  "metadata": {"name": "divergence_arakawa_c_pde"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "div": {"type": "state", "shape": ["x", "y"], "location": "cell_center", "default": 0.0},
        "Fu":  {"type": "state", "shape": ["x", "y"], "location": "face_x",    "default": 0.0},
        "Fv":  {"type": "state", "shape": ["x", "y"], "location": "face_y",    "default": 0.0},
        "dx":  {"type": "parameter"},
        "dy":  {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["div"], "wrt": "t"},
          "rhs": {"op": "div", "args": ["Fu", "Fv"]}
        },
        {
          "lhs": {"op": "D", "args": ["Fu"], "wrt": "t"},
          "rhs": 0.0
        },
        {
          "lhs": {"op": "D", "args": ["Fv"], "wrt": "t"},
          "rhs": 0.0
        }
      ],
      "initial_conditions": {
        "type": "expression",
        "values": {
          "div": 0.0,
          "Fu": {
            "op": "*",
            "args": [
              {"op": "sin", "args": [{"op": "*", "args": [6.283185307179586, "x"]}]},
              {"op": "cos", "args": [{"op": "*", "args": [6.283185307179586, "y"]}]}
            ]
          },
          "Fv": {
            "op": "*",
            "args": [
              {"op": "cos", "args": [{"op": "*", "args": [6.283185307179586, "x"]}]},
              {"op": "sin", "args": [{"op": "*", "args": [6.283185307179586, "y"]}]}
            ]
          }
        }
      }
    }
  }
}
