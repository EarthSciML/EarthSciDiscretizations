{
  "discretizations": {
    "covariant_fv_gradient_latlon_t1": {
      "applies_to": {
        "op": "grad",
        "args": ["$u"],
        "dim": "t1"
      },
      "grid_family": "latlon",
      "accuracy": "O(h^2)",
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              { "op": "index", "args": ["dxi_dt1", "lat", "lon"] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", 1] }] },
                  { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", -1] }] }
                ] },
                { "op": "*", "args": [2, "dlon"] }
              ] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "index", "args": ["deta_dt1", "lat", "lon"] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", 1] }, "lon"] },
                  { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", -1] }, "lon"] }
                ] },
                { "op": "*", "args": [2, "dlat"] }
              ] }
            ]
          }
        ]
      }
    },
    "covariant_fv_gradient_latlon_t2": {
      "applies_to": {
        "op": "grad",
        "args": ["$u"],
        "dim": "t2"
      },
      "grid_family": "latlon",
      "accuracy": "O(h^2)",
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              { "op": "index", "args": ["dxi_dt2", "lat", "lon"] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", 1] }] },
                  { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", -1] }] }
                ] },
                { "op": "*", "args": [2, "dlon"] }
              ] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "index", "args": ["deta_dt2", "lat", "lon"] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", 1] }, "lon"] },
                  { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", -1] }, "lon"] }
                ] },
                { "op": "*", "args": [2, "dlat"] }
              ] }
            ]
          }
        ]
      }
    }
  }
}
