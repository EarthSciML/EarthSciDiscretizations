{
  "discretizations": {
    "covariant_fv_laplacian_latlon": {
      "applies_to": {
        "op": "laplacian",
        "args": ["$u"]
      },
      "grid_family": "latlon",
      "accuracy": "O(h^2)",
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [
                { "op": "index", "args": ["g_xx", "lat", "lon"] },
                { "op": "*", "args": ["dlon", "dlon"] }
              ] },
              { "op": "+", "args": [
                { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", 1] }] },
                { "op": "*", "args": [-2, { "op": "index", "args": ["$u", "lat", "lon"] }] },
                { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", -1] }] }
              ] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [
                { "op": "index", "args": ["g_yy", "lat", "lon"] },
                { "op": "*", "args": ["dlat", "dlat"] }
              ] },
              { "op": "+", "args": [
                { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", 1] }, "lon"] },
                { "op": "*", "args": [-2, { "op": "index", "args": ["$u", "lat", "lon"] }] },
                { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", -1] }, "lon"] }
              ] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [
                { "op": "*", "args": [2, { "op": "index", "args": ["g_xe", "lat", "lon"] }] },
                { "op": "*", "args": [4, { "op": "*", "args": ["dlon", "dlat"] }] }
              ] },
              { "op": "+", "args": [
                { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", 1] }, { "op": "+", "args": ["lon", 1] }] },
                { "op": "*", "args": [-1, { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", 1] }, { "op": "+", "args": ["lon", -1] }] }] },
                { "op": "*", "args": [-1, { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", -1] }, { "op": "+", "args": ["lon", 1] }] }] },
                { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", -1] }, { "op": "+", "args": ["lon", -1] }] }
              ] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "index", "args": ["invJ", "lat", "lon"] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["Jg_xx", "lat", { "op": "+", "args": ["lon", 1] }] },
                  { "op": "index", "args": ["Jg_xx", "lat", { "op": "+", "args": ["lon", -1] }] }
                ] },
                { "op": "*", "args": [2, "dlon"] }
              ] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", 1] }] },
                  { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", -1] }] }
                ] },
                { "op": "*", "args": [2, "dlon"] }
              ] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "index", "args": ["invJ", "lat", "lon"] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["Jg_yy", { "op": "+", "args": ["lat", 1] }, "lon"] },
                  { "op": "index", "args": ["Jg_yy", { "op": "+", "args": ["lat", -1] }, "lon"] }
                ] },
                { "op": "*", "args": [2, "dlat"] }
              ] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", 1] }, "lon"] },
                  { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", -1] }, "lon"] }
                ] },
                { "op": "*", "args": [2, "dlat"] }
              ] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "index", "args": ["invJ", "lat", "lon"] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["Jg_xe", { "op": "+", "args": ["lat", 1] }, "lon"] },
                  { "op": "index", "args": ["Jg_xe", { "op": "+", "args": ["lat", -1] }, "lon"] }
                ] },
                { "op": "*", "args": [2, "dlat"] }
              ] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", 1] }] },
                  { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", -1] }] }
                ] },
                { "op": "*", "args": [2, "dlon"] }
              ] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "index", "args": ["invJ", "lat", "lon"] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["Jg_xe", "lat", { "op": "+", "args": ["lon", 1] }] },
                  { "op": "index", "args": ["Jg_xe", "lat", { "op": "+", "args": ["lon", -1] }] }
                ] },
                { "op": "*", "args": [2, "dlon"] }
              ] },
              { "op": "/", "args": [
                { "op": "-", "args": [
                  { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", 1] }, "lon"] },
                  { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", -1] }, "lon"] }
                ] },
                { "op": "*", "args": [2, "dlat"] }
              ] }
            ]
          }
        ]
      }
    }
  }
}
