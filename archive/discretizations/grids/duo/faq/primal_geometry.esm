                  "args": [
                    "face_vert",
                    "c",
                    "k"
                  ],
                  "op": "index"
                },
                "d"
              ],
              "op": "index"
            },
            "op": "aggregate",
            "output_idx": [
              "c",
              "d"
            ],
            "ranges": {
              "c": {
                "from": "cells"
              },
              "d": {
                "from": "space"
              },
              "k": {
                "from": "corners"
              }
            },
            "semiring": "sum_product"
          }
        },
        {
          "_comment": "(2) cent_nrm2[c] = sum_d cent_sum[c,d]^2 — squared norm (square as a product, not ^, to match the imperative mx*mx float op).",
          "lhs": {
            "args": [
              "cent_nrm2",
