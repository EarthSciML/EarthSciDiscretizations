{
  "case": "diffusion_1d_nonuniform_analytic",
  "pipeline_kind": "mms_convergence",
  "description": "1D vertical heat equation du/dt = d2u/dz2 on [0,1] with non-uniform cell widths (sinusoidal stretching alpha=0.2) and zero Dirichlet BCs. IC = sin(pi*z). Exact continuous solution = sin(pi*z)*exp(-pi^2*t). MMS convergence sweep N=16->32 verifies O(h^2) spatial accuracy of centered_2nd_deriv_nonuniform_vertical via build_ode_problem. Interior-only comparison (boundary_skip=3) avoids the O(1/h) ghost-cell forcing error; t_final=1e-5 keeps ghost contamination at interior cells negligible vs. spatial truncation error.",
  "esm": "diffusion_1d_nonuniform_pde.esm",
  "grid_refs": [
    "../../../../gdd/vertical_1d_nonuniform_n16.gdd.json",
    "../../../../gdd/vertical_1d_nonuniform_n32.gdd.json"
  ],
  "mms_kind": "sin_pi_z_dirichlet_interior",
  "boundary_skip": 3,
  "t_final": 1e-5,
  "convergence": {
    "min_order": 1.8,
    "comment": "Non-uniform O(h^2) centered FD on a sinusoidally-stretched grid. Interior truncation error O(h^2)*t_final dominates at small t_final; ghost-cell contamination at boundary_skip cells from boundary is O(t^4/h^7) << spatial error for N=16,32."
  }
}
