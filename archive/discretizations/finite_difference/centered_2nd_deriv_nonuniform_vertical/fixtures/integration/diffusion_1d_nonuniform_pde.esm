{
  "esm": "0.4.0",
  "metadata": {"name": "diffusion_1d_nonuniform_pde"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u":  {"type": "state", "shape": ["z"], "location": "cell_center", "default": 0.0, "units": "1"},
        "dz": {"type": "state", "shape": ["z"], "location": "cell_center", "default": 1.0, "units": "m"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "d2", "args": ["u"], "dim": "z"}
        }
      ],
      "initial_conditions": {
        "type": "expression",
        "values": {
          "u": {"op": "sin", "args": [{"op": "*", "args": [3.141592653589793, "z"]}]}
        }
      },
      "boundary_conditions": {
        "u_zmin":  {"variable": "u",  "kind": "dirichlet", "side": "zmin", "value": 0},
        "u_zmax":  {"variable": "u",  "kind": "dirichlet", "side": "zmax", "value": 0},
        "dz_zmin": {"variable": "dz", "kind": "neumann",   "side": "zmin", "value": 0},
        "dz_zmax": {"variable": "dz", "kind": "neumann",   "side": "zmax", "value": 0}
      }
    }
  }
}
