{
  "esm": "0.4.0",
  "metadata": {"name": "nonlinear_diffusion_pde"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "acc": {"type": "state", "shape": ["x"], "location": "cell_center", "default": 0.0},
        "u":   {"type": "state", "shape": ["x"], "location": "cell_center", "default": 0.0},
        "f":   {"type": "state", "shape": ["x"], "location": "cell_center", "default": 0.0},
        "dx":  {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["acc"], "wrt": "t"},
          "rhs": {"op": "grad", "args": [
            {"op": "*", "args": ["f", {"op": "grad", "args": ["u"], "dim": "x"}]}
          ], "dim": "x"}
        },
        {"lhs": {"op": "D", "args": ["u"], "wrt": "t"}, "rhs": 0.0},
        {"lhs": {"op": "D", "args": ["f"], "wrt": "t"}, "rhs": 0.0}
      ],
      "initial_conditions": {
        "type": "expression",
        "values": {
          "acc": 0.0,
          "u": {"op": "sin", "args": [{"op": "*", "args": [6.283185307179586, "x"]}]},
          "f": {"op": "+", "args": [2.0, {"op": "sin", "args": [{"op": "*", "args": [6.283185307179586, "x"]}]}]}
        }
      }
    }
  }
}
