{
  "discretizations": {
    "mixed_deriv_2nd_nonuniform": {
      "applies_to": {
        "op": "grad",
        "args": [{ "op": "grad", "args": ["$u"], "dim": "$y" }],
        "dim": "$x"
      },
      "grid_family": "cartesian",
      "accuracy": "O(dx_i*dy_j)",
      "replacement": {
        "op": "arrayop",
        "output_idx": ["$x", "$y"],
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "-",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "$u",
                        { "op": "+", "args": ["$x", 1] },
                        { "op": "+", "args": ["$y", 1] }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "$u",
                        { "op": "+", "args": ["$x", 1] },
                        { "op": "-", "args": ["$y", 1] }
                      ]
                    }
                  ]
                },
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "$u",
                        { "op": "-", "args": ["$x", 1] },
                        { "op": "+", "args": ["$y", 1] }
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "$u",
                        { "op": "-", "args": ["$x", 1] },
                        { "op": "-", "args": ["$y", 1] }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "*",
              "args": [
                {
                  "op": "+",
                  "args": [
                    { "op": "index", "args": ["dx", "$x"] },
                    { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] }
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    { "op": "index", "args": ["dy", "$y"] },
                    { "op": "index", "args": ["dy", { "op": "+", "args": ["$y", 1] }] }
                  ]
                }
              ]
            }
          ]
        },
        "args": ["$u"]
      }
    }
  }
}
