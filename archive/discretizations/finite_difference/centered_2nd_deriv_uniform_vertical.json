{
  "discretizations": {
    "centered_2nd_deriv_uniform_vertical": {
      "applies_to": {
        "op": "d2",
        "args": ["$u"],
        "dim": "$k"
      },
      "grid_family": "vertical",
      "accuracy": "O(dz^2)",
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              {"op": "/", "args": [1, {"op": "*", "args": ["dz", "dz"]}]},
              {"op": "index", "args": ["$u", {"op": "+", "args": ["i", 1]}]}
            ]
          },
          {
            "op": "*",
            "args": [
              {"op": "/", "args": [-2, {"op": "*", "args": ["dz", "dz"]}]},
              {"op": "index", "args": ["$u", "i"]}
            ]
          },
          {
            "op": "*",
            "args": [
              {"op": "/", "args": [1, {"op": "*", "args": ["dz", "dz"]}]},
              {"op": "index", "args": ["$u", {"op": "+", "args": ["i", -1]}]}
            ]
          }
        ]
      }
    }
  }
}
