{
  "case": "diffusion_2d_analytic",
  "pipeline_kind": "diffusion_2d_analytic",
  "description": "2D heat equation du/dt = laplacian(u) on [0,1]x[0,1] periodic, N=32x32. IC = sin(2*pi*x)*sin(2*pi*y). Verification uses the discrete 5-point Laplacian eigenvalue as the exact analytic reference for the ODE system (zero spatial truncation error). Passes when ODE-solver error < 1e-6.",
  "esm": "diffusion_2d_pde.esm",
  "gdd": "../../../../gdd/cartesian_2d_periodic_n32.gdd.json",
  "n_cells": 32,
  "t_final": 0.005,
  "tolerance": {
    "metric": "Linf",
    "max": 1e-6,
    "comment": "ODE solver tolerance 1e-12; spatial truncation is zero because the discrete 5-point eigenvalue is used as the analytic reference."
  }
}
