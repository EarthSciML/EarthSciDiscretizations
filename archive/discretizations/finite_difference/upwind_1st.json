{
  "discretizations": {
    "upwind_1st": {
      "applies_to": {
        "op": "grad",
        "args": ["$u"],
        "dim": "$x"
      },
      "grid_family": "cartesian",
      "accuracy": "O(dx)",
      "replacement": {
        "op": "arrayop",
        "output_idx": ["$x"],
        "expr": {
          "op": "+",
          "args": [
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [-1, "dx"] },
                {
                  "op": "index",
                  "args": ["$u", { "op": "+", "args": ["$x", -1] }]
                }
              ]
            },
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [1, "dx"] },
                { "op": "index", "args": ["$u", "$x"] }
              ]
            }
          ]
        },
        "args": ["$u"]
      }
    }
  }
}
