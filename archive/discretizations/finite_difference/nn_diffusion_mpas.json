{
  "discretizations": {
    "nn_diffusion_mpas": {
      "applies_to": { "op": "laplacian", "args": ["$u"], "dim": "cell" },
      "grid_family": "unstructured",
      "requires_locations": ["cell_center"],
      "emits_location": "cell_center",
      "combine": "+",
      "accuracy": "O(h^2) on a quasi-uniform Voronoi mesh",
      "replacement": {
        "op": "arrayop",
        "reduce": "+",
        "ranges": {
          "k": [
            1,
            { "op": "index", "args": ["n_edges_on_cell", "i"] }
          ]
        },
        "expr": {
          "op": "*",
          "args": [
            {
              "op": "/",
              "args": [
                { "op": "index", "args": [
                    "dv_edge",
                    { "op": "index", "args": ["edges_on_cell", "i", "k"] }
                ]},
                { "op": "*", "args": [
                    { "op": "index", "args": [
                        "dc_edge",
                        { "op": "index", "args": ["edges_on_cell", "i", "k"] }
                    ]},
                    { "op": "index", "args": ["area_cell", "i"] }
                ]}
              ]
            },
            { "op": "-", "args": [
                { "op": "index", "args": [
                    "$u",
                    { "op": "index", "args": ["cells_on_cell", "i", "k"] }
                ]},
                { "op": "index", "args": ["$u", "i"] }
            ]}
          ]
        },
        "args": ["dv_edge", "dc_edge", "area_cell", "edges_on_cell", "cells_on_cell", "n_edges_on_cell"]
      }
    }
  }
}
