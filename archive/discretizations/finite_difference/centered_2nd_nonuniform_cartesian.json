{
  "discretizations": {
    "centered_2nd_nonuniform_cartesian": {
      "applies_to": {
        "op": "d2",
        "args": ["$u"],
        "dim": "$x"
      },
      "grid_family": "cartesian",
      "accuracy": "O(dx^2)",
      "replacement": {
        "op": "arrayop",
        "output_idx": ["$x"],
        "expr": {
          "op": "+",
          "args": [
            {
              "op": "*",
              "args": [
                {
                  "op": "/",
                  "args": [
                    2,
                    {
                      "op": "*",
                      "args": [
                        { "op": "index", "args": ["dx", "$x"] },
                        {
                          "op": "+",
                          "args": [
                            { "op": "index", "args": ["dx", "$x"] },
                            { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": ["$u", { "op": "+", "args": ["$x", -1] }]
                }
              ]
            },
            {
              "op": "*",
              "args": [
                {
                  "op": "/",
                  "args": [
                    -2,
                    {
                      "op": "*",
                      "args": [
                        { "op": "index", "args": ["dx", "$x"] },
                        { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] }
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": ["$u", "$x"]
                }
              ]
            },
            {
              "op": "*",
              "args": [
                {
                  "op": "/",
                  "args": [
                    2,
                    {
                      "op": "*",
                      "args": [
                        { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] },
                        {
                          "op": "+",
                          "args": [
                            { "op": "index", "args": ["dx", "$x"] },
                            { "op": "index", "args": ["dx", { "op": "+", "args": ["$x", 1] }] }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "index",
                  "args": ["$u", { "op": "+", "args": ["$x", 1] }]
                }
              ]
            }
          ]
        },
        "args": ["$u", "dx"]
      }
    }
  }
}
