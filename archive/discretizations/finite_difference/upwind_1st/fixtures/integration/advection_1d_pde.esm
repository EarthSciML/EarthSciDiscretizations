{
  "esm": "0.4.0",
  "metadata": {"name": "advection_1d_pde"},
  "models": {
    "M": {
      "grid": "domain",
      "variables": {
        "u": {"type": "state", "shape": ["x"], "location": "cell_center", "default": 0.0},
        "v": {"type": "parameter", "default": 1.0},
        "dx": {"type": "parameter"}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["u"], "wrt": "t"},
          "rhs": {"op": "*", "args": [
            {"op": "-", "args": [0, "v"]},
            {"op": "grad", "args": ["u"], "dim": "x"}
          ]}
        }
      ],
      "initial_conditions": {
        "type": "expression",
        "values": {
          "u": {"op": "cos", "args": [{"op": "*", "args": [6.283185307179586, "x"]}]}
        }
      }
    }
  }
}
