{
  "discretizations": {
    "godunov_norm_1st_uniform_cartesian_2d": {
      "applies_to": {
        "op": "sqrt",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "op": "^",
                "args": [
                  {
                    "op": "grad",
                    "args": [
                      "$u"
                    ],
                    "dim": "$x"
                  },
                  2.0
                ]
              },
              {
                "op": "^",
                "args": [
                  {
                    "op": "grad",
                    "args": [
                      "$u"
                    ],
                    "dim": "$y"
                  },
                  2.0
                ]
              }
            ]
          }
        ]
      },
      "grid_family": "cartesian",
      "accuracy": "O(dx)",
      "doc": "Godunov upwind discretization of the gradient magnitude |grad u| for a non-negative-speed Hamilton-Jacobi term (psi_t = -S|grad psi|, S>=0; Osher & Sethian 1988, Rouy & Tourin 1992) on a 2-D uniform Cartesian grid. Matches the level-set norm sqrt(grad(u,x)^2 + grad(u,y)^2) once observed sub-expressions are inlined, and rewrites it to sqrt( sum_d max(D-_d,0)^2 + min(D+_d,0)^2 ) with backward D-_d=(u[d]-u[d-1])/dx and forward D+_d=(u[d+1]-u[d])/dx. The max/min entropy fix selects the upwind one-sided difference per axis; centered differences are unstable for this hyperbolic term. First order in space; assumes uniform spacing dx=dy. The grad index reads u[d+-1] are handled by the consumer's boundary ghost lowering.",
      "replacement": {
        "op": "sqrt",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "op": "+",
                "args": [
                  {
                    "op": "^",
                    "args": [
                      {
                        "op": "max",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              {
                                "op": "-",
                                "args": [
                                  {
                                    "op": "index",
                                    "args": [
                                      "$u",
                                      "$x",
                                      "$y"
                                    ]
                                  },
                                  {
                                    "op": "index",
                                    "args": [
                                      "$u",
                                      {
                                        "op": "+",
                                        "args": [
                                          "$x",
                                          -1
                                        ]
                                      },
                                      "$y"
                                    ]
                                  }
                                ]
                              },
                              "dx"
                            ]
                          },
                          0
                        ]
                      },
                      2
                    ]
                  },
                  {
                    "op": "^",
                    "args": [
                      {
                        "op": "min",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              {
                                "op": "-",
                                "args": [
                                  {
                                    "op": "index",
                                    "args": [
                                      "$u",
                                      {
                                        "op": "+",
                                        "args": [
                                          "$x",
                                          1
                                        ]
                                      },
                                      "$y"
                                    ]
                                  },
                                  {
                                    "op": "index",
                                    "args": [
                                      "$u",
                                      "$x",
                                      "$y"
                                    ]
                                  }
                                ]
                              },
                              "dx"
                            ]
                          },
                          0
                        ]
                      },
                      2
                    ]
                  }
                ]
              },
              {
                "op": "+",
                "args": [
                  {
                    "op": "^",
                    "args": [
                      {
                        "op": "max",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              {
                                "op": "-",
                                "args": [
                                  {
                                    "op": "index",
                                    "args": [
                                      "$u",
                                      "$x",
                                      "$y"
                                    ]
                                  },
                                  {
                                    "op": "index",
                                    "args": [
                                      "$u",
                                      "$x",
                                      {
                                        "op": "+",
                                        "args": [
                                          "$y",
                                          -1
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              },
                              "dx"
                            ]
                          },
                          0
                        ]
                      },
                      2
                    ]
                  },
                  {
                    "op": "^",
                    "args": [
                      {
                        "op": "min",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              {
                                "op": "-",
                                "args": [
                                  {
                                    "op": "index",
                                    "args": [
                                      "$u",
                                      "$x",
                                      {
                                        "op": "+",
                                        "args": [
                                          "$y",
                                          1
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "op": "index",
                                    "args": [
                                      "$u",
                                      "$x",
                                      "$y"
                                    ]
                                  }
                                ]
                              },
                              "dx"
                            ]
                          },
                          0
                        ]
                      },
                      2
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
