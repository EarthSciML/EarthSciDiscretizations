{
  "esm": "0.4.0",
  "metadata": { "name": "staggered_1st_uniform_canonical" },
  "grids": {
    "gx": {
      "family": "cartesian",
      "dimensions": [
        { "name": "i", "size": 8, "periodic": true, "spacing": "uniform" }
      ]
    }
  },
  "rules": [
    {
      "name": "staggered_1st_uniform_cc_to_face",
      "pattern": { "op": "grad", "args": ["$u"], "dim": "$x" },
      "replacement": {
        "op": "arrayop",
        "output_idx": ["$x"],
        "expr": {
          "op": "+",
          "args": [
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [-1, "h"] },
                { "op": "index", "args": ["$u", { "op": "+", "args": ["$x", -1] }] }
              ]
            },
            {
              "op": "*",
              "args": [
                { "op": "/", "args": [1, "h"] },
                { "op": "index", "args": ["$u", "$x"] }
              ]
            }
          ]
        }
      }
    }
  ],
  "models": {
    "M": {
      "grid": "gx",
      "variables": {
        "h": { "type": "parameter", "default": 1.0, "units": "1" },
        "p": { "type": "state", "default": 0.0, "units": "1", "shape": ["i"], "location": "cell_center" },
        "v": { "type": "state", "default": 0.0, "units": "1", "shape": ["i"], "location": "face_x" }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["v"], "wrt": "t" },
          "rhs": { "op": "grad", "args": ["p"], "dim": "i" }
        }
      ]
    }
  }
}
