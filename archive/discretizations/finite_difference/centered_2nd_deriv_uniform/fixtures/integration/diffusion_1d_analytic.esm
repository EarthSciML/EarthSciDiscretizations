{
  "case": "diffusion_1d_analytic",
  "pipeline_kind": "diffusion_1d_analytic",
  "description": "1D heat equation du/dt = d2u/dx2 on [0,1] periodic, N=32. IC = sin(2*pi*x). Verification uses the discrete eigenvalue of the centered-FD stencil as the exact analytic reference for the ODE system, isolating ODE-solver accuracy from spatial discretization error. Passes when the ODE solver error is < 1e-6.",
  "esm": "diffusion_1d_pde.esm",
  "gdd": "../../../../gdd/cartesian_1d_periodic_n32.gdd.json",
  "n_cells": 32,
  "t_final": 0.01,
  "tolerance": {
    "metric": "Linf",
    "max": 1e-6,
    "comment": "ODE-solver tolerance is 1e-12; spatial truncation is zero because the discrete eigenvalue is used as the analytic reference."
  }
}
