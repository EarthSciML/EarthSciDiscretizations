{
  "discretizations": {
    "spherical_laplacian_uniform": {
      "applies_to": {
        "op": "spherical_laplacian",
        "args": ["$u"],
        "dim": "$r"
      },
      "grid_family": "cartesian",
      "accuracy": "O(dr^2)",
      "replacement": {
        "op": "arrayop",
        "output_idx": ["$r"],
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "-",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "^",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            0.5,
                            {
                              "op": "+",
                              "args": [
                                { "op": "index", "args": ["r", "$r"] },
                                { "op": "index", "args": ["r", { "op": "+", "args": ["$r", 1] }] }
                              ]
                            }
                          ]
                        },
                        2
                      ]
                    },
                    {
                      "op": "-",
                      "args": [
                        { "op": "index", "args": ["$u", { "op": "+", "args": ["$r", 1] }] },
                        { "op": "index", "args": ["$u", "$r"] }
                      ]
                    }
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "^",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            0.5,
                            {
                              "op": "+",
                              "args": [
                                { "op": "index", "args": ["r", { "op": "-", "args": ["$r", 1] }] },
                                { "op": "index", "args": ["r", "$r"] }
                              ]
                            }
                          ]
                        },
                        2
                      ]
                    },
                    {
                      "op": "-",
                      "args": [
                        { "op": "index", "args": ["$u", "$r"] },
                        { "op": "index", "args": ["$u", { "op": "-", "args": ["$r", 1] }] }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "*",
              "args": [
                {
                  "op": "^",
                  "args": [
                    { "op": "index", "args": ["r", "$r"] },
                    2
                  ]
                },
                { "op": "*", "args": ["dr", "dr"] }
              ]
            }
          ]
        },
        "args": ["$u"]
      }
    }
  }
}
