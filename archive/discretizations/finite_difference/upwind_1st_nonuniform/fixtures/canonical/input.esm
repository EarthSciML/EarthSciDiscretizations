{
  "esm": "0.4.0",
  "metadata": {
    "name": "upwind_1st_nonuniform_canonical"
  },
  "grids": {
    "g": {
      "family": "cartesian",
      "dimensions": [
        {
          "name": "x",
          "size": 4,
          "periodic": true,
          "spacing": "uniform"
        }
      ]
    }
  },
  "models": {
    "M": {
      "grid": "g",
      "variables": {
        "u": {
          "type": "state",
          "default": 0.0,
          "units": "1",
          "shape": ["x"],
          "location": "cell_center"
        },
        "dx": {
          "type": "parameter",
          "default": 0.25,
          "units": "1",
          "shape": ["x"]
        }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": { "op": "grad", "args": ["u"], "dim": "x" }
        }
      ]
    }
  },
  "rules": [
    {
      "name": "upwind_1st_nonuniform",
      "pattern": { "op": "grad", "args": ["$u"], "dim": "$x" },
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  -1,
                  { "op": "index", "args": ["dx", "$x"] }
                ]
              },
              {
                "op": "index",
                "args": ["$u", { "op": "+", "args": ["$x", -1] }]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  1,
                  { "op": "index", "args": ["dx", "$x"] }
                ]
              },
              {
                "op": "index",
                "args": ["$u", "$x"]
              }
            ]
          }
        ]
      }
    }
  ]
}
