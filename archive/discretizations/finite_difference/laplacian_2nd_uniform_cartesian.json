{
  "discretizations": {
    "laplacian_2nd_uniform_cartesian": {
      "applies_to": {
        "op": "laplacian",
        "args": ["$u"]
      },
      "grid_family": "cartesian",
      "combine": "+",
      "accuracy": "O(dx^2)",
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [1, { "op": "*", "args": ["dx", "dx"] }] },
              { "op": "index", "args": ["$u", { "op": "+", "args": ["i", -1] }, "j"] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [-2, { "op": "*", "args": ["dx", "dx"] }] },
              { "op": "index", "args": ["$u", "i", "j"] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [1, { "op": "*", "args": ["dx", "dx"] }] },
              { "op": "index", "args": ["$u", { "op": "+", "args": ["i", 1] }, "j"] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [1, { "op": "*", "args": ["dy", "dy"] }] },
              { "op": "index", "args": ["$u", "i", { "op": "+", "args": ["j", -1] }] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [-2, { "op": "*", "args": ["dy", "dy"] }] },
              { "op": "index", "args": ["$u", "i", "j"] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [1, { "op": "*", "args": ["dy", "dy"] }] },
              { "op": "index", "args": ["$u", "i", { "op": "+", "args": ["j", 1] }] }
            ]
          }
        ]
      }
    }
  }
}
