{
  "case": "grad_1d_convergence",
  "pipeline_kind": "mms_convergence",
  "description": "1D advection du/dt = -v * grad(u) on [0,1] periodic, v=1, discretized with the 2nd-order centered gradient (centered_2nd_uniform). IC = cos(2*pi*x); exact = cos(2*pi*(x - v*t)). Field-level pipeline (build_ode_problem) sweeps N=16 and N=32 and verifies 2nd-order spatial convergence. The GDDs bind ONLY centered_2nd_uniform to avoid a rule conflict with upwind_1st on 'grad'. t_final=0.1 keeps the solution well inside the smooth, asymptotic O(h^2) regime.",
  "esm": "grad_1d_pde.esm",
  "grid_refs": [
    "grad_n16.gdd.json",
    "grad_n32.gdd.json"
  ],
  "mms_kind": "cos_2pi_x_transport",
  "velocity": 1.0,
  "t_final": 0.1,
  "convergence": {
    "expected_order": 2.0,
    "min_order": 1.9,
    "comment": "Centered 2nd-order gradient is O(h^2); the non-dissipative scheme stays in the asymptotic regime at t=0.1 for N=16->32 (observed order 1.99)."
  }
}
