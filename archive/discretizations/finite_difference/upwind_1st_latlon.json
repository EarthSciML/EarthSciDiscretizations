{
  "discretizations": {
    "upwind_1st_latlon": {
      "applies_to": {
        "op": "grad",
        "args": [
          "$u"
        ],
        "dim": "$k"
      },
      "grid_family": "latlon",
      "combine": "+",
      "accuracy": "O(h)",
      "reference": "First-order upwind (backward-difference) gradient on a regular lat-lon sphere; one-sided 2-point stencil on each angular axis with the spherical metric. Latlon analogue of upwind_1st (esd-6g4.13).",
      "notes": "Backward difference (offsets {-1,0}) on each angular axis, metric-scaled by 1/(R cos_lat dlon) for lon and 1/(R dlat) for lat. Assumes positive advection; the sign convention matches upwind_1st.",
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  -1,
                  {
                    "op": "*",
                    "args": [
                      "R",
                      "cos_lat",
                      "dlon"
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "$u",
                  "lat",
                  {
                    "op": "+",
                    "args": [
                      "lon",
                      -1
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  1,
                  {
                    "op": "*",
                    "args": [
                      "R",
                      "cos_lat",
                      "dlon"
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "$u",
                  "lat",
                  "lon"
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  -1,
                  {
                    "op": "*",
                    "args": [
                      "R",
                      "dlat"
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "$u",
                  {
                    "op": "+",
                    "args": [
                      "lat",
                      -1
                    ]
                  },
                  "lon"
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "/",
                "args": [
                  1,
                  {
                    "op": "*",
                    "args": [
                      "R",
                      "dlat"
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "$u",
                  "lat",
                  "lon"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
