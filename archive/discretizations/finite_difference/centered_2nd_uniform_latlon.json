{
  "discretizations": {
    "centered_2nd_uniform_latlon": {
      "applies_to": {
        "op": "grad",
        "args": ["$u"],
        "dim": "$k"
      },
      "grid_family": "latlon",
      "combine": "+",
      "accuracy": "O(h^2)",
      "replacement": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [-1, { "op": "*", "args": [2, "R", "cos_lat", "dlon"] }] },
              { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", -1] }] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [1, { "op": "*", "args": [2, "R", "cos_lat", "dlon"] }] },
              { "op": "index", "args": ["$u", "lat", { "op": "+", "args": ["lon", 1] }] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [-1, { "op": "*", "args": [2, "R", "dlat"] }] },
              { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", -1] }, "lon"] }
            ]
          },
          {
            "op": "*",
            "args": [
              { "op": "/", "args": [1, { "op": "*", "args": [2, "R", "dlat"] }] },
              { "op": "index", "args": ["$u", { "op": "+", "args": ["lat", 1] }, "lon"] }
            ]
          }
        ]
      }
    }
  }
}
