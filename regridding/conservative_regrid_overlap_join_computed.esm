{
  "esm": "0.6.0",
  "metadata": {
    "name": "conservative_regrid_overlap_join_computed",
    "description": "COMPUTED-A_ij conservative regridder (sibling of conservative_regrid_overlap_join.esm). The overlap matrix A_ij is COMPUTED declaratively from the full source/target polygon rings (src_poly[src_cells,cell_verts,coord], tgt_poly[tgt_cells,cell_verts,coord]) via the ranged spherical intersect_polygon clip + the Van Oosterom-Strackee spherical-excess polygon_area FAQ \u2014 NOT supplied as a host const_array. The target denominator A_j_w is the build-once row-sum \u03a3_i A_ij (no host dst_areas). The broad-phase bin-skolem floor->skolem->distinct->equijoin candidate set and the sub-atol sliver filter are unchanged from the fixture. This is the self-contained regridder the camp_fire.esm coupling needs: given only the cell geometries it produces the conservative F_tgt with no host-supplied overlaps. Generated by gen_computed_overlap_join.py from the conformance fixture; reproduces its A_j/F_tgt on the same spherical case.",
    "authors": [
      "EarthSciSerialization/polecats/gastown.slit"
    ],
    "tags": [
      "bin-skolem",
      "computed-aij",
      "conformance",
      "conservation",
      "conservative-regridding",
      "end-to-end",
      "ess-my4.4.5",
      "floor",
      "geometry",
      "intersect_polygon",
      "join",
      "overlap-join",
      "partition-of-unity",
      "polygon-area",
      "schema",
      "self-contained",
      "skolem",
      "spatial-join",
      "value-invention"
    ]
  },
  "models": {
    "ConservativeRegridOverlapJoinComputed": {
      "index_sets": {
        "coord": {
          "kind": "interval",
          "size": 2
        },
        "cell_verts": {
          "kind": "interval",
          "size": 4
        },
        "src_cells": {
          "kind": "interval",
          "size": 3
        },
        "tgt_cells": {
          "kind": "interval",
          "size": 3
        },
        "candidate_pairs": {
          "kind": "derived",
          "from_faq": "candidate_set"
        },
        "clip_ring": {
          "kind": "derived",
          "from_faq": "overlap_clip"
        }
      },
      "variables": {
        "src_lon": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell representative longitude (e.g. the bbox-min corner). A float coordinate that enters ONLY the integer binning via `floor`, never a raw join comparison (\u00a75.8.5)."
        },
        "src_lat": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ],
          "description": "Source-cell representative latitude \u2014 the other binning coordinate."
        },
        "tgt_lon": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ],
          "description": "Target-cell representative longitude."
        },
        "tgt_lat": {
          "type": "parameter",
          "shape": [
            "tgt_cells"
          ],
          "description": "Target-cell representative latitude."
        },
        "dx": {
          "type": "parameter",
          "shape": [],
          "description": "Bin width in degrees \u2014 the exactly-defined integer quantization step of the broad phase (\u00a75.8.5). Shared by source and target so a common bin key means the bboxes fall in the same bucket."
        },
        "dy": {
          "type": "parameter",
          "shape": [],
          "description": "Bin height in degrees."
        },
        "atol": {
          "type": "parameter",
          "shape": [],
          "description": "Sliver floor (\u00a75.8.2): an overlap area at or below `atol` (\u2248 1e-15\u00b7R\u00b2) is treated as equal-to-zero \u2014 'present-but-tiny' and 'absent' both collapse to no contribution. It is the threshold of the zero-area `filter` that turns the byte-identical CANDIDATE set into the tolerance-dependent SURVIVING-overlap set (\u00a75.8.5)."
        },
        "F_src": {
          "type": "parameter",
          "shape": [
            "src_cells"
          ],
          "description": "The source field being remapped. A `parameter` here (static field, build-once apply); in the time-varying case it is `state`/`discrete` and the apply FAQ (eq. 5) becomes CONTINUOUS-cadence per \u00a76.1 \u2014 the build-once weights / apply-many split is exactly the static/dynamic partition."
        },
        "src_poly": {
          "type": "parameter",
          "shape": [
            "src_cells",
            "cell_verts",
            "coord"
          ]
        },
        "tgt_poly": {
          "type": "parameter",
          "shape": [
            "tgt_cells",
            "cell_verts",
            "coord"
          ]
        },
        "src_bin": {
          "type": "state",
          "shape": [
            "src_cells"
          ],
          "description": "Integer bin key of each source cell: skolem(\"bin\", floor(lon/dx), floor(lat/dy)). `floor` does the integer quantization (no bespoke binning op); `skolem` mints the content-addressed key. The equi-join column the candidate set joins on."
        },
        "tgt_bin": {
          "type": "state",
          "shape": [
            "tgt_cells"
          ],
          "description": "Integer bin key of each target cell \u2014 identically quantized, so a shared key means source and target bboxes fall in the same broad-phase bucket."
        },
        "pair_exists": {
          "type": "state",
          "shape": [
            "candidate_pairs"
          ],
          "description": "Membership over the candidate overlap-pair set produced by the bin-Skolem equi-join (the broad phase) \u2014 the byte-identical integer candidate set of \u00a75.8.5, materialized as the derived `candidate_pairs` index set via from_faq:\"candidate_set\"."
        },
        "clip": {
          "type": "observed",
          "shape": [
            "src_cells",
            "tgt_cells",
            "clip_ring",
            "coord"
          ],
          "expression": {
            "op": "arrayop",
            "output_idx": [
              "i",
              "j",
              "w",
              "c"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              },
              "w": {
                "from": "clip_ring"
              },
              "c": {
                "from": "coord"
              }
            },
            "args": [],
            "expr": {
              "op": "index",
              "args": [
                {
                  "op": "intersect_polygon",
                  "id": "overlap_clip",
                  "manifold": "spherical",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_poly",
                        "i"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "tgt_poly",
                        "j"
                      ]
                    }
                  ]
                },
                "w",
                "c"
              ]
            }
          }
        },
        "A_ij": {
          "type": "observed",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "expression": {
            "op": "arrayop",
            "output_idx": [
              "i",
              "j"
            ],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [],
            "expr": {
              "op": "aggregate",
              "semiring": "sum_product",
              "output_idx": [],
              "ranges": {
                "v": {
                  "from": "clip_ring"
                }
              },
              "args": [
                "clip"
              ],
              "expr": {
                "op": "*",
                "args": [
                  2.0,
                  {
                    "op": "atan2",
                    "args": [
                      {
                        "op": "+",
