      },
      "tests": [
        {
          "id": "freestream_q_stays_one_3d",
          "description": "The mixing ratio q = mq/m stays EXACTLY 1 under a strongly divergent, sign-reversing 3-D air-mass flux, because at q == 1 each compound flux-form divergence collapses bitwise onto its bare-D continuity twin (the donor flux F = 0.5*(M*(1+1) - |M|*(1-1)) = M is IEEE-exact), so dmq/dt equals dm/dt to the last bit and mq tracks m forever. Asserted at t=0 and at the end of the span, so it gates the operators AND their behaviour under time integration. This is the joint gate on all six rules: the rule-enforced zonal wrap, the structural polar-face omission, the cos(phi)/area weights and the vertical wall closure. The tolerance is 1e-12 but the measured error is 0.0 EXACTLY; a single operator disagreeing about one face or one weight moves this to O(10), the rate at which the mixing-ratio form (the negative control) destroys a constant tracer.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "dev",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": 0.0
              }
            },
            {
              "variable": "dev",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": 0.0
              }
            }
          ]
        }
      ],
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "m"
            ]
          },
          "rhs": {
