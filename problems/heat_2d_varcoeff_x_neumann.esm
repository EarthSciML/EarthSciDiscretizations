      "tests": [
        {
          "id": "mms_varcoeff_2d_x_neumann_decay",
          "description": "Manufactured solution (constant in the passive y axis) for the 2-D variable-coefficient heat equation u_t = div(k(x) grad u) + S(x,t) reduced to x-diffusion, with k(x) = 1 + 0.5 cos(2 pi x) and inhomogeneous NEUMANN (fixed-flux) x-walls. This is the exact per-axis 2-D lift of problems/heat_1d_varcoeff_neumann: u and k depend only on x and are replicated across the passive y axis (closed to NY=8 at the import edge), so the relative-L2/Linf errors are identical to that 1-D case and fall at the conservative-FV order 2. Boundary compatibility: the decaying cos(pi x) mode has zero wall gradient and the steady ramp x carries the constant wall gradient 1, so the physical wall flux k u_x = 1.5 is constant in time (prescribed as qWALL = 1.5). The closed-form MMS forcing S makes u exact for the continuous PDE (derivation mirrors heat_1d_varcoeff_neumann). References evaluate at cell centers (i-1/2)/NX, spelled inline per esm-spec 6.6.5 (build-time evaluation folds literals and the metaparameter NX only); the wall free names qXL/qXR live only in the runtime rule body. The t=0 assertion pins the ic wiring; the t=0.1 assertion bounds the relative L2 error. Exact per-resolution errors are pinned in tests/conformance/convergence/heat_2d_varcoeff_x_neumann/golden/errors.json.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": {
                  "op": "+",
                  "args": [
                    {
                      "op": "cos",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            3.141592653589793,
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "-",
                                  "args": [
                                    "i",
                                    0.5
                                  ]
                                },
                                {
                                  "op": "/",
                                  "args": [
                                    1,
                                    "NX"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "op": "*",
                      "args": [
                        1.0,
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "-",
                              "args": [
                                "i",
                                0.5
                              ]
                            },
                            {
                              "op": "/",
                              "args": [
                                1,
                                "NX"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "variable": "u",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.002
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": {
