{
  "esm": "1.0.0",
  "metadata": {
    "name": "heat_2d_varcoeff_x_neumann",
    "description": "MMS driver: 2-D VARIABLE-COEFFICIENT heat equation u_t = div(k(x) grad u) + S(x,t) on the unit box [0,1]x[0,1] reduced to x-diffusion, with inhomogeneous NEUMANN (fixed-flux) conditions on the two x-walls, discretized by the conservative finite-volume rule grids/cartesian_uniform_2d/rules/varcoeff_laplacian_x_neumann_bc over the full 2-D field u[x,y]. The consumer writes the operator as the conservative compound D(k*D(u,x),x) (coefficient on the LEFT), which that rule matches at priority 10 and lowers to the arithmetic-mean flux-difference stencil plus the two x-edge faces. This is the exact 2-D per-axis lift of problems/heat_1d_varcoeff_neumann: the manufactured solution and the coefficient k(x) = 1 + 0.5 cos(2 pi x) depend only on x and are constant in the passive y axis, so the x-operator reproduces the 1-D behaviour on every y-row and the discretization error equals the 1-D case (relative L2 and absolute Linf are invariant under the passive-axis replication). The passive y axis is PASSIVE: u is constant in y, no y-operator appears, and NY is closed to 8 at the import edge; NX stays open (grid default 64, rebound by the convergence sweep via the loader API). k is a consumer-supplied [x,y]-shaped observed read by the rule at the x-faces; its aggregate loops over gi/gj (DISTINCT from the stencil's interior i/j) per the keyed-factor capture-avoidance contract (see the rule). Geometry contract (grids/cartesian_uniform_2d/grid.esm) fulfilled for the unit box: x0=y0=0, dx=1/NX, dy=1/NY. BUILD-TIME SCOPE CAVEAT (AGENTS.md): the wall free names qXL/qXR live only in the runtime rule body; the ic, coefficient, forcing, and test references spell the cell-center coordinate (i-1/2)/NX inline from literals and the metaparameter NX (the build-time cellwise evaluator is scope-free), never invoking the grid's x_coord free-name template. The SAME rule also serves the nonlinear case (a consumer declaring k=f(u)); this driver exercises the variable-coefficient dual.",
    "license": "MIT",
    "tags": [
      "esd:problem",
      "grid:cartesian_uniform_2d",
      "equation:heat",
      "mms"
    ],
    "references": [
      {
        "citation": "Roache, P. J. (2002). Code verification by the method of manufactured solutions. J. Fluids Eng. 124(1), 4-10.",
        "doi": "10.1115/1.1436090"
      },
      {
        "citation": "LeVeque, R. J. (2007). Finite Difference Methods for Ordinary and Partial Differential Equations. SIAM. Section 2.15 (variable-coefficient conservative form)."
      }
    ]
  },
  "metaparameters": {
    "NY": {
      "type": "integer",
      "default": 8,
      "description": "Number of cells along y, closed to 8 here: the y axis is passive in this problem. Declared as this document's own metaparameter and passed down to the imported rule as the edge binding value, because esm-spec 9.7.6 binding site 1 has bindings flow DOWN only, so a name closed at an import edge is consumed by the imported subtree and does not re-enter this document's scope. The bare NY in the dy equation therefore resolves to this declaration, and the value folds when this document closes."
    }
  },
  "models": {
    "Heat": {
      "expression_template_imports": [
        {
          "ref": "../grids/cartesian_uniform_2d/rules/varcoeff_laplacian_x_neumann_bc.esm",
          "bindings": {
            "NY": "NY"
          }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "x",
            "y"
          ],
          "description": "Temperature field over the 2-D [x, y] index sets (constant in the passive axis in this per-axis driver)."
        },
        "qXL": {
          "type": "parameter",
          "units": "K*m/s",
          "default": 1.5,
          "description": "Prescribed PHYSICAL FLUX k du/dx (in the +x direction) at the left x-wall (the rule's Neumann free name), equal to the manufactured wall flux k(wall)*u_x(wall) = 1.5*1 = 1.5; reduces to zero-flux at 0."
        },
        "qXR": {
          "type": "parameter",
          "units": "K*m/s",
          "default": 1.5,
          "description": "Prescribed PHYSICAL FLUX k du/dx (in the +x direction) at the right x-wall (the rule's Neumann free name), equal to the manufactured wall flux 1.5; reduces to zero-flux at 0."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left x domain edge a = 0 (unit box): the grid's x0 free name (grids/cartesian_uniform_2d/grid.esm)."
        },
        "y0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Bottom y domain edge (unit box): the grid's y0 free name."
        },
        "dx": {
          "type": "unknown",
          "units": "m",
          "description": "x-spacing 1/NX: the grid's dx free name, resolved in the rewrite rule's expanded body at evaluation. NX substituted as an integer literal at load (esm-spec 9.7.6) so the convergence sweep stays consistent."
        },
        "dy": {
          "type": "unknown",
          "units": "m",
          "description": "y-spacing 1/NY: the grid's dy free name; NY substituted at load so the convergence sweep stays consistent."
        },
        "k": {
          "type": "unknown",
          "units": "m^2/s",
          "shape": [
            "x",
            "y"
          ],
          "description": "Variable conductivity k(x) = 1 + 0.5 cos(2 pi x) over the 2-D [x, y] index sets (constant in the passive axis), evaluated at cell centers (gi - 1/2)/NX spelled inline from literals and the metaparameter name NX. Positive (range [0.5, 1.5]). Bound by the rule's match as the coefficient k (the left factor of k*D(u,x)) and read by the expanded stencil at the x-faces via kf = (k[.]+k[.])/2. The aggregate loops over gi/gj, DISTINCT from the stencil's interior indices i/j: an array coefficient authored as an aggregate observed is inlined into the stencil's interior aggregate at evaluation, and a shared loop-index name would be captured (see the rule description)."
        }
      },
