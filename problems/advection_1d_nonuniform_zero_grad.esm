                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    0.6,
                                    {
                                      "op": "/",
                                      "args": [
                                        "i",
                                        "N"
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "op": "*",
                                  "args": [
                                    0.4,
                                    {
                                      "op": "/",
                                      "args": [
                                        "i",
                                        "N"
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        "i",
                                        "N"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "c"
                    ]
                  },
                  {
                    "op": "D",
                    "args": [
                      "u"
                    ],
