                      "args": [
                        3.141592653589793,
                        {
                          "op": "*",
                          "args": [
                            0.5,
                            {
                              "op": "+",
                              "args": [
                                {
                                  "op": "+",
                                  "args": [
                                    {
                                      "op": "*",
                                      "args": [
