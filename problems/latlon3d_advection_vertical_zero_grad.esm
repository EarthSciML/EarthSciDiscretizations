                                      "args": [
                                        {
                                          "op": "-",
                                          "args": [
                                            "k",
                                            1
                                          ]
                                        },
                                        "NLEV"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "+",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    0.6,
                                    {
                                      "op": "/",
                                      "args": [
                                        "k",
                                        "NLEV"
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "op": "*",
                                  "args": [
                                    0.4,
                                    {
                                      "op": "/",
                                      "args": [
                                        "k",
                                        "NLEV"
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        "k",
                                        "NLEV"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  {
                    "op": "-",
                    "args": [
                      "w"
                    ]
                  },
                  {
                    "op": "D",
                    "args": [
                      "u"
                    ],
                    "wrt": "lev"
                  }
                ]
              },
              "src"
            ]
          }
        },
        {
          "lhs": "pe",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "kn"
            ],
            "args": [],
            "ranges": {
              "kn": {
                "from": "lev_nodes"
              }
            },
            "expr": {
