                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "S",
              {
                "op": "-",
                "args": [
                  "forcing",
                  {
                    "op": "sqrt",
                    "args": [
                      {
                        "op": "+",
                        "args": [
                          {
                            "op": "^",
                            "args": [
                              {
                                "op": "D",
                                "args": [
                                  "u"
                                ],
                                "wrt": "x"
                              },
                              2
                            ]
                          },
                          {
                            "op": "^",
                            "args": [
                              {
                                "op": "D",
                                "args": [
                                  "u"
                                ],
                                "wrt": "y"
                              },
                              2
