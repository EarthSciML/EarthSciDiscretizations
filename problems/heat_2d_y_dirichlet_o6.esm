{
  "esm": "1.0.0",
  "metadata": {
    "name": "heat_2d_y_dirichlet_o6",
    "description": "MMS driver: 2-D heat equation reduced to y-diffusion u_t = alpha u_yy on the unit box [0,1]x[0,1] with inhomogeneous DIRICHLET (fixed-value) conditions on the two y-walls, discretized by grids/cartesian_uniform_2d/rules/central_D2y_6_dirichlet_bc (sixth-order interior 7-point y-stencil with sixth-order one-sided y-face closures) over the full 2-D field u[x,y]. Manufactured solution u(x,y,t) = exp(-alpha pi^2 t) sin(pi y) + gB + (gT - gB) y with gB = 0.5, gT = 1.5: the decaying sine satisfies the heat equation and vanishes at both y-walls, while the steady linear-in-y profile gB + (gT - gB) y satisfies u_t = alpha u_yy = 0 and carries the constant y-wall values u(x,0) = gB, u(x,1) = gT. The exact solution is constant in x (the x axis is PASSIVE; no x-operator appears, NX closed to 8 at the import edge; NY stays open, rebound by the convergence sweep via the loader API). The linear-in-y profile is represented exactly by the discrete sixth-order operator (its interior 7-point stencil and all four boundary closures return identically zero on any linear field — every closure weight-sum is zero), so the discretization error comes solely from the sine mode; because both interior and boundary closures are O(dy^6), the error falls at (observed, honestly pinned) order ~6. This is the y-axis reflection of heat_2d_x_dirichlet_o6 (x<->y, NX<->NY), verifying that the D2y sixth-order Dirichlet rule matches its D2x sibling by symmetry. Geometry contract (grids/cartesian_uniform_2d/grid.esm) fulfilled for the unit box: x0=y0=0, dx=1/NX, dy=1/NY. BUILD-TIME SCOPE CAVEAT (AGENTS.md): gB/gT live only in the runtime rule body; the ic and test references spell the manufactured solution from literals and the metaparameter NY alone (the build-time cellwise evaluator is scope-free), with the wall value 0.5 and slope 1.0 matching the gB and (gT - gB) parameter values.",
    "license": "MIT",
    "tags": [
      "esd:problem",
      "grid:cartesian_uniform_2d",
      "equation:heat",
      "mms"
    ],
    "references": [
      {
        "citation": "Roache, P. J. (2002). Code verification by the method of manufactured solutions. J. Fluids Eng. 124(1), 4-10.",
        "doi": "10.1115/1.1436090"
      },
      {
        "citation": "Fornberg, B. (1988). Generation of finite difference formulas on arbitrarily spaced grids. Mathematics of Computation 51(184), 699-706.",
        "doi": "10.1090/S0025-5718-1988-0935077-0"
      }
    ]
  },
  "metaparameters": {
    "NX": {
      "type": "integer",
      "default": 8,
      "description": "Number of cells along x, closed to 8 here: the x axis is passive in this problem. Declared as this document's own metaparameter and passed down to the imported rule as the edge binding value, because esm-spec 9.7.6 binding site 1 has bindings flow DOWN only, so a name closed at an import edge is consumed by the imported subtree and does not re-enter this document's scope. The bare NX in the dx equation therefore resolves to this declaration, and the value folds when this document closes."
    }
  },
  "models": {
    "Heat2DyDirichletO6": {
      "expression_template_imports": [
        {
          "ref": "../grids/cartesian_uniform_2d/rules/central_D2y_6_dirichlet_bc.esm",
          "bindings": {
            "NX": "NX"
          }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "x",
            "y"
          ],
          "description": "Temperature field over the 2-D [x, y] index sets (constant in x in this problem)."
        },
        "alpha": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.01,
          "description": "Thermal diffusivity."
        },
        "gB": {
          "type": "parameter",
          "units": "K",
          "default": 0.5,
          "description": "Prescribed field value on the bottom y-wall y=y0 (the rule's Dirichlet free name), equal to the manufactured wall value u(x,0) = 0.5."
        },
        "gT": {
          "type": "parameter",
          "units": "K",
          "default": 1.5,
          "description": "Prescribed field value on the top y-wall y=y0+NY*dy (the rule's Dirichlet free name), equal to the manufactured wall value u(x,1) = 1.5."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left x domain edge (unit box): the grid's x0 free name (unused here; the solution is constant in x)."
        },
        "y0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Bottom y domain edge b = 0 (unit box): the grid's y0 free name (consumer-supplied geometry contract, grids/cartesian_uniform_2d/grid.esm)."
        },
        "dx": {
          "type": "unknown",
          "units": "m",
          "description": "x-spacing 1/NX: the grid's dx free name; NX closed to 8 at the import edge (unused here; the y-second-derivative rule references only dy)."
        },
        "dy": {
          "type": "unknown",
          "units": "m",
          "description": "y-spacing 1/NY: the grid's dy free name, resolved inside the rewrite rule's expanded body at evaluation. NY is the document-scoped metaparameter, substituted as an integer literal at load (esm-spec 9.7.6), so the convergence sweep keeps dy consistent."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "i",
              "j"
            ],
            "args": [],
            "ranges": {
              "i": {
                "from": "x"
              },
              "j": {
                "from": "y"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "sin",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        3.141592653589793,
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "-",
                              "args": [
                                "j",
                                0.5
                              ]
                            },
                            {
                              "op": "/",
                              "args": [
                                1,
                                "NY"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                0.5,
                {
                  "op": "*",
                  "args": [
                    1.0,
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "j",
                            0.5
                          ]
                        },
                        {
                          "op": "/",
                          "args": [
                            1,
                            "NY"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "alpha",
              {
                "op": "D",
                "args": [
                  {
                    "op": "D",
                    "args": [
                      "u"
                    ],
                    "wrt": "y"
                  }
                ],
                "wrt": "y"
              }
            ]
          }
        },
        {
          "lhs": "dx",
          "rhs": {
            "op": "/",
            "args": [
              1,
              "NX"
            ]
          }
        },
        {
          "lhs": "dy",
          "rhs": {
            "op": "/",
            "args": [
              1,
              "NY"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "mms_heat_y_dirichlet_o6_decay",
          "description": "Manufactured solution u(x,y,t) = exp(-alpha pi^2 t) sin(pi y) + gB + (gT - gB) y with alpha = 0.01, gB = 0.5, gT = 1.5. The sine mode gives u_t = -alpha pi^2 u_sin and u_yy = -pi^2 u_sin (so u_t = alpha u_yy) with zero y-wall values, constant in x; the linear-in-y profile is steady with wall values gB, gT prescribed to the rule. The linear profile is discretely exact for the sixth-order operator, so the error is the sine mode's, which falls at observed order ~6 (matching heat_2d_x_dirichlet_o6 by x<->y symmetry). References evaluate at cell centers y_j = (j - 1/2)/NY, spelled inline per esm-spec 6.6.5 (build-time evaluation folds literals and metaparameters only). The t=0 assertion pins the ic wiring; the t=0.1 assertion bounds the relative L2 error. Exact per-resolution errors pinned in tests/conformance/convergence/heat_2d_y_dirichlet_o6/golden/errors.json.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": {
                  "op": "+",
                  "args": [
                    {
                      "op": "sin",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            3.141592653589793,
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "-",
                                  "args": [
                                    "j",
                                    0.5
                                  ]
                                },
                                {
                                  "op": "/",
                                  "args": [
                                    1,
                                    "NY"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    0.5,
                    {
                      "op": "*",
                      "args": [
                        1.0,
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "-",
                              "args": [
                                "j",
                                0.5
                              ]
                            },
                            {
                              "op": "/",
                              "args": [
                                1,
                                "NY"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "variable": "u",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.0001
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": {
                  "op": "+",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "exp",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                -0.01,
                                9.869604401089358,
                                0.1
                              ]
                            }
                          ]
                        },
                        {
                          "op": "sin",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                3.141592653589793,
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "j",
                                        0.5
