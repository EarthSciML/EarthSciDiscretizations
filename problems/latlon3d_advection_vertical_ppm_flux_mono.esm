      "tests": [
        {
          "id": "steady_cos_profile",
          "description": "u*(z) = cos(pi z) is an exact steady state of the forced equation; the error at t = 0.1 is the accumulated truncation error of the upwind-biased monotone PPM flux-form vertical advection operator.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": {
                  "op": "/",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        {
                          "op": "sin",
                          "args": [
                            {
                              "op": "*",
                              "args": [
