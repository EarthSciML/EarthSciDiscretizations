{
  "esm": "1.0.0",
  "metadata": {
    "name": "gradient_mpas",
    "description": "Exactness driver for grids/mpas/rules/fv_gradient_edge on the icosahedral level-0 mesh (12 cells, 30 edges, 20 vertices; grids/mpas/mesh/level0.esm mounted as the `mesh` subsystem): u_t = -grad(phi) where phi is a SPATIALLY CONSTANT cell field (phi(i) = 3), so the discrete gradient annihilates it EXACTLY. grad_e = (phi(cellsOnEdge(e,2)) - phi(cellsOnEdge(e,1))) / dcEdge(e) and phi(c2) - phi(c1) = 3 - 3 = 0 to the bit for every edge regardless of the mesh geometry, so grad(phi) = 0 at all 30 edges and u(t) = u(0) to rounding. This is the gradient's null-space mimetic property (grad annihilates constants, the discrete grad(const) = 0), the dual to divergence_mpas's div(curl) = 0 gate. The constant field is the honest exact property here: it needs NO coordinate geometry, so the ic/reference evaluations stay build-time scope-free (edge/cell coordinates never enter). The problem also demonstrates the MPAS keyed-factor wiring contract: the mesh subsystem's const arrays are re-exposed as bare-name observed aliases (cellsOnEdge, dcEdge := mesh.*) — exactly and only the two factors the gradient rule body gathers, where its free geometry names resolve in the model scope (esm-spec 4.6 dot notation; grids/mpas/grid.esm). Import bindings close the grid metaparameters at the level-0 sizes; rebinding {NCELLS: 42, NEDGES: 120, NVERTICES: 80, MAXEDGES: 6} with mesh/level1.esm is the refinement step of a (deferred, out-of-scope-here) convergence sweep — a smooth non-constant phi with a known analytic edge-normal gradient would drive that order study; the constant-annihilation gate is the exactness deliverable, matching how divergence_mpas is gated.",
    "license": "MIT",
    "tags": [
      "esd:problem",
      "grid:mpas",
      "equation:gradient",
      "exactness",
      "unstructured"
    ],
    "references": [
      {
        "citation": "Ringler, T., Thuburn, J., Klemp, J. B., & Skamarock, W. C. (2010). A unified approach to energy conservation and potential vorticity dynamics for arbitrarily-structured C-grids. Journal of Computational Physics, 229(9), 3065-3090. Eq. (22): the discrete edge-normal gradient, whose two-point difference vanishes on a constant cell field."
      }
    ]
  },
  "models": {
    "Gradient": {
      "expression_template_imports": [
        {
          "ref": "../grids/mpas/rules/fv_gradient_edge.esm",
          "bindings": {
            "NCELLS": 12,
            "NEDGES": 30,
            "NVERTICES": 20,
            "MAXEDGES": 5
          }
        }
      ],
      "subsystems": {
        "mesh": {
          "ref": "../grids/mpas/mesh/level0.esm"
        }
      },
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "edges"
          ],
          "description": "Edge-normal field integrated under u_t = -grad(phi); since grad(phi) = 0 exactly it holds its initial field u0(e) = e for all time."
        },
        "cellsOnEdge": {
          "type": "unknown",
          "shape": [
            "edges",
            "edge_ends"
          ],
          "description": "Bare-name alias of mesh.cellsOnEdge: the two cells flanking each edge (positive normal cellsOnEdge[e][1] -> cellsOnEdge[e][2]); the gradient's flanking-cell gather."
        },
        "dcEdge": {
          "type": "unknown",
          "units": "rad",
          "shape": [
            "edges"
          ],
          "description": "Bare-name alias of mesh.dcEdge: cell-center-to-center great-circle arc across each edge, the gradient denominator."
        },
        "phi": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "cells"
          ],
          "description": "Spatially constant cell scalar phi(i) = 3: every flanking-cell difference phi(c2) - phi(c1) = 0 to the bit, so its discrete gradient is exactly zero at every edge."
        },
        "grad_phi": {
          "type": "unknown",
          "units": "1/rad",
          "shape": [
            "edges"
          ],
          "description": "The rule output itself, observed for direct assertion: grad(phi) lowered by fv_gradient_edge to the edge-normal two-point aggregate. Exactly zero at every edge because phi is constant."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "e"
            ],
            "ranges": {
              "e": {
                "from": "edges"
              }
            },
            "expr": "e"
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "grad",
                "args": [
                  "phi"
                ]
              }
            ]
          }
        },
        {
          "lhs": "cellsOnEdge",
          "rhs": "mesh.cellsOnEdge"
        },
        {
          "lhs": "dcEdge",
          "rhs": "mesh.dcEdge"
        },
        {
          "lhs": "phi",
          "rhs": {
            "op": "aggregate",
            "args": [],
            "output_idx": [
              "i"
            ],
            "ranges": {
              "i": {
                "from": "cells"
              }
            },
            "expr": 3.0
          }
        },
        {
          "lhs": "grad_phi",
          "rhs": {
            "op": "grad",
            "args": [
              "phi"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "grad_of_const_is_zero",
          "description": "The gradient's null-space mimetic property, exact on the discrete level. Derivation: grad_e = (phi(cellsOnEdge(e,2)) - phi(cellsOnEdge(e,1))) / dcEdge(e), and with phi(i) = 3 for every cell the numerator phi(c2) - phi(c1) = 3 - 3 = 0 identically at all 30 edges — no geometry, no orientation, no dcEdge value enters the result (a floating-point 3.0 - 3.0 is exactly 0.0), so grad(phi) = 0 to the bit. The max/min assertions pin the rule output to zero at 1e-13 (far tighter than divergence's 1e-11 because there is no dvEdge/A round trip — the difference is an exact subtraction of equal floats), and u (integrated from ic u0(e) = e under du/dt = -grad(phi) = 0) must return its initial field at t = 1 to 1e-9 in relative L2. The mean assertion checks preservation independently: mean(u0) = (1+2+...+30)/30 = 465/30 = 15.5. Any flanking-cell gather error (wrong cellsOnEdge column, a stray dcEdge scaling of a nonzero quantity, or a where-shape mis-fire that fails to lower grad) would either leave grad(phi) unlowered (caught by the unlowered_operator gate) or make some grad_e nonzero by O(1), so the 1e-13 tolerance separates pass from fail by ~13 orders of magnitude.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "grad_phi",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-13
              },
              "reduce": "max"
            },
            {
              "variable": "grad_phi",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-13
              },
              "reduce": "min"
            },
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "args": [],
                "output_idx": [
                  "e"
                ],
                "ranges": {
                  "e": {
                    "from": "edges"
                  }
                },
                "expr": "e"
              }
            },
            {
              "variable": "u",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "args": [],
                "output_idx": [
                  "e"
                ],
                "ranges": {
                  "e": {
                    "from": "edges"
                  }
                },
                "expr": "e"
              }
            },
            {
              "variable": "u",
              "time": 1.0,
              "expected": 15.5,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "mean"
            }
          ]
        }
      ]
    }
  }
}
