                {
                  "op": "*",
                  "args": [
                    0.5,
                    {
                      "op": "sin",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            0.017453292519943295,
                            {
                              "op": "+",
                              "args": [
                                -90.0,
                                {
                                  "op": "*",
                                  "args": [
                                    {
