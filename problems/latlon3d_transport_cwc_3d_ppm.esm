      "tests": [
        {
          "id": "freestream_q_stays_one_3d",
          "description": "MEASURED: the mixing ratio q = mq/m stays EXACTLY 1 under a strongly divergent, sign-reversing 3-D air-mass flux, because at q == 1 the monotone CW84 reconstruction collapses to the constant 1 (all slopes are exactly 0.0, so aL = aR = 1 and the parabola is flat) and the face flux becomes F = M bitwise, making dmq/dt equal dm/dt to the last bit. Measured 2026-07-16: dev = 0.0 exactly at both assertion times. The reference is the CONSTANT ZERO, so a 0.0 result proves nothing on its own -- non-vacuity is established by problems/_falsifier_ppm3d.esm (ic(mq) x 1.000001, i.e. q = 1+1e-6), which makes dev drift at rate (q-1)*div(M) to 1.08e-6 at t=0.1, six orders above the 1e-12 tolerance, and correctly FAILS. Re-run that falsifier whenever this problem changes. Only the t=0.1 assertion discriminates: dev is a state with dev(0)=0 by construction.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "dev",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": 0.0
              }
            },
            {
              "variable": "dev",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": 0.0
              }
            }
          ]
        }
      ],
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "m"
            ]
          },
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "i",
