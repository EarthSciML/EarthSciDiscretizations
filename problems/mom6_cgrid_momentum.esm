{
  "esm": "2.4.0",
  "metadata": {
    "name": "mom6_cgrid_momentum",
    "description": "Numeric conformance problem for the mom6_cgrid momentum rules (grids/mom6_cgrid/rules/mom6_cgrid_vort_x/y, grad_x/y, mask2dBu, avg_u/v, sum_q, avg_cell, pvf_u/v, bound_coriolis_u/v, diff_x/y) on a tiny 5x5x1 basin closed by solid walls (the grid metaparameters N_I/N_J/N_K are bound to 5/5/1 by the simulation manifest). The model chains the same equations as the AST fixtures tests/conformance/ast/mom6_cgrid_momentum (the SADOURNY75_ENERGY Coriolis + KE_ARAKAWA momentum-advection acceleration CAu/CAv of MOM_CoriolisAdv.F90 CorAdCalc with bound_Coriolis) and mom6_cgrid_momentum_pgf (the PressureForce_FV_Bouss face accelerations PFu/PFv of MOM_PressureForce_FV.F90:1796-1813) (the two accelerations a MOM6 momentum step sums with its other tendencies). The wall convention is MOM6's for a basin closed by land: velocities and volume fluxes on the closed wall faces (and on land faces beyond the domain) are 0, so the state sets u(5,j) = uh(5,j) = 0 on the east wall faces and v(i,5) = vh(i,5) = 0 on the north wall faces. Assertions are made only where MOM6 defines the value on such a basin: every interior u-face (i < N_I) and v-face (j < N_J), every cell, and the q-points off the walls. EVALUATION FORM: the products of an [i,j] metric with an [i,j,k] field are written as explicit faq index loops, and the rule calls that feed them (avg_cell, avg_u/avg_v) as their own variables, because the Julia tree-walk evaluator of EarthSciAST 184aa13d3 does not broadcast an [i,j] operand (a parameter array or a makearray result) against an [i,j,k] one (E_TREEWALK_CONSTARRAY_NDIM / E_TREEWALK_MAKEARRAY_NDIM); the arithmetic and its association are those of the AST fixtures.",
    "license": "MIT",
    "tags": [
      "esd:problem",
      "grid:mom6_cgrid",
      "rule:mom6_cgrid_vort_x",
      "rule:mom6_cgrid_vort_y",
      "rule:mom6_cgrid_grad_x",
      "rule:mom6_cgrid_grad_y",
      "rule:mom6_cgrid_mask2dBu",
      "rule:mom6_cgrid_avg_u",
      "rule:mom6_cgrid_avg_v",
      "rule:mom6_cgrid_sum_q",
      "rule:mom6_cgrid_avg_cell",
      "rule:mom6_cgrid_pvf_u",
      "rule:mom6_cgrid_pvf_v",
      "rule:mom6_cgrid_bound_coriolis_u",
      "rule:mom6_cgrid_bound_coriolis_v",
      "rule:mom6_cgrid_diff_x",
      "rule:mom6_cgrid_diff_y"
    ],
    "references": [
      {
        "citation": "Sadourny, R. (1975). The dynamics of finite-difference models of the shallow-water equations. Journal of the Atmospheric Sciences, 32(4), 680-689.",
        "doi": "10.1175/1520-0469(1975)032<0680:TDOFDM>2.0.CO;2"
      },
      {
        "citation": "Adcroft, A., et al. (2019). The GFDL global ocean and sea ice model OM4.0. Journal of Advances in Modeling Earth Systems, 11(10), 3167-3211.",
        "doi": "10.1029/2019MS001726"
      }
    ]
  },
  "models": {
    "Mom6CgridMomentum": {
      "operator_imports": [
        { "ref": "../grids/mom6_cgrid/grid.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_vort_x.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_vort_y.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_grad_x.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_grad_y.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_avg_u.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_avg_v.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_avg_cell.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_sum_q.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_mask2dBu.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_pvf_u.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_pvf_v.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_bound_coriolis_u.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_bound_coriolis_v.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_diff_x.esm" },
        { "ref": "../grids/mom6_cgrid/rules/mom6_cgrid_diff_y.esm" }
      ],
      "variables": {
        "u": {
          "type": "parameter",
          "units": "m/s",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "East-face zonal velocity (0 on the east wall faces i = N_I)."
        },
        "v": {
          "type": "parameter",
          "units": "m/s",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "North-face meridional velocity (0 on the north wall faces j = N_J)."
        },
        "mask": {
          "type": "parameter",
          "units": "1",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "0/1 ocean-cell indicator on the T cells (all ocean)."
        },
        "Area_h": {
          "type": "parameter",
          "units": "m^2",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "Ocean area of the h-cells (areaT*mask2dT)."
        },
        "IareaT": {
          "type": "parameter",
          "units": "1/m^2",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "1/cell area of the h-cells, the KE_ARAKAWA normalization."
        },
        "areaCu": {
          "type": "parameter",
          "units": "m^2",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "u-cell area on the east faces, the KE_ARAKAWA face weight."
        },
        "areaCv": {
          "type": "parameter",
          "units": "m^2",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "v-cell area on the north faces, the KE_ARAKAWA face weight."
        },
        "IdxCu": {
          "type": "parameter",
          "units": "1/m",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "1/zonal length of the u-cell at the east faces."
        },
        "IdyCv": {
          "type": "parameter",
          "units": "1/m",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "1/meridional length of the v-cell at the north faces."
        },
        "dxCu": {
          "type": "parameter",
          "units": "m",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "Zonal length of the u-cell at the east faces (the dudy circulation weight)."
        },
        "dyCv": {
          "type": "parameter",
          "units": "m",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "Meridional length of the v-cell at the north faces (the dvdx circulation weight)."
        },
        "IareaBu": {
          "type": "parameter",
          "units": "1/m^2",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "1/q-cell area at the q-points."
        },
        "f": {
          "type": "parameter",
          "units": "1/s",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "Coriolis parameter at the q-points."
        },
        "Aq": {
          "type": "parameter",
          "units": "m^2",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "Area_q of CorAdCalc (MOM_CoriolisAdv.F90:314): the sum of the four adjacent ocean cell areas Area_h at the q-point (land cells beyond the walls count 0)."
        },
        "h": {
          "type": "parameter",
          "units": "m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Layer thickness on the T cells."
        },
        "uh": {
          "type": "parameter",
          "units": "m^3/s",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "East-face zonal layer volume flux (0 on the east wall faces)."
        },
        "vh": {
          "type": "parameter",
          "units": "m^3/s",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "North-face meridional layer volume flux (0 on the north wall faces)."
        },
        "vol_neglect": { "type": "parameter", "units": "m^3", "default": 0.0, "description": "hArea_q denominator floor." },
        "pa_top": {
          "type": "parameter",
          "units": "Pa",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Pressure anomaly at the top interface of layer k at the cells."
        },
        "intz_dpa": {
          "type": "parameter",
          "units": "Pa m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Vertical integral in depth of the pressure anomaly less the top pressure anomaly, over the layer."
        },
        "e_bot": {
          "type": "parameter",
          "units": "m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Interface height below layer k at the cells."
        },
        "intx_pa": {
          "type": "parameter",
          "units": "Pa",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Interface integral of the pressure anomaly along the east faces divided by the grid spacing."
        },
        "inty_pa": {
          "type": "parameter",
          "units": "Pa",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Interface integral of the pressure anomaly along the north faces divided by the grid spacing."
        },
        "intx_dpa": {
          "type": "parameter",
          "units": "Pa",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Layer change of intx_pa along the east faces."
        },
        "inty_dpa": {
          "type": "parameter",
          "units": "Pa",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Layer change of inty_pa along the north faces."
        },
        "I_Rho0": {
          "type": "parameter",
          "units": "m^3/kg",
          "default": 0.0,
          "description": "1/rho0, the Boussinesq density scaling of the PGF."
        },
        "h_neglect": {
          "type": "parameter",
          "units": "m",
          "default": 0.0,
          "description": "Thickness denominator floor of the face acceleration."
        },
        "Z_to_H": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "Depth-to-thickness conversion of the e_bot correction term."
        },
        "Ah_h": {
          "type": "unknown",
          "units": "m^3",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Area_h*h, the cell layer volume, the avg_u/avg_v argument."
        },
        "eu2": {
          "type": "unknown",
          "units": "m^4/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "areaCu*u^2 on the east faces, an avg_cell argument (the KE_ARAKAWA weighting avg_cell itself does not apply)."
        },
        "nv2": {
          "type": "unknown",
          "units": "m^4/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "areaCv*v^2 on the north faces, an avg_cell argument."
        },
        "dvdx": {
          "type": "unknown",
          "units": "m^2/s",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "The undivided circulation difference D(v,x) at the q-points, the vort_x target."
        },
        "dudy": {
          "type": "unknown",
          "units": "m^2/s",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "The undivided circulation difference D(u,y) at the q-points, the vort_y target."
        },
        "mask2dBu": {
          "type": "unknown",
          "units": "1",
          "shape": ["i", "j"],
          "default": 0.0,
          "description": "The q-point mask, the mask2dBu target."
        },
        "rel_vort": {
          "type": "unknown",
          "units": "1/s",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Free-slip relative vorticity at the q-points."
        },
        "av": {
          "type": "unknown",
          "units": "1/s",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Absolute vorticity at the q-points."
        },
        "hArea_u": {
          "type": "unknown",
          "units": "m^3",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Layer volume of the u-cell on the east face, the avg_u target."
        },
        "hArea_v": {
          "type": "unknown",
          "units": "m^3",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Layer volume of the v-cell on the north face, the avg_v target."
        },
        "hArea_q": {
          "type": "unknown",
          "units": "m^3",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Layer volume of the q-cell, the sum_q target."
        },
        "Ih_q": {
          "type": "unknown",
          "units": "1/m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "1/q-cell layer thickness."
        },
        "q": {
          "type": "unknown",
          "units": "m^-1 s^-1",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Potential vorticity at the q-points."
        },
        "KE_sum": {
          "type": "unknown",
          "units": "m^4/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "The unweighted four-face mean avg_cell(eu2, nv2) (area-weighted squares, m^4/s^2); KE = IareaT*KE_sum is KE_ARAKAWA."
        },
        "KE": {
          "type": "unknown",
          "units": "m^2/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "KE_ARAKAWA kinetic energy on the T cells, the grad rule operand."
        },
        "KEx": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Zonal KE gradient at the east faces, the grad_x target."
        },
        "KEy": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Meridional KE gradient at the north faces, the grad_y target."
        },
        "pvf_u": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Raw east-face potential-vorticity flux, the pvf_u target."
        },
        "pvf_v": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Raw north-face potential-vorticity flux, the pvf_v target."
        },
        "CAu": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "East-face Coriolis + momentum-advection acceleration, the bound_coriolis_u target."
        },
        "CAv": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "North-face Coriolis + momentum-advection acceleration, the bound_coriolis_v target."
        },
        "P_int": {
          "type": "unknown",
          "units": "Pa m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Vertical integral of the pressure anomaly over layer k."
        },
        "dP_x": {
          "type": "unknown",
          "units": "Pa m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "East-face pressure-difference group."
        },
        "dP_y": {
          "type": "unknown",
          "units": "Pa m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "North-face pressure-difference group."
        },
        "h_u": {
          "type": "unknown",
          "units": "m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Face thickness avg_u(h) at the east faces, half the PFu denominator."
        },
        "h_v": {
          "type": "unknown",
          "units": "m",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Face thickness avg_v(h) at the north faces, half the PFv denominator."
        },
        "PFu": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Zonal pressure-gradient acceleration on the east faces."
        },
        "PFv": {
          "type": "unknown",
          "units": "m/s^2",
          "shape": ["i", "j", "k"],
          "default": 0.0,
          "description": "Meridional pressure-gradient acceleration on the north faces."
        }
      },
      "equations": [
        { "lhs": "dvdx", "rhs": { "op": "partial", "args": ["v"], "wrt": "x" } },
        { "lhs": "dudy", "rhs": { "op": "partial", "args": ["u"], "wrt": "y" } },
        { "lhs": "mask2dBu", "rhs": { "op": "mom6_cgrid_mask2dBu", "args": ["mask"] } },
        {
          "lhs": "rel_vort",
          "rhs": {
            "op": "faq",
            "output_idx": ["i", "j", "k"],
            "args": ["mask2dBu", "dvdx", "dudy", "IareaBu"],
            "ranges": { "i": [1, "N_I"], "j": [1, "N_J"], "k": [1, "N_K"] },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "*",
                  "args": [
                    { "op": "index", "args": ["mask2dBu", "i", "j"] },
                    {
                      "op": "-",
                      "args": [
                        { "op": "index", "args": ["dvdx", "i", "j", "k"] },
                        { "op": "index", "args": ["dudy", "i", "j", "k"] }
                      ]
                    }
                  ]
                },
                { "op": "index", "args": ["IareaBu", "i", "j"] }
              ]
            }
          }
        },
        {
          "lhs": "av",
          "rhs": {
            "op": "faq",
            "output_idx": ["i", "j", "k"],
            "args": ["f", "rel_vort"],
            "ranges": { "i": [1, "N_I"], "j": [1, "N_J"], "k": [1, "N_K"] },
            "expr": {
              "op": "+",
              "args": [{ "op": "index", "args": ["f", "i", "j"] }, { "op": "index", "args": ["rel_vort", "i", "j", "k"] }]
            }
          }
        },
        {
          "lhs": "Ah_h",
          "rhs": {
            "op": "faq",
            "output_idx": ["i", "j", "k"],
            "args": ["Area_h", "h"],
            "ranges": { "i": [1, "N_I"], "j": [1, "N_J"], "k": [1, "N_K"] },
            "expr": {
              "op": "*",
              "args": [{ "op": "index", "args": ["Area_h", "i", "j"] }, { "op": "index", "args": ["h", "i", "j", "k"] }]
            }
          }
        },
        { "lhs": "hArea_u", "rhs": { "op": "mom6_cgrid_avg_u", "args": ["Ah_h"] } },
        { "lhs": "hArea_v", "rhs": { "op": "mom6_cgrid_avg_v", "args": ["Ah_h"] } },
        { "lhs": "hArea_q", "rhs": { "op": "mom6_cgrid_sum_q", "args": ["hArea_u", "hArea_v"] } },
        {
          "lhs": "Ih_q",
          "rhs": {
            "op": "faq",
            "output_idx": ["i", "j", "k"],
            "args": ["Aq", "hArea_q", "vol_neglect"],
            "ranges": { "i": [1, "N_I"], "j": [1, "N_J"], "k": [1, "N_K"] },
            "expr": {
              "op": "/",
              "args": [
                { "op": "index", "args": ["Aq", "i", "j"] },
                { "op": "+", "args": [{ "op": "index", "args": ["hArea_q", "i", "j", "k"] }, "vol_neglect"] }
              ]
            }
          }
        },
        { "lhs": "q", "rhs": { "op": "*", "args": ["av", "Ih_q"] } },
        {
          "lhs": "eu2",
          "rhs": {
            "op": "faq",
            "output_idx": ["i", "j", "k"],
            "args": ["areaCu", "u"],
            "ranges": { "i": [1, "N_I"], "j": [1, "N_J"], "k": [1, "N_K"] },
            "expr": {
              "op": "*",
              "args": [
                { "op": "index", "args": ["areaCu", "i", "j"] },
                { "op": "^", "args": [{ "op": "index", "args": ["u", "i", "j", "k"] }, 2] }
              ]
            }
          }
        },
        {
          "lhs": "nv2",
          "rhs": {
            "op": "faq",
            "output_idx": ["i", "j", "k"],
            "args": ["areaCv", "v"],
            "ranges": { "i": [1, "N_I"], "j": [1, "N_J"], "k": [1, "N_K"] },
            "expr": {
              "op": "*",
              "args": [
                { "op": "index", "args": ["areaCv", "i", "j"] },
                { "op": "^", "args": [{ "op": "index", "args": ["v", "i", "j", "k"] }, 2] }
              ]
            }
          }
        },
        { "lhs": "KE_sum", "rhs": { "op": "mom6_cgrid_avg_cell", "args": ["eu2", "nv2"] } },
        {
          "lhs": "KE",
          "rhs": {
            "op": "faq",
            "output_idx": ["i", "j", "k"],
            "args": ["IareaT", "KE_sum"],
            "ranges": { "i": [1, "N_I"], "j": [1, "N_J"], "k": [1, "N_K"] },
            "expr": {
              "op": "*",
              "args": [{ "op": "index", "args": ["IareaT", "i", "j"] }, { "op": "index", "args": ["KE_sum", "i", "j", "k"] }]
            }
          }
        },
        { "lhs": "KEx", "rhs": { "op": "partial", "args": ["KE"], "wrt": "x" } },
        { "lhs": "KEy", "rhs": { "op": "partial", "args": ["KE"], "wrt": "y" } },
        { "lhs": "pvf_u", "rhs": { "op": "mom6_cgrid_pvf_u", "args": ["q", "vh", "IdxCu"] } },
        { "lhs": "pvf_v", "rhs": { "op": "mom6_cgrid_pvf_v", "args": ["q", "uh", "IdyCv"] } },
