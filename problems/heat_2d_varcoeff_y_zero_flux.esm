      ],
      "tests": [
        {
          "id": "mms_varcoeff_2d_y_zero_flux_decay",
          "description": "Manufactured solution (constant in the passive x axis) for the 2-D variable-coefficient heat equation u_t = div(k(y) grad u) + S(y,t) reduced to y-diffusion, with k(y) = 1 + 0.5 cos(2 pi y) and zero-flux (homogeneous Neumann) y-walls. This is the exact per-axis 2-D lift of problems/heat_1d_varcoeff_zero_flux: u and k depend only on y and are replicated across the passive x axis (closed to NX=8 at the import edge), so the relative-L2/Linf errors are identical to that 1-D case and fall at the conservative-FV order 2. Boundary compatibility: the physical flux k u_y vanishes at both y-walls (cos(y) has zero gradient there), matching the zero-flux closure. The closed-form MMS forcing S makes u exact for the continuous PDE (derivation mirrors heat_1d_varcoeff_zero_flux). References evaluate at cell centers (j-1/2)/NY, spelled inline per esm-spec 6.6.5 (build-time evaluation folds literals and the metaparameter NY only); the wall free names (none) live only in the runtime rule body. The t=0 assertion pins the ic wiring; the t=0.1 assertion bounds the relative L2 error. Exact per-resolution errors are pinned in tests/conformance/convergence/heat_2d_varcoeff_y_zero_flux/golden/errors.json.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": {
                  "op": "cos",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        3.141592653589793,
                        {
                          "op": "*",
                          "args": [
                            {
                              "op": "-",
                              "args": [
                                "j",
                                0.5
                              ]
                            },
                            {
                              "op": "/",
                              "args": [
                                1,
                                "NY"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "variable": "u",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.001
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": {
                  "op": "*",
                  "args": [
                    {
                      "op": "exp",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            -9.869604401089358,
                            0.1
                          ]
                        }
                      ]
                    },
                    {
                      "op": "cos",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            3.141592653589793,
                            {
                              "op": "*",
                              "args": [
                                {
