                        ]
                      }
                    ]
                  },
                  {
                    "op": "aggregate",
                    "output_idx": [
                      "i"
                    ],
                    "args": [],
                    "ranges": {
                      "i": {
                        "from": "x"
                      }
                    },
                    "expr": {
                      "op": "+",
                      "args": [
                        -19.739208802178716,
                        {
                          "op": "*",
                          "args": [
                            -9.869604401089358,
                            {
                              "op": "cos",
