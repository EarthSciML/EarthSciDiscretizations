            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "x"
                  }
                },
                "expr": {
                  "op": "-",
                  "args": [
                    1.0,
                    {
                      "op": "*",
                      "args": [
                        0.5,
                        {
                          "op": "cos",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                6.283185307179586,
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "i",
                                        0.5
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        1,
                                        "N"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "variable": "u",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.002
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i"
