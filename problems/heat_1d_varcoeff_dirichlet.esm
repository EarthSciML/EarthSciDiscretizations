                "expr": {
                  "op": "+",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "exp",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                -39.47841760435743,
                                0.1
                              ]
                            }
                          ]
                        },
                        {
