      "tests": [
        {
          "id": "freestream_q_stays_one",
          "description": "Under a strongly divergent, sign-reversing air-mass flux, the tracer mass mq tracks the air mass m exactly, so the mixing ratio q = mq/m stays 1. Both states are asserted against the closed-form semi-discrete air mass m(t) = mean(m0) - t * div(M), which is exact because the finite-volume divergence of exact face fluxes carries no truncation error and the right-hand side is time-independent.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "mq",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": {
                  "op": "-",
                  "args": [
                    2,
                    {
                      "op": "*",
                      "args": [
                        0.5,
                        {
                          "op": "+",
                          "args": [
                            {
                              "op": "+",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    0.6,
                                    {
                                      "op": "/",
                                      "args": [
                                        {
                                          "op": "-",
                                          "args": [
                                            "k",
                                            1
                                          ]
                                        },
                                        "NLEV"
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "op": "*",
                                  "args": [
                                    0.4,
                                    {
                                      "op": "/",
                                      "args": [
                                        {
                                          "op": "-",
                                          "args": [
                                            "k",
                                            1
                                          ]
                                        },
                                        "NLEV"
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        {
                                          "op": "-",
                                          "args": [
                                            "k",
                                            1
                                          ]
                                        },
                                        "NLEV"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "op": "+",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    0.6,
                                    {
                                      "op": "/",
                                      "args": [
                                        {
                                          "op": "-",
                                          "args": [
                                            {
                                              "op": "+",
                                              "args": [
                                                "k",
                                                1
                                              ]
                                            },
                                            1
                                          ]
                                        },
                                        "NLEV"
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "op": "*",
                                  "args": [
                                    0.4,
                                    {
                                      "op": "/",
                                      "args": [
                                        {
                                          "op": "-",
