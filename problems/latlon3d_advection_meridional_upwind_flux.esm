      "tests": [
        {
          "id": "steady_meridional_profile",
          "description": "q*(phi) = 2 + sin(phi) is an exact steady state of the forced equation; the drift at t = 0.1 is the accumulated truncation error of the flux-form meridional upwind operator, and the observed rate over the NLAT = 17/33/65/129 ladder is its truncation order. The t = 0 assertion pins that the `ic` really is the exact cell mean: it folds build-time from literals plus NLAT, independently of the runtime geometry observeds, so an error in either spelling would show up as a mismatch.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
