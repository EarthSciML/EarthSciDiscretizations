      "tests": [
        {
          "id": "freestream_q_stays_one",
          "description": "Under a strongly divergent, sign-reversing meridional air-mass flux the tracer mass mq tracks the air mass m exactly, so the mixing ratio q = mq/m stays 1. Both states are asserted against the closed-form semi-discrete air mass m(t) = m0 - t D(My), which is EXACT: the finite-volume divergence of exact face fluxes carries no truncation error on cell means, and the right-hand side is time-independent, so the trajectory is linear in t. The reference differences the pole terms explicitly and is nonetheless bit-identical to the rules' structural omission, because My is exactly 0.0 at both poles. mq is asserted against the SAME reference as m -- which is the free-stream claim, stated as an assertion.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "mq",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "args": [],
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": {
                  "op": "+",
                  "args": [
                    2,
                    {
                      "op": "*",
                      "args": [
                        0.25,
