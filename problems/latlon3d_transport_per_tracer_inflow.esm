      "tests": [
        {
          "id": "per_tracer_inflow_halos_are_independent",
          "description": "Two tracers, one wind, one lon/lat monotone-PPM inflow rule, DIFFERENT west halos. Tracer A's halo (1.0) matches its uniform interior q==1: every CW84 correction is a difference of equal values, exactly 0.0 in IEEE, each open-wall flux collapses to F = M bitwise, and devA = mqA - m stays EXACTLY 0. Tracer B is identical except its WEST halo is 2.0; the west wind blows INTO the domain, so the mismatched halo is donated and devB departs zero, reaching Linf = 1.874264527785965 at t=0.1 (MEASURED: julia, Tsit5, reltol 1e-10 / abstol 1e-12). BOTH assertions are load-bearing. devA==0 pins that promoting the halo from a free name to a rule param left the scheme's free-stream property bitwise intact. devB's non-zero golden is the NON-VACUITY twin: it proves B's halo is actually READ, and read INDEPENDENTLY of A's — were the halo still a free name, one model scope would hold exactly one `qbc_w`, both tracers would resolve it, and devB would sit at 0.0 alongside devA, failing this assertion. A rule that silently ignored its halo operands would likewise pass devA and fail here.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "devA",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": 0.0
              }
            },
            {
              "variable": "devB",
              "time": 0.1,
              "expected": 1.874264527785965,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": 0.0
              }
            }
          ]
        }
      ],
