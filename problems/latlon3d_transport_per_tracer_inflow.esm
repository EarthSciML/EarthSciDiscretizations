{
  "esm": "0.8.0",
  "metadata": {
    "name": "latlon3d_transport_per_tracer_inflow",
    "description": "PER-TRACER LATERAL INFLOW on a limited-area latlon patch (12x9x4, lon [0,60], lat [20,60], no poles, no zonal wrap): two tracers ride the SAME air-mass flux through the SAME monotone PPM inflow rules on lon and lat, each carrying its OWN prescribed Dirichlet halo. Geometry, winds, metric and initial mass profile are taken verbatim from problems/latlon3d_transport_cwc_regional_inflow.esm, so the only new thing under test is halo independence. Tracer A's halo is 1.0 on all four walls and matches its uniform interior: every CW84 correction is a difference of equal values, exactly 0.0 in IEEE, each wall flux collapses to F = M bitwise, and devA = mqA - m stays EXACTLY 0. Tracer B is identical except its WEST halo is 2.0; the west wind blows into the domain, so that halo is donated and devB departs zero. This document is the regression gate for the halo being a rule PARAM rather than a free name: with a free name, one model scope holds exactly one `qbc_w` and the two tracers could not disagree. See also the sibling CWC case (all-halos-match) and _falsifier_regional_inflow.esm (all halos perturbed).",
    "license": "MIT",
    "tags": [
      "esd:problem",
      "grid:latlon3d",
      "op:advection",
      "bc:inflow",
      "form:flux",
      "scheme:ppm",
      "property:per_tracer_bc"
    ]
  },
  "models": {
    "TransportPerTracerInflow": {
      "expression_template_imports": [
        {
          "ref": "../grids/latlon3d/rules/face_flux_divergence_lon_open_bc.esm",
