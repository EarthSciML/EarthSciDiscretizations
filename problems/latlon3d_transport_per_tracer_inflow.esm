            "NLAT": 9,
            "NLEV": 4
          }
        },
        {
          "ref": "../grids/latlon3d/rules/face_flux_divergence_lat_open_bc.esm",
          "bindings": {
            "NLON": 12,
            "NLAT": 9,
            "NLEV": 4
          }
        },
        {
          "ref": "../grids/latlon3d/rules/ppm_flux_D_lon_mono_inflow_bc.esm",
          "bindings": {
