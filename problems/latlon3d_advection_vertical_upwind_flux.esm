      "tests": [
        {
          "id": "steady_cos_profile",
          "description": "u*(z) = cos(pi z) is an exact steady state of the forced equation; the error at t = 0.1 is the accumulated truncation error of the flux-form upwind operator.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
