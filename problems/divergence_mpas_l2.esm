      "tests": [
        {
          "id": "p2_flux_divergence_error",
          "description": "Pins the discretization-error scale of the TRiSK divergence of the P2 flux at this resolution: u(1) = div_h(flux), compared against the data-free analytic-divergence reference d(i) = -3 (3 sin(latCell(i))^2 - 1) baked as a makearray of per-cell constants (from_file references are not evaluated by run_pde_tests; a makearray of literals is the const-array reference form the official evaluate_cellwise pathway resolves). Tolerances are ~1.3x the authoring-time predicted errors (relative L2 0.02636, absolute Linf 0.2335); the per-level golden errors and the observed order live in tests/conformance/convergence/divergence_mpas/golden/errors.json.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
