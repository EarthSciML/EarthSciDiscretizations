                        ]
                      }
                    ]
                  },
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          3.141592653589793,
                          {
                            "op": "aggregate",
                            "output_idx": [
                              "i"
                            ],
                            "args": [],
                            "ranges": {
                              "i": {
                                "from": "x"
                              }
                            },
                            "expr": {
                              "op": "*",
                              "args": [
                                0.5,
                                {
                                  "op": "+",
                                  "args": [
                                    {
                                      "op": "+",
                                      "args": [
                                        {
                                          "op": "*",
                                          "args": [
