                  1
                ]
              }
            ]
          }
        },
        {
          "lhs": "d2P",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "i",
              "j"
            ],
            "args": [],
            "ranges": {
              "i": {
                "from": "lon"
              },
              "j": {
                "from": "lat"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "^",
                  "args": [
                    {
                      "op": "/",
                      "args": [
                        3.141592653589793,
                        180
                      ]
                    },
                    2
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        12,
                        {
                          "op": "^",
                          "args": [
                            {
                              "op": "cos",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "/",
                                      "args": [
                                        3.141592653589793,
                                        180
                                      ]
                                    },
                                    {
