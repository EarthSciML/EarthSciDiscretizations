      "tests": [
        {
          "id": "mms_steady_polar_cap_diffusion",
          "description": "Manufactured steady solution u*(lat) = cos^4((pi/180) lat) with kappa = 200. Derivation: the continuous balance is u_t = kappa (u*_latlat - d2P) = 0 with d2P = u*_latlat = (pi/180)^2 (12 cos^2 sin^2 - 4 cos^4) (per-degree); the first three Phi-derivatives of u* vanish at both poles, so u* is pole-supercompatible with the rule's ghost-elimination zero-gradient pole rows to O(dlat_deg^2) (a plain cosine eigenmode would degrade the pole face to O(1) and collapse the order to 1 — see metadata.description), and the discrete drift is pure interior + compatible-pole O(dlat_deg^2) truncation. The t=0 assertion pins the ic wiring (reference equals the initial field). The t=0.2 assertion bounds the truncation-driven drift against the SAME steady reference: 1.55e-3 relative L2 at the sweep's coarsest NLAT=17 and 5.01e-5 at the default NLAT=91, so the 5e-3 bound holds across the whole convergence ladder (exact per-resolution errors pinned in tests/conformance/convergence/latlon_diffusion_meridional_zero_grad/golden/errors.json). The max assertion (u* attains 1 at the equator row, present for every odd NLAT) guards against a uniform-shift/source-sign defect that the relative L2 could disguise.",
          "time_span": {
            "start": 0.0,
            "end": 0.2
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "^",
                "args": [
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              3.141592653589793,
                              180
                            ]
                          },
                          {
                            "op": "aggregate",
                            "output_idx": [
                              "i",
                              "j"
                            ],
                            "args": [],
                            "ranges": {
                              "i": {
                                "from": "lon"
                              },
                              "j": {
                                "from": "lat"
                              }
                            },
                            "expr": {
                              "op": "+",
                              "args": [
                                -90,
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "j",
                                        1
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        180,
                                        {
                                          "op": "-",
                                          "args": [
                                            "NLAT",
                                            1
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  },
                  4
                ]
              }
            },
            {
              "variable": "u",
              "time": 0.2,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.005
              },
              "reduce": "L2_error",
              "reference": {
                "op": "^",
                "args": [
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          {
                            "op": "/",
                            "args": [
                              3.141592653589793,
                              180
                            ]
                          },
                          {
                            "op": "aggregate",
                            "output_idx": [
                              "i",
                              "j"
                            ],
                            "args": [],
                            "ranges": {
                              "i": {
                                "from": "lon"
                              },
                              "j": {
                                "from": "lat"
                              }
                            },
                            "expr": {
                              "op": "+",
                              "args": [
                                -90,
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "j",
                                        1
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        180,
                                        {
                                          "op": "-",
                                          "args": [
                                            "NLAT",
                                            1
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  },
                  4
                ]
              }
            },
            {
              "variable": "u",
              "time": 0.2,
              "expected": 1.0,
              "tolerance": {
                "abs": 0.05
              },
              "reduce": "max"
            }
          ]
        }
