                                        0.5
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        1,
                                        "NX"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "op": "sin",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                3.141592653589793,
                                {
                                  "op": "*",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "j",
                                        0.5
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        1,
                                        "NY"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "variable": "u",
              "time": 0.2,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.1
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "x"
