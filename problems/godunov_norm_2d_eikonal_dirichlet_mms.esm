              "i": {
                "from": "x"
              },
              "j": {
                "from": "y"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                0.5,
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "sin",
                      "args": [
