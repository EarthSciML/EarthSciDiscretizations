                            3.141592653589793,
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "-",
                                  "args": [
                                    "i",
                                    0.5
                                  ]
                                },
                                {
                                  "op": "/",
                                  "args": [
                                    1,
                                    "NX"
                                  ]
                                }
                              ]
                            }
                          ]
