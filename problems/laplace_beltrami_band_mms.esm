                                    {
                                      "op": "-",
                                      "args": [
                                        "i",
                                        0.5
                                      ]
                                    },
                                    {
                                      "op": "/",
                                      "args": [
                                        360,
                                        "NLON"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
