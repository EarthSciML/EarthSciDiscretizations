      "tests": [
        {
          "id": "mms_steady_band_laplace_beltrami",
          "description": "Manufactured steady u* = cos^4(s) cos(2 lambda) on the band lat in [30,60], periodic lon, kappa=1. u* is boundary-supercompatible with the rule's zero-flux Neumann band edges (F,F',F'',F''' vanish at s=+-pi/2), so the discrete drift is pure O(dlat_deg^2)+O(dlon_deg^2) truncation; both the cos(lat)-weighted zonal (1/cos^2 phi) and meridional (mimetic cos-flux) terms are exercised. The t=0 assertion pins the ic wiring (reference equals the initial field). The t=0.5 relative-L2 assertion bounds the truncation drift at the default NLON=144,NLAT=91 (4.9e-4, well under 2e-3). The max assertion (u* peaks near 1 at the band-center row lat=45 where cos^4(0)=1 and cos(2 lambda)~1) guards against a uniform-shift or source-sign defect the relative L2 could disguise.",
          "time_span": {
            "start": 0.0,
            "end": 0.5
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  }
                },
                "expr": {
                  "op": "*",
                  "args": [
                    {
                      "op": "cos",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            2,
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "/",
                                  "args": [
                                    3.141592653589793,
                                    180
                                  ]
                                },
                                {
                                  "op": "*",
