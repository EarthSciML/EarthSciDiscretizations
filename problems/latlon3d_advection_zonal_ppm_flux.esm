      "tests": [
        {
          "id": "steady_zonal_wave",
          "description": "q*(lambda) = 2 + sin(lambda) (periodic, strictly positive) is an exact steady state of the forced equation; the state is seeded with its exact CELL MEAN, so the L2 drift at t = 0.1 is the accumulated truncation error of the flux-form zonal PPM operator. The t = 0 assertion pins the ic wiring (it must reproduce the cell mean to 1e-9); the t = 0.1 assertion bounds the drift at the default NLON = 144. Per-resolution errors live in the convergence golden.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
