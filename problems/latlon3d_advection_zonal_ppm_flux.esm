                                          ]
                                        },
                                        "NLON"
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "op": "/",
                          "args": [
                            6.283185307179586,
                            "NLON"
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "variable": "u",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.05
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": {
                  "op": "+",
                  "args": [
                    2,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            {
                              "op": "cos",
                              "args": [
                                {
                                  "op": "*",
                                  "args": [
                                    6.283185307179586,
                                    {
                                      "op": "/",
                                      "args": [
                                        {
                                          "op": "-",
                                          "args": [
                                            "i",
                                            1
                                          ]
                                        },
                                        "NLON"
                                      ]
                                    }
