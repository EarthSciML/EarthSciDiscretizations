                                        { "op": "*", "args": [ 0.4, { "op": "/", "args": [ "i", "N" ] }, { "op": "/", "args": [ "i", "N" ] } ] }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "exp",
                        "args": [
                          {
                            "op": "aggregate",
                            "output_idx": [ "i" ],
                            "args": [],
                            "ranges": { "i": { "from": "x" } },
                            "expr": {
                              "op": "*",
                              "args": [
                                0.5,
                                {
                                  "op": "+",
                                  "args": [
                                    {
                                      "op": "+",
                                      "args": [
                                        { "op": "*", "args": [ 0.6, { "op": "/", "args": [ { "op": "-", "args": [ "i", 1 ] }, "N" ] } ] },
                                        { "op": "*", "args": [ 0.4, { "op": "/", "args": [ { "op": "-", "args": [ "i", 1 ] }, "N" ] }, { "op": "/", "args": [ { "op": "-", "args": [ "i", 1 ] }, "N" ] } ] }
