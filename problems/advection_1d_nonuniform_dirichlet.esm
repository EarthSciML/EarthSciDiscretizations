            "start": 0.0,
            "end": 0.05
          },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "+",
                "args": [
                  {
                    "op": "exp",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          2,
