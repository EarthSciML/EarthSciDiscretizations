                      {
                        "op": "*",
                        "args": [
                          {
                            "op": "exp",
                            "args": [
                              {
                                "op": "aggregate",
                                "output_idx": [ "i" ],
                                "args": [],
                                "ranges": { "i": { "from": "x" } },
                                "expr": {
                                  "op": "*",
