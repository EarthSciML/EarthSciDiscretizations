{
  "esm": "1.2.0",
  "metadata": {
    "name": "sedimentation_column_jh2010_forced",
    "description": "MMS driver for the Juang & Hong (2010) sedimentation operator: q_t = -d/dz(W q) + S(z,t) on the unit column [0, 1] with the layer-centred downward velocity W(z) = -(1 + z) (a fall speed growing with height, as terminal velocities do through the density correction), discretized on the quadratic-stretch column of the grid's shared fixture library grids/column_nonuniform_1d/mesh/mms_column.esm (template mms_column_ze) by grids/column_nonuniform_1d/rules/sedimentation_jh2010_flux_D_lev, the dt -> 0 limit of WRF WSM6's forward semi-Lagrangian fallout. The same problem as sedimentation_column_upwind_forced with the rule swapped, so the two are directly comparable. Manufactured solution q(z,t) = exp(-t) sin(pi z), which vanishes at the model top z = 1 so it is consistent with the rule's no-inflow closure there, and is monotone on either side of its extremum at z = 1/2, where the scheme's slope switch zeroes the reconstruction; the forcing that makes it exact is S(z,t) = q_t + d/dz(W q) = -exp(-t) [ 2 sin(pi z) + pi (1 + z) cos(pi z) ], evaluated at the layer centres. The surface z = 0 is an outflow face and takes no condition. W is strictly negative, so the W == 0 override never fires, and the four-point interface velocity never turns upward, so the upwind-side switch always takes the lower-face value: this problem exercises the reconstruction and the interface velocity, not the two overrides. Expected observed order 1.5: second order on the smooth monotone flanks and first order across the extremum, whose O(dz) local error enters the L2 norm as O(dz^1.5); the recorded L2 errors at t = 0.1 fall by 2.8 with each doubling of NLEV and are about 7.5 times smaller than the donor-cell rule's at NLEV = 64.",
    "license": "MIT",
    "tags": [
      "esd:problem",
      "family:finite_volume",
      "grid:column_nonuniform_1d",
      "op:advection",
      "scheme:semi_lagrangian_plm_limit",
      "mms"
    ],
    "references": [
      {
        "citation": "Juang, H.-M. H., & Hong, S.-Y. (2010). Forward semi-Lagrangian advection with mass conservation and positive definiteness for falling hydrometeors. Monthly Weather Review, 138(5), 1778-1791.",
        "doi": "10.1175/2009MWR3109.1"
      },
      {
        "citation": "Hong, S.-Y., & Lim, J.-O. J. (2006). The WRF single-moment 6-class microphysics scheme (WSM6). Journal of the Korean Meteorological Society, 42(2), 129-151."
      },
      {
        "citation": "WRF v4.8.0 / NCAR MMM-physics 550b5b4, phys/physics_mmm/mp_wsm6.F90, subroutine nislfv_rain_plm."
      }
    ]
  },
  "models": {
    "Fallout": {
      "expression_template_imports": [
        {
          "ref": "../grids/column_nonuniform_1d/rules/sedimentation_jh2010_flux_D_lev.esm"
        },
        {
          "ref": "../grids/column_nonuniform_1d/mesh/mms_column.esm"
        }
      ],
      "variables": {
        "q": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "Falling density over the lev (layer) axis."
        },
        "W": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "lev"
          ],
          "description": "Layer-centred signed velocity along +lev, W = -(1 + zc) <= 0 (a downward fall speed 1 + z)."
        },
        "S": {
          "type": "unknown",
          "units": "1/s",
          "shape": [
            "lev"
          ],
          "description": "Manufactured forcing S(zc, t) = -exp(-t) [ 2 sin(pi zc) + pi (1 + zc) cos(pi zc) ]."
        },
        "ze": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev_nodes"
          ],
          "description": "Interface coordinates of the quadratic-stretch test column, ze[kn] = 0.6 ((kn-1)/NLEV) + 0.4 ((kn-1)/NLEV)^2 for kn = 1..NLEV+1 (ze[1] = 0 the surface, ze[NLEV+1] = 1 the top): the single geometry input of the grid's edge-array contract, taken from the shared fixture library mesh/mms_column.esm (template mms_column_ze) and spelled there from the metaparameter name NLEV so a loader-API rebinding re-derives the whole mesh."
        },
        "zc": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer centres, GRID-DERIVED from ze by applying grids/column_nonuniform_1d column_cell_center."
        },
        "dz": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer thicknesses, GRID-DERIVED from ze by applying column_cell_thickness. The finite-volume measure read by the rule by bare name."
        }
      },
