        }
      ],
      "tests": [
        {
          "id": "freestream_rest_preservation",
          "description": "Rest / free-stream preservation. Initialize at rest: uniform dp = GH0, ua = va = 0, flat topography phis = 0. The composed LMARS RHS is exactly 0 in this state -- zero wind makes every contravariant velocity, LMARS flux, Coriolis term, kinetic-energy gradient and upwinded vorticity vanish, and a uniform dp over flat topography makes the L97 four-corner pressure gradient vanish -- so the discrete field must remain at rest to solver tolerance for all time regardless of the (nonzero) Coriolis f. The t=0 assertions pin the ic wiring; the t=T assertions bound any drift. Any sign, index-offset, halo, or metric error in the composition breaks exact rest by an O(1) amount, so the tight tolerance separates pass from fail by many orders of magnitude.",
          "time_span": {
            "start": 0.0,
            "end": 3600.0
          },
          "assertions": [
            {
              "variable": "dp",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "args": [],
                "output_idx": [
                  "t",
                  "i",
                  "j"
                ],
                "ranges": {
                  "t": {
                    "from": "tile"
                  },
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": 29400.0
              }
            },
            {
              "variable": "ua",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "args": [],
                "output_idx": [
                  "t",
                  "i",
                  "j"
                ],
                "ranges": {
                  "t": {
                    "from": "tile"
                  },
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": 0.0
              }
            },
            {
              "variable": "va",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "args": [],
                "output_idx": [
                  "t",
                  "i",
                  "j"
                ],
                "ranges": {
                  "t": {
                    "from": "tile"
                  },
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": 0.0
              }
            },
            {
              "variable": "dp",
              "time": 3600.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-06
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "args": [],
                "output_idx": [
                  "t",
                  "i",
                  "j"
                ],
                "ranges": {
                  "t": {
                    "from": "tile"
                  },
                  "i": {
                    "from": "x"
                  },
                  "j": {
                    "from": "y"
                  }
                },
                "expr": 29400.0
              }
            },
            {
              "variable": "ua",
              "time": 3600.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-08
              },
              "reduce": "L2_error",
              "reference": {
                "op": "aggregate",
                "args": [],
                "output_idx": [
                  "t",
                  "i",
