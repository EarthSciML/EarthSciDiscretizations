                "op": "apply_expression_template",
                "args": [],
                "name": "pgrad_l97_v_duo_g3",
                "bindings": {
                  "dp": "dp_e",
                  "ua": "ua_e",
                  "va": "va_e",
                  "node": "node",
                  "center": "center",
                  "cosA": "cosA",
                  "phis": {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_extend",
                    "bindings": {
                      "q": "phis",
                      "center": "center",
                      "refx": "refx",
                      "refy": "refy"
                    }
                  }
                }
              }
