{
  "esm": "0.8.0",
  "metadata": {
    "name": "heat_1d_zero_grad",
    "description": "MMS driver: 1-D heat equation u_t = alpha u_xx on the unit interval with zero-gradient (homogeneous Neumann) boundaries, discretized by grids/cartesian_uniform_1d/rules/central_D2_zero_grad_bc. Manufactured solution u(x,t) = exp(-alpha pi^2 t) cos(pi x): cos(pi x) satisfies u_x = 0 at both x=0 and x=1, so it is compatible with the zero-gradient rule and needs no forcing term (contrast the esm-spec 6.6.5 worked example, whose sin(pi x) solution is zero-Dirichlet). Initial condition and test references are written explicitly over the grid's x_coord geometry template, so no implicit index-to-coordinate mapping is assumed anywhere.",
    "license": "MIT",
    "tags": ["esd:problem", "grid:cartesian_uniform_1d", "equation:heat", "mms"],
    "references": [
      {
        "citation": "Roache, P. J. (2002). Code verification by the method of manufactured solutions. J. Fluids Eng. 124(1), 4-10.",
        "doi": "10.1115/1.1436090"
      }
    ]
  },
  "models": {
    "Heat": {
      "expression_template_imports": [
        { "ref": "../grids/cartesian_uniform_1d/rules/central_D2_zero_grad_bc.esm" }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "K",
          "shape": ["x"],
          "description": "Temperature field over the x index set."
        },
        "alpha": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.01,
          "description": "Thermal diffusivity."
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": {
            "op": "cos",
            "args": [
              {
                "op": "*",
                "args": [
                  3.141592653589793,
                  { "op": "apply_expression_template", "args": [], "name": "x_coord", "bindings": {} }
                ]
              }
            ]
          }
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "*",
            "args": [
              "alpha",
              { "op": "D", "args": [ { "op": "D", "args": ["u"], "wrt": "x" } ], "wrt": "x" }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "mms_neumann_decay",
          "description": "Manufactured solution u(x,t) = exp(-alpha pi^2 t) cos(pi x) with alpha = 0.01. Derivation: u_t = -alpha pi^2 u and u_xx = -pi^2 u, so u_t = alpha u_xx exactly; u_x = -pi sin(pi x) vanishes at x = 0 and x = 1, matching the zero-gradient rule; no forcing term required. The t=0 assertion pins the ic wiring (reference equals the initial field); the t=0.1 assertion bounds the relative L2 discretization error, whose leading term scales as (pi dx)^2/12 — approximately 3e-5 at N=16, so the 1e-4 bound holds for every resolution in the convergence sweep. Exact per-resolution error values are pinned in tests/conformance/convergence/heat_1d_zero_grad/golden/errors.json.",
          "time_span": { "start": 0.0, "end": 0.1 },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": { "abs": 1e-9 },
              "reduce": "L2_error",
              "reference": {
                "op": "cos",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      3.141592653589793,
                      { "op": "apply_expression_template", "args": [], "name": "x_coord", "bindings": {} }
                    ]
                  }
                ]
              }
            },
            {
              "variable": "u",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": { "abs": 1e-4 },
              "reduce": "L2_error",
              "reference": {
                "op": "*",
                "args": [
                  {
                    "op": "exp",
                    "args": [
                      { "op": "*", "args": [-0.01, 9.869604401089358, 0.1] }
                    ]
                  },
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          3.141592653589793,
                          { "op": "apply_expression_template", "args": [], "name": "x_coord", "bindings": {} }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
