{
  "esm": "0.8.0",
  "metadata": {
    "name": "_falsifier_regional_inflow",
    "description": "NON-VACUITY falsifier for latlon3d_transport_cwc_regional_inflow: identical except the four prescribed boundary halos qbc_{w,e,s,n} are 1.000001 instead of 1. With a mismatched inflow concentration the open-wall PPM flux no longer collapses to the mass flux, the tracer stops tracking the air mass at the inflow (west, south) walls, and dev drifts off zero -- so the gate correctly FAILS, proving the boundary condition is LIVE and not a silently-dead closure. Regenerated from the gate problem plus the single halo change; re-run if that problem changes.",
    "license": "MIT",
    "tags": [
      "esd:problem",
      "grid:latlon3d",
      "family:finite_volume",
      "op:D",
      "axes:lon,lat,lev",
      "scheme:flux_form",
      "property:free_stream",
      "bc:inflow"
    ]
  },
  "models": {
    "TransportCWCRegionalInflow": {
      "expression_template_imports": [
        {
          "ref": "../grids/latlon3d/rules/face_flux_divergence_lon_open_bc.esm",
          "bindings": {
            "NLON": 12,
            "NLAT": 9,
            "NLEV": 4
          }
        },
        {
          "ref": "../grids/latlon3d/rules/face_flux_divergence_lat_open_bc.esm",
          "bindings": {
            "NLON": 12,
            "NLAT": 9,
            "NLEV": 4
          }
        },
        {
          "ref": "../grids/latlon3d/rules/ppm_flux_D_lon_mono_inflow_bc.esm",
          "bindings": {
            "NLON": 12,
            "NLAT": 9,
            "NLEV": 4
          }
        },
        {
          "ref": "../grids/latlon3d/rules/ppm_flux_D_lat_mono_inflow_bc.esm",
          "bindings": {
            "NLON": 12,
            "NLAT": 9,
            "NLEV": 4
          }
        }
      ],
      "variables": {
        "m": {
          "type": "state",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Air mass per cell (a pressure thickness). Strictly positive."
        },
        "mq": {
          "type": "state",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Tracer mass per cell. Initialised bitwise equal to m, so q == 1."
        },
        "dev": {
          "type": "state",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Diagnostic deviation dev = mq - m, obtained by integrating the DIFFERENCE of the two right-hand sides from dev(0) = 0. This is the quantity the conformance assertion gates: at q == 1 the tracer divergence collapses bitwise onto the continuity divergence, so dev's own right-hand side is EXACTLY 0.0 in IEEE and dev never leaves zero. It exists because assertion `reference` expressions are build-time and cellwise and cannot read states or observeds, so q itself is not assertable and asserting mq would require re-spelling the entire discrete divergence by hand -- i.e. duplicating the operator inside its own test. Against a constant-zero reference there is nothing for the test to get wrong. dev feeds nothing back into m or mq."
        },
        "lon0_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 0.0,
          "description": "Grid's lon0_deg free name; 0 closes the periodic zonal circle."
        },
        "lat0_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 20.0,
          "description": "Grid's lat0_deg free name; -90 for the pole-to-pole global recipe."
        },
        "dlon_deg": {
          "type": "observed",
          "units": "deg",
          "expression": 5.0,
          "description": "Regional zonal spacing 5.0 deg (lon in [0.0, 60.0]); the domain does NOT close, so the zonal axis is OPEN (west/east walls), not periodic."
        },
        "dlat_deg": {
          "type": "observed",
          "units": "deg",
          "expression": 5.0,
          "description": "Regional meridional spacing 5.0 deg (lat in [20.0, 60.0]); the domain does NOT reach the poles, so the meridional axis is OPEN (south/north walls), not polar."
        },
        "phie": {
          "type": "observed",
          "units": "deg",
          "shape": [
            "lat_nodes"
          ],
          "description": "Latitude cell EDGES from the grid's lat_edge template; the half-polar caps fall out of the clamp at +/-90.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lat_edge",
            "bindings": {}
          }
        },
        "coslat_e": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lat_nodes"
          ],
          "description": "cos of the latitude edges. Zero-length face at each pole. Never read at faces 1 or NLAT+1 -- the pole terms are structurally omitted.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "coslat_edge",
            "bindings": {
              "phie": "phie"
            }
          }
        },
        "dS_lat": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lat"
          ],
          "description": "Exact spherical cell-area weight sin(phie[j+1]) - sin(phie[j]).",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "latcell_area",
            "bindings": {
              "phie": "phie"
            }
          }
        },
        "dphi_lat": {
          "type": "observed",
          "units": "rad",
          "shape": [
            "lat"
          ],
          "description": "Meridional cell extent; HALF-width at the two polar caps.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "latcell_dphi",
            "bindings": {
              "phie": "phie"
            }
          }
        },
        "Mx": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lon_nodes",
            "lat",
            "lev"
          ],
          "description": "Zonal face-normal air-mass flux at the WEST edge of each cell. Element NLON+1 IS read here (open east wall). Positive throughout [0,60] deg lon, so the west wall is inflow and the east wall outflow.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "ci",
              "cj",
              "ck"
            ],
            "args": [
              "phie"
            ],
            "ranges": {
              "ci": {
                "from": "lon_nodes"
              },
              "cj": {
                "from": "lat"
              },
              "ck": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                0.7,
                {
                  "op": "cos",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        0.017453292519943295,
                        {
                          "op": "+",
                          "args": [
                            "lon0_deg",
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "-",
                                  "args": [
                                    "ci",
                                    1
                                  ]
                                },
                                "dlon_deg"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    1.0,
                    {
                      "op": "*",
                      "args": [
                        0.3,
                        {
                          "op": "sin",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                0.017453292519943295,
                                {
                                  "op": "*",
                                  "args": [
                                    0.5,
                                    {
                                      "op": "+",
                                      "args": [
                                        {
                                          "op": "index",
                                          "args": [
                                            "phie",
                                            "cj"
                                          ]
                                        },
                                        {
                                          "op": "index",
                                          "args": [
                                            "phie",
                                            {
                                              "op": "+",
                                              "args": [
                                                "cj",
                                                1
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    1.0,
                    {
                      "op": "*",
                      "args": [
                        0.05,
                        {
                          "op": "-",
                          "args": [
                            "ck",
                            1
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "My": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lon",
            "lat_nodes",
            "lev"
          ],
          "description": "Meridional face-normal air-mass flux at the SOUTH edge of each cell. Faces 1 and NLAT+1 are the open south/north walls (real face lengths, NOT poles). Positive across the patch, so the south wall is inflow and the north wall outflow.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "ci",
              "cj",
              "ck"
            ],
            "args": [
              "phie"
            ],
            "ranges": {
              "ci": {
                "from": "lon"
              },
              "cj": {
                "from": "lat_nodes"
              },
              "ck": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
