            "expr": 1.000001
          }
        }
      },
      "tests": [
        {
          "id": "falsifier_regional_inflow_dev_drifts",
          "description": "MEASURED: on a mid-latitude regional patch with OPEN lateral walls carrying a prescribed boundary concentration qbc == 1, the mixing ratio q = mq/m stays EXACTLY 1 under a divergent air-mass flux with genuine inflow (west, south) and outflow (east, north). At q == 1 with the halo == 1 every CW84 slope is a difference of equal values and is exactly 0.0 in IEEE, the reconstruction is the constant 1 through the walls, and each open wall flux collapses to F = M bitwise, so the inflow PPM tracer divergence telescopes onto the open-wall continuity twin and dmq/dt equals dm/dt to the last bit. The reference is the CONSTANT ZERO, so 0.0 proves nothing alone -- non-vacuity is problems/_falsifier_regional_inflow.esm (all four qbc halos x 1.000001), which injects a mismatched boundary concentration through the inflow walls and drives dev off zero, correctly FAILING. Only the t>0 assertion discriminates: dev integrates from dev(0)=0.",
          "time_span": {
            "start": 0.0,
            "end": 0.1
          },
          "assertions": [
            {
              "variable": "dev",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": 0.0
              }
            },
            {
              "variable": "dev",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "Linf_error",
              "reference": {
                "op": "aggregate",
                "output_idx": [
                  "i",
                  "j",
                  "k"
                ],
                "args": [],
                "ranges": {
                  "i": {
                    "from": "lon"
                  },
                  "j": {
                    "from": "lat"
                  },
                  "k": {
                    "from": "lev"
                  }
                },
                "expr": 0.0
              }
            }
          ]
        }
      ],
