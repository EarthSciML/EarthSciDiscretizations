                  "op": "cos",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        0.017453292519943295,
                        {
                          "op": "index",
                          "args": [
                            "phie",
                            "cj"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    1.0,
                    {
                      "op": "*",
                      "args": [
