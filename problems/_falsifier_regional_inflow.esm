        },
        "qbc_n": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lon",
            "lev"
          ],
          "description": "Prescribed tracer concentration in the NORTH halo, == 1.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
