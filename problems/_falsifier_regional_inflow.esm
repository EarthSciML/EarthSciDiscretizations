                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "q": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Mixing ratio mq/m. The quantity under test: it must stay EXACTLY 1.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "iq",
              "jq",
              "kq"
            ],
            "args": [
              "mq",
              "m"
            ],
            "ranges": {
              "iq": {
                "from": "lon"
              },
              "jq": {
                "from": "lat"
              },
              "kq": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "/",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "mq",
                    "iq",
                    "jq",
                    "kq"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "m",
                    "iq",
                    "jq",
                    "kq"
                  ]
                }
              ]
            }
          }
        },
        "qbc_w": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lat",
            "lev"
          ],
          "description": "Prescribed tracer concentration in the WEST halo (Dirichlet inflow data), == 1 so the incoming tracer matches the interior and q stays 1. The falsifier perturbs this.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gl",
              "gl"
            ],
            "args": [],
            "ranges": {
              "gl": {
                "from": "lev"
              }
            },
            "expr": 1.000001
          }
        },
        "qbc_e": {
          "type": "observed",
          "units": "1",
          "shape": [
            "lat",
            "lev"
          ],
          "description": "Prescribed tracer concentration in the EAST halo, == 1.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gl",
              "gl"
            ],
            "args": [],
            "ranges": {
              "gl": {
                "from": "lev"
