         "j",
         "k"
        ],
        "args": [],
        "ranges": {
         "i": {
          "from": "lon"
         },
         "j": {
          "from": "lat"
         },
         "k": {
          "from": "lev"
         }
        },
        "expr": 0.0
       }
      },
