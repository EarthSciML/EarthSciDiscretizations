                    {
                     "op": "*",
                     "args": [
                      0.6,
                      {
                       "op": "/",
                       "args": [
                        {
                         "op": "-",
                         "args": [
                          "i",
                          1
                         ]
                        },
                        "NLEV"
                       ]
                      }
                     ]
                    },
                    {
                     "op": "*",
                     "args": [
                      0.4,
                      {
