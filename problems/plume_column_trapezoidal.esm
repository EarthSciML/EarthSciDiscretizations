   "tests": [
    {
     "id": "plume_trapezoidal_mms",
     "description": "w_plume(1) = phi, the implicit-trapezoidal sweep of dphi/dz = lam (phi_env - phi) + src on the quadratic-stretch column with lam = 2 + 3z, compared in L2 against phi* = 1 + sin(pi z) at the layer centres, at the default NLEV = 64. Measured with the Rust binding: L2 error 3.88e-5; the bound is 2x that. Mutation check: the frozen-coefficient step (lam[k] at both ends of the step) gives 4.82e-3 on this case and fails, so the case discriminates the order claim. Per-resolution errors belong in tests/conformance/convergence/plume_column_trapezoidal/golden/errors.json once the Julia reference generates them.",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "w_plume",
       "time": 1.0,
       "expected": 0.0,
       "tolerance": {
        "abs": 7.8e-05
       },
       "reduce": "L2_error",
       "reference": {
        "op": "faq",
        "output_idx": [
         "i"
        ],
        "args": [],
        "ranges": {
         "i": {
          "from": "lev"
         }
        },
        "expr": {
         "op": "+",
         "args": [
          1.0,
          {
           "op": "sin",
