{
 "esm": "1.2.0",
 "metadata": {
  "name": "plume_column_trapezoidal",
  "description": "MMS driver for grids/column_nonuniform_1d/rules/entraining_plume_lev, the implicit-trapezoidal sweep of the entraining-plume ODE dphi/dz = lam(z)(phi_env(z) - phi(z)) + src(z) upward along lev from a seeded bottom cell. Manufactured solution phi*(z) = 1 + sin(pi z) on the grid's shared quadratic-stretch column (mesh/mms_column.esm), with environment phi_env = cos(pi z) and a VARYING entrainment rate lam = 2 + 3z; the forcing S(z) = phi*' - lam (phi_env - phi*) is supplied as the trapezoidal mean over each step, the centring the rule's source contract asks for. The varying rate is the point: it separates the library step (rate at both ends, second order) from the frozen-coefficient step mass-flux schemes write (rate at the upper end only, first order), which this case was used to measure. An accumulator state w with ic 0 and dw/dt = phi makes w(1) = phi exactly, so the L2 error at t = 1 isolates the lowering. The reference spells the layer centre from literals and NLEV (build-time scope caveat, AGENTS.md).",
  "license": "MIT",
  "tags": [
   "esd:problem",
   "grid:column_nonuniform_1d",
   "equation:entraining_plume",
   "mms"
  ],
  "references": [
   {
    "citation": "Roache, P. J. (2002). Code verification by the method of manufactured solutions. J. Fluids Eng. 124(1), 4-10.",
    "doi": "10.1115/1.1436090"
   }
  ]
 },
 "models": {
  "PlumeTrapezoidal": {
   "expression_template_imports": [
    {
     "ref": "../grids/column_nonuniform_1d/rules/entraining_plume_lev.esm"
    },
    {
     "ref": "../grids/column_nonuniform_1d/mesh/mms_column.esm"
    }
   ],
   "variables": {
    "ze": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "description": "Interface coordinates of the grid's shared quadratic-stretch MMS column (mesh/mms_column.esm mms_column_ze)."
    },
    "zc": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev"
     ],
     "description": "Layer centres, grid-derived from ze by column_cell_center; the coordinate the plume rule steps along, read by bare name."
    },
    "lam": {
     "type": "unknown",
     "units": "1/m",
     "shape": [
      "lev"
     ],
     "description": "Entrainment rate lam(z) = 2 + 3z at the layer centres. It VARIES, so the case discriminates a step that takes the rate at both ends (second order) from one that freezes it at the upper end (first order)."
    },
    "phi_env": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Environment profile cos(pi z) at the layer centres."
    },
    "src": {
     "type": "unknown",
     "units": "1/m",
     "shape": [
      "lev"
     ],
     "description": "Source centred on each step, the trapezoidal mean (S(zc[k-1]) + S(zc[k]))/2 of the manufactured forcing S(z) = phi*'(z) - lam(z)(phi_env(z) - phi*(z)); cell 1 (never read by the rule, which seeds it) holds S(zc[1])."
    },
    "phi0": {
     "type": "unknown",
     "units": "1",
     "description": "Seed: the manufactured solution at the bottom layer centre, 1 + sin(pi zc[1])."
    },
    "phi": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "The lowered plume: phi = entraining_plume_lev(phi_env, lam, src, phi0, phi), compared with phi*(z) = 1 + sin(pi z)."
    },
    "w_plume": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Accumulator state with ic 0 and dw/dt = phi, so w(1) = phi exactly for every integrator and the L2 error of w at t = 1 is the error of the lowering alone (the pattern of problems/integral_column_midpoint.esm)."
    }
   },
