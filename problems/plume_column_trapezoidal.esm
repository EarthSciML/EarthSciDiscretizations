{
 "esm": "2.1.0",
 "metadata": {
  "name": "plume_column_trapezoidal",
  "description": "MMS driver for grids/column_nonuniform_1d/rules/entraining_plume_lev, the implicit-trapezoidal sweep of the entraining-plume ODE dphi/dz = lam(z)(phi_env(z) - phi(z)) + src(z) upward along lev from a seeded bottom cell. Manufactured solution phi*(z) = 1 + sin(pi z) on the grid's shared quadratic-stretch column (mesh/mms_column.esm), with environment phi_env = cos(pi z) and a VARYING entrainment rate lam = 2 + 3z; the forcing S(z) = phi*' - lam (phi_env - phi*) is sampled at the layer centres and supplied as the trapezoidal mean over each step, the centring the rule's source contract asks for. phi*, phi_env, lam and S are written once each, as the model's own expression templates plume_mms_*, and every equation applies them. The varying rate is the point: it separates the library step (rate at both ends, second order) from the frozen-coefficient step mass-flux schemes write (rate at the upper end only, first order), which this case was used to measure. An accumulator state w with ic 0 and dw/dt = phi makes w(1) = phi exactly, so the L2 error at t = 1 isolates the lowering. The test reference spells phi* at the layer centre from literals and NLEV rather than applying plume_mms_exact (build-time scope caveat, AGENTS.md; templates cannot be resolved in a 6.6.5 reference). This document is also the fixture of tests/conformance/ast/entraining_plume_lev, so the model that simulates is the model whose lowering is byte-pinned.",
  "license": "MIT",
  "tags": [
   "esd:problem",
   "grid:column_nonuniform_1d",
   "equation:entraining_plume",
   "mms"
  ],
  "references": [
   {
    "citation": "Roache, P. J. (2002). Code verification by the method of manufactured solutions. J. Fluids Eng. 124(1), 4-10.",
    "doi": "10.1115/1.1436090"
   }
  ]
 },
 "models": {
  "PlumeTrapezoidal": {
   "expression_template_imports": [
    {
     "ref": "../grids/column_nonuniform_1d/rules/entraining_plume_lev.esm"
    },
    {
     "ref": "../grids/column_nonuniform_1d/mesh/mms_column.esm"
    }
   ],
   "expression_templates": {
    "plume_mms_exact": {
     "params": [
      "z"
     ],
     "description": "Manufactured plume solution phi*(z) = 1 + sin(pi z).",
     "body": {
      "op": "+",
      "args": [
       1.0,
       {
        "op": "sin",
        "args": [
         {
          "op": "*",
          "args": [
           3.141592653589793,
           "z"
          ]
         }
        ]
       }
      ]
     }
    },
    "plume_mms_env": {
     "params": [
      "z"
     ],
     "description": "Environment profile phi_env(z) = cos(pi z).",
     "body": {
      "op": "cos",
      "args": [
       {
        "op": "*",
        "args": [
         3.141592653589793,
         "z"
        ]
       }
      ]
     }
    },
    "plume_mms_rate": {
     "params": [
      "z"
     ],
     "description": "Varying entrainment rate lam(z) = 2 + 3z.",
     "body": {
      "op": "+",
      "args": [
       2.0,
       {
        "op": "*",
        "args": [
         3.0,
         "z"
        ]
       }
      ]
     }
    },
    "plume_mms_forcing": {
     "params": [
      "z"
     ],
     "description": "Manufactured forcing S(z) = phi*'(z) - lam(z)(phi_env(z) - phi*(z)), with phi*'(z) = pi cos(pi z) = pi phi_env(z).",
     "body": {
      "op": "-",
      "args": [
       {
        "op": "*",
        "args": [
         3.141592653589793,
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "plume_mms_env",
          "bindings": {
           "z": "z"
          }
         }
        ]
       },
       {
        "op": "*",
        "args": [
         {
          "op": "apply_expression_template",
          "args": [],
          "name": "plume_mms_rate",
          "bindings": {
           "z": "z"
          }
         },
         {
          "op": "-",
          "args": [
           {
            "op": "apply_expression_template",
            "args": [],
            "name": "plume_mms_env",
            "bindings": {
             "z": "z"
            }
           },
           {
            "op": "apply_expression_template",
            "args": [],
            "name": "plume_mms_exact",
            "bindings": {
             "z": "z"
            }
           }
          ]
         }
        ]
       }
      ]
     }
    }
   },
   "variables": {
    "ze": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev_nodes"
     ],
     "description": "Interface coordinates of the grid's shared quadratic-stretch MMS column (mesh/mms_column.esm mms_column_ze)."
    },
    "zc": {
     "type": "unknown",
     "units": "m",
     "shape": [
      "lev"
     ],
     "description": "Layer centres, grid-derived from ze by column_cell_center; the coordinate the plume rule steps along, read by bare name."
    },
    "lam": {
     "type": "unknown",
     "units": "1/m",
     "shape": [
      "lev"
     ],
     "description": "Entrainment rate lam(z) = 2 + 3z at the layer centres. It VARIES, so the case discriminates a step that takes the rate at both ends (second order) from one that freezes it at the upper end (first order)."
    },
    "phi_env": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Environment profile cos(pi z) at the layer centres."
    },
    "S": {
     "type": "unknown",
     "units": "1/m",
     "shape": [
      "lev"
     ],
     "description": "The manufactured forcing S(z) = phi*'(z) - lam(z)(phi_env(z) - phi*(z)) sampled at the layer centres (template plume_mms_forcing)."
    },
    "src": {
     "type": "unknown",
     "units": "1/m",
     "shape": [
      "lev"
     ],
     "description": "Source centred on each step, the trapezoidal mean (S[k-1] + S[k])/2 of the sampled forcing; cell 1 (never read by the rule, which seeds it) holds S[1]."
    },
    "phi0": {
     "type": "unknown",
     "units": "1",
     "description": "Seed: the manufactured solution at the bottom layer centre, 1 + sin(pi zc[1])."
    },
    "phi": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "The lowered plume: phi = entraining_plume_lev(phi_env, lam, src, phi0, phi), compared with phi*(z) = 1 + sin(pi z)."
    },
    "w_plume": {
     "type": "unknown",
     "units": "1",
     "shape": [
      "lev"
     ],
     "description": "Accumulator state with ic 0 and dw/dt = phi, so w(1) = phi exactly for every integrator and the L2 error of w at t = 1 is the error of the lowering alone (the pattern of problems/integral_column_midpoint.esm)."
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "ic",
      "args": [
       "w_plume"
      ]
     },
     "rhs": 0.0
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "w_plume"
      ],
      "wrt": "t"
     },
     "rhs": "phi"
    },
    {
     "lhs": "ze",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "mms_column_ze",
      "bindings": {}
     }
    },
    {
     "lhs": "zc",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "column_cell_center",
      "bindings": {
       "ze": "ze"
      }
     }
    },
    {
     "lhs": "lam",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "i"
      ],
      "args": [
       "zc"
      ],
      "ranges": {
       "i": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "plume_mms_rate",
       "bindings": {
        "z": {
         "op": "index",
         "args": [
          "zc",
          "i"
         ]
        }
       }
      }
     }
    },
    {
     "lhs": "phi_env",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "i"
      ],
      "args": [
       "zc"
      ],
      "ranges": {
       "i": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "plume_mms_env",
       "bindings": {
        "z": {
         "op": "index",
         "args": [
          "zc",
          "i"
         ]
        }
       }
      }
     }
    },
    {
     "lhs": "S",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "i"
      ],
      "args": [
       "zc"
      ],
      "ranges": {
       "i": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "plume_mms_forcing",
       "bindings": {
        "z": {
         "op": "index",
         "args": [
          "zc",
          "i"
         ]
        }
       }
      }
     }
    },
    {
     "lhs": "src",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "i"
      ],
      "args": [
       "S"
      ],
      "ranges": {
       "i": {
        "from": "lev"
       }
      },
      "expr": {
       "op": "ifelse",
       "args": [
        {
         "op": "<=",
         "args": [
          "i",
          1
         ]
        },
        {
         "op": "index",
         "args": [
          "S",
          "i"
         ]
        },
        {
         "op": "*",
         "args": [
          0.5,
          {
           "op": "+",
           "args": [
            {
             "op": "index",
             "args": [
              "S",
              {
               "op": "-",
               "args": [
                "i",
                1
               ]
              }
             ]
            },
            {
             "op": "index",
             "args": [
              "S",
              "i"
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "phi0",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "plume_mms_exact",
      "bindings": {
       "z": {
        "op": "index",
        "args": [
         "zc",
         1
        ]
       }
      }
     }
    },
    {
     "lhs": "phi",
     "rhs": {
      "op": "entraining_plume_lev",
      "args": [
       "phi_env",
       "lam",
       "src",
       "phi0",
       "phi"
      ]
     }
    }
   ],
   "tests": [
    {
     "id": "plume_trapezoidal_mms",
     "description": "w_plume(1) = phi, the implicit-trapezoidal sweep of dphi/dz = lam (phi_env - phi) + src on the quadratic-stretch column with lam = 2 + 3z, compared in L2 against phi* = 1 + sin(pi z) at the layer centres, at the default NLEV = 64. Measured with the julia and rust bindings against EarthSciAST main bf7c1fa2: L2 error 3.88e-5 in both; the bound is 2x that. Mutation check: the frozen-coefficient step (lam[k] at both ends of the step) gives 4.82e-3 on this case and fails, so the case discriminates the order claim. Per-resolution errors are pinned in tests/conformance/convergence/plume_column_trapezoidal/golden/errors.json (julia reference).",
     "time_span": {
      "start": 0.0,
      "end": 1.0
     },
     "assertions": [
      {
       "variable": "w_plume",
       "time": 1.0,
       "expected": 0.0,
       "tolerance": {
        "abs": 7.8e-05
       },
       "reduce": "L2_error",
       "reference": {
        "op": "faq",
        "output_idx": [
         "i"
        ],
        "args": [],
        "ranges": {
         "i": {
          "from": "lev"
         }
        },
        "expr": {
         "op": "+",
         "args": [
          1.0,
          {
           "op": "sin",
           "args": [
            {
             "op": "*",
             "args": [
              3.141592653589793,
              {
               "op": "*",
               "args": [
                0.5,
                {
                 "op": "+",
                 "args": [
                  {
                   "op": "+",
                   "args": [
                    {
                     "op": "*",
                     "args": [
                      0.6,
                      {
                       "op": "/",
                       "args": [
                        {
                         "op": "-",
                         "args": [
                          "i",
                          1
                         ]
                        },
                        "NLEV"
                       ]
                      }
                     ]
                    },
                    {
                     "op": "*",
                     "args": [
                      0.4,
                      {
                       "op": "/",
                       "args": [
                        {
                         "op": "-",
                         "args": [
                          "i",
                          1
                         ]
                        },
                        "NLEV"
                       ]
                      },
                      {
                       "op": "/",
                       "args": [
                        {
                         "op": "-",
                         "args": [
                          "i",
                          1
                         ]
                        },
                        "NLEV"
                       ]
                      }
                     ]
                    }
                   ]
                  },
                  {
                   "op": "+",
                   "args": [
                    {
                     "op": "*",
                     "args": [
                      0.6,
                      {
                       "op": "/",
                       "args": [
                        "i",
                        "NLEV"
                       ]
                      }
                     ]
                    },
                    {
                     "op": "*",
                     "args": [
                      0.4,
                      {
                       "op": "/",
                       "args": [
                        "i",
                        "NLEV"
                       ]
                      },
                      {
                       "op": "/",
                       "args": [
                        "i",
                        "NLEV"
                       ]
                      }
                     ]
                    }
                   ]
                  }
                 ]
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       }
      }
     ]
    }
   ]
  }
 }
}
