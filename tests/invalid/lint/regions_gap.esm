{
  "esm": "0.8.0",
  "metadata": {
    "name": "regions_gap",
    "description": "Lint fixture: a rule whose makearray regions omit the i=N boundary face leaves the axis untiled and must be rejected (L006). Also mislocated relative to its grid directory (L005).",
    "tags": ["esd:rule", "family:finite_difference", "grid:cartesian_uniform_1d", "op:D", "axes:x", "order:1", "bc:zero_gradient"]
  },
  "expression_templates": {
    "regions_gap": {
      "params": ["f"],
      "match": { "op": "D", "args": ["f"], "wrt": "x" },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [[2, { "op": "-", "args": ["N", 1] }]],
          [[1, 1]]
        ],
        "values": [
          { "op": "index", "args": ["f", "i"] },
          { "op": "index", "args": ["f", 1] }
        ]
      }
    }
  }
}
