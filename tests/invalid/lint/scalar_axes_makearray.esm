{
  "esm": "1.2.0",
  "metadata": {
    "name": "scalar_axes_makearray",
    "description": "Lint fixture: a rule tagged axes:none (rank-0 output) whose body is nevertheless a makearray tiling an axis -- L006 must fire.",
    "license": "MIT",
    "tags": [
      "esd:rule",
      "family:finite_volume",
      "grid:column_nonuniform_1d",
      "op:integral",
      "order:2",
      "bc:none",
      "axes:none"
    ]
  },
  "expression_templates": {
    "scalar_axes_makearray": {
      "params": [
        "f"
      ],
      "match": {
        "op": "integral",
        "args": [
          "f"
        ],
        "var": "lev",
        "lower": "z_sfc",
        "upper": "z_top"
      },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [
            [
              1,
              "NLEV"
            ]
          ]
        ],
        "values": [
          "f"
        ]
      }
    }
  }
}
