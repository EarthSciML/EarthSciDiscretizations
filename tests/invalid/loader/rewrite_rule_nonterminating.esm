{
  "esm": "1.0.0",
  "metadata": {
    "name": "rewrite_rule_nonterminating",
    "description": "Loader fixture: a self-reintroducing rewrite rule (D(f,x) -> 2*D(f,x)) never converges; the bounded fixpoint must reject the file with diagnostic rewrite_rule_nonterminating after MAX_REWRITE_PASSES=64 passes (esm-spec 9.6.3 constraint 2)."
  },
  "index_sets": {
    "x": { "kind": "interval", "size": 8 }
  },
  "models": {
    "NonTerminating": {
      "variables": {
        "u": { "type": "unknown", "units": "K", "shape": ["x"], "description": "field whose derivative rule self-reintroduces" }
      },
      "equations": [
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": { "op": "D", "args": ["u"], "wrt": "x" }
        }
      ],
      "expression_templates": {
        "self_reintroducing": {
          "params": ["f"],
          "match": { "op": "D", "args": ["f"], "wrt": "x" },
          "body": { "op": "*", "args": [2, { "op": "D", "args": ["f"], "wrt": "x" }] }
        }
      }
    }
  }
}
