          "description": "Constant transport speed (non-negative; +x upwind convention, inflow at the left wall)."
        },
        "gL": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 0.0,
          "description": "Inflow value carried into the domain at the left wall x=x0 (the rule's inflow free name). Zero default = zero-inflow case; the free name gL appears verbatim in the expanded golden regardless of its numeric default."
        },
