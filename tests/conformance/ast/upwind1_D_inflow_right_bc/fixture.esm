{
  "esm": "0.8.0",
  "metadata": {
    "name": "upwind1_D_inflow_right_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/cartesian_uniform_1d/rules/upwind1_D_inflow_right_bc: a minimal consuming model binding N=8 at the import edge. The plain match D(u,x) must lower, through the section-9.6.3 fixpoint, to the rule's makearray -- interior [1,7] holding the imported forward stencil aggregate, the i=8 inflow face holding (gR-u[8])/dx -- with all metaparameters folded and the free names dx and gR surviving in the expanded body. The model declares gR as an ordinary real parameter (the rule's inflow free name). x0 = 0 and dx = 1/8; the dx expression is spelled with the literal 8 because the edge binding closes N before it reaches this document's scope (grids/cartesian_uniform_1d/grid.esm). The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:cartesian_uniform_1d", "rule:upwind1_D_inflow_right_bc"]
  },
  "models": {
    "Upwind1DInflowRightBcAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_1d/rules/upwind1_D_inflow_right_bc.esm",
          "bindings": { "N": 8 }
        }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "kg/m^3",
          "shape": ["x"],
          "description": "Advected tracer field over the x index set."
        },
        "c": {
          "type": "parameter",
          "units": "m/s",
          "default": -1.0,
          "description": "Constant transport speed (non-positive; forward upwind for flow in -x)."
        },
        "gR": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 0.0,
          "description": "Inflow value carried into the domain at the right wall x=x0+N*dx (the rule's inflow free name). Zero default = zero-inflow case; the free name gR appears verbatim in the expanded golden regardless of its numeric default."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left domain edge a = 0: the grid's x0 free name (consumer-supplied geometry contract)."
        },
        "dx": {
          "type": "observed",
          "units": "m",
          "expression": { "op": "/", "args": [1, 8] },
          "description": "Grid spacing 1/N = 1/8, spelled with the literal 8: the import edge binds N, closing it before this document's scope (grids/cartesian_uniform_1d/grid.esm contract)."
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": 0.0
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "*",
            "args": [
              { "op": "-", "args": ["c"] },
              { "op": "D", "args": ["u"], "wrt": "x" }
            ]
          }
        }
      ]
    }
  }
