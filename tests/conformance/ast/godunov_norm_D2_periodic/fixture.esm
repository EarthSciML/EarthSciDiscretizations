{
  "esm": "1.0.0",
  "metadata": {
    "name": "godunov_norm_D2_periodic_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/cartesian_uniform_2d/rules/godunov_norm_D2_periodic: a minimal consuming model binding NX=NY=4 at the import edge. The COMPOUND match sqrt((D(u,x))^2 + (D(u,y))^2) must fire through the section-9.6.3 rewrite fixpoint at priority 10 (before any plain first-derivative rule could lower the inner D(u,x) or D(u,y)) and lower the whole Hamilton-Jacobi gradient-magnitude term to the rule's makearray — the doubly-interior block [2,3]x[2,3] holding the Godunov-norm aggregate sqrt(max(D-_x,0)^2 + min(D+_x,0)^2 + max(D-_y,0)^2 + min(D+_y,0)^2), the four periodic edge strips (i=1, i=NX, j=1, j=NY) and four corners holding the same norm with the seam neighbor(s) wrapped — with all metaparameters folded and the free names dx, dy surviving in the expanded body (the grid's consumer-supplied geometry contract). This is the full 2-D Godunov scheme and the concrete instance of the compound-precedence example cited in esm-spec 9.6.3 / 9.6.8. The model fulfills the geometry contract with x0 = y0 = 0 and dx = dy = 1/4; the dx/dy expressions are spelled with the literal 4 because the edge binding closes NX,NY before they reach this document's scope (grids/cartesian_uniform_2d/grid.esm). The golden pins the byte-identical post-lowering AST across bindings, with zero unlowered rewrite-target ops (the spatial D's are gone) and zero apply_expression_template nodes.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:cartesian_uniform_2d",
      "rule:godunov_norm_D2_periodic"
    ]
  },
  "models": {
    "GodunovNormD2PeriodicAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_2d/rules/godunov_norm_D2_periodic.esm",
          "bindings": {
            "NX": 4,
            "NY": 4
          }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "x",
            "y"
          ],
          "description": "Level-set / eikonal field over the 2-D [x, y] index sets."
        },
        "S": {
          "type": "parameter",
          "units": "1/s",
          "default": 1.0,
          "description": "Non-negative Hamilton-Jacobi speed (psi_t = -S|grad psi|)."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left x domain edge a = 0: the grid's x0 free name (consumer-supplied geometry contract)."
        },
        "y0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Bottom y domain edge b = 0: the grid's y0 free name."
        },
        "dx": {
          "type": "unknown",
          "units": "m",
          "description": "x-spacing 1/NX = 1/4, spelled with the literal 4: the import edge binds NX, closing it before this document's scope (grids/cartesian_uniform_2d/grid.esm contract)."
        },
        "dy": {
          "type": "unknown",
          "units": "m",
          "description": "y-spacing 1/NY = 1/4, spelled with the literal 4: the import edge binds NY, closing it before this document's scope."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "S"
                ]
              },
              {
                "op": "sqrt",
                "args": [
                  {
                    "op": "+",
                    "args": [
                      {
                        "op": "^",
                        "args": [
                          {
                            "op": "D",
                            "args": [
                              "u"
                            ],
                            "wrt": "x"
                          },
                          2
                        ]
                      },
                      {
                        "op": "^",
                        "args": [
                          {
                            "op": "D",
                            "args": [
                              "u"
                            ],
                            "wrt": "y"
                          },
                          2
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
