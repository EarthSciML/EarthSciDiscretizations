{
  "esm": "1.0.0",
  "metadata": {
    "name": "laplacian_2d_neumann_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for the 2-D Laplacian on cartesian_uniform_2d, assembled from grids/cartesian_uniform_2d/rules/central_D2x_neumann_bc and central_D2y_neumann_bc: a minimal consuming model binding NX=NY=4 at the import edge. The equation's Laplacian D(D(u,x),x) + D(D(u,y),y) must lower, through the section-9.6.3 fixpoint, to the sum of the two per-axis makearrays — each with its interior stencil aggregate and its two ghost-eliminated Neumann faces (all j / all i strips) — with all metaparameters folded and the free names dx, dy, qXL, qXR, qYL, qYR surviving in the expanded body. qXL and qYL keep their zero defaults; qXR and qYR are nonzero so both the homogeneous and inhomogeneous face spellings appear. The geometry contract is fulfilled for the unit box with x0=y0=0 and dx=dy=1/4 (spelled with the literal 4 because the edge binding closes NX/NY before this document's scope; grids/cartesian_uniform_2d/grid.esm). The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:cartesian_uniform_2d",
      "rule:central_D2x_neumann_bc",
      "rule:central_D2y_neumann_bc"
    ]
  },
  "models": {
    "Laplacian2dNeumannBcAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_2d/rules/central_D2x_neumann_bc.esm",
          "bindings": {
            "NX": 4,
            "NY": 4
          }
        },
        {
          "ref": "../../../../grids/cartesian_uniform_2d/rules/central_D2y_neumann_bc.esm",
          "bindings": {
            "NX": 4,
            "NY": 4
          }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "x",
            "y"
          ],
          "description": "Temperature field over the 2-D [x, y] index sets."
        },
        "alpha": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.01,
          "description": "Thermal diffusivity."
        },
        "qXL": {
          "type": "parameter",
          "units": "K/m",
          "default": 0.0,
          "description": "df/dx at the left x-wall (rule free name); zero default = homogeneous."
        },
        "qXR": {
          "type": "parameter",
          "units": "K/m",
          "default": 2.5,
          "description": "df/dx at the right x-wall (rule free name); nonzero so the inhomogeneous x-face term appears."
        },
        "qYL": {
          "type": "parameter",
          "units": "K/m",
          "default": 0.0,
          "description": "df/dy at the bottom y-wall (rule free name); zero default = homogeneous."
        },
        "qYR": {
          "type": "parameter",
          "units": "K/m",
          "default": 1.5,
          "description": "df/dy at the top y-wall (rule free name); nonzero so the inhomogeneous y-face term appears."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left x domain edge (unit box): the grid's x0 free name."
        },
        "y0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Bottom y domain edge (unit box): the grid's y0 free name."
        },
        "dx": {
          "type": "unknown",
          "units": "m",
          "description": "x-spacing 1/NX = 1/4, spelled with the literal 4: the import edge binds NX, closing it before this document's scope (grids/cartesian_uniform_2d/grid.esm contract)."
        },
        "dy": {
          "type": "unknown",
          "units": "m",
          "description": "y-spacing 1/NY = 1/4, spelled with the literal 4: the import edge binds NY, closing it before this document's scope."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "alpha",
              {
                "op": "+",
                "args": [
                  {
                    "op": "D",
                    "args": [
                      {
                        "op": "D",
                        "args": [
                          "u"
                        ],
                        "wrt": "x"
                      }
                    ],
                    "wrt": "x"
                  },
                  {
                    "op": "D",
                    "args": [
                      {
                        "op": "D",
                        "args": [
                          "u"
                        ],
                        "wrt": "y"
                      }
                    ],
                    "wrt": "y"
                  }
                ]
              }
            ]
          }
        },
        {
          "lhs": "dx",
          "rhs": {
            "op": "/",
            "args": [
              1,
              4
            ]
          }
        },
        {
          "lhs": "dy",
          "rhs": {
            "op": "/",
            "args": [
              1,
              4
            ]
          }
        }
      ]
    }
  }
}
