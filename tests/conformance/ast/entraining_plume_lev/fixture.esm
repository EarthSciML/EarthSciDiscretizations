{
 "esm": "1.2.0",
 "metadata": {
  "name": "entraining_plume_lev_ast_fixture",
  "description": "AST-expansion conformance fixture for grids/column_nonuniform_1d/rules/entraining_plume_lev: the consuming model of problems/plume_column_trapezoidal.esm with NLEV bound to 8 at both import edges. The match fires on phi = entraining_plume_lev(phi_env, lam, src, phi0, phi) (where phi_env, lam, src, phi: [lev]) and lowers to ONE faq over lev whose cell k reads index(phi, k-1) behind an ifelse seed guard at k = 1 -- the esm-spec 4.3.1.1 recurrence spelling -- with each step an application of the scalar stencil entraining_plume_lev_interior, preserved uninlined in the template registry (esm-spec 9.6.4 reference-preserving form), and the layer-centre spacing read from the grid-derived observed zc by bare name. The golden pins the byte-identical post-lowering AST across bindings.",
  "license": "MIT",
  "tags": [
   "conformance",
   "ast",
   "grid:column_nonuniform_1d",
   "rule:entraining_plume_lev"
  ]
 },
 "models": {
  "EntrainingPlumeLevAst": {
   "expression_template_imports": [
    {
     "ref": "../../../../grids/column_nonuniform_1d/rules/entraining_plume_lev.esm",
     "bindings": {
      "NLEV": 8
     }
    },
    {
