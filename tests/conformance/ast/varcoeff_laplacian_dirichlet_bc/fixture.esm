{
  "esm": "0.8.0",
  "metadata": {
    "name": "varcoeff_laplacian_dirichlet_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/cartesian_uniform_1d/rules/varcoeff_laplacian_dirichlet_bc: a minimal consuming model binding N=8 at the import edge. The compound match D( k * D(u,x), x ) must fire through the section-9.6.3 fixpoint (priority 10) and lower to the rule's makearray -- interior [2,7] holding the imported conservative flux-difference stencil aggregate over u and k, faces i=1 and i=8 holding the mirror-ghost fixed-value one-sided fluxes with the wall conductivities k[1], k[8] -- with zero apply_expression_template nodes, zero surviving spatial D, and the free names dx, gL, gR surviving in the expanded body. The model declares gL and gR as ordinary real parameters (gL homogeneous, gR a nonzero fixed value), which survive as symbolic names in the golden. The coefficient k is a consumer-supplied field of shape [x] (here k=1+0.5 cos(2 pi x_i)), bound by the match as the LEFT factor of the product; u is the state. x0 = 0 and dx = 1/8; the dx expression is spelled with the literal 8 because the edge binding closes N before it reaches this document's scope (grids/cartesian_uniform_1d/grid.esm). The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:cartesian_uniform_1d", "rule:varcoeff_laplacian_dirichlet_bc"]
  },
  "models": {
    "VarcoeffLaplacianDirichletBcAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_1d/rules/varcoeff_laplacian_dirichlet_bc.esm",
          "bindings": { "N": 8 }
        }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "K",
          "shape": ["x"],
          "description": "Temperature field over the x index set."
        },
        "k": {
          "type": "observed",
          "units": "m^2/s",
          "shape": ["x"],
          "description": "Consumer-supplied variable conductivity of shape [x], k_gi = 1 + 0.5 cos(2 pi x_gi) at cell centers x_gi = (gi - 1/2)/8, spelled inline from literals and the edge-bound N=8. Bound by the rule's match as the coefficient k (the left factor of k*D(u,x)); read by the expanded stencil at the interior faces and the wall conductivities k[1], k[8] at the boundary faces. The aggregate loops over `gi`, distinct from the stencil's interior index `i`, per the keyed-factor convention (see the rule description).",
          "expression": {
            "op": "aggregate",
            "output_idx": ["gi"],
            "args": [],
            "ranges": { "gi": { "from": "x" } },
            "expr": {
              "op": "+",
              "args": [
                1.0,
                {
                  "op": "*",
                  "args": [
                    0.5,
                    {
                      "op": "cos",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            6.283185307179586,
                            {
                              "op": "*",
                              "args": [
                                { "op": "-", "args": ["gi", 0.5] },
                                { "op": "/", "args": [1, 8] }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "gL": {
          "type": "parameter",
          "units": "K",
          "default": 0.0,
          "description": "Prescribed field value at the left wall x=x0 (the rule's Dirichlet free name). Zero default = homogeneous left wall."
        },
        "gR": {
          "type": "parameter",
          "units": "K",
          "default": 1.0,
          "description": "Prescribed field value at the right wall (the rule's Dirichlet free name), nonzero so the inhomogeneous face term appears in the expanded golden."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left domain edge a = 0: the grid's x0 free name (consumer-supplied geometry contract)."
        },
        "dx": {
          "type": "observed",
          "units": "m",
          "expression": { "op": "/", "args": [1, 8] },
          "description": "Grid spacing 1/N = 1/8, spelled with the literal 8: the import edge binds N, closing it before this document's scope (grids/cartesian_uniform_1d/grid.esm contract)."
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": 0.0
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "D",
            "args": [
              {
                "op": "*",
                "args": [
                  "k",
                  { "op": "D", "args": ["u"], "wrt": "x" }
                ]
              }
            ],
            "wrt": "x"
          }
        }
      ]
    }
  }
}
