{
  "esm": "0.8.0",
  "metadata": {
    "name": "upwind1_D_periodic_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/cartesian_uniform_1d/rules/upwind1_D_periodic: a minimal consuming model binding N=8 at the import edge. The plain match D(u,x) must lower, through the section-9.6.3 fixpoint, to the rule's makearray — interior [2,8] holding the backward-difference aggregate, the i=1 face holding the explicit periodic wrap (u[1]-u[8])/dx — with all metaparameters folded. The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:cartesian_uniform_1d", "rule:upwind1_D_periodic"]
  },
  "models": {
    "Upwind1DPeriodicAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_1d/rules/upwind1_D_periodic.esm",
          "bindings": { "N": 8 }
        }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "kg/m^3",
          "shape": ["x"],
          "description": "Advected tracer field over the x index set."
        },
        "c": {
          "type": "parameter",
          "units": "m/s",
          "default": 1.0,
          "description": "Constant transport speed (non-negative; the upwind rule assumes flow in +x)."
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": 0.0
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "*",
            "args": [
              { "op": "-", "args": ["c"] },
              { "op": "D", "args": ["u"], "wrt": "x" }
            ]
          }
        }
      ]
    }
  }
}
