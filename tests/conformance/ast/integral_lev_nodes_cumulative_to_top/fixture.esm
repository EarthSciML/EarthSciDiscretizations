            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "w"
            ],
            "wrt": "t"
          },
          "rhs": "F"
        },
        {
          "lhs": "f",
          "rhs": "zc"
        },
        {
