                },
                {
                  "op": "+",
                  "args": [
                    1,
                    {
                      "op": "*",
                      "args": [
                        0.25,
                        {
                          "op": "cos",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                6.283185307179586,
                                {
                                  "op": "/",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "im",
                                        0.5
                                      ]
                                    },
                                    8
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "cos",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        3.141592653589793,
                        {
                          "op": "/",
                          "args": [
                            {
                              "op": "-",
                              "args": [
                                "km",
                                1
                              ]
