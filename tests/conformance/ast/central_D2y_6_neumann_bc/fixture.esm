{
  "esm": "0.8.0",
  "metadata": {
    "name": "central_D2y_6_neumann_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/cartesian_uniform_2d/rules/central_D2y_6_neumann_bc: a minimal consuming model binding NX=4, NY=8 at the import edge. The compound match D(D(u,y),y) fires (priority 10) through the section-9.6.3 fixpoint and lowers to the rule's makearray — interior rows [4,5] (all i) holding the imported 7-point sixth-order y second-difference stencil aggregate, the six y-face rows j in {1,2,3,6,7,8} over the (NX x 1) strips holding the sixth-order one-sided neumann closures (face1/face2/face3) carrying the free names qYL, qYR and dy — with all metaparameters folded. x0=y0=0 and dx=1/4, dy=1/8; the dx/dy expressions are spelled with literals because the edge binding closes NX/NY before this document's scope (grids/cartesian_uniform_2d/grid.esm). The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:cartesian_uniform_2d",
      "rule:central_D2y_6_neumann_bc"
    ]
  },
  "models": {
    "CentralD2y6NeumannBcAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_2d/rules/central_D2y_6_neumann_bc.esm",
          "bindings": {
            "NX": 4,
            "NY": 8
          }
        }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "K",
          "shape": [
            "x",
            "y"
          ],
          "description": "Temperature field over the 2-D [x, y] index sets."
        },
        "alpha": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.01,
          "description": "Thermal diffusivity."
        },
        "qYL": {
          "type": "parameter",
          "units": "K/m",
          "default": 0.0,
          "description": "df/dy at the bottom y-wall (the rule's Neumann free name). Zero default = homogeneous (zero-flux) bottom wall."
        },
        "qYR": {
          "type": "parameter",
          "units": "K/m",
          "default": 1.0,
          "description": "df/dy at the top y-wall (the rule's Neumann free name), nonzero so the inhomogeneous face flux term appears in the expanded golden."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left x domain edge a = 0: the grid's x0 free name (consumer-supplied geometry contract)."
        },
        "y0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Bottom y domain edge: the grid's y0 free name."
        },
        "dx": {
          "type": "observed",
          "units": "m",
          "expression": {
            "op": "/",
            "args": [
              1,
              4
            ]
          },
          "description": "x-spacing 1/NX = 1/4, spelled with the literal 4: the import edge binds NX, closing it before this document's scope (grids/cartesian_uniform_2d/grid.esm contract)."
        },
        "dy": {
          "type": "observed",
          "units": "m",
          "expression": {
            "op": "/",
            "args": [
              1,
              8
            ]
          },
          "description": "y-spacing 1/NY = 1/8, spelled with the literal 8: the import edge binds NY."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              "alpha",
              {
                "op": "D",
                "args": [
                  {
                    "op": "D",
                    "args": [
                      "u"
                    ],
                    "wrt": "y"
                  }
                ],
                "wrt": "y"
              }
            ]
          }
        }
      ]
    }
  }
}
