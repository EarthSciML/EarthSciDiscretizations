{
  "esm": "0.8.0",
  "metadata": {
    "name": "duo_halo_remap_ast_fixture",
    "description": "AST-expansion conformance fixture for the grids/duo duo-grid halo remap (Phase 2). A minimal consuming model importing grids/duo/grid.esm (geometry + index sets) AND grids/duo/rules/duo_extend.esm (the halo operator) with N bound at each import edge, declaring a per-tile A-grid state field q[tile,x,y] and an observed qext[tile,x_cell_ext,y_cell_ext] that applies duo_extend, binding center to the duo_cell_center geometry chain and refx/refy to the equiangular reference lines. Forces the section-9.6.3 fixpoint to expand the 25-region makearray (whole-box base fill + 24 per-tile seam contractions), the closed-form donor cube-frame maps, the tensor-product tent weights over the reference line, and the padded donor gathers. Pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:duo",
      "rule:duo_extend"
    ]
  },
  "models": {
    "DuoHaloRemapAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/duo/grid.esm",
          "bindings": {
            "N": 4
          }
        },
        {
          "ref": "../../../../grids/duo/rules/duo_extend.esm",
          "bindings": {
            "N": 4
          }
        }
      ],
      "variables": {
        "q": {
          "type": "variable",
          "units": "1",
          "shape": [
            "tile",
            "x",
            "y"
          ],
          "description": "Per-tile A-grid prognostic field (interior cells only), the remap input."
        },
        "qext": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tile",
            "x_cell_ext",
            "y_cell_ext"
          ],
          "description": "Halo-filled field via duo_extend: interior copied, the 3-layer W/E/S/N halo remapped from neighbour tiles by the bilinear donor-cube tent.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_extend",
            "bindings": {
              "q": "q",
              "center": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_cell_center",
                "bindings": {
                  "node": {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_node_cart",
                    "bindings": {
                      "refx": {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "duo_ref_x",
                        "bindings": {}
                      },
                      "refy": {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "duo_ref_y",
                        "bindings": {}
                      }
                    }
                  }
                }
              },
              "refx": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_ref_x",
                "bindings": {}
              },
              "refy": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_ref_y",
                "bindings": {}
              }
            }
          }
        }
      }
    }
  }
}
