{
  "esm": "1.2.0",
  "metadata": {
    "name": "growth_lr2m_tracer_D_bin_closed_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/sectional_volume_1d/rules/growth_lr2m_tracer_D_bin_closed: a minimal consuming model binding NCELL=2, NBIN=4, NTRACER=2 at the import edges, writing dm/dt = -D(lam*m, N, V, wrt: bin) for two volume-carried quantities m [cell, bin, tracer] with the section number N, section volume V and growth rate lam declared [cell, bin] as the trailing operands. The three-operand compound match must fire through the fixpoint (priority 10, where m: [cell, bin, tracer], lam, N, V: [cell, bin]) and lower to the rule's three-region makearray over [cell, bin, tracer] -- interior sections [2, 3] holding the imported sectional_lr2m_growth_tracer_interior stencil, sections 1 and 4 the closed-end regions -- and the number rule must NOT match it (arity keeps the two patterns disjoint; the number rule is not imported here, so a spurious match would surface as an unlowered D). V is the sum of the two tracers, the shape in which a sectional aerosol model carries its component volumes. The size grid is the grid's shared test grid mesh/mms_sections.esm at NBIN=4. The golden pins the byte-identical post-lowering AST, in the esm-spec 9.6.4 reference-preserving form, across bindings.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:sectional_volume_1d",
      "rule:growth_lr2m_tracer_D_bin_closed"
    ]
  },
  "models": {
    "GrowthLr2mTracerDBinClosedAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/sectional_volume_1d/rules/growth_lr2m_tracer_D_bin_closed.esm",
          "bindings": {"NCELL": 2, "NBIN": 4, "NTRACER": 2}
        },
        {
          "ref": "../../../../grids/sectional_volume_1d/mesh/mms_sections.esm",
          "bindings": {"NCELL": 2, "NBIN": 4, "NTRACER": 2}
        }
      ],
      "variables": {
        "m": {"type": "unknown", "units": "um^3/m^3", "shape": ["cell", "bin", "tracer"], "description": "Two volume-carried quantities per section."},
        "N": {"type": "unknown", "units": "1/m^3", "shape": ["cell", "bin"], "description": "Section number moment."},
        "V": {"type": "unknown", "units": "um^3/m^3", "shape": ["cell", "bin"], "description": "Section volume moment, the sum of the two tracers."},
        "lam": {"type": "unknown", "units": "1/s", "shape": ["cell", "bin"], "description": "Relative volume growth rate, uniform 0.1 1/s."},
        "vb": {"type": "unknown", "units": "um^3", "shape": ["bin_nodes"], "description": "Section edge volumes, mms_sections_vb at NBIN=4."}
      },
      "equations": [
        {"lhs": {"op": "ic", "args": ["m"]}, "rhs": 1.0},
        {"lhs": {"op": "ic", "args": ["N"]}, "rhs": 1.0},
        {
          "lhs": {"op": "D", "args": ["m"], "wrt": "t"},
          "rhs": {"op": "-", "args": [{"op": "D", "args": [{"op": "*", "args": ["lam", "m"]}, "N", "V"], "wrt": "bin"}]}
        },
        {"lhs": {"op": "D", "args": ["N"], "wrt": "t"}, "rhs": 0.0},
        {
          "lhs": "V",
          "rhs": {"op": "faq", "output_idx": ["c", "j"], "reduce": "+", "args": ["m"],
                  "ranges": {"c": {"from": "cell"}, "j": {"from": "bin"}, "s": {"from": "tracer"}},
                  "expr": {"op": "index", "args": ["m", "c", "j", "s"]}}
        },
        {
          "lhs": "lam",
          "rhs": {"op": "faq", "output_idx": ["c", "j"], "args": [], "ranges": {"c": {"from": "cell"}, "j": {"from": "bin"}}, "expr": 0.1}
        },
        {"lhs": "vb", "rhs": {"op": "apply_expression_template", "args": [], "name": "mms_sections_vb", "bindings": {}}}
      ]
    }
  }
}
