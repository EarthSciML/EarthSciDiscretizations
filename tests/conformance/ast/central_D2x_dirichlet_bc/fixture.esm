{
  "esm": "0.8.0",
  "metadata": {
    "name": "central_D2x_dirichlet_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/cartesian_uniform_2d/rules/central_D2x_dirichlet_bc: a minimal consuming model binding NX=NY=4 at the import edge. The compound match D(D(u,x),x) fires (priority 10) through the section-9.6.3 fixpoint and lowers to the rule's makearray — interior columns [2,3] (all j) holding the imported 3-point x second-difference stencil aggregate, the i=1 and i=4 x-faces holding the mirror-ghost fixed-value one-sided second differences over the (1 x NY) strips carrying the free names gL, gR and dx — with all metaparameters folded. The model declares gL and gR as ordinary real parameters (gL homogeneous, gR a nonzero fixed value). x0=y0=0 and dx=dy=1/4; the dx/dy expressions are spelled with the literal 4 because the edge binding closes NX/NY before this document's scope (grids/cartesian_uniform_2d/grid.esm). The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:cartesian_uniform_2d", "rule:central_D2x_dirichlet_bc"]
  },
  "models": {
    "CentralD2xDirichletBcAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_2d/rules/central_D2x_dirichlet_bc.esm",
          "bindings": { "NX": 4, "NY": 4 }
        }
      ],
      "variables": {
        "u": { "type": "state", "units": "K", "shape": ["x", "y"], "description": "Temperature field over the 2-D [x, y] index sets." },
        "alpha": { "type": "parameter", "units": "m^2/s", "default": 0.01, "description": "Thermal diffusivity." },
        "gL": { "type": "parameter", "units": "K", "default": 0.0, "description": "Prescribed field value on the left x-wall x=x0 (the rule's Dirichlet free name). Zero default = homogeneous left wall." },
        "gR": { "type": "parameter", "units": "K", "default": 1.0, "description": "Prescribed field value on the right x-wall (the rule's Dirichlet free name), nonzero so the inhomogeneous face term appears in the expanded golden." },
        "x0": { "type": "parameter", "units": "m", "default": 0, "description": "Left x domain edge a = 0: the grid's x0 free name (consumer-supplied geometry contract)." },
        "y0": { "type": "parameter", "units": "m", "default": 0, "description": "Bottom y domain edge: the grid's y0 free name." },
        "dx": { "type": "observed", "units": "m", "expression": { "op": "/", "args": [1, 4] }, "description": "x-spacing 1/NX = 1/4, spelled with the literal 4: the import edge binds NX, closing it before this document's scope (grids/cartesian_uniform_2d/grid.esm contract)." },
        "dy": { "type": "observed", "units": "m", "expression": { "op": "/", "args": [1, 4] }, "description": "y-spacing 1/NY = 1/4, spelled with the literal 4: the import edge binds NY." }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": 0.0
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "*",
            "args": [
              "alpha",
              { "op": "D", "args": [ { "op": "D", "args": ["u"], "wrt": "x" } ], "wrt": "x" }
            ]
          }
        }
      ]
    }
  }
}
