{
  "esm": "1.0.0",
  "metadata": {
    "name": "latlon3d_ppm_D_lat_zero_grad_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/latlon3d/rules/ppm_D_lat_zero_grad_bc, bound to NLON=8, NLAT=8, NLEV=4 at the import edge (NLAT>=7 so the PPM interior [4,NLAT-2] is non-empty). The match D(u,lat) on a [lon,lat,lev] field must lower, through the section-9.6.3 fixpoint, to the rule's rank-3 six-region makearray — interior conservative PPM meridional flux-difference (F_{j+1/2}-F_{j-1/2})/dlat_deg over [1,8] x [4,6] x [1,4] with the CW84-limited semi-discrete upwind edge flux (ppm_face_value/ppm_limit_right/ppm_flux inlined), plus the five explicit zero-gradient boundary slab rows j=1,2,3,7,8 — with zero apply_expression_template nodes, all metaparameters folded, and the consumer-supplied spacing surviving as the free name dlat_deg. The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:latlon3d", "rule:ppm_D_lat_zero_grad_bc"]
  },
  "models": {
    "Latlon3dPpmDLatZeroGradAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/latlon3d/rules/ppm_D_lat_zero_grad_bc.esm",
          "bindings": { "NLON": 8, "NLAT": 8, "NLEV": 4 }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": ["lon", "lat", "lev"],
          "description": "Field over the lon x lat x lev index sets."
        },
        "dlat_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 30,
          "description": "The grid's dlat_deg free name (inherited consumer-supplied geometry contract): 180/(NLAT-1) spelled as a placeholder literal because NLAT is closed at the import edge; its value does not affect the lowered AST structure (dlat_deg survives as a free name)."
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": 0
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "-",
            "args": [ { "op": "D", "args": ["u"], "wrt": "lat" } ]
          }
        }
      ]
    }
  }
}
