{
  "esm": "1.0.0",
  "metadata": {
    "name": "weno5_D_inflow_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/cartesian_uniform_1d/rules/weno5_D_inflow_bc: a minimal consuming model binding N=8 at the import edge. The plain match D(u,x) fires at priority 10 and lowers, through the section-9.6.3 fixpoint (with the weno5_D_interior / weno5_recon / weno3_recon body-reference templates inlined at load per esm-spec 9.7.3), to the rule's makearray -- interior [4,6] holding the conservative WENO5-Z flux-difference aggregate (hatF_{i+1/2}-hatF_{i-1/2})/dx over the six-cell support, the three inflow-wall faces i=1,2,3 (WENO3 reconstruction with the free name gL in the upstream ghost slots and hatF_{1/2}=gL), and the two outflow-wall faces i=7,8 (WENO3 with the zeroth-order extrapolation ghost u[8]) -- with all metaparameters folded, zero apply_expression_template nodes, zero unlowered rewrite-target ops (the spatial D is gone), and the free names dx and gL surviving in the expanded body (the grid's consumer-supplied geometry contract and the rule's inflow free name). The model declares gL as an ordinary real parameter (default 0). It fulfills the grid contract with x0 = 0 and dx = 1/8; the dx expression is spelled with the literal 8 because the edge binding closes N before it reaches this document's scope (grids/cartesian_uniform_1d/grid.esm). N=8 is the smallest size that keeps the six makearray regions disjoint ({1,2,3}, [4,6], {7,8} tile [1,8]). The expanded golden is large (the WENO5-Z reconstruction is repeated per face) and is pinned by sha256 digest above the 64 KiB threshold, exactly like weno5_D_periodic.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:cartesian_uniform_1d",
      "rule:weno5_D_inflow_bc"
    ]
  },
  "models": {
    "Weno5DInflowBcAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_1d/rules/weno5_D_inflow_bc.esm",
          "bindings": {
            "N": 8
          }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "kg/m^3",
          "shape": [
            "x"
          ],
          "description": "Advected tracer field over the x index set."
        },
        "c": {
          "type": "parameter",
          "units": "m/s",
          "default": 1.0,
          "description": "Constant transport speed (non-negative; the WENO5 upwind reconstruction assumes flow in +x, inflow at the left wall)."
        },
        "gL": {
          "type": "parameter",
          "units": "kg/m^3",
          "default": 0.0,
          "description": "Inflow value carried into the domain at the left wall x=x0 (the rule's inflow free name). Zero default = zero-inflow case; the free name gL appears verbatim in the expanded golden regardless of its numeric default."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left domain edge a = 0: the grid's x0 free name (consumer-supplied geometry contract)."
        },
        "dx": {
          "type": "unknown",
          "units": "m",
          "description": "Grid spacing 1/N = 1/8, spelled with the literal 8: the import edge binds N, closing it before this document's scope (grids/cartesian_uniform_1d/grid.esm contract)."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  "c"
                ]
              },
              {
                "op": "D",
                "args": [
                  "u"
                ],
                "wrt": "x"
              }
            ]
          }
        },
        {
          "lhs": "dx",
          "rhs": {
            "op": "/",
            "args": [
              1,
              8
            ]
          }
        }
      ]
    }
  }
}
