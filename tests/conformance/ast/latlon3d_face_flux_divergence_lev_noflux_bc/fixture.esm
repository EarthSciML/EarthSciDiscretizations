{
  "esm": "1.0.0",
  "metadata": {
    "name": "latlon3d_face_flux_divergence_lev_noflux_bc",
    "description": "AST fixture for the face-staggered flux divergence rule (the continuity half of the CWC transport pair). Carries BOTH a cell-centred state and a face-staggered flux, and BOTH the plain-D lev rule and the face-divergence rule, so the golden pins that the esm-spec 9.6.1 shape constraint -- not priority -- is what routes each derivative to its own rule.",
    "license": "MIT"
  },
  "metaparameters": {
    "NLEV": {
      "type": "integer",
      "default": 6,
      "description": "Number of vertical cells (levels), closed to 6 for this fixture. Declared as this document's own metaparameter and passed down to the imported rule as the edge binding value, because esm-spec 9.7.6 binding site 1 has bindings flow DOWN only, so a name closed at an import edge is consumed by the imported subtree and does not re-enter this document's scope. The bare NLEV in the pe equation therefore resolves to this declaration, and the value folds when this document closes."
    }
  },
  "models": {
    "Latlon3dFaceFluxDivergenceLevNofluxAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/latlon3d/rules/face_flux_divergence_lev_noflux_bc.esm",
          "bindings": {
            "NLON": 8,
            "NLAT": 5,
            "NLEV": "NLEV"
          }
        },
        {
          "ref": "../../../../grids/latlon3d/rules/central_D_lev_zero_grad_bc.esm",
          "bindings": {
            "NLON": 8,
            "NLAT": 5,
            "NLEV": "NLEV"
          }
        }
      ],
      "variables": {
        "m": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Air mass per unit area (cell means)."
        },
        "pe": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev_nodes"
          ],
          "description": "Level-edge coordinate; pe[1] = 0 (ground), pe[NLEV+1] = 1 (model top). Stretched (0.6 s + 0.4 s^2, s = (kn-1)/NLEV) so the vertical mesh is genuinely non-uniform and cells are thin at the ground. Aggregate index `kn`, distinct from an operator's `k` (observeds are inlined non-hygienically)."
        },
        "dz": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "Layer thicknesses dz[k] = pe[k+1] - pe[k], from the grid's lev_thickness template (aggregate index `gk`). Both the continuity divergence and the tracer flux divergence divide by THIS array, which is one of the three things the free-stream bit-exactness argument depends on (same faces, same thicknesses, same wall omissions)."
        },
        "zc": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "Cell (level) centres from the grid's lev_center template. Read by central_D_lev_zero_grad_bc, the cell-centred lev rule the fixture carries alongside the face-divergence rule so the golden pins that the two coexist; the face-divergence rule itself never reads zc (a flux divergence needs thicknesses, not centres)."
        },
        "M": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev_nodes"
          ],
          "description": "Face air-mass flux on the NLEV+1 face axis; vanishes at both walls and reverses sign at mid-column."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "m"
            ]
          },
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "i",
              "j",
              "k"
            ],
            "args": [],
            "ranges": {
              "i": {
                "from": "lon"
              },
              "j": {
                "from": "lat"
              },
              "k": {
                "from": "lev"
              }
            },
            "expr": 1.0
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "m"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "-",
                "args": [
                  {
                    "op": "D",
                    "args": [
                      "M"
                    ],
                    "wrt": "lev"
                  }
                ]
              },
              {
                "op": "D",
                "args": [
                  "m"
                ],
                "wrt": "lev"
              }
            ]
          }
        },
        {
          "lhs": "pe",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "kn"
            ],
            "args": [],
            "ranges": {
              "kn": {
                "from": "lev_nodes"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "*",
                  "args": [
                    0.6,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        "NLEV"
                      ]
                    }
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    0.4,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        "NLEV"
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        "NLEV"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "dz",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lev_thickness",
            "bindings": {
              "pe": "pe"
            }
          }
        },
        {
          "lhs": "zc",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lev_center",
            "bindings": {
              "pe": "pe"
            }
          }
        },
        {
          "lhs": "M",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "iw",
              "jw",
              "kw"
            ],
            "args": [
              "pe"
            ],
            "ranges": {
              "iw": {
                "from": "lon"
              },
              "jw": {
                "from": "lat"
              },
              "kw": {
                "from": "lev_nodes"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "*",
                  "args": [
                    4.0,
                    {
                      "op": "index",
                      "args": [
                        "pe",
                        "kw"
                      ]
                    },
                    {
                      "op": "-",
                      "args": [
                        1,
                        {
                          "op": "index",
                          "args": [
                            "pe",
                            "kw"
                          ]
                        }
                      ]
                    },
                    {
                      "op": "-",
                      "args": [
                        1,
                        {
                          "op": "*",
                          "args": [
                            2,
                            {
                              "op": "index",
                              "args": [
                                "pe",
                                "kw"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    1,
                    {
                      "op": "*",
                      "args": [
                        0.25,
                        {
                          "op": "cos",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                6.283185307179586,
                                {
                                  "op": "/",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "iw",
                                        0.5
                                      ]
                                    },
                                    8
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    1,
                    {
                      "op": "*",
                      "args": [
                        0.2,
                        {
                          "op": "sin",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                3.141592653589793,
                                {
                                  "op": "/",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "jw",
                                        1
                                      ]
                                    },
                                    4
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
