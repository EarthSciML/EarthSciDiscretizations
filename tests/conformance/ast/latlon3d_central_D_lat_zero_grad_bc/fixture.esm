{
  "esm": "0.8.0",
  "metadata": {
    "name": "latlon3d_central_D_lat_zero_grad_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/latlon3d/rules/central_D_lat_zero_grad_bc, bound to NLON=8, NLAT=5, NLEV=4 at the import edge. The match D(u,lat) on a [lon,lat,lev] field must lower, through the section-9.6.3 fixpoint, to the rule's rank-3 three-region makearray — interior rows [1,8] x [2,4] x [1,4] holding the imported centered stencil, and the j=1 and j=NLAT=5 zero-gradient pole slabs — with all metaparameters folded and dlat_deg (declared here as a parameter, 180/(5-1)=45) surviving as the consumer free name. The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:latlon3d", "rule:central_D_lat_zero_grad_bc"]
  },
  "models": {
    "Latlon3dCentralDLatZeroGradAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/latlon3d/rules/central_D_lat_zero_grad_bc.esm",
          "bindings": { "NLON": 8, "NLAT": 5, "NLEV": 4 }
        }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "1",
          "shape": ["lon", "lat", "lev"],
          "description": "Field over the lon x lat x lev index sets."
        },
        "dlat_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 45,
          "description": "The grid's dlat_deg free name: 180/(NLAT-1) = 45 spelled as a literal because NLAT is closed at the import edge."
        }
      },
      "equations": [
        { "lhs": { "op": "ic", "args": ["u"] }, "rhs": 0 },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": { "op": "-", "args": [ { "op": "D", "args": ["u"], "wrt": "lat" } ] }
        }
      ]
    }
  }
}
