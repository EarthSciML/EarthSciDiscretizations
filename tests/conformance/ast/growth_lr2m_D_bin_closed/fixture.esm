{
  "esm": "1.2.0",
  "metadata": {
    "name": "growth_lr2m_D_bin_closed_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/sectional_volume_1d/rules/growth_lr2m_D_bin_closed: a minimal consuming model binding NCELL=2, NBIN=4, NTRACER=1 at the import edges, writing dN/dt = -D(lam*N, V, wrt: bin) with the section number N, the section volume V and the relative growth rate lam all declared [cell, bin]. The two-operand compound match must fire through the fixpoint (priority 10, where lam, N, V: [cell, bin]) and lower to the rule's three-region makearray -- interior sections [2, 3] holding the imported sectional_lr2m_growth_number_interior stencil, section 1 and section 4 holding the closed-end regions that drop the outer edge flux (section 1: up-flux through its upper edge minus the down-flux of section 2; section 4: down-flux through its lower edge minus the up-flux of section 3). The model follows the grid's consumer-supplied-geometry contract: the 5-edge array vb comes from the grid's shared test grid mesh/mms_sections.esm (vb[kn] = 2^((kn-1)/4)), read by the rule's stencils by bare name. The golden pins the byte-identical post-lowering AST, in the esm-spec 9.6.4 reference-preserving form (stencil and mesh template references survive uninlined in the document's template registry), across bindings.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:sectional_volume_1d",
      "rule:growth_lr2m_D_bin_closed"
    ]
  },
  "models": {
    "GrowthLr2mDBinClosedAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/sectional_volume_1d/rules/growth_lr2m_D_bin_closed.esm",
          "bindings": {"NCELL": 2, "NBIN": 4, "NTRACER": 1}
        },
        {
          "ref": "../../../../grids/sectional_volume_1d/mesh/mms_sections.esm",
          "bindings": {"NCELL": 2, "NBIN": 4, "NTRACER": 1}
        }
      ],
      "variables": {
        "N": {"type": "unknown", "units": "1/m^3", "shape": ["cell", "bin"], "description": "Section number moment."},
        "V": {"type": "unknown", "units": "um^3/m^3", "shape": ["cell", "bin"], "description": "Section volume moment, 1.5 times the number (mean volume 1.5 um^3 in every section)."},
        "lam": {"type": "unknown", "units": "1/s", "shape": ["cell", "bin"], "description": "Relative volume growth rate, uniform 0.1 1/s."},
        "vb": {"type": "unknown", "units": "um^3", "shape": ["bin_nodes"], "description": "Section edge volumes, mms_sections_vb at NBIN=4."}
      },
      "equations": [
        {"lhs": {"op": "ic", "args": ["N"]}, "rhs": 1.0},
        {
          "lhs": {"op": "D", "args": ["N"], "wrt": "t"},
          "rhs": {"op": "-", "args": [{"op": "D", "args": [{"op": "*", "args": ["lam", "N"]}, "V"], "wrt": "bin"}]}
        },
        {
          "lhs": "V",
          "rhs": {"op": "faq", "output_idx": ["c", "j"], "args": [], "ranges": {"c": {"from": "cell"}, "j": {"from": "bin"}},
                  "expr": {"op": "*", "args": [1.5, {"op": "index", "args": ["N", "c", "j"]}]}}
        },
        {
          "lhs": "lam",
          "rhs": {"op": "faq", "output_idx": ["c", "j"], "args": [], "ranges": {"c": {"from": "cell"}, "j": {"from": "bin"}}, "expr": 0.1}
        },
        {"lhs": "vb", "rhs": {"op": "apply_expression_template", "args": [], "name": "mms_sections_vb", "bindings": {}}}
      ]
    }
  }
}
