          ],
          "description": "Consumer-supplied variable conductivity of shape [x], k_gi = 1 + 0.5 cos(2 pi x_gi) at cell centers x_gi = (gi - 1/2)/8, spelled inline from literals and the edge-bound N=8. Bound by the rule's match as the coefficient k (the left factor of k*D(u,x)); read by the expanded stencil at the interior faces. The boundary faces prescribe the flux directly and read no wall conductivity. The aggregate loops over `gi`, distinct from the stencil's interior index `i`, per the keyed-factor convention (see the rule description)."
        },
        "qL": {
          "type": "parameter",
          "units": "K*m/s",
          "default": 0.0,
          "description": "Prescribed physical flux k du/dx at the left wall x=x0 (the rule's Neumann free name). Zero default = homogeneous (zero-flux) left wall."
        },
        "qR": {
          "type": "parameter",
          "units": "K*m/s",
          "default": 2.5,
          "description": "Prescribed physical flux k du/dx at the right wall (the rule's Neumann free name), nonzero so the inhomogeneous face term appears in the expanded golden."
        },
