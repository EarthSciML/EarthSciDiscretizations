{
  "esm": "0.8.0",
  "metadata": {
    "name": "upwind1_D_lon_periodic_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/latlon/rules/upwind1_D_lon_periodic, bound to NLON=8, NLAT=5 at the import edge. The match D(u,lon) must lower, through the section-9.6.3 fixpoint, to the rule's two-axis makearray — interior columns [2,8] x [1,5] holding the imported backward-difference stencil, the single wrap-face column i=1 holding the full-rank periodic gather aggregate (u[1,j]-u[8,j])/dlon_deg — with all metaparameters folded and the consumer-supplied spacing surviving as the free name dlon_deg (declared here as a parameter, 360/8 = 45, per the grid's keyed-factor contract). Unlike the centered central_D_lon_periodic fixture the interior spans all the way to i=8 and there is exactly one face column, because backward upwind lacks a neighbor only at i=1. The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:latlon", "rule:upwind1_D_lon_periodic"]
  },
  "models": {
    "Upwind1DLonPeriodicAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/latlon/rules/upwind1_D_lon_periodic.esm",
          "bindings": { "NLON": 8, "NLAT": 5 }
        }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "K",
          "shape": ["lon", "lat"],
          "description": "Field over the lon x lat index sets."
        },
        "dlon_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 45,
          "description": "The grid's dlon_deg free name (consumer-supplied geometry contract): 360/NLON = 45 spelled as a literal because NLON is closed at the import edge."
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": 0
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "-",
            "args": [ { "op": "D", "args": ["u"], "wrt": "lon" } ]
          }
        }
      ]
    }
  }
}
