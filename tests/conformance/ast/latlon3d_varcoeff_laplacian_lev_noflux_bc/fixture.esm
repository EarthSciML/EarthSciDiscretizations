{
  "esm": "1.0.0",
  "metadata": {
    "name": "latlon3d_varcoeff_laplacian_lev_noflux_bc",
    "description": "AST conformance fixture for grids/latlon3d/rules/varcoeff_laplacian_lev_noflux_bc.esm. Minimal driver: one state field, the geometry observeds the rule's stencils read as free names, and a single equation carrying the conservative compound D(kz * D(u,lev), lev) that the rule matches. ic = 0 (the AST golden pins STRUCTURE, not values)."
  },
  "metaparameters": {
    "NLEV": {
      "type": "integer",
      "default": 6,
      "description": "Number of vertical cells (levels), closed to 6 for this fixture. Declared as this document's own metaparameter and passed down to the imported rule as the edge binding value, because esm-spec 9.7.6 binding site 1 has bindings flow DOWN only, so a name closed at an import edge is consumed by the imported subtree and does not re-enter this document's scope. The bare NLEV in the pe equation therefore resolves to this declaration, and the value folds when this document closes."
    }
  },
  "models": {
    "Latlon3dVarcoeffLaplacianLevNofluxAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/latlon3d/rules/varcoeff_laplacian_lev_noflux_bc.esm",
          "bindings": {
            "NLON": 8,
            "NLAT": 5,
            "NLEV": "NLEV"
          }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Vertically mixed tracer."
        },
        "pe": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev_nodes"
          ],
          "description": "Level-edge coordinates of the quadratic-stretch vertical mesh, pe[kn] = 0.6 s + 0.4 s^2 with s = (kn-1)/NLEV, over node kn = 1..NLEV+1 (pe[1] = 0 at the ground, pe[NLEV+1] = 1 at the model top; monotone increasing since dpe/ds = 0.6 + 0.8 s > 0). Cells are THIN near the surface and thicken upward, which is the physically right stretch for a boundary-layer-resolving column. Identical to the mesh of problems/latlon3d_advection_vertical_ppm, so the advection and diffusion operators are exercised on the same vertical grid. HYGIENE: aggregates over the node index `kn` (not k), so inlined pe[k]/dz[k]/zc[k] reads do not capture a consuming vertical stencil's own aggregate index k."
        },
        "dz": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "Cell thicknesses dz[k] = pe[k+1] - pe[k], derived by the grid's lev_thickness template (which aggregates over the geometry index gk). This is the `dz` free name read by the diffusion rule's stencils."
        },
        "zc": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lev"
          ],
          "description": "Cell centres zc[k] = (pe[k] + pe[k+1])/2, derived by the grid's lev_center template (aggregating over the geometry index gk). Read here only to build the diffusivity kz and the manufactured forcing; the diffusion stencils themselves need only `dz`."
        },
        "kz": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev"
          ],
          "description": "Vertical turbulent diffusivity Kzz(z) = 0.5 (1 + 4 z (1 - z)), a parabolic boundary-layer mixing profile: it vanishes nowhere on [0,1] (range [0.5, 1.0]), peaks at mid-column and falls to 0.5 at the ground and the lid, which is the classic O'Brien/Troen-Mahrt shape of a well-mixed PBL. Horizontally uniform here (the vertical operator is what is under test), but declared with the full [lon,lat,lev] shape the rule's match requires so a real consumer can supply a genuinely 3-D Kzz. Bound by the rule's match as the coefficient kz -- the LEFT factor of kz * D(u, lev). HYGIENE: aggregates over (ik, jk, kk), all distinct from the operator's (i, j, k)."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "D",
            "args": [
              {
                "op": "*",
                "args": [
                  "kz",
                  {
                    "op": "D",
                    "args": [
                      "u"
                    ],
                    "wrt": "lev"
                  }
                ]
              }
            ],
            "wrt": "lev"
          }
        },
        {
          "lhs": "pe",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "kn"
            ],
            "args": [],
            "ranges": {
              "kn": {
                "from": "lev_nodes"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "*",
                  "args": [
                    0.6,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        "NLEV"
                      ]
                    }
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    0.4,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        "NLEV"
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        "NLEV"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "dz",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lev_thickness",
            "bindings": {
              "pe": "pe"
            }
          }
        },
        {
          "lhs": "zc",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "lev_center",
            "bindings": {
              "pe": "pe"
            }
          }
        },
        {
          "lhs": "kz",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "ik",
              "jk",
              "kk"
            ],
            "args": [
              "zc"
            ],
            "ranges": {
              "ik": {
                "from": "lon"
              },
              "jk": {
                "from": "lat"
              },
              "kk": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "*",
              "args": [
                0.5,
                {
                  "op": "+",
                  "args": [
                    1,
                    {
                      "op": "*",
                      "args": [
                        4,
                        {
                          "op": "index",
                          "args": [
                            "zc",
                            "kk"
                          ]
                        },
                        {
                          "op": "-",
                          "args": [
                            1,
                            {
                              "op": "index",
                              "args": [
                                "zc",
                                "kk"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
