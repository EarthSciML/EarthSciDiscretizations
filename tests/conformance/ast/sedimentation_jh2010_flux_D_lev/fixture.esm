{
  "esm": "1.2.0",
  "metadata": {
    "name": "sedimentation_jh2010_flux_D_lev_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/column_nonuniform_1d/rules/sedimentation_jh2010_flux_D_lev, the dt -> 0 limit of the Juang & Hong (2010) semi-Lagrangian fallout used by WRF WSM6. The same minimal consuming model as the donor-cell rule's fixture -- NLEV = 8 bound at the import edge, dq/dt = -D(W*q, wrt: lev) with q and the layer-centred downward velocity W both over [lev], the 9-interface quadratic-stretch ze from the shared fixture library mesh/mms_column.esm and the grid-derived zc, dz -- importing THIS rule instead, so the two fixtures differ only in what the compound lowers to. The compound match must fire through the fixpoint (priority 10, where q: [lev], W: [lev]) and lower to the rule's five-region makearray: layer 1 (the end-face flux through face 2 minus the donor flux through face 1), layer 2 (the first interior face flux minus the end-face flux), the imported interior stencil over [3,6], layer 7 (the lid face flux through face 8 minus the last interior face flux) and the top layer 8 (the lid face flux only). Surviving apply_expression_template nodes naming the face-flux templates (sedimentation_jh2010_face_flux, sedimentation_jh2010_end_face_flux, sedimentation_jh2010_lid_face_flux), the donor-cell rule's sedimentation_donor_flux_lev, the velocities (sedimentation_jh2010_face_velocity, sedimentation_jh2010_end_face_velocity), the reconstruction chain (sedimentation_jh2010_one_sided_slope, sedimentation_jh2010_unlimited_half_jump, sedimentation_jh2010_half_jump, sedimentation_jh2010_face_value, sedimentation_jh2010_top_face_value) and the mesh template mms_column_ze are resolved match-less leaves (esm-spec 9.6.4, the reference-preserving loader), not un-fired rules. NLEV = 8 >= 5 keeps the five regions distinct.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:column_nonuniform_1d",
      "rule:sedimentation_jh2010_flux_D_lev"
    ]
  },
  "models": {
    "SedimentationJh2010FluxDLevAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/column_nonuniform_1d/rules/sedimentation_jh2010_flux_D_lev.esm",
          "bindings": {
            "NLEV": 8
          }
        },
        {
          "ref": "../../../../grids/column_nonuniform_1d/mesh/mms_column.esm",
          "bindings": {
            "NLEV": 8
          }
        }
      ],
      "variables": {
        "q": {
          "type": "unknown",
          "units": "kg/m^3",
          "shape": [
            "lev"
          ],
          "description": "Falling density over the lev index set."
        },
        "W": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "lev"
          ],
          "description": "Layer-centred downward velocity -(1 + zc)."
        },
        "ze": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev_nodes"
          ],
          "description": "Interface coordinates of the quadratic-stretch test column, ze[kn] = 0.6 ((kn-1)/NLEV) + 0.4 ((kn-1)/NLEV)^2 for kn = 1..NLEV+1, taken from the grid's shared fixture library mesh/mms_column.esm (template mms_column_ze) with NLEV bound to 8 at the import edge: the single geometry input of the grid's edge-array contract."
        },
        "zc": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer centres, grid-derived by applying column_cell_center to ze."
        },
        "dz": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer thicknesses, grid-derived by applying column_cell_thickness to ze."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "q"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "q"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "D",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "W",
                      "q"
                    ]
                  }
                ],
                "wrt": "lev"
              }
            ]
          }
        },
        {
          "lhs": "W",
          "rhs": {
            "op": "faq",
            "output_idx": [
              "i"
            ],
            "args": [],
            "ranges": {
              "i": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "+",
                  "args": [
                    1.0,
                    {
                      "op": "index",
                      "args": [
                        "zc",
                        "i"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "ze",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "mms_column_ze",
            "bindings": {}
          }
        },
        {
          "lhs": "zc",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "column_cell_center",
            "bindings": {
              "ze": "ze"
            }
          }
        },
        {
          "lhs": "dz",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "column_cell_thickness",
            "bindings": {
              "ze": "ze"
            }
          }
        }
      ]
    }
  }
}
