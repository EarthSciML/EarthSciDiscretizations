{
  "esm": "1.0.0",
  "metadata": {
    "name": "sedimentation_jh2010_flux_D_lev_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/column_nonuniform_1d/rules/sedimentation_jh2010_flux_D_lev, the dt -> 0 limit of the Juang & Hong (2010) semi-Lagrangian fallout used by WRF WSM6. The same minimal consuming model as the donor-cell rule's fixture -- NLEV=8 bound at the import edge, dq/dt = -D(W*q, wrt: lev) with q and the layer-centred downward velocity W both over [lev], the 9-interface quadratic-stretch ze and the grid-derived zc, dz spelled with the literal 8 -- importing THIS rule instead, so the two fixtures differ only in what the compound lowers to. The compound match must fire through the fixpoint (priority 10, where q: [lev], W: [lev]) and lower to the rule's five-region makearray: layer 1 (face 1 donor flux, face 2 two-point velocity with the W == 0 override), layer 2, the imported interior stencil over [3,6], layer 7 (face 8 two-point velocity and the lid closure qp1 = 0, dzp1 = 0), and the top layer 8 (outflow through face 8 only). Surviving apply_expression_template nodes naming sedimentation_jh2010_face_velocity, sedimentation_jh2010_face_value, sedimentation_jh2010_top_face_value, sedimentation_jh2010_half_jump and sedimentation_jh2010_face_flux (the upwind-side interior face flux) are resolved match-less leaves (esm-spec 9.6.4, the reference-preserving loader), not un-fired rules. NLEV = 8 >= 5 keeps the five regions distinct.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:column_nonuniform_1d",
      "rule:sedimentation_jh2010_flux_D_lev"
    ]
  },
  "models": {
    "SedimentationJh2010FluxDLevAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/column_nonuniform_1d/rules/sedimentation_jh2010_flux_D_lev.esm",
          "bindings": {
            "NLEV": 8
          }
        }
      ],
      "variables": {
        "q": {
          "type": "unknown",
          "units": "kg/m^3",
          "shape": [
            "lev"
          ],
          "description": "Falling density over the lev index set."
        },
        "W": {
          "type": "unknown",
          "units": "m/s",
          "shape": [
            "lev"
          ],
          "description": "Layer-centred downward velocity -(1 + zc)."
        },
        "ze": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev_nodes"
          ],
          "description": "Interface coordinates of the quadratic-stretch column at NLEV=8, ze[kn] = 0.6 ((kn-1)/8) + 0.4 ((kn-1)/8)^2 for kn=1..9 (the single geometry input; the edge binding closes NLEV so spelled with the literal 8)."
        },
        "zc": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer centres, grid-derived by applying column_cell_center to ze."
        },
        "dz": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer thicknesses, grid-derived by applying column_cell_thickness to ze."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "q"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "q"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "D",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "W",
                      "q"
                    ]
                  }
                ],
                "wrt": "lev"
              }
            ]
          }
        },
        {
          "lhs": "W",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "i"
            ],
            "args": [],
            "ranges": {
              "i": {
                "from": "lev"
              }
            },
            "expr": {
              "op": "-",
              "args": [
                {
                  "op": "+",
                  "args": [
                    1.0,
                    {
                      "op": "index",
                      "args": [
                        "zc",
                        "i"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "ze",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "kn"
            ],
            "args": [],
            "ranges": {
              "kn": {
                "from": "lev_nodes"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "*",
                  "args": [
                    0.6,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        8
                      ]
                    }
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    0.4,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        8
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        8
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "zc",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "column_cell_center",
            "bindings": {
              "ze": "ze"
            }
          }
        },
        {
          "lhs": "dz",
          "rhs": {
