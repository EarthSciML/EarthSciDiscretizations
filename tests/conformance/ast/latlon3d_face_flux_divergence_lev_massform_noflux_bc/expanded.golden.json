                      "op": "*"
                    }
                  ],
                  "op": "sin"
                },
                {
                  "args": [
                    {
                      "args": [
                        {
                          "args": [
                            3.141592653589793,
                            180
                          ],
                          "op": "/"
                        },
                        {
                          "args": [
                            "phie",
                            "gja"
                          ],
                          "op": "index"
                        }
                      ],
                      "op": "*"
                    }
                  ],
                  "op": "sin"
                }
