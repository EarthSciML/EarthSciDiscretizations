{
  "esm": "1.0.0",
  "metadata": {
    "name": "varcoeff_face_laplacian_lev_flux_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/column_nonuniform_1d/rules/varcoeff_face_laplacian_lev_flux_bc: a minimal consuming model binding NLEV=8 at the import edge, writing du/dt = D(K*D(u, wrt: lev), wrt: lev) with the coefficient K declared on the interfaces (shape [lev_nodes]) and the two prescribed-flux free names kdudz_bot / kdudz_top as parameters. The compound match must fire through the fixpoint (priority 10, where u: [lev], K: [lev_nodes]) and lower to the rule's three-region makearray -- interior [2,7] holding the imported interface-coefficient flux-difference stencil aggregate, layer 1 and layer 8 holding the prescribed-flux faces. The model follows the grid's EDGE-ARRAY contract at NLEV=8: it supplies the 9-interface (lev_nodes) quadratic-stretch array ze and derives zc = column_cell_center(ze), dz = column_cell_thickness(ze), all spelled with the literal 8 because the edge binding closes NLEV. The golden pins the byte-identical post-lowering AST -- including the grid-derived geometry observeds -- across bindings.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:column_nonuniform_1d",
      "rule:varcoeff_face_laplacian_lev_flux_bc"
    ]
  },
  "models": {
    "VarcoeffFaceLaplacianLevAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/column_nonuniform_1d/rules/varcoeff_face_laplacian_lev_flux_bc.esm",
          "bindings": {
            "NLEV": 8
          }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "lev"
          ],
          "description": "Temperature field over the lev index set."
        },
        "K": {
          "type": "unknown",
          "units": "m^2/s",
          "shape": [
            "lev_nodes"
          ],
          "description": "Interface diffusivity 1 + ze."
        },
        "kdudz_bot": {
          "type": "parameter",
          "units": "K m/s",
          "default": 0.0,
          "description": "Prescribed K du/dz on the surface interface (the rule's free name)."
        },
        "kdudz_top": {
          "type": "parameter",
          "units": "K m/s",
          "default": 0.0,
          "description": "Prescribed K du/dz on the top interface (the rule's free name)."
        },
        "ze": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev_nodes"
          ],
          "description": "Interface coordinates of the quadratic-stretch column at NLEV=8, ze[kn] = 0.6 ((kn-1)/8) + 0.4 ((kn-1)/8)^2 for kn=1..9 (the single geometry input; the edge binding closes NLEV so spelled with the literal 8)."
        },
        "zc": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer centres, grid-derived by applying column_cell_center to ze."
        },
        "dz": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer thicknesses, grid-derived by applying column_cell_thickness to ze."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "D",
            "args": [
              {
                "op": "*",
                "args": [
                  "K",
                  {
                    "op": "D",
                    "args": [
                      "u"
                    ],
                    "wrt": "lev"
                  }
                ]
              }
            ],
            "wrt": "lev"
          }
        },
        {
          "lhs": "K",
          "rhs": {
            "op": "+",
            "args": [
              1.0,
              "ze"
            ]
          }
        },
        {
          "lhs": "ze",
          "rhs": {
            "op": "aggregate",
            "output_idx": [
              "kn"
            ],
            "args": [],
            "ranges": {
              "kn": {
                "from": "lev_nodes"
              }
            },
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "*",
                  "args": [
                    0.6,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        8
                      ]
                    }
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    0.4,
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        8
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "kn",
                            1
                          ]
                        },
                        8
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "lhs": "zc",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "column_cell_center",
            "bindings": {
              "ze": "ze"
            }
          }
        },
        {
          "lhs": "dz",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "column_cell_thickness",
            "bindings": {
              "ze": "ze"
            }
          }
        }
      ]
    }
  }
