{
  "esm": "0.8.0",
  "metadata": {
    "name": "duo_grid_geometry_ast_fixture",
    "description": "AST-expansion conformance fixture for the grids/duo (gnomonic cubed-sphere) geometry templates: a minimal consuming model importing grids/duo/grid.esm with N bound at the import edge, declaring four observeds that apply the geometry chain (duo_node_cart -> duo_cell_center -> duo_cell_area / duo_cos_alpha) so the section-9.6.3 fixpoint resolves the two imported scalar atoms (duo_spherical_angle, duo_tangent_cos), the duo_tile_map const application, the reference-line aggregates and the nested apply_expression_template tree. Pins the byte-identical post-lowering AST across bindings. The real-valued free names R_sphere, alpha_ref, R_ref (equiangular here) survive in the expanded bodies per the extent convention.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:duo",
      "rule:duo_grid_geometry"
    ]
  },
  "models": {
    "DuoGridGeometryAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/duo/grid.esm",
          "bindings": {
            "N": 4
          }
        }
      ],
      "variables": {
        "node_cart": {
          "type": "observed",
          "units": "m",
          "shape": [
            "tile",
            "x_nodes_ext",
            "y_nodes_ext",
            "space"
          ],
          "description": "Corner-node Cartesian positions, applying duo_node_cart with the equiangular reference lines.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_node_cart",
            "bindings": {
              "refx": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_ref_x",
                "bindings": {}
              },
              "refy": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_ref_y",
                "bindings": {}
              }
            }
          }
        },
        "cell_center": {
          "type": "observed",
          "units": "m",
          "shape": [
            "tile",
            "x_cell_ext",
            "y_cell_ext",
            "space"
          ],
          "description": "Cell-centre positions, applying duo_cell_center.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_cell_center",
            "bindings": {
              "node": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_node_cart",
                "bindings": {
                  "refx": {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_ref_x",
                    "bindings": {}
                  },
                  "refy": {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_ref_y",
                    "bindings": {}
                  }
                }
              }
            }
          }
        },
        "cell_area": {
          "type": "observed",
          "units": "m^2",
          "shape": [
            "tile",
            "x_cell_ext",
            "y_cell_ext"
          ],
          "description": "Cell areas via spherical excess, applying duo_cell_area.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_cell_area",
            "bindings": {
              "node": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_node_cart",
                "bindings": {
                  "refx": {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_ref_x",
                    "bindings": {}
                  },
                  "refy": {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_ref_y",
                    "bindings": {}
                  }
                }
              }
            }
          }
        },
        "cos_alpha": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tile",
            "x_metric",
            "y_metric"
          ],
          "description": "Metric cos(alpha), applying duo_cos_alpha.",
          "expression": {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_cos_alpha",
            "bindings": {
              "center": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_cell_center",
                "bindings": {
                  "node": {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_node_cart",
                    "bindings": {
                      "refx": {
                        "op": "apply_expression_template",
                        "args": [],
