{
  "esm": "0.8.0",
  "metadata": {
    "name": "central_D2_lat_zero_grad_bc_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/latlon/rules/central_D2_lat_zero_grad_bc, bound to NLON=8, NLAT=5 at the import edge. The compound match D(D(u,lat),lat) must fire through the section-9.6.3 fixpoint (priority 10, before any plain-D rule could lower the inner meridional derivative) and lower to the rule's two-axis makearray — interior rows [1,8] x [2,4] holding the imported 3-point centered second-difference stencil, zero-gradient pole rows j=1 and j=5 holding the full-rank ghost-eliminated one-sided aggregates — with all metaparameters folded and the consumer-supplied spacing surviving as the free name dlat_deg (declared here as a parameter, 180/(5-1) = 45, per the grid's keyed-factor contract). The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:latlon", "rule:central_D2_lat_zero_grad_bc"]
  },
  "models": {
    "CentralD2LatZeroGradBcAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/latlon/rules/central_D2_lat_zero_grad_bc.esm",
          "bindings": { "NLON": 8, "NLAT": 5 }
        }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "K",
          "shape": ["lon", "lat"],
          "description": "Field over the lon x lat index sets."
        },
        "dlat_deg": {
          "type": "parameter",
          "units": "deg",
          "default": 45,
          "description": "The grid's dlat_deg free name (consumer-supplied geometry contract): 180/(NLAT-1) = 45 spelled as a literal because NLAT is closed at the import edge."
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": 0
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "D",
            "args": [ { "op": "D", "args": ["u"], "wrt": "lat" } ],
            "wrt": "lat"
          }
        }
      ]
    }
  }
}
