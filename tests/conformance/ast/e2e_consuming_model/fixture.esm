{
  "esm": "0.8.0",
  "metadata": {
    "name": "e2e_consuming_model_fixture",
    "description": "End-to-end consuming-model conformance fixture (the bootstrap plan's final gate): a scratch heat-equation model importing grids/cartesian_uniform_1d/rules/central_D2_zero_grad_bc.esm with the loader-visible edge binding N=64 — the library consumed exactly as a downstream model would consume it, at production resolution. Every binding must (a) resolve the import closure (rule -> stencil -> grid), fold N=64 through index sets, regions, and ranges, fire the compound D(D(u,x),x) match through the section-9.6.3 fixpoint, lower the coordinate-expression ic and the section-6.6.5 test references written over the grid's x_coord geometry template, and (b) emit byte-identical canonical post-lowering bytes in which the consumer-supplied free names x0 and dx SURVIVE as bare references — this case is the cross-binding byte pin of the grid's consumer-supplied geometry contract (grids/cartesian_uniform_1d/grid.esm): x_coord inlines to x0 + (i - 1/2) dx and the rule body carries 1/(dx dx), both resolving to the model's own x0/dx variables (declared here as the contract requires: x0 = 0, dx = 1/64 spelled with the literal 64 because the edge binding closes N before this document's scope). This fixture is lowering-only: the runtime-executable authoring of the same physics — where ic and 6.6.5 references must spell the index-to-coordinate conversion with load-foldable scalars because build-time cellwise evaluation is scope-free — is problems/heat_1d_zero_grad.esm, executed by the simulation and convergence categories. The golden is generated by the Julia reference runner only (scripts/regenerate-goldens.sh) and compared bytewise by the other bindings.",
    "license": "MIT",
    "tags": ["conformance", "ast", "e2e", "grid:cartesian_uniform_1d", "rule:central_D2_zero_grad_bc"]
  },
  "models": {
    "HeatE2e": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/cartesian_uniform_1d/rules/central_D2_zero_grad_bc.esm",
          "bindings": { "N": 64 }
        }
      ],
      "variables": {
        "u": {
          "type": "state",
          "units": "K",
          "shape": ["x"],
          "description": "Temperature field over the x index set."
        },
        "alpha": {
          "type": "parameter",
          "units": "m^2/s",
          "default": 0.01,
          "description": "Thermal diffusivity."
        },
        "x0": {
          "type": "parameter",
          "units": "m",
          "default": 0,
          "description": "Left domain edge a = 0: the grid's x0 free name (consumer-supplied geometry contract)."
        },
        "dx": {
          "type": "observed",
          "units": "m",
          "expression": { "op": "/", "args": [1, 64] },
          "description": "Grid spacing 1/N = 1/64, spelled with the literal 64: the import edge binds N, closing it before this document's scope (grids/cartesian_uniform_1d/grid.esm contract)."
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": {
            "op": "cos",
            "args": [
              {
                "op": "*",
                "args": [
                  3.141592653589793,
                  { "op": "apply_expression_template", "args": [], "name": "x_coord", "bindings": {} }
                ]
              }
            ]
          }
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": {
            "op": "*",
            "args": [
              "alpha",
              { "op": "D", "args": [ { "op": "D", "args": ["u"], "wrt": "x" } ], "wrt": "x" }
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "mms_neumann_decay_n64",
          "description": "The problems/heat_1d_zero_grad.esm manufactured solution at the N=64 edge binding: u(x,t) = exp(-alpha pi^2 t) cos(pi x) with alpha = 0.01 satisfies u_t = alpha u_xx exactly and u_x = 0 at both boundaries (derivation in the problem file). The t=0 assertion pins the coordinate-expression ic wiring; the t=0.1 assertion bounds the relative L2 discretization error, whose leading term (pi dx)^2/12 is approximately 2e-6 at N=64, well inside the 1e-4 bound.",
          "time_span": { "start": 0.0, "end": 0.1 },
          "assertions": [
            {
              "variable": "u",
              "time": 0.0,
              "expected": 0.0,
              "tolerance": { "abs": 1e-9 },
              "reduce": "L2_error",
              "reference": {
                "op": "cos",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      3.141592653589793,
                      { "op": "apply_expression_template", "args": [], "name": "x_coord", "bindings": {} }
                    ]
                  }
                ]
              }
            },
            {
              "variable": "u",
              "time": 0.1,
              "expected": 0.0,
              "tolerance": { "abs": 1e-4 },
              "reduce": "L2_error",
              "reference": {
                "op": "*",
                "args": [
                  {
                    "op": "exp",
                    "args": [
                      { "op": "*", "args": [-0.01, 9.869604401089358, 0.1] }
                    ]
                  },
                  {
                    "op": "cos",
                    "args": [
                      {
                        "op": "*",
                        "args": [
                          3.141592653589793,
                          { "op": "apply_expression_template", "args": [], "name": "x_coord", "bindings": {} }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
