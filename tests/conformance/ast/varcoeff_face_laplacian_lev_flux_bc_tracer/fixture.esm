{
  "esm": "2.3.0",
  "metadata": {
    "name": "varcoeff_face_laplacian_lev_flux_bc_tracer_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/column_nonuniform_1d_tracer/rules/varcoeff_face_laplacian_lev_flux_bc_tracer, and for its disjointness from the 1-D rule grids/column_nonuniform_1d/rules/varcoeff_face_laplacian_lev_flux_bc: one model imports BOTH rules (the 1-D rule FIRST, so it would win the equal-priority tie on any node both matched) and writes the same compound D(K*D(., wrt: lev), wrt: lev) for two states sharing the interface coefficient K (shape [lev_nodes]): u shaped [lev, tracer] with the per-tracer prescribed fluxes kdudz_bot / kdudz_top as [tracer] parameters, and w shaped [lev]. NLEV=8 and NTRACER=3 are bound at the import edges. The 1-D rule's scalar free names kdudz_bot / kdudz_top are rebound at its import edge to w_kdudz_bot / w_kdudz_top (esm-spec 9.7.7 rebind), which is how a consumer mixing both field shapes keeps the two rules' free names apart. Each compound must fire exactly one rule through the fixpoint (priority 10): du/dt only the tracer rule (where u: [lev, tracer]; the 1-D rule's where u: [lev] excludes it), dw/dt only the 1-D rule (the tracer rule's where excludes it). The u equation lowers to the tracer rule's body, a reference to the tracer grid's three-region layout rules/varcoeff_face_laplacian_lev_tracer_frame over [lev, tracer] (interior [2,7] x [1,3] holding the per-tracer interior stencil, layers 1 and 8 the per-tracer boundary layers as faqs over the tracer axis with an explicit singleton lev output index) with its face-flux parameters bound to kdudz_bot / kdudz_top; every interior flux is interface_flux_K_lev_tracer, an application of the column grid's two-point law interface_flux_K_two_point. The w equation lowers to the 1-D rule's three-region makearray reading w_kdudz_bot / w_kdudz_top. Geometry follows the column grid's edge-array contract exactly as in the 1-D fixture: ze from mesh/mms_column.esm (NLEV=8), zc and dz by column_cell_center / column_cell_thickness from grids/column_nonuniform_1d/grid.esm, shared by both states. The golden pins the byte-identical post-lowering AST across bindings.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:column_nonuniform_1d_tracer",
      "rule:varcoeff_face_laplacian_lev_flux_bc_tracer"
    ]
  },
  "models": {
    "VarcoeffFaceLaplacianLevTracerAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/column_nonuniform_1d/rules/varcoeff_face_laplacian_lev_flux_bc.esm",
          "bindings": {
            "NLEV": 8
          },
          "rebind": {
            "kdudz_bot": "w_kdudz_bot",
            "kdudz_top": "w_kdudz_top"
          }
        },
        {
          "ref": "../../../../grids/column_nonuniform_1d_tracer/rules/varcoeff_face_laplacian_lev_flux_bc_tracer.esm",
          "bindings": {
            "NLEV": 8,
            "NTRACER": 3
          }
        },
        {
          "ref": "../../../../grids/column_nonuniform_1d/mesh/mms_column.esm",
          "bindings": {
            "NLEV": 8
          }
        },
        {
          "ref": "../../../../grids/column_nonuniform_1d/grid.esm",
          "only": [
            "column_cell_center",
            "column_cell_thickness"
          ],
          "bindings": {
            "NLEV": 8
          }
        }
      ],
      "variables": {
        "u": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "lev",
            "tracer"
          ],
          "description": "Three tracers over the lev index set."
        },
        "w": {
          "type": "unknown",
          "units": "K",
          "shape": [
            "lev"
          ],
          "description": "A single [lev] field beside the tracers, lowered by the 1-D rule."
        },
        "w_kdudz_bot": {
          "type": "parameter",
          "units": "K m/s",
          "default": 0.0,
          "description": "Prescribed K dw/dz on the surface interface: the 1-D rule's free name kdudz_bot, rebound at its import edge so it does not collide with the tracer rule's [tracer] kdudz_bot."
        },
        "w_kdudz_top": {
          "type": "parameter",
          "units": "K m/s",
          "default": 0.0,
          "description": "Prescribed K dw/dz on the top interface: the 1-D rule's free name kdudz_top, rebound at its import edge."
        },
        "K": {
          "type": "unknown",
          "units": "m^2/s",
          "shape": [
            "lev_nodes"
          ],
          "description": "Interface diffusivity 1 + ze."
        },
        "kdudz_bot": {
          "type": "parameter",
          "units": "K m/s",
          "default": 0.0,
          "description": "Per-tracer prescribed K du/dz on the surface interface (the rule's free name).",
          "shape": [
            "tracer"
          ]
        },
        "kdudz_top": {
          "type": "parameter",
          "units": "K m/s",
          "default": 0.0,
          "description": "Per-tracer prescribed K du/dz on the top interface (the rule's free name).",
          "shape": [
            "tracer"
          ]
        },
        "ze": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev_nodes"
          ],
          "description": "Interface coordinates of the quadratic-stretch column at NLEV=8, ze[kn] = 0.6 ((kn-1)/8) + 0.4 ((kn-1)/8)^2 for kn=1..9: the grid's shared MMS test column mms_column_ze (mesh/mms_column.esm), bound at NLEV=8 at its import edge."
        },
        "zc": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer centres, grid-derived by applying column_cell_center to ze."
        },
        "dz": {
          "type": "unknown",
          "units": "m",
          "shape": [
            "lev"
          ],
          "description": "Layer thicknesses, grid-derived by applying column_cell_thickness to ze."
        }
      },
      "equations": [
        {
          "lhs": {
            "op": "ic",
            "args": [
              "u"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "w"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "w"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "D",
            "args": [
              {
                "op": "*",
                "args": [
                  "K",
                  {
                    "op": "D",
                    "args": [
                      "w"
                    ],
                    "wrt": "lev"
                  }
                ]
              }
            ],
            "wrt": "lev"
          }
        },
        {
          "lhs": {
            "op": "D",
            "args": [
              "u"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "D",
            "args": [
              {
                "op": "*",
                "args": [
                  "K",
                  {
                    "op": "D",
                    "args": [
                      "u"
                    ],
                    "wrt": "lev"
                  }
                ]
              }
            ],
            "wrt": "lev"
          }
        },
        {
          "lhs": "K",
          "rhs": {
            "op": "+",
            "args": [
              1.0,
              "ze"
            ]
          }
        },
        {
          "lhs": "ze",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "mms_column_ze",
            "bindings": {}
          }
        },
        {
          "lhs": "zc",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "column_cell_center",
            "bindings": {
              "ze": "ze"
            }
          }
        },
        {
          "lhs": "dz",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "column_cell_thickness",
            "bindings": {
              "ze": "ze"
            }
          }
        }
      ]
    }
  }
}
