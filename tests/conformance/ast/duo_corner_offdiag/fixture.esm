{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_corner_offdiag_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/duo/rules/duo_corner_offdiag.esm at N=4: a minimal model importing grids/duo/grid.esm and the corner rule, declaring a per-tile A-grid field q[tile,x,y] and an observed q_corner[tile,x_cell_ext,y_cell_ext] that applies the rule with center bound to the duo_cell_center geometry chain (R_sphere left symbolic). Forces expansion of the 4 per-corner block aggregates, the ifelse direction selection, and the barycentric-Lagrange weights via the shared duo_arc_length atom. Pins the byte-identical post-lowering AST.",
    "license": "MIT",
    "tags": [
      "conformance",
      "ast",
      "grid:duo",
      "rule:duo_corner_offdiag"
    ]
  },
  "models": {
    "DuoCornerOffdiagAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/duo/grid.esm",
          "bindings": {
            "N": 4
          }
        },
        {
          "ref": "../../../../grids/duo/rules/duo_corner_offdiag.esm",
          "bindings": {
            "N": 4
          }
        }
      ],
      "variables": {
        "q": {
          "type": "parameter",
          "units": "1",
          "shape": [
            "tile",
            "x",
            "y"
          ],
          "description": "Per-tile A-grid field (interior cells), the corner-fill input."
        },
        "q_corner": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tile",
            "x_cell_ext",
            "y_cell_ext"
          ],
          "description": "Applies duo_corner_offdiag, binding center to the duo_cell_center geometry chain."
        }
      },
      "equations": [
        {
          "lhs": "q_corner",
          "rhs": {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_corner_offdiag",
            "bindings": {
              "q": "q",
              "center": {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_cell_center",
                "bindings": {
                  "node": {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_node_cart",
                    "bindings": {
                      "refx": {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "duo_ref_x",
                        "bindings": {}
                      },
                      "refy": {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "duo_ref_y",
                        "bindings": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
