{
  "esm": "0.8.0",
  "metadata": {
    "name": "fv_gradient_edge_ast_fixture",
    "description": "AST-expansion conformance fixture for grids/mpas/rules/fv_gradient_edge: a minimal consuming model on the icosahedral level-0 mesh (metaparameters bound to NCELLS=12, NEDGES=30, NVERTICES=20, MAXEDGES=5 at the import edge). The single spatial operator grad(phi) must lower, through the section-9.6.3 fixpoint, to the rule's edge-normal finite-volume aggregate with all metaparameters folded — the golden pins the byte-identical post-lowering AST across bindings. The cell scalar is pure index arithmetic (phi(i) = i) so the fixture carries no data beyond the mesh subsystem; the mesh's const arrays enter the expanded AST only through the bare-name observed aliases (cellsOnEdge, dcEdge) that satisfy the grid's keyed-factor contract — the two factors the gradient stencil gathers, unlike the divergence rule which also needs edgeSignOnCell/edgesOnCell/areaCell.",
    "license": "MIT",
    "tags": ["conformance", "ast", "grid:mpas", "rule:fv_gradient_edge"]
  },
  "models": {
    "FvGradientEdgeAst": {
      "expression_template_imports": [
        {
          "ref": "../../../../grids/mpas/rules/fv_gradient_edge.esm",
          "bindings": { "NCELLS": 12, "NEDGES": 30, "NVERTICES": 20, "MAXEDGES": 5 }
        }
      ],
      "subsystems": {
        "mesh": { "ref": "../../../../grids/mpas/mesh/level0.esm" }
      },
      "variables": {
        "u": {
          "type": "state",
          "units": "1",
          "shape": ["edges"],
          "description": "Edge-normal field driven by the gradient (the rule's output axis is edges)."
        },
        "cellsOnEdge": {
          "type": "observed",
          "shape": ["edges", "edge_ends"],
          "description": "Bare-name alias of mesh.cellsOnEdge: the two cells flanking each edge; the gradient's flanking-cell gather (positive normal cellsOnEdge[e][1] -> cellsOnEdge[e][2]).",
          "expression": "mesh.cellsOnEdge"
        },
        "dcEdge": {
          "type": "observed",
          "units": "rad",
          "shape": ["edges"],
          "description": "Bare-name alias of mesh.dcEdge: cell-center-to-center arc across each edge (the gradient denominator).",
          "expression": "mesh.dcEdge"
        },
        "phi": {
          "type": "observed",
          "units": "1",
          "shape": ["cells"],
          "description": "Data-free cell scalar phi(i) = i: enough structure to pin the flanking-cell gather pattern of the expanded gradient.",
          "expression": {
            "op": "aggregate",
            "args": [],
            "output_idx": ["i"],
            "ranges": { "i": { "from": "cells" } },
            "expr": "i"
          }
        }
      },
      "equations": [
        {
          "lhs": { "op": "ic", "args": ["u"] },
          "rhs": 0.0
        },
        {
          "lhs": { "op": "D", "args": ["u"], "wrt": "t" },
          "rhs": { "op": "-", "args": [{ "op": "grad", "args": ["phi"] }] }
        }
      ]
    }
  }
}
