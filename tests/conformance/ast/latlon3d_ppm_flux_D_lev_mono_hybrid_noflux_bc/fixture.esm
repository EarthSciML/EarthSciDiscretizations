          "type": "unknown",
          "units": "1",
          "shape": [
            "lon",
            "lat",
            "lev_nodes"
          ],
          "description": "Three-dimensional pressure-at-edges: a stretched vertical profile modulated in lon and lat so the derived thickness dp is genuinely rank-3 (terrain-following)."
        },
        "dp": {
          "type": "unknown",
          "units": "1",
          "shape": [
