        "src_bin": {
          "type": "state",
          "shape": [
            "src_cells"
          ],
          "description": "BROAD PHASE stage 2: integer bin key of each source cell, skolem('bin', floor(lon/4), floor(lat/4)) via the library template -- all nine cells land in bin (0, 0), so the candidate set is the full cross product (the degenerate-safe admissible binning; CONFORMANCE_SPEC 5.8.5 byte-identity still gates the key construction). Spelled per the upstream-supported value-invention pathway (ESS tests/coupling/cross_domain_coupling.esm rg_src_bin): a STATE variable assigned by a per-element skolem-aggregate equation -- the bindings' relational front-doors detect skolem maps on state equations, materialize the buffer once at build time, and drop the equation from the ODE."
        },
        "tgt_bin": {
          "type": "state",
          "shape": [
            "tgt_cells"
          ],
          "description": "BROAD PHASE stage 2: integer bin key of each target cell, identically quantized. STATE + skolem-aggregate equation, as src_bin."
        },
        "A_ij": {
          "type": "observed",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "CANDIDATE-GATED narrow phase: the overlap-area matrix through conservative_overlap_A_ij_gated (join.on [[src_bin, tgt_bin]]), manifold 'planar' bound at the invocation. Must equal A_ij_dense bit-for-bit (the ident_state gate) and the dense exemplar's golden numbers.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_A_ij_gated",
            "args": [],
            "bindings": {
              "src_poly": "src_poly",
              "tgt_poly": "tgt_poly",
              "manifold": "planar",
              "src_bin": "src_bin",
              "tgt_bin": "tgt_bin"
            }
          }
        },
        "A_j": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "CANDIDATE-GATED row normalization: the denominator broad-phases like the numerator (same join gate, same sliver filter), keeping partition-of-unity exact by construction. Expected 2.25 for every j.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_A_j_gated",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "src_bin": "src_bin",
              "tgt_bin": "tgt_bin",
              "atol": "atol"
            }
          }
        },
        "W_ij": {
          "type": "observed",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "CANDIDATE-GATED normalized weights (same join gate and filter as A_j). Expected the dense exemplar's exact rationals: corner 4/9, edge 2/9, center 1/9.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_W_ij_gated",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "A_j": "A_j",
              "src_bin": "src_bin",
              "tgt_bin": "tgt_bin",
              "atol": "atol"
            }
          }
        },
        "A_ij_dense": {
          "type": "observed",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "DENSE REFERENCE PATH: the ungated narrow phase on the same rings (the dense exemplar's spelling), computed side by side for the value-identity gate.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_A_ij",
            "args": [],
            "bindings": {
              "src_poly": "src_poly",
              "tgt_poly": "tgt_poly",
              "manifold": "planar"
            }
          }
        },
        "A_j_dense": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "DENSE REFERENCE PATH: the ungated filtered row-sum.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_A_j",
            "args": [],
            "bindings": {
              "A_ij": "A_ij_dense",
              "atol": "atol"
            }
          }
        },
        "W_ij_dense": {
          "type": "observed",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "DENSE REFERENCE PATH: the ungated normalized weights.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_W_ij",
            "args": [],
            "bindings": {
              "A_ij": "A_ij_dense",
              "A_j": "A_j_dense",
              "atol": "atol"
            }
          }
        },
        "ident_A": {
          "type": "observed",
          "units": "1",
          "description": "L1 residual of the gated vs dense overlap matrices: sum_{i,j} |A_ij - A_ij_dense|. Exactly 0.0 -- identical surviving sets, identical nonnegative terms.",
          "expression": {
            "op": "aggregate",
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [
              "A_ij",
              "A_ij_dense"
            ],
            "expr": {
              "op": "abs",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "A_ij",
                        "i",
                        "j"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "A_ij_dense",
                        "i",
                        "j"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "ident_Aj": {
          "type": "observed",
          "units": "1",
          "description": "L1 residual of the gated vs dense denominators: sum_j |A_j - A_j_dense|. Exactly 0.0.",
          "expression": {
            "op": "aggregate",
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [
              "A_j",
              "A_j_dense"
            ],
            "expr": {
              "op": "abs",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "A_j",
                        "j"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "A_j_dense",
                        "j"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "ident_W": {
          "type": "observed",
          "units": "1",
          "description": "L1 residual of the gated vs dense weight matrices: sum_{i,j} |W_ij - W_ij_dense|. Exactly 0.0.",
          "expression": {
            "op": "aggregate",
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "i": {
                "from": "src_cells"
              },
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [
              "W_ij",
              "W_ij_dense"
            ],
            "expr": {
              "op": "abs",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "W_ij",
                        "i",
                        "j"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "W_ij_dense",
                        "i",
                        "j"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "F_tgt": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "The regridded field through the CANDIDATE-GATED apply (same join gate and filter as A_j). Expected [7/3, 11/3, 19/3, 23/3], the dense exemplar's values.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_apply_gated",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "A_j": "A_j",
              "F_src": "F_src",
              "src_bin": "src_bin",
              "tgt_bin": "tgt_bin",
              "atol": "atol"
