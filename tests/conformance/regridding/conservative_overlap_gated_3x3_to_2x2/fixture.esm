      ],
      "tests": [
        {
          "id": "exact_invariants",
          "description": "The two EXACT gates of CONFORMANCE_SPEC 5.8.3 on the CANDIDATE-GATED pipeline: partition-of-unity (pou_state(1) = 1 for every target cell, max and min at the tight epsilon) and conservation (cons_state(1) = 0; both masses equal 45).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "pou_state",
              "time": 1.0,
              "expected": 1.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "max"
            },
            {
              "variable": "pou_state",
              "time": 1.0,
              "expected": 1.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "min"
            },
            {
              "variable": "cons_state",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "max"
            },
            {
              "variable": "cons_state",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "min"
            }
          ]
        },
        {
          "id": "gated_equals_dense",
          "description": "VALUE-IDENTITY of the candidate-gated and dense paths (the esm-spec 8.6.1 equivalence, made a hard gate): ident_state(1) = sum|A_ij - A_ij_dense| + sum|A_j - A_j_dense| + sum|W_ij - W_ij_dense| = 0.0 EXACTLY (tolerance abs 0.0 -- bit-identical values, since the gated contraction visits the same surviving terms and addition of exact zeros is FP-exact on nonnegative areas). The solver integrates a constant-zero derivative, so the only admissible residual is 0.0.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "ident_state",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.0
              },
              "reduce": "max"
            },
            {
              "variable": "ident_state",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.0
              },
              "reduce": "min"
            }
          ]
        }
      ]
    }
