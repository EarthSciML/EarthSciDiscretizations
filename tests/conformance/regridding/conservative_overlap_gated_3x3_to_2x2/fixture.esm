          }
        },
        "F_unit_tgt": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "The constant-1 field through the gated apply: F_unit_tgt[j] = sum_i W_ij = 1 exactly (partition-of-unity, exact by construction because the gated denominator row-sums the same computed areas over the same gated surviving set).",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_apply_gated",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "A_j": "A_j",
              "F_src": "unit_src",
              "src_bin": "src_bin",
              "tgt_bin": "tgt_bin",
              "atol": "atol"
            }
          }
        },
        "mass_src": {
          "type": "observed",
          "units": "1",
          "description": "Source-side mass sum_i A_i*F_src[i] = 45.",
          "expression": {
            "op": "aggregate",
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "i": {
                "from": "src_cells"
              }
            },
            "args": [
              "src_area",
              "F_src"
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "src_area",
                    "i"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "F_src",
                    "i"
                  ]
                }
              ]
            }
          }
        },
        "mass_tgt": {
          "type": "observed",
          "units": "1",
          "description": "Target-side mass sum_j A_j*F_tgt[j] with the computed gated denominators as target areas (the 5.8.3 construction). Equals mass_src exactly (the target tiles the source domain).",
          "expression": {
            "op": "aggregate",
            "semiring": "sum_product",
            "output_idx": [],
            "ranges": {
              "j": {
                "from": "tgt_cells"
              }
            },
            "args": [
              "A_j",
              "F_tgt"
            ],
            "expr": {
              "op": "*",
              "args": [
                {
                  "op": "index",
                  "args": [
                    "A_j",
                    "j"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "F_tgt",
                    "j"
                  ]
                }
              ]
            }
          }
        },
        "pou_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for partition-of-unity: d(pou_state[j])/dt = F_unit_tgt[j] from a zero IC, so pou_state(1) = sum_i W_ij."
        },
        "cons_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the conservation residual: d(cons_state[j])/dt = mass_tgt - mass_src = 0 from a zero IC."
        },
        "regrid_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the gated regridded field: regrid_state(1) = F_tgt, gated against golden/weights.json and cross-binding."
        },
        "ident_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the gated-vs-dense VALUE-IDENTITY residual: d(ident_state[j])/dt = ident_A + ident_Aj + ident_W (a scalar broadcast over tgt_cells), so ident_state(1) is the total L1 discrepancy between the candidate-gated and dense paths -- asserted EXACTLY zero (tolerance abs 0.0)."
        }
      },
      "equations": [
        {
          "_comment": "BROAD PHASE bin buffers (value-invention, build-time): src_bin[i] = skolem('bin', floor(src_lon[i]/bin_dx), floor(src_lat[i]/bin_dy)) via the library template. A per-element skolem map on a state LHS is the relational front-door's :map classification; the buffer is materialized once at setup and this equation never enters the ODE.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin",
              "i"
            ]
          },
          "rhs": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_src_bin",
            "args": [],
            "bindings": {
              "src_lon": "src_lon",
              "src_lat": "src_lat",
              "bin_dx": "bin_dx",
              "bin_dy": "bin_dy"
            }
          }
        },
        {
          "_comment": "BROAD PHASE bin buffers: tgt_bin[j], identically quantized.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin",
              "j"
            ]
          },
          "rhs": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_tgt_bin",
            "args": [],
            "bindings": {
              "tgt_lon": "tgt_lon",
              "tgt_lat": "tgt_lat",
              "bin_dx": "bin_dx",
              "bin_dy": "bin_dy"
            }
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "pou_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "cons_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "regrid_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "ident_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "_comment": "d(pou_state)/dt = F_unit_tgt (the gated regrid of the constant-1 field).",
          "lhs": {
            "op": "D",
            "args": [
              "pou_state"
            ],
            "wrt": "t"
          },
          "rhs": "F_unit_tgt"
        },
        {
          "_comment": "d(cons_state)/dt = mass_tgt - mass_src, the conservation residual.",
          "lhs": {
            "op": "D",
            "args": [
              "cons_state"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              "mass_tgt",
              "mass_src"
            ]
          }
        },
        {
          "_comment": "d(regrid_state)/dt = F_tgt (the gated regridded field).",
          "lhs": {
            "op": "D",
            "args": [
              "regrid_state"
            ],
            "wrt": "t"
          },
          "rhs": "F_tgt"
        },
        {
          "_comment": "d(ident_state)/dt = the total gated-vs-dense L1 residual, exactly 0.",
          "lhs": {
            "op": "D",
            "args": [
              "ident_state"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              "ident_A",
              "ident_Aj",
              "ident_W"
            ]
          }
        }
      ],
      "tests": [
        {
          "id": "exact_invariants",
          "description": "The two EXACT gates of CONFORMANCE_SPEC 5.8.3 on the CANDIDATE-GATED pipeline: partition-of-unity (pou_state(1) = 1 for every target cell, max and min at the tight epsilon) and conservation (cons_state(1) = 0; both masses equal 45).",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "pou_state",
              "time": 1.0,
              "expected": 1.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "max"
            },
            {
              "variable": "pou_state",
              "time": 1.0,
              "expected": 1.0,
              "tolerance": {
                "abs": 1e-12
              },
              "reduce": "min"
            },
            {
              "variable": "cons_state",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "max"
            },
            {
              "variable": "cons_state",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 1e-09
              },
              "reduce": "min"
            }
          ]
        },
        {
          "id": "gated_equals_dense",
          "description": "VALUE-IDENTITY of the candidate-gated and dense paths (the esm-spec 8.6.1 equivalence, made a hard gate): ident_state(1) = sum|A_ij - A_ij_dense| + sum|A_j - A_j_dense| + sum|W_ij - W_ij_dense| = 0.0 EXACTLY (tolerance abs 0.0 -- bit-identical values, since the gated contraction visits the same surviving terms and addition of exact zeros is FP-exact on nonnegative areas). The solver integrates a constant-zero derivative, so the only admissible residual is 0.0.",
          "time_span": {
            "start": 0.0,
            "end": 1.0
          },
          "assertions": [
            {
              "variable": "ident_state",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.0
              },
              "reduce": "max"
            },
            {
              "variable": "ident_state",
              "time": 1.0,
              "expected": 0.0,
              "tolerance": {
                "abs": 0.0
              },
              "reduce": "min"
            }
          ]
        }
      ]
    }
  }
}
