        },
        "bin_dx": {
          "type": "parameter",
          "units": "1",
          "default": 4.0,
          "description": "Broad-phase bin width (degrees lon): 4.0 spans the [0,3] domain, the degenerate-safe admissible binning for this compact tiling (see the fixture description for why nothing finer can prune here without dropping genuine overlaps)."
        },
