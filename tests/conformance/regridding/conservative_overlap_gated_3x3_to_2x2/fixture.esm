            "tgt_cells"
          ],
          "description": "DENSE REFERENCE PATH: the ungated normalized weights.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_W_ij",
            "args": [],
            "bindings": {
              "A_ij": "A_ij_dense",
              "A_j": "A_j_dense",
              "atol": "atol"
            }
          }
        },
        "F_tgt": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "The regridded field through the CANDIDATE-GATED apply (same join.overlap gate and filter as A_j). Expected [7/3, 11/3, 19/3, 23/3], the dense exemplar's values.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_apply_gated",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "A_j": "A_j",
              "F_src": "F_src",
              "src_poly": "src_poly",
              "tgt_poly": "tgt_poly",
              "atol": "atol"
            }
          }
        },
        "F_unit_tgt": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "The constant-1 field through the gated apply: F_unit_tgt[j] = sum_i W_ij = 1 exactly (partition-of-unity, exact by construction because the gated denominator row-sums the same computed areas over the same gated surviving set).",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_apply_gated",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "A_j": "A_j",
              "F_src": "unit_src",
              "src_poly": "src_poly",
              "tgt_poly": "tgt_poly",
              "atol": "atol"
            }
          }
        },
        "pou_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for partition-of-unity: d(pou_state[j])/dt = F_unit_tgt[j] from a zero IC, so pou_state(1) = sum_i W_ij."
        },
        "cons_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the conservation residual: d(cons_state[j])/dt = sum_j A_j*F_tgt[j] - sum_i A_i*F_src[i] (both mass reductions INLINE in the equation RHS for the same python bin-pre-pass ordering reason as ident_state) = 0 from a zero IC."
        },
        "regrid_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the gated regridded field: regrid_state(1) = F_tgt, gated against golden/weights.json and cross-binding."
        },
        "ident_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the gated-vs-dense VALUE-IDENTITY residual: d(ident_state[j])/dt = sum|A_ij - A_ij_dense| + sum|A_j - A_j_dense| + sum|W_ij - W_ij_dense| (three scalar aggregates INLINE in the equation RHS, broadcast over tgt_cells), asserted EXACTLY zero (tolerance abs 0.0). The reductions live in the state equation rather than intermediate scalar observeds because a join-FREE observed reading a join-CARRYING observed is not materializable in the python binding's bin pre-pass (the join-carrying chain is deferred to the buffered runtime context, which state RHS evaluation uses -- the ESS cross_domain_coupling pattern)."
        }
      },
      "equations": [
