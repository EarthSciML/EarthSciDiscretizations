{
  "esm": "1.0.0",
  "metadata": {
    "name": "cartesian_rings_regrid_cart2cart_3x3_to_2x2",
    "description": "CARTESIAN-TO-CARTESIAN regridding END-TO-END DECLARATIVE with BOTH grids constructed in-library -- the composition the single-import note on regridding/cartesian_cell_rings.esm once declared out of reach, now expressed with esm-spec 9.7.7 import renaming. The one ring-constructor library is imported TWICE under distinct namespace prefixes: prefix `src` at GX = GY = 3 (a 3x3 unit-cell source tiling [0,3]^2) and prefix `tgt` at GX = GY = 2 (a 2x2 target of 1.5-degree cells tiling the SAME [0,3]^2). Renaming is transitive: each edge's ring_* index sets arrive as src.ring_cells/src.ring_verts/src.ring_coord and tgt.ring_*, the metaparameter-sized ring_cells = GX*GY folds per edge (9 and 4), and the match-less templates namespace to src.cartesian_cell_rings_poly / tgt.cartesian_cell_rings_poly -- applied by their DOTTED names, with the {from: ring_cells} references inside their aggregate bodies renamed to the edge's own axis (esm-spec 9.7.7: prefix reaches templates, index sets, ranges, and {from} refs alike). The two constructed ring stacks flow straight into ONE conservative_overlap import (NSRC = 9, NTGT = 4, NVERT = 4) as src_poly/tgt_poly at manifold 'planar' -- narrow phase / assembly / apply -- so the whole pipeline is grid-spec -> rings -> regrid with NO out-of-document precomputation on EITHER side (the earlier end-to-end case cartesian_rings_regrid_3x3_to_2x2 still had to supply the source rings as consumer const data because one document then supported only one ring import; here both sides are constructed). The GEOMETRY IS THE DENSE EXEMPLAR'S ring for ring (src the 3x3 unit tiling, tgt the 2x2 of 1.5 over [0,3]^2), so the golden per-pair weights (official Julia runner, scripts/regenerate-goldens.sh) reproduce conservative_overlap_3x3_to_2x2's exact rationals: A_ij corner 1.0 / edge 0.5 / center 0.25 deg^2, A_j = 2.25, W = 4/9 / 2/9 / 1/9, F_tgt = [7/3, 11/3, 19/3, 23/3], mass 45. Gates: (1) affine_formula -- BOTH constructed ring stacks match their inline hand oracles EXACTLY (abs 0.0; every coordinate 0, 1, 1.5, 2, 3, 0.75, 2.25 is exactly representable, so the src AND tgt constructors are bit-checked); (2) exact_invariants -- partition-of-unity and conservation per CONFORMANCE_SPEC 5.8.3 (the constructed 2x2 target tiles the constructed 3x3 source's [0,3]^2 domain); (3) the golden per-pair weights. This is the proof that two prefixed ring imports coexist and both apply by dotted name -- the ESD-side close of the cartesian<->cartesian regridding gap, needing no ESS change (the §9.7.7 mechanism ported in the 2026-07 renaming wave already reaches explicitly-applied library templates and their renamed index-set references)."
  },
  "models": {
    "Regrid": {
      "expression_template_imports": [
        {
          "ref": "../../../../regridding/conservative_overlap.esm",
          "bindings": {
            "NSRC": 9,
            "NTGT": 4,
            "NVERT": 4
          }
        },
        {
          "ref": "../../../../regridding/cartesian_cell_rings.esm",
          "prefix": "src",
          "bindings": {
            "GX": 3,
            "GY": 3
          }
        },
        {
          "ref": "../../../../regridding/cartesian_cell_rings.esm",
          "prefix": "tgt",
          "bindings": {
            "GX": 2,
            "GY": 2
          }
        }
      ],
      "variables": {
        "atol": {
          "type": "parameter",
          "units": "1",
          "default": 1e-12,
          "description": "Sliver floor (CONFORMANCE_SPEC 5.8.2), as in the dense exemplar."
        },
        "src_x0": {
          "type": "parameter",
          "units": "deg",
          "default": 0.0,
          "description": "SOURCE GRID SPEC: west-most cell-edge x-coordinate. Bound into the prefix `src` ring constructor."
        },
        "src_y0": {
          "type": "parameter",
          "units": "deg",
          "default": 0.0,
          "description": "SOURCE GRID SPEC: south-most cell-edge y-coordinate."
        },
        "src_dx": {
          "type": "parameter",
          "units": "deg",
          "default": 1.0,
          "description": "SOURCE GRID SPEC: uniform x spacing. With GX = 3 the source tiles [0,3] exactly (unit cells)."
        },
        "src_dy": {
          "type": "parameter",
          "units": "deg",
          "default": 1.0,
          "description": "SOURCE GRID SPEC: uniform y spacing."
        },
        "tgt_x0": {
          "type": "parameter",
          "units": "deg",
          "default": 0.0,
          "description": "TARGET GRID SPEC: west-most cell-edge x-coordinate. Bound into the prefix `tgt` ring constructor."
        },
        "tgt_y0": {
          "type": "parameter",
          "units": "deg",
          "default": 0.0,
          "description": "TARGET GRID SPEC: south-most cell-edge y-coordinate."
        },
        "tgt_dx": {
          "type": "parameter",
          "units": "deg",
          "default": 1.5,
          "description": "TARGET GRID SPEC: uniform x spacing. With GX = 2 the target tiles the same [0,3] as the source."
        },
        "tgt_dy": {
          "type": "parameter",
          "units": "deg",
          "default": 1.5,
          "description": "TARGET GRID SPEC: uniform y spacing."
        },
        "src_poly": {
          "type": "unknown",
          "shape": [
            "src_cells",
            "overlap_cell_verts",
            "overlap_coord"
          ],
          "description": "CONSTRUCTED source-cell geometry: the four-corner CCW rings emitted by the prefix `src` ring constructor (src.cartesian_cell_rings_poly) from the source grid spec alone (flattened row-major over src.ring_cells = GX*GY = 9 = NSRC). Declared over conservative_overlap's src_cells/overlap_cell_verts/overlap_coord axes (same sizes 9/4/2 as src.ring_*), so it feeds the narrow phase directly."
        },
        "tgt_poly": {
          "type": "unknown",
          "shape": [
            "tgt_cells",
            "overlap_cell_verts",
            "overlap_coord"
          ],
          "description": "CONSTRUCTED target-cell geometry: the four-corner CCW rings emitted by the prefix `tgt` ring constructor (tgt.cartesian_cell_rings_poly) from the target grid spec (flattened row-major over tgt.ring_cells = GX*GY = 4 = NTGT)."
        },
        "src_poly_expected": {
          "type": "unknown",
          "shape": [
            "src_cells",
            "overlap_cell_verts",
            "overlap_coord"
          ],
          "description": "AFFINE-FORMULA ORACLE for the source: nine unit cells tiling [0,3]^2, row-major from the southwest, CCW (W,S)->(E,S)->(E,N)->(W,N). Every coordinate (0,1,2,3) is exactly representable, so the prefix `src` constructor must match bit-for-bit."
        },
        "tgt_poly_expected": {
          "type": "unknown",
          "shape": [
            "tgt_cells",
            "overlap_cell_verts",
            "overlap_coord"
          ],
          "description": "AFFINE-FORMULA ORACLE for the target: the 2x2 rings of 1.5-degree cells (the dense exemplar's hand-authored tgt_poly). Every coordinate (0, 1.5, 3.0) is exactly representable."
        },
        "src_ring_err": {
          "type": "unknown",
          "units": "1",
          "description": "L1 residual of the constructed SOURCE rings against the affine oracle: sum_{c,v,k} |src_poly - src_poly_expected|. Exactly 0.0."
        },
        "tgt_ring_err": {
          "type": "unknown",
          "units": "1",
          "description": "L1 residual of the constructed TARGET rings against the affine oracle: sum_{c,v,k} |tgt_poly - tgt_poly_expected|. Exactly 0.0."
        },
        "src_area": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells"
          ],
          "description": "True source-cell areas (1 deg^2 each) for the conservation invariant."
        },
        "F_src": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells"
          ],
          "description": "The source field, F[i] = i (the exemplar field; F_tgt = [7/3, 11/3, 19/3, 23/3], mass 45)."
        },
        "unit_src": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells"
          ],
          "description": "The constant-1 source field for the partition-of-unity surface."
        },
        "A_ij": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "DENSE narrow phase on the two CONSTRUCTED ring stacks, manifold 'planar'. Expected the exemplar's exact areas: corner 1.0, edge 0.5, center 0.25 deg^2."
        },
        "A_j": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "Row normalization (denominator is the row-sum of the SAME computed areas under the SAME sliver filter). Expected 2.25 for every j."
        },
        "W_ij": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "Normalized weights (same filter as A_j/apply). Expected the exemplar's exact rationals 4/9, 2/9, 1/9."
        },
        "F_tgt": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "The regridded field through the library apply. Expected [7/3, 11/3, 19/3, 23/3]."
        },
        "F_unit_tgt": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "The constant-1 field through the same apply: partition-of-unity as an ordinary field, exactly 1 by construction."
        },
        "mass_src": {
          "type": "unknown",
          "units": "1",
          "description": "Source-side mass sum_i A_i*F_src[i] = 45."
        },
        "mass_tgt": {
          "type": "unknown",
          "units": "1",
          "description": "Target-side mass sum_j A_j*F_tgt[j] with the computed denominators as target areas. Equals mass_src exactly (the constructed target tiles the constructed source domain)."
        },
        "pou_state": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for partition-of-unity: pou_state(1) = sum_i W_ij."
        },
        "cons_state": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the conservation residual: cons_state(1) = mass_tgt - mass_src = 0."
        },
        "regrid_state": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the regridded field: regrid_state(1) = F_tgt."
        },
        "affine_state": {
          "type": "unknown",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the AFFINE-FORMULA gate: affine_state(1) = src_ring_err + tgt_ring_err, the total L1 residual of BOTH constructed ring stacks against their inline oracles -- asserted EXACTLY zero (abs 0.0)."
        }
      },
