        "F_tgt": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "The regridded field through the CANDIDATE-GATED apply. Expected [1.5, 3.5].",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_apply_gated",
