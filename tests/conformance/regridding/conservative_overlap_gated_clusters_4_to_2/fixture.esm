            }
          }
        },
        "pou_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for partition-of-unity: pou_state(1) = sum_i W_ij."
        },
        "cons_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the conservation residual: d(cons_state[j])/dt = sum_j A_j*F_tgt[j] - sum_i A_i*F_src[i] (both mass reductions INLINE in the equation RHS for the same python bin-pre-pass ordering reason as ident_state) = 0 from a zero IC."
        },
        "regrid_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the gated regridded field: regrid_state(1) = F_tgt = [1.5, 3.5]."
        },
        "ident_state": {
          "type": "state",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "default": 0.0,
          "description": "Surfacing state for the gated-vs-dense VALUE-IDENTITY residual: d(ident_state[j])/dt = sum|A_ij - A_ij_dense| + sum|A_j - A_j_dense| + sum|W_ij - W_ij_dense| (three scalar aggregates INLINE in the equation RHS, broadcast over tgt_cells), asserted EXACTLY zero (tolerance abs 0.0). The reductions live in the state equation rather than intermediate scalar observeds because a join-FREE observed reading a join-CARRYING observed is not materializable in the python binding's bin pre-pass (the join-carrying chain is deferred to the buffered runtime context, which state RHS evaluation uses -- the ESS cross_domain_coupling pattern)."
        }
      },
      "equations": [
        {
          "_comment": "BROAD PHASE bin buffers (value-invention, build-time): src_bin[i] = skolem('bin', floor(src_lon[i]/bin_dx), floor(src_lat[i]/bin_dy)) via the library template. A per-element skolem map on a state LHS is the relational front-door's :map classification; the buffer is materialized once at setup and this equation never enters the ODE.",
          "lhs": {
            "op": "index",
            "args": [
              "src_bin",
              "i"
            ]
          },
          "rhs": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_src_bin",
            "args": [],
            "bindings": {
              "src_lon": "src_lon",
              "src_lat": "src_lat",
              "bin_dx": "bin_dx",
              "bin_dy": "bin_dy"
            }
          }
        },
        {
          "_comment": "BROAD PHASE bin buffers: tgt_bin[j], identically quantized.",
          "lhs": {
            "op": "index",
            "args": [
              "tgt_bin",
              "j"
            ]
          },
          "rhs": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_tgt_bin",
            "args": [],
            "bindings": {
              "tgt_lon": "tgt_lon",
              "tgt_lat": "tgt_lat",
              "bin_dx": "bin_dx",
              "bin_dy": "bin_dy"
            }
          }
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "pou_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "cons_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "regrid_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "lhs": {
            "op": "ic",
            "args": [
              "ident_state"
            ]
          },
          "rhs": 0.0
        },
        {
          "_comment": "d(pou_state)/dt = F_unit_tgt (the gated regrid of the constant-1 field).",
          "lhs": {
            "op": "D",
            "args": [
              "pou_state"
            ],
            "wrt": "t"
          },
          "rhs": "F_unit_tgt"
        },
        {
          "_comment": "d(cons_state)/dt = mass_tgt - mass_src, both reductions inline (see cons_state _doc).",
          "lhs": {
            "op": "D",
            "args": [
              "cons_state"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "-",
            "args": [
              {
                "op": "aggregate",
                "semiring": "sum_product",
                "output_idx": [],
                "ranges": {
                  "j": {
                    "from": "tgt_cells"
                  }
                },
                "args": [
                  "A_j",
                  "F_tgt"
                ],
                "expr": {
                  "op": "*",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "A_j",
                        "j"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "F_tgt",
                        "j"
                      ]
                    }
                  ]
                }
              },
              {
                "op": "aggregate",
                "semiring": "sum_product",
                "output_idx": [],
                "ranges": {
                  "i": {
                    "from": "src_cells"
                  }
                },
                "args": [
                  "src_area",
                  "F_src"
                ],
                "expr": {
                  "op": "*",
                  "args": [
                    {
                      "op": "index",
                      "args": [
                        "src_area",
                        "i"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "F_src",
                        "i"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "_comment": "d(regrid_state)/dt = F_tgt (the gated regridded field).",
          "lhs": {
            "op": "D",
            "args": [
              "regrid_state"
            ],
            "wrt": "t"
          },
          "rhs": "F_tgt"
        },
        {
          "_comment": "d(ident_state)/dt = the total gated-vs-dense L1 residual, three reductions inline (see ident_state _doc), exactly 0.",
          "lhs": {
            "op": "D",
            "args": [
              "ident_state"
            ],
            "wrt": "t"
          },
          "rhs": {
            "op": "+",
            "args": [
              {
                "op": "aggregate",
                "semiring": "sum_product",
                "output_idx": [],
                "ranges": {
                  "i": {
                    "from": "src_cells"
                  },
                  "j": {
                    "from": "tgt_cells"
                  }
                },
                "args": [
                  "A_ij",
                  "A_ij_dense"
                ],
                "expr": {
                  "op": "abs",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "A_ij",
                            "i",
                            "j"
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "A_ij_dense",
                            "i",
                            "j"
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "op": "aggregate",
                "semiring": "sum_product",
                "output_idx": [],
                "ranges": {
                  "j": {
                    "from": "tgt_cells"
                  }
                },
                "args": [
                  "A_j",
                  "A_j_dense"
                ],
                "expr": {
                  "op": "abs",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        {
                          "op": "index",
                          "args": [
                            "A_j",
                            "j"
                          ]
                        },
                        {
                          "op": "index",
                          "args": [
                            "A_j_dense",
                            "j"
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "op": "aggregate",
                "semiring": "sum_product",
                "output_idx": [],
                "ranges": {
                  "i": {
                    "from": "src_cells"
                  },
                  "j": {
                    "from": "tgt_cells"
                  }
                },
                "args": [
