          "type": "observed",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "DENSE REFERENCE PATH: clips all 8 pairs; the cross-cluster four come back exactly 0 (disjoint cells), so the filtered surviving set is identical to the gated path's.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_A_ij",
            "args": [],
            "bindings": {
              "src_poly": "src_poly",
              "tgt_poly": "tgt_poly",
              "manifold": "planar"
            }
          }
        },
        "A_j_dense": {
          "type": "observed",
