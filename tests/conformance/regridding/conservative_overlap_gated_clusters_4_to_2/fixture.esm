            "tgt_cells"
          ],
          "description": "DENSE REFERENCE PATH: the ungated normalized weights.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_W_ij",
            "args": [],
            "bindings": {
              "A_ij": "A_ij_dense",
              "A_j": "A_j_dense",
