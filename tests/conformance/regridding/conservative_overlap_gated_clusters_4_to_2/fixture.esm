        "src_bin": {
          "type": "state",
          "shape": [
            "src_cells"
          ],
          "description": "Integer bin keys skolem('bin', floor(lon/4), floor(lat/4)): cluster A -> ('bin', 0, 0), cluster B -> ('bin', 2, 0). Byte-identical across bindings (integer components only, CONFORMANCE_SPEC 5.8.5). Spelled per the upstream-supported value-invention pathway (ESS tests/coupling/cross_domain_coupling.esm rg_src_bin): a STATE variable assigned by a per-element skolem-aggregate equation -- the bindings' relational front-doors detect skolem maps on state equations, materialize the buffer once at build time, and drop the equation from the ODE."
        },
        "tgt_bin": {
          "type": "state",
          "shape": [
            "tgt_cells"
          ],
          "description": "Integer bin keys, identically quantized: [('bin', 0, 0), ('bin', 2, 0)]. STATE + skolem-aggregate equation, as src_bin."
        },
        "A_ij": {
          "type": "observed",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "CANDIDATE-GATED narrow phase: only the four same-cluster pairs are clipped (the join prunes the cross-cluster four, which stay the additive identity 0 without ever being visited). Expected 1.0 deg^2 on the surviving pairs, 0 elsewhere.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_A_ij_gated",
            "args": [],
            "bindings": {
              "src_poly": "src_poly",
              "tgt_poly": "tgt_poly",
              "manifold": "planar",
              "src_bin": "src_bin",
              "tgt_bin": "tgt_bin"
            }
          }
        },
        "A_j": {
          "type": "observed",
          "units": "1",
          "shape": [
            "tgt_cells"
          ],
          "description": "CANDIDATE-GATED row normalization (same join gate, same sliver filter as the numerator -- the denominator broad-phases like the numerator). Expected 2.0 for both targets.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_A_j_gated",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "src_bin": "src_bin",
              "tgt_bin": "tgt_bin",
              "atol": "atol"
            }
          }
        },
        "W_ij": {
          "type": "observed",
          "units": "1",
          "shape": [
            "src_cells",
            "tgt_cells"
          ],
          "description": "CANDIDATE-GATED normalized weights. Expected exactly 1/2 on the four surviving pairs, 0 elsewhere.",
          "expression": {
            "op": "apply_expression_template",
            "name": "conservative_overlap_W_ij_gated",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "A_j": "A_j",
