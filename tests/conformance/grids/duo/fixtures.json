{
  "version": "1.0.0",
  "family": "duo",
  "tolerance": {
    "relative": 1e-12,
    "notes": "Per docs/GRIDS_API.md §4.2 (per-family override). DUO cell_area goes through dot → acos → L'Huilier → sqrt → atan per triangle; libm differences in acos/atan across bindings push the 1e-14 default past. 1e-12 is tight enough to catch algorithm drift (bit-reordering errors show up >1e-9) while stable across platforms."
  },
  "reference_binding": "julia",
  "boundary_sentinel": -1,
