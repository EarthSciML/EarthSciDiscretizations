{
  "esm": "2.1.0",
  "metadata": {
    "name": "sectional_mean_volume",
    "description": "Mean single-particle volume vbar = V[c,j] / N[c,j] of section j in cell c, from the section's integrated volume V and number N (both shape [cell, bin]); the one quantity the two-moment reconstruction of the sibling stencils is built from. An EMPTY section (N <= 0, e.g. every section outside a compactly supported distribution) has no mean, and gets vbar = vb[j], its lower edge, which sectional_lr2m_interior_mean rejects, so the section carries nothing. The guard is applied twice -- ifelse(N > 0, V / ifelse(N > 0, N, 1), vb[j]) -- so the division is finite on BOTH branches: a binding that differentiates through ifelse (a taped/AD Jacobian for an implicit integrator) multiplies the untaken branch's derivative by zero, and a 0/0 there would turn that zero into NaN and poison the Jacobian.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:sectional_volume_1d",
      "op:advection",
      "order:2",
      "scheme:linear-discrete"
    ],
    "references": [
      {
        "citation": "Zaveri, R. A., Easter, R. C., Fast, J. D., & Peters, L. K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). Journal of Geophysical Research, 113, D13204.",
        "doi": "10.1029/2007JD008782"
      },
      {
        "citation": "WRF-Chem v4.8.0 chem/module_mosaic_movesect.F, subroutines move_sections_calc_masnumadvect and move_sections_apply_moves (R. C. Easter), the 'linear-discrete' / mass-number-advection section-moving algorithm (msectional = 20)."
      },
      {
        "citation": "Gelbard, F., Tambour, Y., & Seinfeld, J. H. (1980). Sectional representations for simulating aerosol dynamics. Journal of Colloid and Interface Science, 76(2), 541-556.",
        "doi": "10.1016/0021-9797(80)90394-X"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "sectional_mean_volume": {
      "params": ["N", "V", "c", "j"],
      "body": {
        "op": "ifelse",
        "args": [
          {"op": ">", "args": [{"op": "index", "args": ["N", "c", "j"]}, 0]},
          {
            "op": "/",
            "args": [
              {"op": "index", "args": ["V", "c", "j"]},
              {
                "op": "ifelse",
                "args": [
                  {"op": ">", "args": [{"op": "index", "args": ["N", "c", "j"]}, 0]},
                  {"op": "index", "args": ["N", "c", "j"]},
                  1
                ]
              }
            ]
          },
          {"op": "index", "args": ["vb", "j"]}
        ]
      }
    }
  }
}
