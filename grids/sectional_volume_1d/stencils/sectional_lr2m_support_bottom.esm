{
  "esm": "1.2.0",
  "metadata": {
    "name": "sectional_lr2m_support_bottom",
    "description": "Lower end of the support of the reconstructed number density of section j: vb[j], or, for a mean in the upper third (sectional_lr2m_high_triangle, consulted only when the lower-third test is false), max(vb[j], vb[j+1] + 3 (vbar - vb[j+1])) -- the bottom of the triangle that has the section's mean and vanishes there. A support that starts above vb[j] puts no particles at the lower edge, so evaporation carries nothing across it.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:sectional_volume_1d",
      "op:advection",
      "order:1",
      "scheme:linear-discrete"
    ],
    "references": [
      {
        "citation": "Zaveri, R. A., Easter, R. C., Fast, J. D., & Peters, L. K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). Journal of Geophysical Research, 113, D13204.",
        "doi": "10.1029/2007JD008782"
      },
      {
        "citation": "WRF-Chem v4.8.0 chem/module_mosaic_movesect.F, subroutines move_sections_calc_masnumadvect and move_sections_apply_moves (R. C. Easter), the 'linear-discrete' / mass-number-advection section-moving algorithm (msectional = 20)."
      },
      {
        "citation": "Gelbard, F., Tambour, Y., & Seinfeld, J. H. (1980). Sectional representations for simulating aerosol dynamics. Journal of Colloid and Interface Science, 76(2), 541-556.",
        "doi": "10.1016/0021-9797(80)90394-X"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "./sectional_mean_volume.esm"
    },
    {
      "ref": "./sectional_lr2m_low_triangle.esm"
    },
    {
      "ref": "./sectional_lr2m_high_triangle.esm"
    },
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "sectional_lr2m_support_bottom": {
      "params": [
        "N",
        "V",
        "c",
        "j"
      ],
      "body": {
        "op": "ifelse",
        "args": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "sectional_lr2m_low_triangle",
            "bindings": {
              "N": "N",
              "V": "V",
              "c": "c",
              "j": "j"
            }
          },
          {
            "op": "index",
            "args": [
              "vb",
              "j"
            ]
          },
          {
            "op": "ifelse",
            "args": [
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "sectional_lr2m_high_triangle",
                "bindings": {
                  "N": "N",
                  "V": "V",
                  "c": "c",
                  "j": "j"
                }
              },
              {
                "op": "max",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "vb",
                      "j"
                    ]
                  },
                  {
                    "op": "+",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "vb",
                          {
                            "op": "+",
                            "args": [
                              "j",
                              1
                            ]
                          }
                        ]
                      },
                      {
                        "op": "*",
                        "args": [
                          3,
                          {
                            "op": "-",
                            "args": [
                              {
                                "op": "apply_expression_template",
                                "args": [],
                                "name": "sectional_mean_volume",
                                "bindings": {
                                  "N": "N",
                                  "V": "V",
                                  "c": "c",
                                  "j": "j"
                                }
                              },
                              {
                                "op": "index",
                                "args": [
                                  "vb",
                                  {
                                    "op": "+",
                                    "args": [
                                      "j",
                                      1
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "index",
                "args": [
                  "vb",
                  "j"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
