{
  "esm": "1.2.0",
  "metadata": {
    "name": "sectional_lr2m_number_flux_up",
    "description": "Number flux UP through the upper edge of section j carried by section j's own growth: G(v) n(v) at v = vb[j+1] with the growth law G(v) = lam v of the section, i.e. max(lam[c,j], 0) vb[j+1] n_top. Upwind: a growing section (lam > 0) is the donor of its upper edge; a shrinking one sends nothing up. lam is the section's relative volume growth rate (1/V dV/dt at fixed number), shape [cell, bin].",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:sectional_volume_1d",
      "op:advection",
      "order:1",
      "scheme:linear-discrete"
    ],
    "references": [
      {
        "citation": "Zaveri, R. A., Easter, R. C., Fast, J. D., & Peters, L. K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). Journal of Geophysical Research, 113, D13204.",
        "doi": "10.1029/2007JD008782"
      },
      {
        "citation": "WRF-Chem v4.8.0 chem/module_mosaic_movesect.F, subroutines move_sections_calc_masnumadvect and move_sections_apply_moves (R. C. Easter), the 'linear-discrete' / mass-number-advection section-moving algorithm (msectional = 20)."
      },
      {
        "citation": "Gelbard, F., Tambour, Y., & Seinfeld, J. H. (1980). Sectional representations for simulating aerosol dynamics. Journal of Colloid and Interface Science, 76(2), 541-556.",
        "doi": "10.1016/0021-9797(80)90394-X"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "./sectional_lr2m_density_top.esm"
    },
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "sectional_lr2m_number_flux_up": {
      "params": [
        "lam",
        "N",
        "V",
        "c",
        "j"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "max",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "lam",
                      "c",
                      "j"
                    ]
                  },
                  0
                ]
              },
              {
                "op": "index",
                "args": [
                  "vb",
                  {
                    "op": "+",
                    "args": [
                      "j",
                      1
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "sectional_lr2m_density_top",
            "bindings": {
              "N": "N",
              "V": "V",
              "c": "c",
              "j": "j"
            }
          }
        ]
      }
    }
  }
}
