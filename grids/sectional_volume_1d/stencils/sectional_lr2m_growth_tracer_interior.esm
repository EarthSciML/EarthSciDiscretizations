{
  "esm": "2.1.0",
  "metadata": {
    "name": "sectional_lr2m_growth_tracer_interior",
    "description": "INTERIOR sections j = 2 .. NBIN-1 of the integrated growth divergence of a volume-carried quantity m (shape [cell, bin, tracer]): outflow through both edges minus inflow from the neighbours, each edge flux one reference to sectional_lr2m_tracer_flux_up / _down.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:sectional_volume_1d",
      "op:advection",
      "order:2",
      "scheme:linear-discrete"
    ],
    "references": [
      {
        "citation": "Zaveri, R. A., Easter, R. C., Fast, J. D., & Peters, L. K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). Journal of Geophysical Research, 113, D13204.",
        "doi": "10.1029/2007JD008782"
      },
      {
        "citation": "WRF-Chem v4.8.0 chem/module_mosaic_movesect.F, subroutines move_sections_calc_masnumadvect and move_sections_apply_moves (R. C. Easter), the 'linear-discrete' / mass-number-advection section-moving algorithm (msectional = 20)."
      },
      {
        "citation": "Gelbard, F., Tambour, Y., & Seinfeld, J. H. (1980). Sectional representations for simulating aerosol dynamics. Journal of Colloid and Interface Science, 76(2), 541-556.",
        "doi": "10.1016/0021-9797(80)90394-X"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "./sectional_lr2m_tracer_flux_up.esm"
    },
    {
      "ref": "./sectional_lr2m_tracer_flux_down.esm"
    },
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "sectional_lr2m_growth_tracer_interior": {
      "params": [
        "lam",
        "N",
        "V",
        "m"
      ],
      "body": {
        "op": "faq",
        "output_idx": [
          "c",
          "j",
          "s"
        ],
        "args": [
          "lam",
          "N",
          "V",
          "m"
        ],
        "ranges": {
          "c": {
            "from": "cell"
          },
          "j": [
            2,
            {
              "op": "-",
              "args": [
                "NBIN",
                1
              ]
            }
          ],
          "s": {
            "from": "tracer"
          }
        },
        "expr": {
          "op": "-",
          "args": [
            {
              "op": "+",
              "args": [
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "sectional_lr2m_tracer_flux_up",
                  "bindings": {
                    "lam": "lam",
                    "N": "N",
                    "V": "V",
                    "m": "m",
                    "c": "c",
                    "j": "j",
                    "s": "s"
                  }
                },
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "sectional_lr2m_tracer_flux_down",
                  "bindings": {
                    "lam": "lam",
                    "N": "N",
                    "V": "V",
                    "m": "m",
                    "c": "c",
                    "j": "j",
                    "s": "s"
                  }
                }
              ]
            },
            {
              "op": "+",
              "args": [
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "sectional_lr2m_tracer_flux_up",
                  "bindings": {
                    "lam": "lam",
                    "N": "N",
                    "V": "V",
                    "m": "m",
                    "c": "c",
                    "j": {
                      "op": "-",
                      "args": [
                        "j",
                        1
                      ]
                    },
                    "s": "s"
                  }
                },
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "sectional_lr2m_tracer_flux_down",
                  "bindings": {
                    "lam": "lam",
                    "N": "N",
                    "V": "V",
                    "m": "m",
                    "c": "c",
                    "j": {
                      "op": "+",
                      "args": [
                        "j",
                        1
                      ]
                    },
                    "s": "s"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}
