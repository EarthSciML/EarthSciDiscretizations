{
  "esm": "2.1.0",
  "metadata": {
    "name": "sectional_lr2m_tracer_per_volume",
    "description": "Amount of a volume-carried quantity m (shape [cell, bin, tracer]: a component mass, water, ...) per unit particle volume in section j, m[c,j,s] / V[c,j]: the quantity is uniformly mixed over the section's particles, so every particle volume crossing an edge out of section j carries this much of it (sectional_lr2m_tracer_flux_up / _down). It is guarded by the SAME predicate that gates the number flux it multiplies, sectional_lr2m_interior_mean, so the two zero conditions coincide: wherever the number flux can be nonzero the mean is interior and V = N vbar > 0, and everywhere else the denominator is 1 and the (zero) number flux makes the product zero. The denominator is therefore finite on every path, including the untaken branch an AD/taped binding differentiates.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:sectional_volume_1d",
      "op:advection",
      "order:2",
      "scheme:linear-discrete"
    ],
    "references": [
      {
        "citation": "WRF-Chem v4.8.0 chem/module_mosaic_movesect.F, subroutines move_sections_calc_masnumadvect and move_sections_apply_moves (R. C. Easter), the 'linear-discrete' / mass-number-advection section-moving algorithm (msectional = 20)."
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "./sectional_lr2m_interior_mean.esm"
    },
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "sectional_lr2m_tracer_per_volume": {
      "params": ["N", "V", "m", "c", "j", "s"],
      "body": {
        "op": "/",
        "args": [
          {"op": "index", "args": ["m", "c", "j", "s"]},
          {
            "op": "ifelse",
            "args": [
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "sectional_lr2m_interior_mean",
                "bindings": {"N": "N", "V": "V", "c": "c", "j": "j"}
              },
              {"op": "index", "args": ["V", "c", "j"]},
              1
            ]
          }
        ]
      }
    }
  }
}
