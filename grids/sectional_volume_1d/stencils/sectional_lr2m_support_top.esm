{
  "esm": "2.1.0",
  "metadata": {
    "name": "sectional_lr2m_support_top",
    "description": "Upper end of the support of the reconstructed number density of section j: vb[j+1], or, for a mean in the lower third (sectional_lr2m_low_triangle), vb[j] + 3 (vbar - vb[j]) -- the top of the triangle that has the section's mean and vanishes there, which lies inside the section because x <= 1/3. A support that ends below vb[j+1] puts no particles at the upper edge, so growth carries nothing across it.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:sectional_volume_1d",
      "op:advection",
      "order:2",
      "scheme:linear-discrete"
    ],
    "references": [
      {
        "citation": "Zaveri, R. A., Easter, R. C., Fast, J. D., & Peters, L. K. (2008). Model for Simulating Aerosol Interactions and Chemistry (MOSAIC). Journal of Geophysical Research, 113, D13204.",
        "doi": "10.1029/2007JD008782"
      },
      {
        "citation": "WRF-Chem v4.8.0 chem/module_mosaic_movesect.F, subroutines move_sections_calc_masnumadvect and move_sections_apply_moves (R. C. Easter), the 'linear-discrete' / mass-number-advection section-moving algorithm (msectional = 20)."
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "./sectional_mean_volume.esm"
    },
    {
      "ref": "./sectional_lr2m_low_triangle.esm"
    },
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "sectional_lr2m_support_top": {
      "params": ["N", "V", "c", "j"],
      "body": {
        "op": "ifelse",
        "args": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "sectional_lr2m_low_triangle",
            "bindings": {"N": "N", "V": "V", "c": "c", "j": "j"}
          },
          {
            "op": "+",
            "args": [
              {"op": "index", "args": ["vb", "j"]},
              {
                "op": "*",
                "args": [
                  3,
                  {
                    "op": "-",
                    "args": [
                      {
                        "op": "apply_expression_template",
                        "args": [],
                        "name": "sectional_mean_volume",
                        "bindings": {"N": "N", "V": "V", "c": "c", "j": "j"}
                      },
                      {"op": "index", "args": ["vb", "j"]}
                    ]
                  }
                ]
              }
            ]
          },
          {"op": "index", "args": ["vb", {"op": "+", "args": ["j", 1]}]}
        ]
      }
    }
  }
}
