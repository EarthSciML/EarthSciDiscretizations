{
  "esm": "1.2.0",
  "metadata": {
    "name": "varcoeff_face_laplacian_lev_interior_tracer",
    "description": "Interior [2, NLEV-1] of the variable-coefficient vertical diffusion for a [lev, tracer] field: (G[k+1,s] - G[k,s]) / dz[k] for every tracer s, G being stencils/interface_flux_K_lev_tracer. Column s is grids/column_nonuniform_1d/stencils/varcoeff_face_laplacian_lev_interior applied to u[:, s].",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:column_nonuniform_1d_tracer",
      "op:varcoeff_laplacian",
      "order:2",
      "stencil_width:3"
    ]
  },
  "expression_template_imports": [
    {
      "ref": "./interface_flux_K_lev_tracer.esm"
    },
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "varcoeff_face_laplacian_lev_interior_tracer": {
      "params": [
        "u",
        "K"
      ],
      "body": {
        "op": "faq",
        "output_idx": [
          "k",
          "s"
        ],
        "args": [
          "u",
          "K"
        ],
        "ranges": {
          "k": [
            2,
            {
              "op": "-",
              "args": [
                "NLEV",
                1
              ]
            }
          ],
          "s": {
            "from": "tracer"
          }
        },
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "-",
              "args": [
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "interface_flux_K_lev_tracer",
                  "bindings": {
                    "u": "u",
                    "K": "K",
                    "n": {
                      "op": "+",
                      "args": [
                        "k",
                        1
                      ]
                    },
                    "s": "s"
                  }
                },
                {
                  "op": "apply_expression_template",
                  "args": [],
                  "name": "interface_flux_K_lev_tracer",
                  "bindings": {
                    "u": "u",
                    "K": "K",
                    "n": "k",
                    "s": "s"
                  }
                }
              ]
            },
            {
              "op": "index",
              "args": [
                "dz",
                "k"
              ]
            }
          ]
        }
      }
    }
  }
}
