{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_contravariant",
    "description": "Raise one covariant wind component to its contravariant counterpart through the duo metric g^{ij} = (1/(1-cosA^2)) [[1,-cosA],[-cosA,1]] (Chen 2021 C35): given the covariant component u aligned with this coordinate and the other covariant component v, returns u^i = (u - cosA v)/(1 - cosA^2). Apply once per coordinate direction (bind u,v to the same-direction and cross-direction covariant winds); cosA is duo_cos_alpha at the evaluation point. AXIS-NEUTRAL scalar algebra, no grid knowledge.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:metric",
      "scheme:vector_invariant"
    ],
    "references": [
      {
        "citation": "Chen, X. (2021). The LMARS based shallow-water dynamical core on generic gnomonic cubed-sphere geometry. Journal of Advances in Modeling Earth Systems, 13(1), e2020MS002280.",
        "doi": "10.1029/2020MS002280"
      }
    ]
  },
  "expression_templates": {
    "duo_contravariant": {
      "params": [
        "u",
        "v",
        "cosA"
      ],
      "body": {
        "op": "/",
        "args": [
          {
            "op": "-",
            "args": [
              "u",
              {
                "op": "*",
                "args": [
                  "cosA",
                  "v"
                ]
              }
            ]
          },
          {
            "op": "-",
            "args": [
              1,
              {
                "op": "*",
                "args": [
                  "cosA",
                  "cosA"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}