{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_tangent_norm",
    "description": "Norm of the great-circle tangent vector cross(cross(a,b),a) between two duo node positions, via duo_wind_cross_sq. Divides the tangent components to produce the unit coordinate-line direction at a face.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:tangent"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "duo_wind_cross_sq.esm"
    }
  ],
  "expression_templates": {
    "duo_wind_tangent_norm": {
      "params": [
        "p1",
        "p2",
        "p3",
        "p4",
        "p5",
        "p6"
      ],
      "body": {
        "op": "sqrt",
        "args": [
          {
            "op": "+",
            "args": [
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_wind_cross_sq",
                "bindings": {
                  "p1": "p1",
                  "p2": "p2",
                  "p3": "p3",
                  "p4": "p4",
                  "p6": "p5",
                  "p7": "p6"
                }
              },
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_wind_cross_sq",
                "bindings": {
                  "p1": "p3",
                  "p2": "p5",
                  "p3": "p6",
                  "p4": "p2",
                  "p6": "p4",
                  "p7": "p1"
                }
              },
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_wind_cross_sq",
                "bindings": {
                  "p1": "p6",
                  "p2": "p4",
                  "p3": "p1",
                  "p4": "p5",
                  "p6": "p2",
                  "p7": "p3"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
