{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_contra_u",
    "description": "Contravariant u wind at a duo point: duo_wind_cov_resid_u / (1 - c^2) with c = duo_wind_basis_cos. Output stage of the covariant->contravariant solve in the staggered-wind remap.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:wind_solve"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "duo_wind_basis_cos.esm"
    },
    {
      "ref": "duo_wind_cov_resid_u.esm"
    }
  ],
  "expression_templates": {
    "duo_wind_contra_u": {
      "params": [
        "center",
        "ua",
        "va"
      ],
      "body": {
        "op": "/",
        "args": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_wind_cov_resid_u",
            "bindings": {
              "center": "center",
              "ua": "ua",
              "va": "va"
            }
          },
          {
            "op": "-",
            "args": [
              1.0,
              {
                "op": "*",
                "args": [
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_wind_basis_cos",
                    "bindings": {
                      "center": "center"
                    }
                  },
                  {
                    "op": "apply_expression_template",
                    "args": [],
                    "name": "duo_wind_basis_cos",
                    "bindings": {
                      "center": "center"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
