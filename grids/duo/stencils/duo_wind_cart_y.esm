{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_cart_y",
    "description": "Cartesian Y component of the Earth wind (uz, vm) at a duo cell center: Y = uz*cos(lambda) - vm*sin(theta)*sin(lambda) with lambda = atan2(c2, c1), theta = asin(c3/R_sphere) from the center's Cartesian coordinates. Zonal/meridional -> Cartesian rotation used by the duo staggered-wind rules.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:wind_rotate"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_templates": {
    "duo_wind_cart_y": {
      "params": [
        "center",
        "uz",
        "vm"
      ],
      "body": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              {
                "op": "index",
                "args": [
                  "uz",
                  "gt",
                  "gi",
                  "gj"
                ]
              },
              {
                "op": "cos",
                "args": [
                  {
                    "op": "atan2",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "center",
                          "gt",
                          "gi",
                          "gj",
                          2
                        ]
                      },
                      {
                        "op": "index",
                        "args": [
                          "center",
                          "gt",
                          "gi",
                          "gj",
                          1
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "index",
                "args": [
                  "vm",
                  "gt",
                  "gi",
                  "gj"
                ]
              },
              {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "sin",
                        "args": [
                          {
                            "op": "asin",
                            "args": [
                              {
                                "op": "/",
                                "args": [
                                  {
                                    "op": "index",
                                    "args": [
                                      "center",
                                      "gt",
                                      "gi",
                                      "gj",
                                      3
                                    ]
                                  },
                                  "R_sphere"
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "op": "sin",
                        "args": [
                          {
                            "op": "atan2",
                            "args": [
                              {
                                "op": "index",
                                "args": [
                                  "center",
                                  "gt",
                                  "gi",
                                  "gj",
                                  2
                                ]
                              },
                              {
                                "op": "index",
                                "args": [
                                  "center",
                                  "gt",
                                  "gi",
                                  "gj",
                                  1
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
