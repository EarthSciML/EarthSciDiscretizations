{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_corner_assy_1",
    "description": "Corner-fill assembly, level 1: great-circle arc-length remap weight over a corner node pair (applies duo_arc_length on the halo-extended node array). Outlined from the generated corner rules (exact-tree verified).",
