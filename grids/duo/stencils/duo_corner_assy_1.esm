                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  1
                ]
              },
              "ay": {
                "op": "index",
                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  2
                ]
              },
              "az": {
                "op": "index",
                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  3
                ]
              },
              "bx": "p1",
              "by": "p2",
              "bz": "p3",
              "radius": "R_sphere"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_arc_length",
            "bindings": {
              "ax": "p4",
              "ay": "p5",
              "az": "p6",
              "bx": "p1",
              "by": "p2",
