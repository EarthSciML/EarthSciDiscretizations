{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_extend_strip_w",
    "description": "West-edge halo strip of the duo_extend donor-cube remap: tent-basis remap of the donor tile's field over the strip's gnomonic coordinates (X, Y), with one-sided extrapolation at the strip ends. Parameters (q, center, refx, refy, dt, X, Y); the caller binds the donor tile dt and the signed center-component ratios X, Y.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:halo_extend"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
