{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_assy_14",
    "description": "Systematic assembly template of the duo staggered-wind remap, outlined from the generated wind rules by anti-unification (exact-tree verified against the original inline forms). Composes lower assembly levels of the great-circle tangent / cross-product geometry; the name is positional (assembly level 14), pending a semantic identification against Mouallem et al.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:wind_assy"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "duo_wind_assy_2.esm"
    },
    {
      "ref": "duo_wind_contra_u.esm"
    }
  ],
