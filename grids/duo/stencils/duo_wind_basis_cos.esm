{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_basis_cos",
    "description": "Cosine of the angle between the two coordinate-line unit tangents at a duo point (the non-orthogonality of the gnomonic basis), assembled from duo_wind_assy_7. Appears in the covariant<->contravariant wind solve.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:basis_cos"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
