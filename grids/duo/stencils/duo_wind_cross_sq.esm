{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_cross_sq",
    "description": "Squared norm of the cross product of two node position vectors, assembled from three duo_cross_x components. Normalization factor of the great-circle tangent cross(cross(a,b),a) in the duo staggered-wind remap.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:cross"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "duo_cross_x.esm"
    }
  ],
  "expression_templates": {
    "duo_wind_cross_sq": {
      "params": [
        "p1",
        "p2",
        "p3",
        "p4",
        "p6",
        "p7"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_cross_x",
            "bindings": {
              "a2": {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "p1",
                      "p2"
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "p3",
                      "p4"
                    ]
                  }
                ]
              },
              "a3": {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "p3",
                      "p6"
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "p7",
                      "p2"
                    ]
                  }
                ]
              },
              "b2": "p7",
              "b3": "p1"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_cross_x",
            "bindings": {
              "a2": {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "p1",
                      "p2"
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "p3",
                      "p4"
                    ]
                  }
                ]
              },
              "a3": {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "p3",
                      "p6"
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "p7",
                      "p2"
                    ]
                  }
                ]
              },
              "b2": "p7",
              "b3": "p1"
            }
          }
        ]
      }
    }
  }
}
