{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_ke_orthogonal",
    "description": "Interface kinetic energy K = 1/2 (ut^2 + up^2) built from the ORTHOGONAL pair at an LMARS interface: the normal Riemann velocity ut (duo_lmars_ustar_a) and the upwinded tangential velocity up (duo_upwind). This is the paper's interface KE (Chen 2021 Eq 10 evaluated on the orthogonalised interface state), distinct from the covariant duo_ke which carries the cross-metric term; on an orthogonal interface frame the cross term vanishes and K reduces to 1/2(ut^2+up^2). AXIS-NEUTRAL scalar algebra.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:kinetic_energy",
      "scheme:vector_invariant"
    ],
    "references": [
      {
        "citation": "Chen, X. (2021). The LMARS based shallow-water dynamical core on generic gnomonic cubed-sphere geometry. Journal of Advances in Modeling Earth Systems, 13(1), e2020MS002280.",
        "doi": "10.1029/2020MS002280"
      }
    ]
  },
  "expression_templates": {
    "duo_ke_orthogonal": {
      "params": [
        "ut",
        "up"
      ],
      "body": {
        "op": "*",
        "args": [
          0.5,
          {
            "op": "+",
            "args": [
              {
                "op": "*",
                "args": [
                  "ut",
                  "ut"
                ]
              },
              {
                "op": "*",
                "args": [
                  "up",
                  "up"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}