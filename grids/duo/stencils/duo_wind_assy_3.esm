{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_assy_3",
    "description": "Systematic assembly template of the duo staggered-wind remap, outlined from the generated wind rules by anti-unification (exact-tree verified against the original inline forms). Composes lower assembly levels of the great-circle tangent / cross-product geometry; the name is positional (assembly level 3), pending a semantic identification against Mouallem et al.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:wind_assy"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "duo_wind_assy_2.esm"
    }
  ],
  "expression_templates": {
    "duo_wind_assy_3": {
      "params": [
        "center",
        "p1",
        "p2",
        "p3",
        "p4",
        "p5",
        "p6",
        "p7",
        "p8",
        "p9",
        "p10"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "ifelse",
            "args": [
              {
                "op": "<",
                "args": [
                  "p1",
                  {
                    "op": "+",
                    "args": [
                      "N",
                      6
                    ]
                  }
                ]
              },
              1.0,
              -1.0
            ]
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_wind_assy_2",
            "bindings": {
              "p1": "p2",
              "p2": "p3",
              "p3": "p4",
              "p4": "p5",
              "p6": "p6",
              "p7": "p7",
              "p11": {
                "op": "index",
                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  3
                ]
              },
              "p12": "p8",
              "p13": {
                "op": "index",
                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  1
                ]
              },
              "p14": "p9",
              "p15": "p10",
              "p16": {
                "op": "index",
                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  2
                ]
              }
            }
          }
        ]
      }
    }
  }
}
