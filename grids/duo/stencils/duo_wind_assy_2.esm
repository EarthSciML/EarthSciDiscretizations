{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_assy_2",
    "description": "Systematic assembly template of the duo staggered-wind remap, outlined from the generated wind rules by anti-unification (exact-tree verified against the original inline forms). Composes lower assembly levels of the great-circle tangent / cross-product geometry; the name is positional (assembly level 2), pending a semantic identification against Mouallem et al.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:wind_assy"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "duo_cross_x.esm"
    },
    {
      "ref": "duo_wind_tangent_norm.esm"
    }
  ],
  "expression_templates": {
    "duo_wind_assy_2": {
      "params": [
        "p1",
        "p2",
        "p3",
        "p4",
        "p6",
        "p7",
        "p11",
        "p12",
        "p13",
        "p14",
        "p15",
        "p16"
      ],
      "body": {
        "op": "/",
        "args": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_cross_x",
            "bindings": {
              "a2": {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "p1",
                      "p2"
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "p3",
                      "p4"
                    ]
                  }
                ]
              },
              "a3": {
                "op": "-",
                "args": [
                  {
                    "op": "*",
                    "args": [
                      "p3",
                      "p6"
                    ]
                  },
                  {
                    "op": "*",
                    "args": [
                      "p7",
                      "p2"
                    ]
                  }
                ]
              },
              "b2": "p7",
              "b3": "p1"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_wind_tangent_norm",
            "bindings": {
              "p1": "p11",
              "p2": "p12",
              "p3": "p13",
              "p4": "p14",
              "p5": "p15",
              "p6": "p16"
            }
          }
        ]
      }
    }
  }
}
