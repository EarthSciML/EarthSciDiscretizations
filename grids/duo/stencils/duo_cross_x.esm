{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_cross_x",
    "description": "One Cartesian component of a vector cross product a x b: cross_x(a2,a3,b2,b3) = a2*b3 - a3*b2. AXIS-NEUTRAL: bind the (y,z) components for the x output, (z,x) for y, (x,y) for z. Atom of the great-circle tangent construction cross(cross(a,b),a) used by the duo staggered-wind remap.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:cross"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_templates": {
    "duo_cross_x": {
      "params": [
        "a1",
        "a2",
        "a3",
        "b1",
        "b2",
        "b3"
      ],
      "body": {
        "op": "-",
        "args": [
          {
            "op": "*",
            "args": [
              "a2",
              "b3"
            ]
          },
          {
            "op": "*",
            "args": [
              "a3",
              "b2"
            ]
          }
        ]
      }
    }
  }
}
