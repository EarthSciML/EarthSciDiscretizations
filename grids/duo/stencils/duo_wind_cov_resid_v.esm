{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_cov_resid_v",
    "description": "Covariant-solve residual for the v component: (va - ua*c) with c = duo_wind_basis_cos. Intermediate of the duo covariant wind decomposition.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:wind_solve"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "duo_wind_basis_cos.esm"
    }
  ],
  "expression_templates": {
    "duo_wind_cov_resid_v": {
      "params": [
        "center",
        "ua",
        "va"
      ],
      "body": {
        "op": "-",
        "args": [
          {
            "op": "index",
            "args": [
              "va",
              "gt",
              "gi",
              "gj"
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "index",
                "args": [
                  "ua",
                  "gt",
                  "gi",
                  "gj"
                ]
              },
              {
                "op": "apply_expression_template",
                "args": [],
                "name": "duo_wind_basis_cos",
                "bindings": {
                  "center": "center"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
