{
  "esm": "1.0.0",
  "metadata": {
    "name": "duo_wind_assy_5",
    "description": "Systematic assembly template of the duo staggered-wind remap, outlined from the generated wind rules by anti-unification (exact-tree verified against the original inline forms). Composes lower assembly levels of the great-circle tangent / cross-product geometry; the name is positional (assembly level 5), pending a semantic identification against Mouallem et al.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:duo",
      "op:wind_assy"
    ],
    "references": [
      {
        "citation": "Mouallem, J., Harris, L., & Chen, X. (2023). Implementation of the novel duo-grid in GFDL's FV3 dynamical core. Journal of Advances in Modeling Earth Systems, 15, e2023MS003712.",
        "doi": "10.1029/2023MS003712"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "duo_wind_assy_3.esm"
    },
    {
      "ref": "duo_wind_cart_y.esm"
    }
  ],
  "expression_templates": {
    "duo_wind_assy_5": {
      "params": [
        "center",
        "uz",
        "vm",
        "p1",
        "p2",
        "p3",
        "p4"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_wind_cart_y",
            "bindings": {
              "center": "center",
              "uz": "uz",
              "vm": "vm"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "duo_wind_assy_3",
            "bindings": {
              "center": "center",
              "p1": "p1",
              "p2": {
                "op": "index",
                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  1
                ]
              },
              "p3": "p2",
              "p4": {
                "op": "index",
                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  2
                ]
              },
              "p5": "p3",
              "p6": "p4",
              "p7": {
                "op": "index",
                "args": [
                  "center",
                  "gt",
                  "gi",
                  "gj",
                  3
                ]
              },
              "p8": "p3",
