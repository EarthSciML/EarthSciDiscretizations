{
  "esm": "1.0.0",
  "metadata": {
    "name": "pgrad_direct_u_duo_g3",
    "description": "Pressure-gradient tendency for the covariant u-wind, duo SWE core, Ng=3. Direct LMARS-Pi* pressure gradient -dx(Pibar + Pivis + Phi_s)/Dx, mathematically equivalent to the L97 four-corner form for SW (paper) but written as a plain interface-pressure difference. Pibar = 1/2(dpe+dpw) is the symmetric M**vm face average of the depth pressure (= 1/2 of the two reconstructed interface pressures); Sbar the same for the surface geopotential Phi_s (problem-supplied, 0 for no topography); Pivis = a/2(uE-uW) the LMARS viscous pressure; Dx the arc between x-face midpoints. Add to momentum_u_duo_g3 for the full tendency. Method-of-lines spatial RHS (beta=1, no forward-backward).",
    "license": "MIT",
    "tags": [
      "esd:rule",
      "family:finite_volume",
      "grid:duo",
      "op:pgrad_direct_u",
      "order:5",
      "bc:duo",
      "axes:tile,x,y",
      "form:vector_invariant"
    ],
    "references": [
      {
        "citation": "Chen, X. (2021). The LMARS based shallow-water dynamical core on generic gnomonic cubed-sphere geometry. JAMES 13(1), e2020MS002280.",
        "doi": "10.1029/2020MS002280"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "../grid.esm"
    },
    {
      "ref": "../stencils/duo_arc_length.esm"
    },
