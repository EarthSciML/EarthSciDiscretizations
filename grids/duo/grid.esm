    "duo_cell_area_mean": {
      "params": [],
      "description": "The nominal resolution measure: 4 pi R_sphere^2 / (6 N^2), the mean cell area over the sphere, with nominal spacing h ~ sqrt(duo_cell_area_mean). Convergence sweeps use it exactly as cartesian_uniform_1d uses dx = 1/N. The ACTUAL areas vary about this mean by the projection's area ratio -- about 1.39 equiangular, 2.27 equi-edge, 4.97 equidistance at C48 -- so it is a resolution label, not a bound on any one cell.",
      "body": {
        "op": "/",
        "args": [
          {
            "op": "*",
            "args": [
              4,
              3.141592653589793,
              {
                "op": "^",
                "args": [
                  "R_sphere",
                  2
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              6,
              {
                "op": "^",
                "args": [
                  "N",
                  2
                ]
              }
            ]
          }
        ]
      }
    }
  }
