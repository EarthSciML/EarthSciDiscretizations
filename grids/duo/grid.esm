    "duo_cell_center": {
      "params": [
        "node"
      ],
      "description": "Cell-CENTRE positions on the sphere, shaped [tile, x_cell_ext, y_cell_ext, space]: the mean of the cell's four corner nodes, renormalised back onto the R_sphere sphere. This is the unstaggered (A-grid) collocation point at which EVERY prognostic variable lives in Chen (2021) -- the depth h and both covariant wind components share it, which is what makes the solver unstaggered. Renormalising after averaging matters: the chord midpoint of four points on a sphere lies strictly inside it, and skipping the projection would put the collocation point off the manifold by O(h^2). Index convention: cell index k on x_cell_ext takes its corners from node indices k and k+1 on x_nodes_ext, so the halo offset cancels and no index arithmetic beyond +1 appears. Bind `node` to duo_node_cart.",
      "body": {
        "op": "aggregate",
        "output_idx": [
          "gt",
          "gi",
          "gj",
          "gd"
        ],
        "args": [
          "node"
        ],
        "ranges": {
          "gt": {
            "from": "tile"
          },
          "gi": {
            "from": "x_cell_ext"
          },
          "gj": {
            "from": "y_cell_ext"
          },
          "gd": {
            "from": "space"
          }
        },
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "*",
              "args": [
                "R_sphere",
