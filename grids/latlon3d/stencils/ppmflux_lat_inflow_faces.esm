                    1
                  ]
                }
              ]
            },
            "dL1": {
              "op": "index",
              "args": [
                "dphi_lat",
                {
                  "op": "max",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "j",
                        2
                      ]
                    },
