                        3
                      ]
                    },
                    1
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    "i",
                    {
                      "op": "max",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "j",
                            3
                          ]
                        },
                        1
                      ]
                    },
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_s",
                    "i",
                    "k"
                  ]
                }
              ]
            },
            "aL1": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">=",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "j",
                        2
                      ]
                    },
                    1
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    "i",
                    {
                      "op": "max",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "j",
                            2
                          ]
                        },
                        1
                      ]
                    },
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_s",
                    "i",
                    "k"
                  ]
                }
              ]
            },
            "aC": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">=",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "j",
                        1
                      ]
                    },
                    1
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    "i",
                    {
                      "op": "max",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "j",
                            1
                          ]
                        },
                        1
                      ]
                    },
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_s",
                    "i",
                    "k"
                  ]
                }
              ]
            },
            "aRc": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "j",
                    "NLAT"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    "i",
                    {
                      "op": "min",
                      "args": [
                        "j",
                        "NLAT"
                      ]
                    },
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_n",
                    "i",
                    "k"
                  ]
                }
              ]
            },
            "aR1": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        "j",
                        1
                      ]
                    },
                    "NLAT"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    "i",
                    {
                      "op": "min",
                      "args": [
                        {
                          "op": "+",
                          "args": [
                            "j",
                            1
                          ]
                        },
                        "NLAT"
                      ]
                    },
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_n",
                    "i",
                    "k"
                  ]
                }
              ]
            },
            "aR2": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        "j",
                        2
                      ]
                    },
                    "NLAT"
