{
  "esm": "2.3.0",
  "metadata": {
    "name": "ppmflux_lat_inflow_faces",
    "description": "The upwind-biased, monotone PPM lat face flux F_f = max(V,0)*aR_L + min(V,0)*aL_R (./ppmflux_lev_face_flux) at EVERY face f = 1..NLAT+1 of the regional latlon3d grid at once, OPEN walls included. Face f is the southern edge of cell f: it lies between cell L = f-1 (aC) and cell R = f (aRc), and V[.,f,.] is the face-normal wind there. The CW84 eq (1.6)/(1.8)/(1.10) reconstruction reads the six-cell window f-3..f+2 of the tracer q with the meridional cell widths dphi_lat, edge-extended (max(j-n,1), min(j+n,NLAT)) past the walls. A window member outside the domain is the prescribed lateral-boundary concentration (qbc_s below cell 1, qbc_n above cell NLAT; shape over the two other axes), a constant halo along the wall: each read is ifelse(inside, q at the clamped cell, halo), so the subscript stays in range and the halo is selected exactly. This is the boundary closure the open-wall rule has always used -- every near-wall slab of the earlier spelling read exactly this window -- written so that the lat index is an ordinary array axis and the whole face array is one aggregate. The (south/north) walls are inflow/outflow faces like any other: the upwind selection donates the halo on inflow and the interior parabola on outflow. At q == 1 with the halo == 1 every slope is 0.0 and F = V bitwise.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:latlon3d",
      "op:advection",
      "axes:lon,lat_nodes,lev",
      "order:3",
      "scheme:upwind",
      "stencil_width:6"
    ],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201.",
        "doi": "10.1016/0021-9991(84)90143-8"
      },
      {
        "citation": "Lin, S.-J., & Rood, R. B. (1996). Multidimensional flux-form semi-Lagrangian transport schemes. Monthly Weather Review, 124(9), 2046-2070.",
        "doi": "10.1175/1520-0493(1996)124<2046:MFFSLT>2.0.CO;2"
      },
      {
        "citation": "LeVeque, R. J. (2002). Finite Volume Methods for Hyperbolic Problems. Cambridge University Press. Section 4.1 (the donor-cell upwind flux; the upwind selection is the same whatever sub-grid reconstruction supplies the two one-sided face values)."
      },
      {
        "citation": "Colella, P., & Sekora, M. D. (2008). A limiter for PPM that preserves accuracy at smooth extrema. Journal of Computational Physics, 227(15), 7069-7076.",
        "doi": "10.1016/j.jcp.2008.03.034"
      },
      {
        "citation": "Jacobson, M. Z. (2005). Fundamentals of Atmospheric Modeling (2nd ed.). Cambridge University Press. Chapter 6 (finite-volume flux-form tracer transport; consistency with continuity)."
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "../grid.esm"
    },
    {
      "ref": "./ppmflux_lev_face_flux.esm"
    }
  ],
  "expression_templates": {
    "ppmflux_lat_inflow_faces": {
      "params": [
        "q",
        "V",
        "qbc_s",
        "qbc_n"
      ],
      "body": {
