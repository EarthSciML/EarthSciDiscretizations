{
  "esm": "2.3.0",
  "metadata": {
    "name": "ppmflux_lon_inflow_faces",
    "description": "The upwind-biased, monotone PPM lon face flux F_f = max(U,0)*aR_L + min(U,0)*aL_R (./ppmflux_lev_face_flux) at EVERY face f = 1..NLON+1 of the regional latlon3d grid at once, OPEN walls included. Face f is the western edge of cell f: it lies between cell L = f-1 (aC) and cell R = f (aRc), and U[.,f,.] is the face-normal wind there. The CW84 eq (1.6)/(1.8)/(1.10) reconstruction reads the six-cell window f-3..f+2 of the tracer q with the uniform zonal width dlon_deg. A window member outside the domain is the prescribed lateral-boundary concentration (qbc_w below cell 1, qbc_e above cell NLON; shape over the two other axes), a constant halo along the wall: each read is ifelse(inside, q at the clamped cell, halo), so the subscript stays in range and the halo is selected exactly. This is the boundary closure the open-wall rule has always used -- every near-wall slab of the earlier spelling read exactly this window -- written so that the lon index is an ordinary array axis and the whole face array is one aggregate. The (west/east) walls are inflow/outflow faces like any other: the upwind selection donates the halo on inflow and the interior parabola on outflow. At q == 1 with the halo == 1 every slope is 0.0 and F = U bitwise.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_volume",
      "grid:latlon3d",
      "op:advection",
      "axes:lon_nodes,lat,lev",
      "order:3",
      "scheme:upwind",
      "stencil_width:6"
    ],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201.",
        "doi": "10.1016/0021-9991(84)90143-8"
      },
      {
        "citation": "Lin, S.-J., & Rood, R. B. (1996). Multidimensional flux-form semi-Lagrangian transport schemes. Monthly Weather Review, 124(9), 2046-2070.",
        "doi": "10.1175/1520-0493(1996)124<2046:MFFSLT>2.0.CO;2"
      },
      {
        "citation": "Williamson, D. L., Drake, J. B., Hack, J. J., Jakob, R., & Swarztrauber, P. N. (1992). A standard test set for numerical approximations to the shallow water equations in spherical geometry. Journal of Computational Physics, 102(1), 211-224. (Spherical lat-lon metric factors for the zonal flux divergence.)",
        "doi": "10.1016/S0021-9991(05)80016-6"
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "../grid.esm"
    },
    {
      "ref": "./ppmflux_lev_face_flux.esm"
    }
  ],
  "expression_templates": {
    "ppmflux_lon_inflow_faces": {
      "params": [
        "q",
        "U",
        "qbc_w",
        "qbc_e"
      ],
      "body": {
        "op": "faq",
        "output_idx": [
          "i",
          "j",
          "k"
        ],
        "args": [
          "q",
          "U"
        ],
        "ranges": {
          "i": [
            1,
            {
              "op": "+",
              "args": [
                "NLON",
                1
              ]
            }
          ],
          "j": {
            "from": "lat"
          },
          "k": {
            "from": "lev"
          }
        },
        "expr": {
          "op": "apply_expression_template",
          "args": [],
          "name": "ppmflux_lev_face_flux",
          "bindings": {
            "aL2": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">=",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "i",
                        3
                      ]
                    },
                    1
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    {
                      "op": "max",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "i",
                            3
                          ]
                        },
                        1
                      ]
                    },
                    "j",
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_w",
                    "j",
                    "k"
                  ]
                }
              ]
            },
            "aL1": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">=",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "i",
                        2
                      ]
                    },
                    1
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    {
                      "op": "max",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "i",
                            2
                          ]
                        },
                        1
                      ]
                    },
                    "j",
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_w",
                    "j",
                    "k"
                  ]
                }
              ]
            },
            "aC": {
              "op": "ifelse",
              "args": [
                {
                  "op": ">=",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        "i",
                        1
                      ]
                    },
                    1
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    {
                      "op": "max",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "i",
                            1
                          ]
                        },
                        1
                      ]
                    },
                    "j",
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_w",
                    "j",
                    "k"
                  ]
                }
              ]
            },
            "aRc": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    "i",
                    "NLON"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    {
                      "op": "min",
                      "args": [
                        "i",
                        "NLON"
                      ]
                    },
                    "j",
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_e",
                    "j",
                    "k"
                  ]
                }
              ]
            },
            "aR1": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        "i",
                        1
                      ]
                    },
                    "NLON"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    {
                      "op": "min",
                      "args": [
                        {
                          "op": "+",
                          "args": [
                            "i",
                            1
                          ]
                        },
                        "NLON"
                      ]
                    },
                    "j",
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_e",
                    "j",
                    "k"
                  ]
                }
              ]
            },
            "aR2": {
              "op": "ifelse",
              "args": [
                {
                  "op": "<=",
                  "args": [
                    {
                      "op": "+",
                      "args": [
                        "i",
                        2
                      ]
                    },
                    "NLON"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "q",
                    {
                      "op": "min",
                      "args": [
                        {
                          "op": "+",
                          "args": [
                            "i",
                            2
                          ]
                        },
                        "NLON"
                      ]
                    },
                    "j",
                    "k"
                  ]
                },
                {
                  "op": "index",
                  "args": [
                    "qbc_e",
                    "j",
                    "k"
                  ]
                }
              ]
            },
            "dL2": "dlon_deg",
            "dL1": "dlon_deg",
            "dC": "dlon_deg",
            "dRc": "dlon_deg",
            "dR1": "dlon_deg",
            "dR2": "dlon_deg",
            "w": {
              "op": "index",
              "args": [
                "U",
                "i",
                "j",
                "k"
              ]
            }
          }
        }
      }
    }
  }
}
