        "W"
      ],
      "priority": 10,
      "match": {
        "op": "D",
        "args": [
          {
            "op": "*",
            "args": [
              "W",
              "q"
            ]
          }
        ],
        "wrt": "lev"
      },
      "where": {
        "W": {
          "shape": [
            "lon",
            "lat",
            "lev_nodes"
          ]
        }
      },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [
            [
              1,
              "NLON"
            ],
            [
              1,
              "NLAT"
            ],
            [
