                  "NLEV",
                  1
                ]
              }
            ]
          ],
          [
            [
              1,
              "NLON"
            ],
            [
              1,
              "NLAT"
            ],
            [
              "NLEV",
              "NLEV"
            ]
          ]
        ],
        "values": [
          {
            "op": "apply_expression_template",
