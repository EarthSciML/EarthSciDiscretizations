  "expression_templates": {
    "ppm_flux_D_lon_periodic": {
      "params": [
        "q",
        "U"
      ],
      "priority": 10,
      "match": {
        "op": "D",
        "args": [
          {
            "op": "*",
            "args": [
              "U",
              "q"
            ]
          }
        ],
        "wrt": "lon"
      },
      "where": {
        "U": {
          "shape": [
            "lon_nodes",
            "lat",
            "lev"
          ]
        }
      },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [
            [
              3,
              {
                "op": "-",
                "args": [
                  "NLON",
                  2
                ]
              }
            ],
            [
              1,
              "NLAT"
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              1,
              1
            ],
            [
              1,
              "NLAT"
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              2,
              2
            ],
            [
              1,
              "NLAT"
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              {
                "op": "-",
                "args": [
                  "NLON",
                  1
                ]
              },
              {
                "op": "-",
                "args": [
                  "NLON",
                  1
                ]
              }
            ],
            [
              1,
              "NLAT"
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              "NLON",
              "NLON"
            ],
            [
              1,
              "NLAT"
            ],
            [
              1,
              "NLEV"
            ]
          ]
        ],
        "values": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "ppmflux_D_lon_unlim_interior",
            "bindings": {
              "q": "q",
              "U": "U"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "ppmflux_D_lon_unlim_wrap_i1",
            "bindings": {
              "q": "q",
              "U": "U"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "ppmflux_D_lon_unlim_wrap_i2",
            "bindings": {
              "q": "q",
              "U": "U"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "ppmflux_D_lon_unlim_wrap_iNm1",
            "bindings": {
