    }
  ],
  "expression_templates": {
    "upwind1_flux_D_lev_noflux_bc": {
      "params": [
        "q",
        "W"
      ],
      "priority": 10,
      "match": {
        "op": "D",
        "args": [
          {
            "op": "*",
            "args": [
              "W",
              "q"
            ]
          }
        ],
        "wrt": "lev"
      },
      "where": {
        "q": {
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        },
        "W": {
          "shape": [
            "lon",
            "lat",
            "lev_nodes"
          ]
        }
      },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [
            [
              1,
              "NLON"
            ],
            [
              1,
              "NLAT"
            ],
            [
              2,
              {
                "op": "-",
                "args": [
                  "NLEV",
                  1
                ]
              }
            ]
          ],
          [
            [
              1,
              "NLON"
            ],
            [
              1,
              "NLAT"
            ],
            [
              1,
              1
            ]
          ],
          [
            [
              1,
              "NLON"
            ],
            [
              1,
              "NLAT"
            ],
            [
              "NLEV",
              "NLEV"
            ]
          ]
        ],
        "values": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "upwind1_D_lev_flux_interior",
            "bindings": {
              "q": "q",
              "W": "W"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "upwind1_D_lev_flux_nf_k1",
            "bindings": {
              "q": "q",
              "W": "W"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "upwind1_D_lev_flux_nf_kN",
            "bindings": {
              "q": "q",
              "W": "W"
            }
          }
        ]
      }
    }
  }
}
