  "expression_templates": {
    "upwind1_flux_D_lat_polar": {
      "params": [
        "q",
        "V"
      ],
      "priority": 10,
      "match": {
        "op": "D",
        "args": [
          {
            "op": "*",
            "args": [
              "V",
              "q"
            ]
          }
        ],
        "wrt": "lat"
      },
      "where": {
        "q": {
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        },
        "V": {
          "shape": [
            "lon",
            "lat_nodes",
            "lev"
          ]
        }
      },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [
            [
              1,
              "NLON"
            ],
            [
              2,
              {
                "op": "-",
                "args": [
                  "NLAT",
                  1
                ]
              }
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              1,
              "NLON"
            ],
            [
              1,
              1
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              1,
              "NLON"
            ],
            [
              "NLAT",
              "NLAT"
            ],
            [
              1,
              "NLEV"
            ]
          ]
        ],
        "values": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "upwind1_D_lat_flux_interior",
            "bindings": {
              "q": "q",
              "V": "V"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "upwind1_D_lat_flux_cap_s",
            "bindings": {
              "q": "q",
              "V": "V"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "upwind1_D_lat_flux_cap_n",
            "bindings": {
              "q": "q",
              "V": "V"
            }
          }
