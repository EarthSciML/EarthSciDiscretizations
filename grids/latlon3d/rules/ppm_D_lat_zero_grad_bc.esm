  "expression_templates": {
    "ppm_D_lat_zero_grad_bc": {
      "params": [
        "f"
      ],
      "priority": 10,
      "match": {
        "op": "D",
        "args": [
          "f"
        ],
        "wrt": "lat"
      },
      "where": {
        "f": {
          "shape": [
            "lon",
            "lat",
            "lev"
          ]
        }
      },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [
            [
              1,
              "NLON"
            ],
            [
              4,
              {
                "op": "-",
                "args": [
                  "NLAT",
                  2
                ]
              }
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
