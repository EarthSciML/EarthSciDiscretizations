              1,
              "NLON"
            ],
            [
              2,
              2
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              1,
              "NLON"
            ],
            [
              3,
              3
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              1,
              "NLON"
            ],
            [
              {
                "op": "-",
                "args": [
                  "NLAT",
                  1
                ]
              },
              {
                "op": "-",
                "args": [
                  "NLAT",
                  1
                ]
              }
            ],
            [
              1,
              "NLEV"
            ]
          ],
          [
            [
              1,
              "NLON"
            ],
            [
              "NLAT",
              "NLAT"
            ],
            [
              1,
              "NLEV"
            ]
          ]
        ],
        "values": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "ppm_D_lat_interior",
            "bindings": {
              "f": "f"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "ppm_D_lat_zg_row1",
            "bindings": {
              "f": "f"
            }
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "ppm_D_lat_zg_row2",
            "bindings": {
              "f": "f"
            }
