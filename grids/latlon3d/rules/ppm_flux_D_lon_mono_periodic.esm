      "esd:rule",
      "family:finite_volume",
      "grid:latlon3d",
      "op:advection",
      "axes:lon,lat,lev",
      "order:2",
      "stencil_width:7",
      "scheme:upwind",
      "bc:periodic",
      "form:flux",
      "spec:9.6.8"
    ],
