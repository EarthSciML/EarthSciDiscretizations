                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "/",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "cos",
                          "args": [
                            {
                              "op": "*",
                              "args": [
                                {
                                  "op": "/",
                                  "args": [
                                    3.141592653589793,
                                    180
                                  ]
                                },
                                {
