{
  "esm": "0.8.0",
  "metadata": {
    "name": "latlon",
    "description": "Uniform global longitude-latitude grid: NLON cells around the full 360-degree zonal circle, NLAT cells pole to pole. The `lon` and `lat` index sets are the iteration axes; `dlon_deg` and `dlat_deg` are zero-parameter geometry templates giving the grid spacings in degrees. Defaults (144 x 91) match the esm-spec 9.6.8 worked example.",
    "license": "MIT",
    "tags": ["esd:grid", "family:latlon", "ndim:2", "spacing:uniform", "axis:lon", "axis:lat"]
  },
  "metaparameters": {
    "NLON": { "type": "integer", "default": 144, "description": "Number of cells along longitude (full circle)." },
    "NLAT": { "type": "integer", "default": 91, "description": "Number of cells along latitude (pole to pole)." }
  },
  "index_sets": {
    "lon": { "kind": "interval", "size": "NLON" },
    "lat": { "kind": "interval", "size": "NLAT" }
  },
  "expression_templates": {
    "dlon_deg": {
      "params": [],
      "description": "Zonal grid spacing in degrees: 360 / NLON.",
      "body": { "op": "/", "args": [360, "NLON"] }
    },
    "dlat_deg": {
      "params": [],
      "description": "Meridional grid spacing in degrees: 180 / (NLAT - 1) for a pole-to-pole point grid.",
      "body": { "op": "/", "args": [180, { "op": "-", "args": ["NLAT", 1] }] }
    }
  }
}
