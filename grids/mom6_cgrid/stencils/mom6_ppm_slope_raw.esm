{
  "esm": "2.2.0",
  "metadata": {
    "name": "mom6_ppm_slope_raw",
    "description": "The unlimited centered slope of one cell of the MOM6 PPM reconstruction (PPM_reconstruction_x, MOM_continuity_PPM.F90:2401, slp = 0.5*(h_in(i+1) - h_in(i-1))): s = 0.5*(h_p1 - h_m1). The sign test and the magnitude of mom6_ppm_slope both read it; mom6_ppm_slope_mag limits its magnitude. Pure scalar algebra, [m].",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:reconstruct"],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201.",
        "doi": "10.1016/0021-9991(84)90143-8"
      }
    ]
  },
  "expression_templates": {
    "mom6_ppm_slope_raw": {
      "params": ["h_m1", "h_p1"],
      "description": "The unlimited centered PPM slope of one cell (MOM_continuity_PPM.F90:2401)",
      "body": { "op": "*", "args": [0.5, { "op": "-", "args": ["h_p1", "h_m1"] }] }
    }
  }
}
