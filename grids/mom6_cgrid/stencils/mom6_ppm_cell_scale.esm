{
  "esm": "2.2.0",
  "metadata": {
    "name": "mom6_ppm_cell_scale",
    "description": "The PPM_limit_pos scale of one cell from its 5-cell stencil (PPM_reconstruction_x then PPM_limit_pos, MOM_continuity_PPM.F90:2430-2433, 2665-2677): mom6_ppm_limit_scale with hL_raw = mom6_ppm_edge_w and hR_raw = mom6_ppm_edge_e of the cell, h_0 the cell's thickness and h_min_recon the floor. Both limited edges of the cell (mom6_ppm_upwind_flux_pos/neg) scale toward h_0 by this one number. Positional stencil params h_m2..h_p2 / m_m2..m_p2 (two cells left of the cell to two cells right of it, along the reconstruction axis). Pure scalar algebra, dimensionless.",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:limit"],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201.",
        "doi": "10.1016/0021-9991(84)90143-8"
      }
    ]
  },
  "expression_template_imports": [
    { "ref": "./mom6_ppm_edge_w.esm" },
    { "ref": "./mom6_ppm_edge_e.esm" },
    { "ref": "./mom6_ppm_limit_scale.esm" }
  ],
  "expression_templates": {
    "mom6_ppm_cell_scale": {
      "params": ["h_m2", "h_m1", "h_0", "h_p1", "h_p2", "m_m2", "m_m1", "m_0", "m_p1", "m_p2", "h_min_recon"],
      "description": "The PPM_limit_pos scale of one cell from its 5-cell stencil (MOM_continuity_PPM.F90:2430-2433, 2665-2677)",
      "body": {
        "op": "apply_expression_template",
        "args": [],
        "name": "mom6_ppm_limit_scale",
        "bindings": {
          "hL_raw": { "op": "apply_expression_template", "args": [], "name": "mom6_ppm_edge_w", "bindings": { "h_m2": "h_m2", "h_m1": "h_m1", "h_0": "h_0", "h_p1": "h_p1", "m_m2": "m_m2", "m_m1": "m_m1", "m_0": "m_0", "m_p1": "m_p1" } },
          "hR_raw": { "op": "apply_expression_template", "args": [], "name": "mom6_ppm_edge_e", "bindings": { "h_m1": "h_m1", "h_0": "h_0", "h_p1": "h_p1", "h_p2": "h_p2", "m_m1": "m_m1", "m_0": "m_0", "m_p1": "m_p1", "m_p2": "m_p2" } },
          "h_0": "h_0",
          "h_min_recon": "h_min_recon"
        }
      }
    }
  }
}
