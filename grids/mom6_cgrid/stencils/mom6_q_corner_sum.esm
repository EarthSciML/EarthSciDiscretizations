{
  "esm": "2.3.0",
  "metadata": {
    "name": "mom6_q_corner_sum",
    "description": "The q-cell corner sum of MOM6 (MOM_CoriolisAdv.F90 CorAdCalc :542, hArea_q = (hArea_u(I,j) + hArea_u(I,j+1)) + (hArea_v(i,J) + hArea_v(i+1,J))): sum = (x_s + x_n) + (x_w + x_e), the two u-face values south and north of the q-point plus the two v-face values west and east of it, in the Fortran's grouping. mom6_cgrid_sum_q binds it at every q-point; a face beyond the domain is a land face whose value is 0 (Area_h = 0 on land makes hArea_u/hArea_v vanish there). Pure scalar algebra.",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:sum"],
    "references": [
      {
        "citation": "Sadourny, R. (1975). The dynamics of finite-difference models of the shallow-water equations. Journal of the Atmospheric Sciences, 32(4), 680-689.",
        "doi": "10.1175/1520-0469(1975)032<0680:TDOFDM>2.0.CO;2"
      },
      {
        "citation": "Adcroft, A., et al. (2019). The GFDL global ocean and sea ice model OM4.0. Journal of Advances in Modeling Earth Systems, 11(10), 3167-3211.",
        "doi": "10.1029/2019MS001726"
      }
    ]
  },
  "expression_templates": {
    "mom6_q_corner_sum": {
      "params": ["x_s", "x_n", "x_w", "x_e"],
      "description": "The q-cell corner sum (x_s + x_n) + (x_w + x_e) (MOM_CoriolisAdv.F90:542)",
      "body": { "op": "+", "args": [{ "op": "+", "args": ["x_s", "x_n"] }, { "op": "+", "args": ["x_w", "x_e"] }] }
    }
  }
}
