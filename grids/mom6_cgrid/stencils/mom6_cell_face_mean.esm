{
  "esm": "2.2.0",
  "metadata": {
    "name": "mom6_cell_face_mean",
    "description": "The four-face mean of a T cell (MOM_CoriolisAdv.F90 gradKE :1290-1297, the KE_ARAKAWA sum without its IareaT factor): mean = 0.25*((x_e + x_w) + (x_n + x_s)), the cell's east and west u-face values plus its north and south v-face values, in the Fortran's grouping. mom6_cgrid_avg_cell binds it at every cell; a closed wall face contributes 0 (MOM6's zero wall velocity). Pure scalar algebra.",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:avg"],
    "references": [
      {
        "citation": "Sadourny, R. (1975). The dynamics of finite-difference models of the shallow-water equations. Journal of the Atmospheric Sciences, 32(4), 680-689.",
        "doi": "10.1175/1520-0469(1975)032<0680:TDOFDM>2.0.CO;2"
      },
      {
        "citation": "Adcroft, A., et al. (2019). The GFDL global ocean and sea ice model OM4.0. Journal of Advances in Modeling Earth Systems, 11(10), 3167-3211.",
        "doi": "10.1029/2019MS001726"
      }
    ]
  },
  "expression_templates": {
    "mom6_cell_face_mean": {
      "params": ["x_e", "x_w", "x_n", "x_s"],
      "description": "The four-face mean 0.25*((x_e + x_w) + (x_n + x_s)) of a T cell (MOM_CoriolisAdv.F90:1290-1297)",
      "body": {
        "op": "*",
        "args": [{ "op": "const", "args": [], "value": 0.25, "units": "1" }, { "op": "+", "args": [{ "op": "+", "args": ["x_e", "x_w"] }, { "op": "+", "args": ["x_n", "x_s"] }] }]
      }
    }
  }
}
