{
  "esm": "2.2.0",
  "metadata": {
    "name": "mom6_ppm_curv",
    "description": "The grid-normalized curvature of one cell's PPM parabola (PPM_limit_pos, MOM_continuity_PPM.F90:2665): curv = 3*((hL_raw + hR_raw) - 2*h_0), positive exactly when the parabola through the raw edges and the cell mean is convex (a minimum, the only case PPM_limit_pos limits). Read by mom6_ppm_limit_scale and its numerator/denominator sub-laws mom6_ppm_limit_scale_num/den. Pure scalar algebra, [m].",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:limit"],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201. (The positive-definiteness argument behind PPM_limit_pos.)",
        "doi": "10.1016/0021-9991(84)90143-8"
      }
    ]
  },
  "expression_templates": {
    "mom6_ppm_curv": {
      "params": ["hL_raw", "hR_raw", "h_0"],
      "description": "The PPM_limit_pos curvature of one cell (MOM_continuity_PPM.F90:2665)",
      "body": {
        "op": "*",
        "args": [3.0, { "op": "-", "args": [{ "op": "+", "args": ["hL_raw", "hR_raw"] }, { "op": "*", "args": [2.0, "h_0"] }] }]
      }
    }
  }
}
