{
  "esm": "2.4.0",
  "metadata": {
    "name": "mom6_ppm_edge_w",
    "description": "The raw (un-limited) LEFT (west/south) edge of one cell's MOM6 PPM parabola from the cell's 4-cell stencil (PPM_reconstruction_x, MOM_continuity_PPM.F90:2430, 2432): h_W = mom6_ppm_edge with h_side = h_m1, m_side = m_m1, slp_side = the left neighbour's slope mom6_ppm_slope(h_m2, h_m1, h_0) and slp_0 = the cell's own slope mom6_ppm_slope(h_m1, h_0, h_p1), i.e. h_W = 0.5*(h_im1 + h_0) + (slp(i-1) - slp(i))/6 with the masked-neighbour replacement h_im1. The stencil params are positional relative to the cell (m2 = two cells to the left, ..., p1 = one cell to the right) so the same law serves both axes and every cell the rules bind it to. Pure scalar algebra, [m].",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:reconstruct"],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201.",
        "doi": "10.1016/0021-9991(84)90143-8"
      }
    ]
  },
  "operator_imports": [{ "ref": "./mom6_ppm_slope.esm" }, { "ref": "./mom6_ppm_edge.esm" }],
  "operators": {
    "mom6_ppm_edge_w": {
      "params": ["h_m2", "h_m1", "h_0", "h_p1", "m_m2", "m_m1", "m_0", "m_p1"],
      "description": "The raw left PPM edge of one cell (MOM_continuity_PPM.F90:2430, 2432)",
      "body": {
        "op": "apply_operator",
        "args": [],
        "name": "mom6_ppm_edge",
        "bindings": {
          "h_side": "h_m1",
          "h_0": "h_0",
          "slp_side": {
            "op": "apply_operator",
            "args": [],
            "name": "mom6_ppm_slope",
            "bindings": { "h_m1": "h_m2", "h_0": "h_m1", "h_p1": "h_0", "m_m1": "m_m2", "m_0": "m_m1", "m_p1": "m_0" }
          },
          "slp_0": {
            "op": "apply_operator",
            "args": [],
            "name": "mom6_ppm_slope",
            "bindings": { "h_m1": "h_m1", "h_0": "h_0", "h_p1": "h_p1", "m_m1": "m_m1", "m_0": "m_0", "m_p1": "m_p1" }
          },
          "m_side": "m_m1"
        }
      }
    }
  }
}
