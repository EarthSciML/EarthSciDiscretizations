{
  "esm": "2.4.0",
  "metadata": {
    "name": "mom6_ppm_dh",
    "description": "The edge difference of one cell's PPM parabola (PPM_limit_pos, MOM_continuity_PPM.F90:2667): dh = hR_raw - hL_raw. With mom6_ppm_curv it locates the parabola's extremum (|dh| < curv puts the minimum inside the cell) and sizes its depth (curv^2 + 3*dh^2, mom6_ppm_limit_scale_den). Pure scalar algebra, [m].",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:limit"],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201. (The positive-definiteness argument behind PPM_limit_pos.)",
        "doi": "10.1016/0021-9991(84)90143-8"
      }
    ]
  },
  "operators": {
    "mom6_ppm_dh": {
      "params": ["hL_raw", "hR_raw"],
      "description": "The PPM_limit_pos edge difference of one cell (MOM_continuity_PPM.F90:2667)",
      "body": { "op": "-", "args": ["hR_raw", "hL_raw"] }
    }
  }
}
