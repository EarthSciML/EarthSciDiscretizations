{
  "esm": "2.3.0",
  "metadata": {
    "name": "mom6_ppm_limit_scale_den",
    "description": "The denominator of the PPM_limit_pos scale (MOM_continuity_PPM.F90:2671, 2674): den = curv^2 + 3*dh^2 with curv = mom6_ppm_curv and dh = mom6_ppm_dh (the Fortran's curv**2 + 3.0*dh**2, spelled as products). den/(12*curv) is the depth of the parabola's minimum below the cell mean. Pure scalar algebra, [m^2].",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:limit"],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201. (The positive-definiteness argument behind PPM_limit_pos.)",
        "doi": "10.1016/0021-9991(84)90143-8"
      }
    ]
  },
  "expression_template_imports": [{ "ref": "./mom6_ppm_curv.esm" }, { "ref": "./mom6_ppm_dh.esm" }],
  "expression_templates": {
    "mom6_ppm_limit_scale_den": {
      "params": ["hL_raw", "hR_raw", "h_0"],
      "description": "The PPM_limit_pos scale denominator curv^2 + 3*dh^2 of one cell (MOM_continuity_PPM.F90:2671, 2674)",
      "body": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              { "op": "apply_expression_template", "args": [], "name": "mom6_ppm_curv", "bindings": { "hL_raw": "hL_raw", "hR_raw": "hR_raw", "h_0": "h_0" } },
              { "op": "apply_expression_template", "args": [], "name": "mom6_ppm_curv", "bindings": { "hL_raw": "hL_raw", "hR_raw": "hR_raw", "h_0": "h_0" } }
            ]
          },
          {
            "op": "*",
            "args": [
              3.0,
              {
                "op": "*",
                "args": [
                  { "op": "apply_expression_template", "args": [], "name": "mom6_ppm_dh", "bindings": { "hL_raw": "hL_raw", "hR_raw": "hR_raw" } },
                  { "op": "apply_expression_template", "args": [], "name": "mom6_ppm_dh", "bindings": { "hL_raw": "hL_raw", "hR_raw": "hR_raw" } }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
