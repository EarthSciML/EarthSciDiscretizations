{
  "esm": "0.8.0",
  "metadata": {
    "name": "cartesian_uniform_1d",
    "description": "Uniform 1-D Cartesian grid on the unit interval [0, 1]: N cell-centered points, spacing dx = 1/N, cell centers x_i = (i - 1/2) dx. The index set `x` is the iteration axis; `dx` and `x_coord` are zero-parameter geometry templates (esm-spec 9.7: grid geometry is ordinary expressions, resolution-generic through the metaparameter N).",
    "license": "MIT",
    "tags": ["esd:grid", "family:cartesian", "ndim:1", "spacing:uniform", "axis:x"]
  },
  "metaparameters": {
    "N": { "type": "integer", "default": 64, "description": "Number of cells along x." }
  },
  "index_sets": {
    "x": { "kind": "interval", "size": "N" }
  },
  "expression_templates": {
    "dx": {
      "params": [],
      "description": "Grid spacing 1/N on the unit interval.",
      "body": { "op": "/", "args": [1, "N"] }
    },
    "x_coord": {
      "params": [],
      "description": "Cell-center coordinates x_i = (i - 1/2) dx, shaped over the x index set.",
      "body": {
        "op": "aggregate",
        "output_idx": ["i"],
        "args": [],
        "ranges": { "i": { "from": "x" } },
        "expr": {
          "op": "*",
          "args": [
            { "op": "-", "args": ["i", 0.5] },
            { "op": "apply_expression_template", "args": [], "name": "dx", "bindings": {} }
          ]
        }
      }
    }
  }
}
