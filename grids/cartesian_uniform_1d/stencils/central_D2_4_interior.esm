{
  "esm": "0.8.0",
  "metadata": {
    "name": "central_D2_4_interior",
    "description": "Interior-only 5-point fourth-order centered second derivative on cartesian_uniform_1d: (-f[i-2] + 16 f[i-1] - 30 f[i] + 16 f[i+1] - f[i+2]) / (12 dx^2) over i in [3, N-2]. Match-less named template; boundary-condition layers (rules/) wrap it into complete rewrite rules. `dx` is a free name resolving to the consuming model's spacing variable (the grid's consumer-supplied geometry contract; see grids/cartesian_uniform_1d/grid.esm). O(dx^4) on this uniform grid — the 4th-order companion to the 3-point central_D2_interior.",
    "license": "MIT",
    "tags": ["esd:stencil", "family:finite_difference", "grid:cartesian_uniform_1d", "op:D2", "order:4", "stencil_width:5"],
    "references": [
      {
        "citation": "Fornberg, B. (1988). Generation of finite difference formulas on arbitrarily spaced grids. Mathematics of Computation 51(184), 699-706.",
        "doi": "10.1090/S0025-5718-1988-0935077-0"
      }
    ]
  },
  "expression_template_imports": [
    { "ref": "../grid.esm" }
  ],
  "expression_templates": {
    "central_D2_4_interior": {
      "params": ["f"],
      "body": {
        "op": "aggregate",
        "output_idx": ["i"],
        "args": ["f"],
        "ranges": { "i": [3, { "op": "-", "args": ["N", 2] }] },
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "+",
              "args": [
                { "op": "*", "args": [-1, { "op": "index", "args": ["f", { "op": "-", "args": ["i", 2] }] }] },
                { "op": "*", "args": [16, { "op": "index", "args": ["f", { "op": "-", "args": ["i", 1] }] }] },
                { "op": "*", "args": [-30, { "op": "index", "args": ["f", "i"] }] },
                { "op": "*", "args": [16, { "op": "index", "args": ["f", { "op": "+", "args": ["i", 1] }] }] },
                { "op": "*", "args": [-1, { "op": "index", "args": ["f", { "op": "+", "args": ["i", 2] }] }] }
              ]
            },
            { "op": "*", "args": [12, "dx", "dx"] }
          ]
        }
      }
    }
  }
}
