{
  "esm": "1.0.0",
  "metadata": {
    "name": "central_D1_interior",
    "description": "Interior-only 3-point centered first derivative on cartesian_uniform_1d: (f[i+1] - f[i-1]) / (2 dx) over i in [2, N-1]. Match-less named template; boundary-condition layers (rules/) wrap it into complete rewrite rules. `dx` is a free name resolving to the consuming model's spacing variable (the grid's consumer-supplied geometry contract; see grids/cartesian_uniform_1d/grid.esm). O(dx^2) on this uniform grid.",
    "license": "MIT",
    "tags": ["esd:stencil", "family:finite_difference", "grid:cartesian_uniform_1d", "op:D", "order:2", "stencil_width:3"],
    "references": [
      {
        "citation": "Fornberg, B. (1988). Generation of finite difference formulas on arbitrarily spaced grids. Mathematics of Computation 51(184), 699-706.",
        "doi": "10.1090/S0025-5718-1988-0935077-0"
      }
    ]
  },
  "expression_template_imports": [
    { "ref": "../grid.esm" }
  ],
  "expression_templates": {
    "central_D1_interior": {
      "params": ["f"],
      "body": {
        "op": "aggregate",
        "output_idx": ["i"],
        "args": ["f"],
        "ranges": { "i": [2, { "op": "-", "args": ["N", 1] }] },
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "-",
              "args": [
                { "op": "index", "args": ["f", { "op": "+", "args": ["i", 1] }] },
                { "op": "index", "args": ["f", { "op": "-", "args": ["i", 1] }] }
              ]
            },
            { "op": "*", "args": [2, "dx"] }
          ]
        }
      }
    }
  }
}
