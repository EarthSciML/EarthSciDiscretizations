{
  "esm": "0.8.0",
  "metadata": {
    "name": "upwind1_D_periodic",
    "description": "First-order upwind (backward) first derivative with periodic boundary on cartesian_uniform_1d, for advection with non-negative transport speed: interior i in [2, N]: (f[i] - f[i-1]) / dx; the i=1 face wraps periodically to (f[1] - f[N]) / dx. The wrap is an explicit makearray face region, following the ESS pde_simulation fixture precedent for periodic boundaries. Matches plain D(f, wrt: x) at default priority, so compound rules (e.g. a second-derivative rule at priority 10) fire first. O(dx). Sign convention: upwind for flow in +x; a sign-aware variant belongs in a separate rule.",
    "license": "MIT",
    "tags": ["esd:rule", "family:finite_difference", "grid:cartesian_uniform_1d", "op:D", "axes:x", "order:1", "stencil_width:2", "bc:periodic", "spec:9.6.8"],
    "references": [
      {
        "citation": "LeVeque, R. J. (2002). Finite Volume Methods for Hyperbolic Problems. Cambridge University Press. Section 4.8 (upwind methods)."
      }
    ]
  },
  "expression_template_imports": [
    { "ref": "../grid.esm" }
  ],
  "expression_templates": {
    "upwind1_D_periodic": {
      "params": ["f"],
      "match": { "op": "D", "args": ["f"], "wrt": "x" },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [[2, "N"]],
          [[1, 1]]
        ],
        "values": [
          {
            "op": "aggregate",
            "output_idx": ["i"],
            "args": ["f"],
            "ranges": { "i": [2, "N"] },
            "expr": {
              "op": "/",
              "args": [
                {
                  "op": "-",
                  "args": [
                    { "op": "index", "args": ["f", "i"] },
                    { "op": "index", "args": ["f", { "op": "-", "args": ["i", 1] }] }
                  ]
                },
                { "op": "apply_expression_template", "args": [], "name": "dx", "bindings": {} }
              ]
            }
          },
          {
            "op": "/",
            "args": [
              {
                "op": "-",
                "args": [
                  { "op": "index", "args": ["f", 1] },
                  { "op": "index", "args": ["f", "N"] }
                ]
              },
              { "op": "apply_expression_template", "args": [], "name": "dx", "bindings": {} }
            ]
          }
        ]
      }
    }
  }
}
