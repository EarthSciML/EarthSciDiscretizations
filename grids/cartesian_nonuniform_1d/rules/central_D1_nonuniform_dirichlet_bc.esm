                              { "op": "index", "args": ["xc", 1] }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  { "op": "index", "args": ["f", 1] }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "/",
                        "args": [
                          { "op": "index", "args": ["dxw", 1] },
                          2
                        ]
                      },
                      {
                        "op": "*",
