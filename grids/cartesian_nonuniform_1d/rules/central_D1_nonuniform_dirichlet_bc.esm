          [[2, { "op": "-", "args": ["N", 1] }]],
          [[1, 1]],
          [["N", "N"]]
        ],
        "values": [
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "central_D1_nonuniform_interior",
            "bindings": { "f": "f" }
          },
          {
            "op": "+",
            "args": [
