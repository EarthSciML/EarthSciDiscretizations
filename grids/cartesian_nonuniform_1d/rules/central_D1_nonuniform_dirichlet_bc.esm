                                  { "op": "index", "args": ["xc", 1] }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "gL"
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "op": "/",
                    "args": [
                      {
                        "op": "-",
                        "args": [
                          {
                            "op": "-",
                            "args": [
                              { "op": "index", "args": ["xc", 2] },
                              { "op": "index", "args": ["xc", 1] }
                            ]
                          },
                          {
                            "op": "/",
                            "args": [
