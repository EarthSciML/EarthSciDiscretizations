                  4290,
                  "f5"
                ]
              },
              {
                "op": "*",
                "args": [
                  -1404,
                  "f6"
                ]
              },
              {
                "op": "*",
                "args": [
                  187,
                  "f7"
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              25740,
              "dx",
              "dx"
            ]
          }
        ]
      }
    }
  }
}
