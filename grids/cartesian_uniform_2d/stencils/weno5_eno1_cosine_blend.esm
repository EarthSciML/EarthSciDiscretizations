{
  "esm": "1.0.0",
  "metadata": {
    "name": "weno5_eno1_cosine_blend",
    "description": "Pointwise convex combination m w + (1 - m) e of a high-order and a low-order derivative, the blending step of NCAR fire_behavior's fire_upwinding = 10 (physics/level_set_mod.F90 Calc_tend_ls case 10): diff2 = mask diff2_weno + (1 - mask) diff2_eno. Written as a named template purely so the caller binds the mask once instead of inlining the cosine twice per axis; it carries no branching and no grid dependence.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_difference",
      "grid:cartesian_uniform_2d",
      "op:blend",
      "axes:x,y",
      "order:1",
      "stencil_width:1"
    ],
    "references": [
      {
        "citation": "NCAR Community Fire Behavior Model (fire_behavior), develop @ eb77580, physics/level_set_mod.F90 Calc_tend_ls case 10 (WENO5/ENO1 with a blending zone)."
      }
    ]
  },
  "expression_template_imports": [],
  "expression_templates": {
    "weno5_eno1_cosine_blend": {
      "params": [
        "m",
        "w",
        "e"
      ],
      "body": {
        "op": "+",
        "args": [
          {
            "op": "*",
            "args": [
              "m",
              "w"
            ]
          },
          {
            "op": "*",
            "args": [
              {
                "op": "-",
                "args": [
                  1.0,
                  "m"
                ]
              },
              "e"
            ]
          }
        ]
      }
    }
  }
}
