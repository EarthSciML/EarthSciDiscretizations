{
  "esm": "1.0.0",
  "metadata": {
    "name": "central_D2y_interior",
    "description": "Interior-only 3-point centered second derivative along y on cartesian_uniform_2d: (f[i,j+1] - 2 f[i,j] + f[i,j-1]) / dy^2 over j in [2, NY-1], all i. Match-less named template; the boundary-condition layer (rules/central_D2y_neumann_bc.esm) wraps it with the y-edge faces. `dy` is a free name resolving to the consuming model's y-spacing variable (the grid's consumer-supplied geometry contract; see grids/cartesian_uniform_2d/grid.esm). O(dy^2). The 2-D Laplacian is assembled in the consuming equation as D(D(f,x),x) + D(D(f,y),y), each half lowered by its own per-axis rule.",
    "license": "MIT",
    "tags": ["esd:stencil", "family:finite_difference", "grid:cartesian_uniform_2d", "op:D2", "order:2", "stencil_width:3"],
    "references": [
      {
        "citation": "Fornberg, B. (1988). Generation of finite difference formulas on arbitrarily spaced grids. Mathematics of Computation 51(184), 699-706.",
        "doi": "10.1090/S0025-5718-1988-0935077-0"
      }
    ]
  },
  "expression_template_imports": [
    { "ref": "../grid.esm" }
  ],
  "expression_templates": {
    "central_D2y_interior": {
      "params": ["f"],
      "body": {
        "op": "aggregate",
        "output_idx": ["i", "j"],
        "args": ["f"],
        "ranges": {
          "i": { "from": "x" },
          "j": [2, { "op": "-", "args": ["NY", 1] }]
        },
        "expr": {
          "op": "/",
          "args": [
            {
              "op": "+",
              "args": [
                { "op": "index", "args": ["f", "i", { "op": "+", "args": ["j", 1] }] },
                { "op": "*", "args": [-2, { "op": "index", "args": ["f", "i", "j"] }] },
                { "op": "index", "args": ["f", "i", { "op": "-", "args": ["j", 1] }] }
              ]
            },
            { "op": "*", "args": ["dy", "dy"] }
          ]
        }
      }
    }
  }
}
