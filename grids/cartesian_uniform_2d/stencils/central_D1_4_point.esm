{
  "esm": "1.0.0",
  "metadata": {
    "name": "central_D1_4_point",
    "description": "Pointwise fourth-order centered first derivative along one axis from the four neighbours m2, m1, p1, p2 (cells i-2, i-1, i+1, i+2) and the spacing h: (8 (p1 - m1) - (p2 - m2))/(12 h). Algebraically identical to fire_behavior's Select_4th, which forms it as the difference of two fourth-order face fluxes (7 p1 + 7 c - p2 - m1)/(12 h) - (7 c + 7 m1 - p1 - m2)/(12 h) (the cell value cancels). Used by the hybrid level-set stencils only to build the upwind SELECTOR of the WENO5 derivative (the wind-relative propagation sign), never as the derivative itself. Match-less helper.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_difference",
      "grid:cartesian_uniform_2d",
      "op:D",
      "axes:x",
      "order:4",
      "stencil_width:5"
    ],
    "references": [
      {
        "citation": "NCAR Community Fire Behavior Model (fire_behavior), develop @ eb77580, physics/level_set_mod.F90: Calc_tend_ls, Select_eno, Select_weno5, Select_4th, Select_godunov (case 4), Extrapol_var_at_bdys. The transcribed reference implementation."
      }
    ]
  },
  "expression_template_imports": [],
  "expression_templates": {
    "central_D1_4_point": {
      "params": [
        "h",
        "m2",
        "m1",
        "p1",
        "p2"
      ],
      "body": {
        "op": "/",
        "args": [
          {
            "op": "-",
            "args": [
              {
                "op": "*",
                "args": [
                  8,
                  {
                    "op": "-",
                    "args": [
                      "p1",
                      "m1"
                    ]
                  }
                ]
              },
              {
                "op": "-",
                "args": [
                  "p2",
                  "m2"
                ]
              }
            ]
          },
          {
            "op": "*",
            "args": [
              12,
              "h"
            ]
          }
        ]
      }
    }
  }
}
