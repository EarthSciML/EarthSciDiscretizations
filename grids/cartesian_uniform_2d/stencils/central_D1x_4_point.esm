{
  "esm": "1.2.0",
  "metadata": {
    "name": "central_D1x_4_point",
    "description": "Pointwise fourth-order central derivative d u/dx at the cell (i, j) of cartesian_uniform_2d: stencils/central_D1_4_point bound to u at offsets -2, -1, +1, +2 along x and spacing dx. fire_behavior's Select_4th (dx, lfn(i, j), ...). u is the field, i and j the cell indices, bound by the caller's faq. It is not a derivative the level-set rules return: it only builds their upwind selectors (stencils/grad4_dot_wind, and the per-axis factor of signo_x). It reaches two cells either side along x.",
    "license": "MIT",
    "tags": [
      "esd:stencil",
      "family:finite_difference",
      "grid:cartesian_uniform_2d",
      "op:D",
      "axes:x",
      "order:4",
      "stencil_width:5"
    ],
    "references": [
      {
        "citation": "NCAR Community Fire Behavior Model (fire_behavior), develop @ eb77580, physics/level_set_mod.F90: Calc_tend_ls, Select_eno, Select_weno5, Select_4th, Select_godunov (case 4), Extrapol_var_at_bdys. The transcribed reference implementation."
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "central_D1_4_point.esm"
    }
  ],
  "expression_templates": {
    "central_D1x_4_point": {
      "params": [
        "u",
        "i",
        "j"
      ],
      "body": {
        "op": "apply_expression_template",
        "args": [],
        "name": "central_D1_4_point",
        "bindings": {
          "h": "dx",
          "m2": {
            "op": "index",
            "args": [
              "u",
              {
                "op": "-",
                "args": [
                  "i",
                  2
                ]
              },
              "j"
            ]
          },
          "m1": {
            "op": "index",
            "args": [
              "u",
              {
                "op": "-",
                "args": [
                  "i",
                  1
                ]
              },
              "j"
            ]
          },
          "p1": {
            "op": "index",
            "args": [
              "u",
              {
                "op": "+",
                "args": [
                  "i",
                  1
                ]
              },
              "j"
            ]
          },
          "p2": {
            "op": "index",
            "args": [
              "u",
              {
                "op": "+",
                "args": [
                  "i",
                  2
                ]
              },
              "j"
            ]
          }
        }
      }
    }
  }
}
