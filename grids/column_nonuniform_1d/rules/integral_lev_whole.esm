{
  "esm": "1.0.0",
  "metadata": {
    "name": "integral_lev_whole",
    "description": "Whole-column integral: lowers integral(f, var: lev, lower: a, upper: b) with BOTH bounds bound to anything other than the axis names (constants, parameters, or expressions, e.g. the surface and top interface coordinates) to the composite midpoint sum over all NLEV layers, sum_j f[j] dz[j], a scalar. Priority 0 so the cumulative forms (priority 10, which name the axis in one bound) win wherever they apply. Typical uses: column burden, column-integrated heating, precipitable water, the total optical depth. The integrand `f` must be a bare layer-shaped (lev) field of THIS grid (where {f: {shape: [lev]}}, esm-spec 9.6.1); bind a compound integrand to a declared [lev] observed first. The measure is the consumer's free-name layer-thickness observed `dz` (grids/column_nonuniform_1d/grid.esm) -- rebind it at the import edge (esm-spec 9.7.7) to integrate against another monotone layer measure such as dp/g. The integral node's `var` names the axis (`lev`); esm-spec 4.2 leaves the bounds measure-free, so the bounds carry no numeric weight here: they select the FORM of the sum (whole column / cumulative from the surface / cumulative from the top / to layer centres / to interfaces) and are otherwise documentation. Because the layer values are midpoint samples, every form is the composite midpoint rule and is second-order accurate on a smoothly stretched column.",
    "license": "MIT",
    "tags": [
      "esd:rule",
      "family:finite_volume",
      "grid:column_nonuniform_1d",
      "op:integral",
      "order:2",
      "stencil_width:1",
      "bc:none",
      "spec:9.6.8",
      "axes:lev"
    ],
    "references": [
      {
        "citation": "LeVeque, R. J. (2007). Finite Difference Methods for Ordinary and Partial Differential Equations. SIAM. Section 2.13 (nonuniform grids)."
      },
      {
        "citation": "Davis, P. J. and Rabinowitz, P. (1984). Methods of Numerical Integration, 2nd ed. Academic Press. Section 2.1 (the midpoint rule and its error)."
      }
    ]
  },
  "expression_template_imports": [
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "integral_lev_whole": {
      "params": [
        "f",
        "a",
        "b"
      ],
      "priority": 0,
      "match": {
        "op": "integral",
        "args": [
          "f"
        ],
        "var": "lev",
        "lower": "a",
        "upper": "b"
      },
      "where": {
        "f": {
          "shape": [
            "lev"
          ]
        }
      },
      "body": {
        "op": "aggregate",
        "output_idx": [],
        "reduce": "+",
        "args": [
          "f"
        ],
        "ranges": {
          "j": {
            "from": "lev"
          }
        },
        "expr": {
          "op": "*",
          "args": [
            {
              "op": "index",
              "args": [
                "f",
                "j"
              ]
            },
            {
              "op": "index",
              "args": [
                "dz",
                "j"
              ]
            }
          ]
        }
      }
    }
  }
}
