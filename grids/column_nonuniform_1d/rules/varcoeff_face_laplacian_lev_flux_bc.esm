                "args": [
                  "kdudz_top",
                  {
                    "op": "*",
                    "args": [
                      {
                        "op": "index",
                        "args": [
                          "K",
                          "NLEV"
                        ]
                      },
                      {
                        "op": "/",
                        "args": [
                          {
                            "op": "-",
                            "args": [
                              {
                                "op": "index",
                                "args": [
                                  "u",
                                  "NLEV"
                                ]
