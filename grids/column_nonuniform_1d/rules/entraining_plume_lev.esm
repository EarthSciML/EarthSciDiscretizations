      "ref": "../stencils/entraining_plume_lev_interior.esm"
    }
  ],
  "expression_templates": {
    "entraining_plume_lev": {
      "params": [
        "phi_env",
        "lam",
        "src",
        "phi0",
        "phi"
      ],
      "match": {
        "op": "entraining_plume_lev",
        "args": [
          "phi_env",
          "lam",
          "src",
          "phi0",
          "phi"
        ]
      },
      "where": {
        "phi_env": {
          "shape": [
            "lev"
          ]
        },
        "lam": {
          "shape": [
            "lev"
          ]
        },
        "src": {
          "shape": [
            "lev"
          ]
        },
        "phi": {
          "shape": [
            "lev"
          ]
        }
      },
      "body": {
        "op": "makearray",
        "args": [],
        "regions": [
          [
            [
              1,
              1
            ]
          ],
          [
            [
              2,
              "NLEV"
            ]
          ]
        ],
        "values": [
          {
            "op": "faq",
            "output_idx": [
              "k"
            ],
            "args": [
              "phi0"
            ],
            "ranges": {
              "k": [
                1,
                1
              ]
            },
            "expr": "phi0"
          },
          {
            "op": "apply_expression_template",
            "args": [],
            "name": "entraining_plume_lev_interior",
            "bindings": {
              "phi_env": "phi_env",
              "lam": "lam",
              "src": "src",
              "phi": "phi"
            }
          }
        ]
      }
    }
  }
}
