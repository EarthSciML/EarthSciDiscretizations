{
  "esm": "1.2.0",
  "metadata": {
    "name": "interface_flux_K_lev_tracer",
    "description": "The interface flux of stencils/interface_flux_K_lev for ONE member s of a trailing tracer axis: G[n,s] = K[n] (u[n,s]-u[n-1,s])/(zc[n]-zc[n-1]). The coefficient K and the geometry are shared by every tracer; only u carries the second index. Identical arithmetic to interface_flux_K_lev applied to the column u[:,s].",
    "license": "MIT"
  },
  "expression_template_imports": [
    {
      "ref": "../grid.esm"
    }
  ],
  "expression_templates": {
    "interface_flux_K_lev_tracer": {
      "params": [
        "u",
        "K",
        "n",
        "s"
      ],
      "body": {
        "op": "*",
        "args": [
          {
            "op": "index",
            "args": [
              "K",
              "n"
            ]
          },
          {
            "op": "/",
            "args": [
              {
                "op": "-",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "u",
                      "n",
                      "s"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "u",
                      {
                        "op": "-",
                        "args": [
                          "n",
                          1
                        ]
                      },
                      "s"
                    ]
                  }
                ]
              },
              {
                "op": "-",
                "args": [
                  {
                    "op": "index",
                    "args": [
                      "zc",
                      "n"
                    ]
                  },
                  {
                    "op": "index",
                    "args": [
                      "zc",
                      {
                        "op": "-",
                        "args": [
                          "n",
                          1
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}