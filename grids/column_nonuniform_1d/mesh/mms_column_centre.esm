{
  "esm": "2.4.0",
  "metadata": {
    "name": "mms_column_centre",
    "description": "The layer centres of the grid's shared MMS test column (mesh/mms_column.esm) as a CLOSED per-layer template, for build-time positions -- ic equations -- where the consumer's grid-derived observed zc is out of scope (AGENTS.md build-time scope caveat) -- a fixture template library (grids/*/mesh/ holds fixture geometry, schema-validated only). `mms_column_zc(i)` is the mid-point of layer i of the quadratic-stretch unit column, 0.5 ( z((i-1)/NLEV) + z(i/NLEV) ) with z(xi) = 0.6 xi + 0.4 xi^2: the value the runtime observed zc = column_cell_center(mms_column_ze()) takes at layer i, spelled from the layer index, literals and the metaparameter NLEV only, so an ic applies it inside its own aggregate over lev (faq output_idx [i], z bound to mms_column_zc(i)) and the coordinate formula is written once instead of once per ic. It reads no model name, so it is closed and the build inlines it to exactly the inline spelling. Not usable in a 6.6.5 test reference: the inline-test oracle does not resolve template references, so references keep the inline spelling.",
    "license": "MIT",
    "tags": [
      "esd:mesh-data",
      "family:column",
      "grid:column_nonuniform_1d",
      "mesh:quadratic_stretch"
    ]
  },
  "operator_imports": [
    { "ref": "../grid.esm" }
  ],
  "operators": {
    "mms_column_zc": {
      "params": ["i"],
      "description": "Mid-point of layer i of the quadratic-stretch unit column: 0.5 (z((i-1)/NLEV) + z(i/NLEV)), z(xi) = 0.6 xi + 0.4 xi^2.",
      "body": {
        "op": "*",
        "args": [
          0.5,
          {
            "op": "+",
            "args": [
              {
                "op": "+",
                "args": [
                  { "op": "*", "args": [0.6, { "op": "/", "args": [{ "op": "-", "args": ["i", 1] }, "NLEV"] }] },
                  {
                    "op": "*",
                    "args": [
                      0.4,
                      { "op": "/", "args": [{ "op": "-", "args": ["i", 1] }, "NLEV"] },
                      { "op": "/", "args": [{ "op": "-", "args": ["i", 1] }, "NLEV"] }
                    ]
                  }
                ]
              },
              {
                "op": "+",
                "args": [
                  { "op": "*", "args": [0.6, { "op": "/", "args": ["i", "NLEV"] }] },
                  { "op": "*", "args": [0.4, { "op": "/", "args": ["i", "NLEV"] }, { "op": "/", "args": ["i", "NLEV"] }] }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
