{
  "esm": "1.2.0",
  "metadata": {
    "name": "column_tracer_axis",
    "description": "A trailing TRACER axis for column_nonuniform_1d: `tracer`, NTRACER members, for fields shaped [lev, tracer] -- many transported constituents sharing one column's geometry and coefficients (chemical species, aerosol sections). A consumer whose own axis has another name imports the rules that use it with `rename: {tracer: <its axis>}` and binds NTRACER to that axis's size.",
    "license": "MIT"
  },
  "metaparameters": {
    "NTRACER": {
      "type": "integer",
      "default": 1,
      "description": "Number of tracers on the trailing axis."
    }
  },
  "index_sets": {
    "tracer": {
      "kind": "interval",
      "size": "NTRACER"
    }
  },
  "expression_templates": {}
}